<file path="apps/web/src/modules/repository/wbs-transfer-state.ts">
import { isRecord, numberValue, stringValue } from "@line_bot_v1/platform/validation";
import { parseProjectManagementCommand } from "@line_bot_v1/project/application/management";
import type { ProjectManagementCommand } from "@line_bot_v1/project/contracts/management";
import {
  parseCancelWbsScopeTransferCommand,
  parseRequestWbsScopeTransferCommand,
} from "@line_bot_v1/wbs/application/commands/transfer";
import type {
  CancelWbsScopeTransferCommand,
  RequestWbsScopeTransferCommand,
  WbsScopeTransfer,
} from "@line_bot_v1/wbs/contracts/dto/transfer";

export type CreateTransferProjectCommand = Extract<
  ProjectManagementCommand,
  { action: "create-project" }
>;

export type WbsTransferOperation = Readonly<{
  actorUserId: string;
  repositoryId: string;
  sourceVersion: number;
  sourceHeadRevisionId: string;
  createCommand: CreateTransferProjectCommand;
  transferCommand: RequestWbsScopeTransferCommand | null;
  accepted: WbsScopeTransfer | null;
}>;

export type WbsTransferCancellation = Readonly<{
  actorUserId: string;
  repositoryId: string;
  command: CancelWbsScopeTransferCommand;
}>;

export function parseWbsTransferOperation(
  value: unknown,
  expected: {
    actorUserId: string;
    repositoryId: string;
    sourceVersion: number;
    sourceHeadRevisionId: string;
  },
): WbsTransferOperation {
  if (!isRecord(value)) throw new Error("WBS 移轉重試資料不正確。");
  const createCommand = parseProjectManagementCommand(value.createCommand);
  if (
    createCommand.action !== "create-project" ||
    createCommand.ownerKind !== "USER" ||
    createCommand.ownerAccountId !== expected.actorUserId ||
    createCommand.public ||
    createCommand.repositoryId !== expected.repositoryId ||
    createCommand.teamId !== null ||
    createCommand.expectedVersion !== 0 ||
    value.actorUserId !== expected.actorUserId ||
    value.repositoryId !== expected.repositoryId ||
    typeof value.sourceVersion !== "number" ||
    typeof value.sourceHeadRevisionId !== "string"
  ) {
    throw new Error("WBS 移轉重試範圍不正確。");
  }
  const transferCommand =
    value.transferCommand === null
      ? null
      : parseRequestWbsScopeTransferCommand(value.transferCommand);
  if (
    transferCommand &&
    (transferCommand.repositoryId !== expected.repositoryId ||
      transferCommand.sourceVersion !== value.sourceVersion ||
      transferCommand.sourceHeadRevisionId !== value.sourceHeadRevisionId)
  ) {
    throw new Error("WBS 移轉請求與來源版本不一致。");
  }
  const accepted = value.accepted === null ? null : parseWbsScopeTransfer(value.accepted);
  if (
    accepted &&
    (!transferCommand ||
      accepted.id !== transferCommand.transferId ||
      accepted.requestId !== transferCommand.requestId ||
      accepted.actorUserId !== expected.actorUserId ||
      accepted.repositoryId !== expected.repositoryId ||
      accepted.projectId !== transferCommand.projectId ||
      accepted.sourceVersion !== value.sourceVersion ||
      accepted.sourceHeadRevisionId !== value.sourceHeadRevisionId)
  ) {
    throw new Error("WBS 移轉回執不一致。");
  }
  if (
    !accepted &&
    (value.sourceVersion !== expected.sourceVersion ||
      value.sourceHeadRevisionId !== expected.sourceHeadRevisionId)
  ) {
    throw new Error("WBS 移轉重試來源已變更。");
  }
  return {
    actorUserId: expected.actorUserId,
    repositoryId: expected.repositoryId,
    sourceVersion: value.sourceVersion,
    sourceHeadRevisionId: value.sourceHeadRevisionId,
    createCommand,
    transferCommand,
    accepted,
  };
}

export function parseWbsScopeTransfer(value: unknown): WbsScopeTransfer {
  if (!isRecord(value)) throw new Error("WBS 移轉回應不完整。");
  const state = value.state;
  if (state !== "REQUESTED" && state !== "ACTIVE" && state !== "CANCELLED")
    throw new Error("WBS 移轉狀態不正確。");
  return {
    id: stringValue(value.id),
    repositoryId: stringValue(value.repositoryId),
    projectId: stringValue(value.projectId),
    actorUserId: stringValue(value.actorUserId),
    requestId: stringValue(value.requestId),
    state,
    sourceVersion: numberValue(value.sourceVersion),
    sourceHeadRevisionId: stringValue(value.sourceHeadRevisionId),
    revisionCount: numberValue(value.revisionCount),
    commandCount: numberValue(value.commandCount),
    sourceHash: stringValue(value.sourceHash),
    requestedAt: numberValue(value.requestedAt),
    activatedAt: value.activatedAt === null ? null : numberValue(value.activatedAt),
    releaseSha: value.releaseSha === null ? null : stringValue(value.releaseSha),
    cancelledAt: value.cancelledAt === null ? null : numberValue(value.cancelledAt),
    cancelRequestId: value.cancelRequestId === null ? null : stringValue(value.cancelRequestId),
  };
}

export function parseWbsTransferCancellation(
  value: unknown,
  expected: { actorUserId: string; repositoryId: string },
): WbsTransferCancellation {
  if (!isRecord(value)) throw new Error("WBS 移轉撤回重試資料不正確。");
  const command = parseCancelWbsScopeTransferCommand(value.command);
  if (
    value.actorUserId !== expected.actorUserId ||
    value.repositoryId !== expected.repositoryId ||
    command.repositoryId !== expected.repositoryId
  ) {
    throw new Error("WBS 移轉撤回重試範圍不正確。");
  }
  return { actorUserId: expected.actorUserId, repositoryId: expected.repositoryId, command };
}

export function reconcileWbsTransferCancellation(
  cancellation: WbsTransferCancellation | null,
  durable: WbsScopeTransfer | null,
): WbsTransferCancellation | null {
  if (!cancellation || !durable) return cancellation;
  return durable.state === "REQUESTED" &&
    cancellation.repositoryId === durable.repositoryId &&
    cancellation.command.repositoryId === durable.repositoryId &&
    cancellation.command.transferId === durable.id
    ? cancellation
    : null;
}
</file>

<file path="apps/web/src/modules/repository/wiki-http.server.ts">
import type { createWikiHistory } from "@line_bot_v1/wiki/application/use-cases/history";
import type { createWiki } from "@line_bot_v1/wiki/application/use-cases/pages";
import { WikiError } from "@line_bot_v1/wiki/domain/wiki-error";
import { jsonResponse } from "../../shared/server/http";
import { repositoryBody, repositoryFailure, repositoryPathSelector } from "./http.server";

type WikiWebScope = {
  actorUserId: string;
  repository: { id: string; ownerLogin: string; name: string };
  canEdit: boolean;
  canManageRepository: boolean;
  archived: boolean;
};
export type WikiWebRuntime = {
  scope(
    subject: string,
    selector: { ownerLogin: string; repositoryName: string },
  ): Promise<WikiWebScope>;
  pages(): ReturnType<typeof createWiki>;
  history(): ReturnType<typeof createWikiHistory>;
};
export async function wikiRequest(
  request: Request,
  runtime: WikiWebRuntime,
  identity: (request: Request) => Promise<string>,
) {
  try {
    const subject = await identity(request);
    const query = new URL(request.url).searchParams;
    const scope = await runtime.scope(
      subject,
      repositoryPathSelector(query.get("owner") ?? "", query.get("name") ?? ""),
    );
    const user = scope.actorUserId,
      repositoryId = scope.repository.id;
    if (request.method === "POST") {
      const command = await repositoryBody(request, 2097152);
      if (command.repositoryId !== repositoryId)
        throw new WikiError(400, "Wiki scope does not match this Repository URL.");
      if (
        query.has("pageId") &&
        (typeof command.pageId !== "string" ||
          command.pageId.toLowerCase() !== query.get("pageId")?.toLowerCase())
      )
        throw new WikiError(400, "Wiki page does not match this request URL.");
      return jsonResponse(await runtime.pages().execute(user, command));
    }
    const pageId = query.get("pageId");
    const view = query.get("view") ?? (pageId ? "page" : "list");
    if (view === "list")
      return jsonResponse({
        ...scope,
        ...(await runtime.pages().list(user, repositoryId, query.get("after") ?? undefined)),
      });
    if (!pageId) throw new WikiError(400, "Wiki page ID is required.");
    const selector = { repositoryId, pageId };
    if (view === "page")
      return jsonResponse({
        ...scope,
        revision: await runtime.pages().read(user, {
          ...selector,
          ...(query.has("revisionId") ? { revisionId: query.get("revisionId") ?? "" } : {}),
        }),
      });
    if (view === "history")
      return jsonResponse({
        ...scope,
        ...(await runtime
          .history()
          .history(user, selector, query.has("before") ? Number(query.get("before")) : undefined)),
      });
    if (view === "compare")
      return jsonResponse({
        ...scope,
        ...(await runtime
          .history()
          .compare(user, selector, query.get("beforeId") ?? "", query.get("afterId") ?? "")),
      });
    throw new WikiError(400, "Unknown Wiki query.");
  } catch (error) {
    if (error instanceof WikiError) return jsonResponse({ error: error.message }, error.status);
    return repositoryFailure(error);
  }
}
