<file path="packages/account/src/application/user-profile-status.ts">
import type { UserProfileStatusChange } from "../contracts/dto/user-profile-status.js";
import type { UserProfileStatusPersistence } from "../contracts/output/user-profile-status.js";
import type { UserProfileStatusStore } from "../contracts/repositories/user-profile-status.js";
import { UserError } from "../domain/user.js";
import {
  nextUserProfileStatusVersion,
  requireUserProfileStatusWriter,
  userProfileStatusFields,
} from "../domain/user-profile-status.js";

function isRecord(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

export function parseUserProfileStatusChange(input: unknown): UserProfileStatusChange {
  if (!isRecord(input)) throw new UserError(400, "狀態格式不正確。");
  const allowed = new Set([
    "requestId",
    "message",
    "emoji",
    "limitedAvailability",
    "expiresAt",
    "expectedVersion",
  ]);
  if (Object.keys(input).some((key) => !allowed.has(key))) {
    throw new UserError(400, "狀態包含不支援的欄位。");
  }
  if (
    typeof input.requestId !== "string" ||
    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
      input.requestId,
    ) ||
    !Number.isSafeInteger(input.expectedVersion) ||
    Number(input.expectedVersion) < 0
  ) {
    throw new UserError(400, "狀態操作編號或版本不正確。");
  }
  return {
    requestId: input.requestId.toLowerCase(),
    ...userProfileStatusFields(input),
    expectedVersion: Number(input.expectedVersion),
  };
}

export function createUserProfileStatuses(deps: {
  activeUser(subject: string): Promise<{ id: string }>;
  store(): UserProfileStatusStore;
  persistence(): UserProfileStatusPersistence;
  now(): number;
}) {
  return {
    get: async (subject: string) => deps.store().read((await deps.activeUser(subject)).id),
    publicByUserId: async (userId: string) => {
      const status = await deps.store().readPublic(userId, deps.now());
      return status
        ? {
            message: status.message,
            emoji: status.emoji,
            limitedAvailability: status.limitedAvailability,
            expiresAt: status.expiresAt,
          }
        : null;
    },
    change: async (subject: string, input: unknown) => {
      const command = parseUserProfileStatusChange(input);
      const userId = (await deps.activeUser(subject)).id;
      const payload = JSON.stringify(command);
      const at = deps.now();
      return deps.persistence().transact(userId, command.requestId, async (transaction) => {
        requireUserProfileStatusWriter(await transaction.active());
        const replay = await transaction.replay(payload);
        if (replay) {
          if (!replay.matches) throw new UserError(409, "狀態操作編號已用於不同內容。");
          return replay.result;
        }
        const current = await transaction.current();
        const version = nextUserProfileStatusVersion(
          current?.version ?? null,
          command.expectedVersion,
        );
        const saved = await transaction.save(
          {
            message: command.message,
            emoji: command.emoji,
            limitedAvailability: command.limitedAvailability,
            expiresAt: command.expiresAt,
          },
          command.expectedVersion,
          version,
          at,
        );
        const result = { ...saved, requestId: command.requestId };
        await transaction.record(payload, result, at);
        return result;
      });
    },
  };
}
</file>

<file path="packages/account/src/application/user.ts">
import { normalizeAccountLogin } from "@line_bot_v1/namespace";
import type { GoogleLinkRepository, UserRepository, UserView } from "../contracts/input/user.js";
import type { VerifiedGoogleIdentity } from "../contracts/output/identity-provider.js";
import { requireActiveUser, UserError } from "../domain/user.js";

export type AccountView = UserView;

/** Decodes the Account-owned projection at an untrusted transport boundary. */
export function parseAccountView(value: unknown): AccountView {
  if (
    value === null ||
    typeof value !== "object" ||
    Array.isArray(value) ||
    !("id" in value) ||
    typeof value.id !== "string" ||
    !("status" in value) ||
    (value.status !== "active" && value.status !== "paused" && value.status !== "suspended") ||
    !("createdAt" in value) ||
    typeof value.createdAt !== "number" ||
    !Number.isFinite(value.createdAt) ||
    !("login" in value) ||
    typeof value.login !== "string" ||
    !("googleEmail" in value) ||
    (value.googleEmail !== null && typeof value.googleEmail !== "string")
  ) {
    throw new TypeError("Account view is invalid");
  }
  return {
    id: value.id,
    status: value.status,
    createdAt: value.createdAt,
    login: value.login,
    googleEmail: value.googleEmail,
  };
}

export interface UserDependencies {
  repository(): UserRepository;
  lineProvider(): string;
}

export function createUser(deps: UserDependencies) {
  return {
    /** Finds the User for a delivery-verified provider subject without expanding it. */
    findUser: (subject: string) => deps.repository().find(deps.lineProvider(), subject),

    /** Looks up the Account-owned User projection in one provider-qualified read. */
    getUser: (subject: string) => deps.repository().viewByIdentity(deps.lineProvider(), subject),

    /** Resolves a trusted provider subject to the stable ID needed by protected operations. */
    activeLineUser: async (subject: string) =>
      requireActiveUser(await deps.repository().find(deps.lineProvider(), subject)),

    /** Reads an active User after Namespace has resolved its stable Account ID. */
    publicById: (userId: string) => deps.repository().publicById(userId),

    /** Changes the current User locator without coupling it to Profile metadata. */
    updateLogin: async (subject: string, value: unknown, expectedValue: unknown) => {
      if (typeof value !== "string" || typeof expectedValue !== "string")
        throw new UserError(400, "登入名稱格式不正確。");
      let login: string;
      let expectedLogin: string;
      try {
        login = normalizeAccountLogin(value);
        expectedLogin = normalizeAccountLogin(expectedValue);
      } catch {
        throw new UserError(400, "登入名稱格式不正確或已保留。");
      }
      const account = requireActiveUser(await deps.repository().find(deps.lineProvider(), subject));
      return deps.repository().updateLogin(account.id, login, expectedLogin, Date.now());
    },

    /** Explicit LINE registration; the repository returns the committed Account projection. */
    registerUser: (subject: string, value: unknown) => {
      if (typeof value !== "string") throw new UserError(400, "登入名稱格式不正確。");
      let login: string;
      try {
        login = normalizeAccountLogin(value);
      } catch {
        throw new UserError(400, "登入名稱格式不正確或已保留。");
      }
      return deps.repository().registerLine(deps.lineProvider(), subject, login);
    },

    /** A User may be paused by its verified owner only while active. */
    pauseUser: async (subject: string) => {
      const account = requireActiveUser(await deps.repository().find(deps.lineProvider(), subject));
      return deps.repository().pause(account.id);
    },

    restoreUser: (subject: string) => deps.repository().restoreLine(deps.lineProvider(), subject),
  };
}

export type UserUseCases = ReturnType<typeof createUser>;

/** LINE proof owns the request; Google proof may only fill its pending result. */
export function createGoogleLink(deps: {
  repository(): GoogleLinkRepository;
  lineProvider(): string;
  now(): number;
}) {
  return {
    start: (subject: string) => deps.repository().start(deps.lineProvider(), subject, deps.now()),
    pending: (subject: string) =>
      deps.repository().pending(deps.lineProvider(), subject, deps.now()),
    stage: (token: string, google: VerifiedGoogleIdentity) =>
      deps.repository().stage(token, google, deps.now()),
    confirm: (subject: string, id: string) =>
      deps.repository().confirm(deps.lineProvider(), subject, id, deps.now()),
    cancel: (subject: string, id: string) =>
      deps.repository().cancel(deps.lineProvider(), subject, id),
    unlink: (subject: string) => deps.repository().unlink(deps.lineProvider(), subject, deps.now()),
  };
}
