      deps
        .store()
        .view(
          await identity(subject),
          identifier(repositoryId, "Repository 識別碼"),
          identifier(issueId, "Issue 識別碼"),
        ),
    command: async (subject: string, raw: unknown) =>
      deps.store().execute(await identity(subject), parseCommand(raw), deps.now()),
  };
}
