import type { PermissionStore } from "../contracts/input/permissions.js";
import { PermissionError } from "../domain/permission.js";
import { parsePermissionCommand } from "./commands/permission.js";

export { type PermissionCommand, parsePermissionCommand } from "./commands/permission.js";
export function createPermissions(deps: {
  activeUser(subject: string): Promise<{ id: string }>;
  store(): PermissionStore;
  now(): number;
}) {
  return {
    async read(subject: string, target = "") {
      if (target.length > 128) throw new PermissionError(400, "會員編號不正確。");
      const user = await deps.activeUser(subject);
      return deps.store().read(user.id, target);
    },
    async change(subject: string, raw: unknown) {
      const c = parsePermissionCommand(raw);
      const user = await deps.activeUser(subject);
      return deps.store().change(user.id, c, deps.now());
    },
  };
}
</file>

