<file path="apps/web/src/modules/resources/resources-http.server.ts">
import { UserError } from "@line_bot_v1/account/domain/user";
import { normalizeAccountLogin } from "@line_bot_v1/namespace";
import { RepositoryError } from "@line_bot_v1/repository/contracts/errors/repository-error";
import { normalizeRepositoryName } from "@line_bot_v1/repository/domain/repository/value-objects/repository-name";
import type { createResources } from "@line_bot_v1/resources/application/use-cases/resources";
import { ResourceError } from "@line_bot_v1/resources/domain/resource-error";
import { logServerError } from "../../shared/observability/runtime-error.server";
import { BodyTooLargeError, jsonResponse, readBodyText } from "../../shared/server/http";
import { RequestIdentityError } from "../../shared/server/request-identity-error";

type Scope = {
  actorUserId: string;
  repository: { id: string; ownerLogin: string; name: string };
  archived: boolean;
  canEdit: boolean;
  canManage: boolean;
};
export type ResourceWebRuntime = {
  scope(subject: string, selector: { ownerLogin: string; repositoryName: string }): Promise<Scope>;
  owner(): ReturnType<typeof createResources>;
};

function selector(query: URLSearchParams) {
  try {
    const ownerLogin = normalizeAccountLogin(query.get("owner") ?? "");
    const repositoryName = normalizeRepositoryName(query.get("name") ?? "");
    if (!repositoryName) throw new Error();
    return { ownerLogin, repositoryName };
  } catch {
    throw new ResourceError(400, "Repository locator is invalid.", "INVALID_INPUT");
  }
}
async function body(request: Request) {
  const origin = process.env.APP_ORIGIN;
  if (!origin || new URL(origin).origin !== origin || !origin.startsWith("https://"))
    throw new ResourceError(503, "Service origin is unavailable.", "UNAVAILABLE");
  if (request.headers.get("origin") !== origin)
    throw new ResourceError(403, "Use the Line_Bot_v1 application.", "FORBIDDEN");
  if (request.headers.get("content-type")?.split(";")[0]?.trim() !== "application/json")
    throw new ResourceError(415, "JSON is required.", "INVALID_INPUT");
  let text: string;
  try {
    text = await readBodyText(request, 524_288);
  } catch (error) {
    if (error instanceof BodyTooLargeError)
      throw new ResourceError(413, "Content is too large.", "INVALID_INPUT");
    throw error;
  }
  try {
    return JSON.parse(text);
  } catch {
    throw new ResourceError(400, "Invalid JSON body.", "INVALID_INPUT");
  }
}
function failure(error: unknown) {
  const known =
    error instanceof ResourceError ||
    error instanceof RepositoryError ||
    error instanceof UserError ||
    error instanceof RequestIdentityError;
  const status = known ? error.status : 503;
  logServerError(error, {
    service: "repository-resources-api",
    operation: "request",
    status,
  });
  return jsonResponse(
    {
      error: error instanceof Error ? error.message : String(error),
      ...(error instanceof ResourceError ? { code: error.code } : {}),
    },
    status,
  );
}
export async function resourcesRequest(
  request: Request,
  runtime: ResourceWebRuntime,
  identity: (request: Request) => Promise<string>,
) {
  try {
    const command = request.method === "POST" ? await body(request) : undefined;
    const subject = await identity(request);
    const query = new URL(request.url).searchParams;
    const scope = await runtime.scope(subject, selector(query));
    const owner = runtime.owner();
    if (request.method === "POST") {
      if (command?.repositoryId !== scope.repository.id)
        throw new ResourceError(400, "Resource scope does not match the URL.", "INVALID_INPUT");
      return jsonResponse(await owner.execute(scope.actorUserId, command));
    }
    const resourceId = query.get("resourceId");
    const view = query.get("view") ?? (resourceId ? "read" : "list");
    if (view === "list")
      return jsonResponse({
        ...scope,
        ...(await owner.list(
          scope.actorUserId,
          scope.repository.id,
          query.get("after") ?? undefined,
        )),
      });
    if (!resourceId) throw new ResourceError(400, "Resource ID is required.", "INVALID_INPUT");
    if (view === "history")
      return jsonResponse({
        ...scope,
        ...(await owner.history(
          scope.actorUserId,
          { repositoryId: scope.repository.id, resourceId },
          query.has("before") ? Number(query.get("before")) : undefined,
        )),
      });
    if (view === "read")
      return jsonResponse({
        ...scope,
        revision: await owner.read(scope.actorUserId, {
          repositoryId: scope.repository.id,
          resourceId,
          ...(query.has("revisionId") ? { revisionId: query.get("revisionId") ?? "" } : {}),
        }),
      });
    throw new ResourceError(400, "Unknown Resource query.", "INVALID_INPUT");
  } catch (error) {
    return failure(error);
  }
}
</file>

<file path="packages/content/src/application/commands/plans.ts">
import { isRecord } from "@line_bot_v1/platform/validation";
import { ContentError } from "../../domain/error.js";
import {
  type ContentMeasure,
  type ContentNodeKind,
  type ContentPlanDocument,
  type ContentPlanNode,
  type ContentResourceKind,
  type ContentResourcePin,
} from "../../domain/plan.js";
import { normalizeQuantityUnit } from "../../domain/quantity.js";

const uuid = /^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i;

export type ContentPlanCommand =
  | Readonly<{
      action: "initialize" | "replace";
      repositoryId: string;
      requestId: string;
      expectedVersion: number;
      document: ContentPlanDocument;
    }>
  | Readonly<{
      action: "import-contract-document";
      repositoryId: string;
      requestId: string;
      expectedVersion: number;
      confirmedDisclosure: true;
      contract: Readonly<{ documentId: string; revisionId: string }>;
    }>;

function invalid(message = "Invalid Content plan command."): never {
  throw new ContentError(400, message, "INVALID_INPUT");
}

function object(value: unknown): Record<string, unknown> {
  if (!isRecord(value)) return invalid();
  return { ...value };
}

function exact(value: Record<string, unknown>, keys: readonly string[]): void {
  if (Object.keys(value).some((key) => !keys.includes(key))) invalid("Unknown Content plan field.");
}

function id(value: unknown): string {
  if (typeof value !== "string" || !uuid.test(value)) return invalid();
  return value.toLowerCase();
}

function text(value: unknown): string {
  if (typeof value !== "string") return invalid();
  return value;
}

function integer(value: unknown): number {
  if (typeof value !== "number" || !Number.isSafeInteger(value)) return invalid();
  return value;
}

function nodeKind(value: unknown): ContentNodeKind {
  if (
    value !== "SUBJECT" &&
    value !== "OBJECT" &&
    value !== "SUBOBJECT" &&
    value !== "WORK" &&
    value !== "TASK"
  )
    return invalid();
  return value;
}

function resourceKind(value: unknown): ContentResourceKind {
  if (value !== "LOCATION" && value !== "EQUIPMENT" && value !== "MATERIAL") return invalid();
  return value;
}

function measure(input: unknown): ContentMeasure {
  const value = object(input);
  exact(value, ["id", "name", "subject", "unit"]);
  return {
    id: id(value.id),
    name: text(value.name),
    subject: text(value.subject),
    unit: normalizeQuantityUnit(value.unit),
  };
}

function node(input: unknown): ContentPlanNode {
  const value = object(input);
  exact(value, ["id", "parentId", "position", "kind", "title", "body", "plannedQuantity"]);
  const kind = nodeKind(value.kind);
  const position = integer(value.position);
  if (position < 0) return invalid();
  let plannedQuantity: ContentPlanNode["plannedQuantity"] = null;
  if (value.plannedQuantity !== null) {
    const quantity = object(value.plannedQuantity);
    exact(quantity, ["measureId", "value"]);
    const quantityValue = text(quantity.value);
    if (quantityValue.length > 32) return invalid();
    plannedQuantity = { measureId: id(quantity.measureId), value: quantityValue };
  }
  return {
    id: id(value.id),
    parentId: value.parentId === null ? null : id(value.parentId),
    position,
    kind,
    title: text(value.title),
    body: text(value.body),
    plannedQuantity,
  };
}

function pin(input: unknown): ContentResourcePin {
  const value = object(input);
  exact(value, ["nodeId", "resourceId", "resourceRevisionId", "kind"]);
  const kind = resourceKind(value.kind);
  return {
    nodeId: id(value.nodeId),
    resourceId: id(value.resourceId),
    resourceRevisionId: id(value.resourceRevisionId),
    kind,
  };
}

function document(input: unknown): ContentPlanDocument {
  const value = object(input);
  exact(value, ["schemaVersion", "measures", "nodes", "resourcePins"]);
  if (
    value.schemaVersion !== 1 ||
    !Array.isArray(value.measures) ||
    !Array.isArray(value.nodes) ||
    !Array.isArray(value.resourcePins) ||
    value.measures.length > 1000 ||
    value.nodes.length > 1000 ||
    value.resourcePins.length > 5000
  )
    return invalid();
  return {
    schemaVersion: 1,
    measures: value.measures.map(measure),
    nodes: value.nodes.map(node),
    resourcePins: value.resourcePins.map(pin),
  };
}

export function parseContentPlanCommand(input: unknown): ContentPlanCommand {
  const value = object(input);
  const expectedVersion = integer(value.expectedVersion);
  if (
    typeof value.repositoryId !== "string" ||
    value.repositoryId.length < 1 ||
    value.repositoryId.length > 128 ||
    expectedVersion < 0 ||
    expectedVersion >= 2_147_483_647
  )
    return invalid();
  const repositoryId = value.repositoryId;
  const requestId = id(value.requestId);
  if (value.action === "import-contract-document") {
    exact(value, [
      "action",
      "repositoryId",
      "requestId",
      "expectedVersion",
      "confirmedDisclosure",
      "contract",
    ]);
    if (expectedVersion === 0 || value.confirmedDisclosure !== true)
      return invalid("Explicit whole-document Content disclosure is required.");
    const contract = object(value.contract);
    exact(contract, ["documentId", "revisionId"]);
    return {
      action: "import-contract-document",
      repositoryId,
      requestId,
      expectedVersion,
      confirmedDisclosure: true,
      contract: { documentId: id(contract.documentId), revisionId: id(contract.revisionId) },
    };
  }
  exact(value, ["action", "repositoryId", "requestId", "expectedVersion", "document"]);
  if (value.action !== "initialize" && value.action !== "replace") return invalid();
  return {
    action: value.action,
    repositoryId,
    requestId,
    expectedVersion,
    document: document(value.document),
  };
}
</file>

