}

.home-create-popover a:hover,
.home-create-popover a:focus-visible {
  background: #30363d;
}

.home-create-icon {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  place-items: center;
  border-radius: 7px;
  background: #30363d;
  color: var(--green-strong);
  font-weight: 700;
}

.home-create-popover strong,
.home-create-popover small {
  display: block;
}

.home-create-popover small {
  margin-top: 4px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

@media (max-width: 430px) {
  .home-create-popover {
    right: -48px;
  }
