<file path="packages/assistant/src/application/use-cases/draft-issue.ts">
import { type IssueDraft, validateIssueDraft } from "../../contracts/dto/issue-draft.js";
import type { IntakeModel, IntakeTime } from "../../contracts/output/intake-model.js";

/** Anchor relative dates before drafting; untrusted model output never commits an Issue. */
export async function draftAssistantIssue(deps: {
  input: string;
  model: IntakeModel;
  now(): Date;
}): Promise<IssueDraft> {
  if (!deps.input.trim() || deps.input.length > 500) throw new Error("Invalid agent input");
  const controller = new AbortController();
  let timer: ReturnType<typeof setTimeout> | undefined;
  const run = async () => {
    await deps.model.requestTime(controller.signal);
    const now = deps.now();
    const time: IntakeTime = {
      timezone: "Asia/Taipei",
      local: new Intl.DateTimeFormat("sv-SE", {
        timeZone: "Asia/Taipei",
        dateStyle: "short",
        timeStyle: "medium",
      }).format(now),
      weekday: new Intl.DateTimeFormat("zh-TW", {
        timeZone: "Asia/Taipei",
        weekday: "long",
      }).format(now),
    };
    if (controller.signal.aborted) throw new Error("Agent timed out");
    return validateIssueDraft(await deps.model.draftIssue(time, controller.signal));
  };
  try {
    return await Promise.race([
      run(),
      new Promise<never>((_, reject) => {
        timer = setTimeout(() => {
          controller.abort();
          reject(new Error("Agent timed out"));
        }, 12_000);
      }),
    ]);
  } finally {
    clearTimeout(timer);
  }
}
</file>

<file path="packages/assistant/src/application/answer-question.ts">
import type { AnswerDependencies } from "../contracts/output/answer.js";

export type AnswerResult =
  | { type: "help" | "tooLong" | "cooldown" | "empty" | "unavailable" }
  | { type: "time"; at: number }
  | { type: "text"; text: string };

/** Only explicitly addressed input from an authorized delivery adapter reaches this use case. */
export function createAnswerAssistantQuestion(deps: AnswerDependencies) {
  return async (input: string): Promise<AnswerResult> => {
    if (!input) return { type: "help" };
    if (/^(?:今天|現在).*(?:幾號|日期|星期|幾點|時間)[？?。!！]*$/.test(input)) {
      return { type: "time", at: deps.now() };
    }
    if (/^(?:建立\s*Issue|Issue|議題)[：:\s]/i.test(input)) {
      return {
        type: "text",
        text: await deps.draftIssue(input.replace(/^(?:建立\s*Issue|Issue|議題)[：:\s]+/i, "")),
      };
    }
    if (input.length > 500) return { type: "tooLong" };
    if (!deps.acquireCooldown()) return { type: "cooldown" };
    try {
      const text = (await deps.generate(input))?.trim().slice(0, 2000);
      return text ? { type: "text", text } : { type: "empty" };
    } catch {
      return { type: "unavailable" };
    }
  };
}
</file>

<file path="packages/assistant/src/contracts/dto/issue-draft.ts">
export type IssueDraft = {
  title: string;
  dueDate: string;
  timeHint: string;
  checklist: string[];
  questions: string[];
};

function isRecord(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

export function validateIssueDraft(value: unknown): IssueDraft {
  if (!isRecord(value)) throw new Error("Invalid draft");
  const v = value;
  const fields = ["title", "dueDate", "timeHint", "checklist", "questions"];
  if (Object.keys(v).some((key) => !fields.includes(key)))
    throw new Error("Unexpected draft fields");
  const str = (s: unknown, limit: number): s is string =>
    typeof s === "string" && s.length <= limit && !/[\u0000-\u001f]/.test(s);
  const list = (s: unknown, min: number): s is string[] =>
    Array.isArray(s) && s.length >= min && s.length <= 5 && s.every((t) => str(t, 120) && t.trim());
  if (
    !str(v.title, 80) ||
    !v.title.trim() ||
    !str(v.timeHint, 80) ||
    !str(v.dueDate, 10) ||
    !list(v.checklist, 1) ||
    !list(v.questions, 0)
  ) {
    throw new Error("Invalid draft fields");
  }
  if (
    v.dueDate &&
    (!/^\d{4}-\d{2}-\d{2}$/.test(v.dueDate) ||
      Number.isNaN(Date.parse(v.dueDate)) ||
      new Date(v.dueDate).toISOString().slice(0, 10) !== v.dueDate)
  ) {
    throw new Error("Invalid draft date");
  }
  return {
    title: v.title,
    dueDate: v.dueDate,
    timeHint: v.timeHint,
    checklist: v.checklist,
    questions: v.questions,
  };
}
</file>

