<file path="packages/organization/src/postgres/membership-sources.ts">
import { GovernanceAccessError } from "@line_bot_v1/identity-access/domain/role-assignment";
import type { Sql } from "@line_bot_v1/platform/postgres";
import { literalValue, numberValue } from "@line_bot_v1/platform/validation";
import { OrganizationError, requireOrganizationOwnerAfterSourceRemoval } from "../domain.js";
import {
  hasOrganizationOwnerAssignment,
  hasReplacementOrganizationOwner,
  revokeOrganizationOwnerForMembershipRemoval,
} from "./owner-roles.js";

function refreshedMembershipRow(row: Record<string, unknown>) {
  return {
    membership_status: literalValue(row.membership_status, ["active", "removed"]),
    membership_version: numberValue(row.membership_version),
  };
}

export async function assertOrganizationMembershipSourceRemovable(
  sql: Sql,
  organizationAccountId: string,
  userId: string,
  sourceKind: "direct" | "enterprise-team",
  sourceId: string,
  affectedUserIds: readonly string[] | undefined = undefined,
) {
  // A batch supplies its complete population; single-user removals leave the other users intact.
  const hasOtherSource = Boolean(
    (
      await sql.query(
        `SELECT 1 FROM organization_membership_sources
         WHERE organization_account_id=$1 AND user_id=$2
           AND NOT (source_kind=$3 AND source_id=$4)
         LIMIT 1`,
        [organizationAccountId, userId, sourceKind, sourceId],
      )
    ).rows[0],
  );
  const targetEffective =
    !hasOtherSource && (await hasOrganizationOwnerAssignment(sql, organizationAccountId, userId));
  const anotherEffective =
    targetEffective &&
    (await hasReplacementOrganizationOwner(
      sql,
      organizationAccountId,
      userId,
      affectedUserIds ? { affectedUserIds, sourceKind, sourceId } : undefined,
    ));
  try {
    requireOrganizationOwnerAfterSourceRemoval(hasOtherSource, targetEffective, anotherEffective);
  } catch (error) {
    if (!(error instanceof OrganizationError)) throw error;
    throw new GovernanceAccessError(409, error.code, error.message);
  }
}

export async function refreshOrganizationMembershipFromSources(
  sql: Sql,
  organizationAccountId: string,
  userId: string,
  at: number,
) {
  const row = (
    await sql.query(
      `SELECT membership_status,membership_version
       FROM refresh_organization_membership($1,$2,$3)`,
      [organizationAccountId, userId, at],
      refreshedMembershipRow,
    )
  ).rows[0];
  if (row?.membership_status === "removed") {
    await revokeOrganizationOwnerForMembershipRemoval(sql, organizationAccountId, userId);
  }
  return row;
}
</file>

<file path="packages/organization/src/postgres/public.ts">
import { readActiveUserQualification } from "@line_bot_v1/account/postgres";
import { resolveAccountLogin } from "@line_bot_v1/namespace/postgres";
import { businessDatabase, type Database, type Sql } from "@line_bot_v1/platform/postgres";
import {
  booleanValue,
  nullableNumericValue,
  numberValue,
  stringValue,
} from "@line_bot_v1/platform/validation";
import type {
  OrganizationPublicStore,
  OrganizationViewerCapabilities,
  PublicOrganization,
} from "../contracts/output/public.js";

function publicOrganizationRow(row: Record<string, unknown>) {
  return { id: stringValue(row.id), name: stringValue(row.name) };
}

function viewerCapabilitiesRow(row: Record<string, unknown>) {
  return {
    organization_version: numberValue(row.organization_version),
    membership_version: numberValue(row.membership_version),
    owner_role_version: nullableNumericValue(row.owner_role_version),
    member_can_create_public_repositories: booleanValue(row.member_can_create_public_repositories),
    member_can_create_private_repositories: booleanValue(
      row.member_can_create_private_repositories,
    ),
    member_can_create_internal_repositories: booleanValue(
      row.member_can_create_internal_repositories,
    ),
    member_can_create_project_v2: booleanValue(row.member_can_create_project_v2),
    member_can_create_teams: booleanValue(row.member_can_create_teams),
  };
}

function accountIdRow(row: Record<string, unknown>) {
  return { account_id: stringValue(row.account_id) };
}

export class PostgresOrganizationPublicStore implements OrganizationPublicStore {
  constructor(private db: Database = businessDatabase()) {}

  byLogin(login: string): Promise<PublicOrganization | null> {
    return this.db.transaction(async (sql) => {
      const owner = await resolveAccountLogin(sql, login);
      if (!owner || owner.kind !== "ORGANIZATION") return null;
      const row = (
        await sql.query(
          `SELECT account_id AS id,name
           FROM organizations
          WHERE account_id=$1 AND status='active'`,
          [owner.id],
          publicOrganizationRow,
        )
      ).rows[0];
      return row ? { ...row, login: owner.login } : null;
    });
  }
}

export async function readOrganizationViewerCapabilities(
  sql: Sql,
  userId: string,
  organizationAccountId: string,
): Promise<OrganizationViewerCapabilities | null> {
  const user = await readActiveUserQualification(sql, userId, "share");
  if (!user) return null;

  const row = (
    await sql.query(
      `SELECT o.version AS organization_version,m.version AS membership_version,
              o.member_can_create_public_repositories,
              o.member_can_create_private_repositories,
              o.member_can_create_internal_repositories,
              o.member_can_create_project_v2,
              o.member_can_create_teams,
              owner_role.version AS owner_role_version
       FROM organizations o
       JOIN organization_memberships m
         ON m.organization_account_id=o.account_id
        AND m.user_id=$2
        AND m.status='active'
       LEFT JOIN LATERAL (
         SELECT r.version
         FROM organization_role_assignments r
         WHERE r.organization_account_id=o.account_id
           AND r.user_id=$2
           AND r.role='OrganizationOwner'
           AND r.status='active'
           AND r.user_status_version=$3
           AND r.membership_version=m.version
         LIMIT 1
       ) owner_role ON true
      WHERE o.account_id=$1 AND o.status='active'`,
      [organizationAccountId, userId, user.statusVersion],
      viewerCapabilitiesRow,
    )
  ).rows[0];
  if (!row) return null;

  const isOrganizationOwner = row.owner_role_version !== null;
  const memberRole = isOrganizationOwner ? "ADMIN" : "MEMBER";
  const viewerCanAdminister = isOrganizationOwner;
  const viewerCanCreateRepositoryVisibilities = {
    public: isOrganizationOwner || row.member_can_create_public_repositories,
    private: isOrganizationOwner || row.member_can_create_private_repositories,
    internal: isOrganizationOwner || row.member_can_create_internal_repositories,
  };
  return {
    memberRole,
    isOrganizationOwner,
    viewerIsAMember: true,
    viewerCanAdminister,
    viewerCanCreateRepositories: Object.values(viewerCanCreateRepositoryVisibilities).some(Boolean),
    viewerCanCreateRepositoryVisibilities,
    viewerCanCreateProjectV2: isOrganizationOwner || row.member_can_create_project_v2,
    viewerCanCreateTeams: isOrganizationOwner || row.member_can_create_teams,
    organizationVersion: Number(row.organization_version),
    membershipVersion: Number(row.membership_version),
    roleVersion: isOrganizationOwner ? Number(row.owner_role_version) : null,
  };
}

async function activeOrganizationIds(sql: Sql, userId: string): Promise<string[]> {
  const rows = (
    await sql.query(
      `SELECT o.account_id
       FROM organizations o
       JOIN organization_memberships m
         ON m.organization_account_id=o.account_id AND m.user_id=$1
       WHERE o.status='active' AND m.status='active'
      ORDER BY o.account_id`,
      [userId],
      accountIdRow,
    )
  ).rows;
  return rows.map((row) => row.account_id);
}

export async function listOrganizationAdministrationScopeIds(
  sql: Sql,
  userId: string,
): Promise<string[]> {
  const result: string[] = [];
  for (const organizationAccountId of await activeOrganizationIds(sql, userId)) {
    const capabilities = await readOrganizationViewerCapabilities(
      sql,
      userId,
      organizationAccountId,
    );
    if (capabilities?.viewerCanAdminister) result.push(organizationAccountId);
  }
  return result;
}

export async function listOrganizationRepositoryCreationScopeIds(
  sql: Sql,
  userId: string,
): Promise<string[]> {
  const result: string[] = [];
  for (const organizationAccountId of await activeOrganizationIds(sql, userId)) {
    const capabilities = await readOrganizationViewerCapabilities(
      sql,
      userId,
      organizationAccountId,
    );
    if (capabilities?.viewerCanCreateRepositories) result.push(organizationAccountId);
  }
  return result;
}
</file>

<file path="packages/organization/src/postgres/qualification.ts">
import { readActiveUserQualification } from "@line_bot_v1/account/postgres";
import type { VerifiedLineActor } from "@line_bot_v1/identity-access/contracts/governance";
import { GovernanceAccessError } from "@line_bot_v1/identity-access/domain/role-assignment";
import { resolveVerifiedLineActor } from "@line_bot_v1/identity-access/postgres";
import { readAccountLogin } from "@line_bot_v1/namespace/postgres";
import type { Sql } from "@line_bot_v1/platform/postgres";
import { literalValue, numberValue, stringValue } from "@line_bot_v1/platform/validation";

export type OrganizationTeamQualification = Readonly<{
  userId: string;
  userStatusVersion: number;
  organizationVersion: number;
  membershipVersion: number;
  organizationLogin: string;
}>;

export type OrganizationQualification = Readonly<{
  id: string;
  status: "active" | "inactive";
  version: number;
}>;

function organizationRow(row: Record<string, unknown>): OrganizationQualification {
  return {
    id: stringValue(row.account_id),
    status: literalValue(row.status, ["active", "inactive"]),
    version: numberValue(row.version),
  };
}

function organizationAccountRow(row: Record<string, unknown>) {
  return { organizationAccountId: stringValue(row.organizationAccountId) };
}

function userIdRow(row: Record<string, unknown>) {
  return { user_id: stringValue(row.user_id) };
}

function teamQualificationRow(row: Record<string, unknown>) {
  return {
    organization_version: numberValue(row.organization_version),
    membership_version: numberValue(row.membership_version),
  };
}

export async function readOrganizationQualification(
  sql: Sql,
  organizationAccountId: string,
  lock: "none" | "share" | "update" = "none",
): Promise<OrganizationQualification | null> {
  const suffix = lock === "share" ? " FOR SHARE" : lock === "update" ? " FOR UPDATE" : "";
  const row = (
    await sql.query(
      `SELECT account_id,status,version FROM organizations
      WHERE account_id=$1${suffix}`,
      [organizationAccountId],
      organizationRow,
    )
  ).rows[0];
  return row ?? null;
}

export async function listOrganizationTeamScopes(
  sql: Sql,
  actor: VerifiedLineActor,
): Promise<Array<{ organizationAccountId: string; login: string }>> {
  const resolved = await resolveVerifiedLineActor(sql, actor);
  const rows = (
    await sql.query(
      `SELECT o.account_id AS "organizationAccountId"
       FROM organizations o
       JOIN organization_memberships m ON m.organization_account_id=o.account_id
       WHERE m.user_id=$1 AND o.status='active' AND m.status='active'
      ORDER BY o.account_id`,
      [resolved.userId],
      organizationAccountRow,
    )
  ).rows;
  const result: Array<{ organizationAccountId: string; login: string }> = [];
  for (const row of rows) {
    const locator = await readAccountLogin(sql, row.organizationAccountId, "ORGANIZATION");
    if (locator) result.push({ ...row, login: locator.login });
  }
  return result;
}

export async function activeOrganizationParticipantIds(
  sql: Sql,
  organizationAccountId: string,
  userIds: string[],
): Promise<Set<string>> {
  if (userIds.length === 0) return new Set();
  const rows = (
    await sql.query(
      `SELECT m.user_id FROM organizations o
       JOIN organization_memberships m ON m.organization_account_id=o.account_id
       WHERE o.account_id=$1 AND m.user_id=ANY($2::text[])
         AND o.status='active' AND m.status='active'
       ORDER BY m.user_id`,
      [organizationAccountId, [...new Set(userIds)].sort()],
      userIdRow,
    )
  ).rows;
  const active = new Set<string>();
  for (const row of rows) {
    if (await readActiveUserQualification(sql, row.user_id, "share")) active.add(row.user_id);
  }
  return active;
}

export async function qualifyOrganizationTeamScope(
  sql: Sql,
  actor: VerifiedLineActor,
  organizationAccountId: string,
): Promise<OrganizationTeamQualification> {
  const resolved = await resolveVerifiedLineActor(sql, actor);
  const row = (
    await sql.query(
      `SELECT o.version AS organization_version,m.version AS membership_version
       FROM organizations o
       JOIN organization_memberships m ON m.organization_account_id=o.account_id
       WHERE o.account_id=$1 AND m.user_id=$2
         AND o.status='active' AND m.status='active'
       FOR SHARE OF o,m`,
      [organizationAccountId, resolved.userId],
      teamQualificationRow,
    )
  ).rows[0];
  if (!row) {
    throw new GovernanceAccessError(403, "forbidden", "你不是此 Organization 的有效成員。");
  }
  const locator = await readAccountLogin(sql, organizationAccountId, "ORGANIZATION");
  if (!locator) {
    throw new GovernanceAccessError(409, "scope-conflict", "Organization login 不可用。");
  }
  return {
    ...resolved,
    organizationVersion: Number(row.organization_version),
    membershipVersion: Number(row.membership_version),
    organizationLogin: locator.login,
  };
}
