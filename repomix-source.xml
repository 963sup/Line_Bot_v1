<file path="packages/wbs/src/adapters/outbound/persistence/baseline-events.ts">
import { randomUUID } from "node:crypto";
import type { Database, Sql } from "@line_bot_v1/platform/postgres";
import { numericValue, stringValue } from "@line_bot_v1/platform/validation";
import type {
  WbsBaselineEvent,
  WbsBaselineEvents,
} from "../../../contracts/output/baseline-events.js";
import { PostgresWbsScopeBoundary } from "./scope-boundary.js";

/** Called under the Repository lock when a rule enables its future-event delegation. */
async function wbsEventCursor(sql: Sql, repositoryId: string) {
  const row = (
    await sql.query(
      "SELECT COALESCE(max(event_no),0) AS n FROM repository_wbs_outbox WHERE repository_id=$1",
      [repositoryId],
      (r) => ({ n: Number(numericValue(r.n)) }),
    )
  ).rows[0];
  return row?.n ?? 0;
}
export class PostgresWbsBaselineEvents implements WbsBaselineEvents {
  constructor(private db: Database) {}
  cursor(repositoryId: string) {
    return this.db.transaction(async (sql) => {
      await new PostgresWbsScopeBoundary(sql).repositoryAvailable(repositoryId);
      return wbsEventCursor(sql, repositoryId);
    });
  }
  claim(now: number) {
    return this.db.transaction(async (sql) => {
      if (!(await new PostgresWbsScopeBoundary(sql).legacyQueueAvailable())) return null;
      const token = randomUUID();
      return (
        (
          await sql.query(
            `UPDATE repository_wbs_outbox SET lease_token=$2,lease_until=$1+60000
        WHERE id=(SELECT id FROM repository_wbs_outbox WHERE acknowledged_at IS NULL
        AND (lease_until IS NULL OR lease_until<=$1) ORDER BY event_no FOR UPDATE SKIP LOCKED LIMIT 1)
        RETURNING *`,
            [now, token],
            (r) => ({
              id: stringValue(r.id),
              cursor: Number(numericValue(r.event_no)),
              repositoryId: stringValue(r.repository_id),
              baselineId: stringValue(r.baseline_id),
              revisionId: stringValue(r.revision_id),
              at: Number(numericValue(r.at)),
              leaseToken: token,
            }),
          )
        ).rows[0] ?? null
      );
    });
  }
  acknowledge(event: WbsBaselineEvent, now: number) {
    return this.db.transaction(async (sql) => {
      await new PostgresWbsScopeBoundary(sql).repositoryAvailable(event.repositoryId);
      return (
        (
          await sql.query(
            "UPDATE repository_wbs_outbox SET acknowledged_at=$3,lease_token=NULL,lease_until=NULL WHERE id=$1 AND lease_token=$2 AND lease_until>$3 AND acknowledged_at IS NULL RETURNING id",
            [event.id, event.leaseToken, now],
          )
        ).rows.length === 1
      );
    });
  }
}
</file>

<file path="packages/wbs/src/adapters/outbound/persistence/legacy-entry.ts">
import { businessDatabase, type Database, type Sql } from "@line_bot_v1/platform/postgres";
import { booleanValue } from "@line_bot_v1/platform/validation";
import type { RepositorySelector } from "@line_bot_v1/repository/contracts/selectors";
import { repositoryContentScope } from "@line_bot_v1/repository/postgres/content-scope";
import type {
  LegacyWbsEntry,
  LegacyWbsEntryQuery,
} from "../../../contracts/output/legacy-entry.js";

async function sourceRelationExists(sql: Sql) {
  return booleanValue(
    (
      await sql.query("SELECT to_regclass($1::text) IS NOT NULL AS present", [
        "app_private.repository_wbs",
      ])
    ).rows[0]?.present,
  );
}

async function hasSourceFact(sql: Sql, repositoryId: string) {
  if (!(await sourceRelationExists(sql))) return false;
  // Every source Revision, content/governance receipt and governance row is FK-rooted here.
  // Activated receipt evidence is checked separately because it survives source-table retirement.
  return Boolean(
    (await sql.query("SELECT 1 FROM repository_wbs WHERE repository_id=$1 LIMIT 1", [repositoryId]))
      .rows.length,
  );
}

export class PostgresLegacyWbsEntryQuery implements LegacyWbsEntryQuery {
  constructor(private readonly db: Database = businessDatabase()) {}

  read(userId: string, selector: RepositorySelector): Promise<LegacyWbsEntry> {
    return this.db.transaction(async (sql) => {
      const { repository } = await repositoryContentScope(sql, userId, selector);
      const durableRecoveryFact = (
        await sql.query(
          `SELECT
             EXISTS(
               SELECT 1 FROM legacy_wbs_command_evidence
               WHERE repository_id=$1
             ) OR EXISTS(
               SELECT 1 FROM wbs_scope_transfers
               WHERE repository_id=$1 AND actor_user_id=$2
                 AND state IN ('REQUESTED','ACTIVE')
             ) AS entry_required`,
          [repository.id, userId],
          (row) => ({ entryRequired: booleanValue(row.entry_required) }),
        )
      ).rows[0];
      if (durableRecoveryFact?.entryRequired) return { entryRequired: true };

      return { entryRequired: await hasSourceFact(sql, repository.id) };
    });
  }
}
</file>

