  text-decoration: none;
  font-size: 14px;
  font-weight: 750;
}

.button-link-primary {
  background: #d9f4c9;
  color: #143f33;
}

.button-link-secondary {
  background: #ffffff17;
  color: white;
  border: 1px solid #ffffff40;
}

.home-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.home-action-grid .action-row {
  min-height: 104px;
  align-items: flex-start;
}

.more-tools {
  margin-top: 30px;
  border-top: 1px solid var(--line);
}

.more-tools summary {
  display: flex;
  align-items: center;
  min-height: 56px;
  cursor: pointer;
  color: var(--ink);
  font-size: 14px;
  font-weight: 700;
}

.more-tools[open] summary {
  margin-bottom: 10px;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 78px;
  padding: 17px 18px;
  border: 1px solid var(--line);
  border-radius: 16px;
  color: var(--ink);
  text-decoration: none;
  background: var(--surface);
}

.action-row strong,
.action-row small {
  display: block;
}

.action-row strong {
  font-size: 14.5px;
  font-weight: 700;
}

.action-row small {
  margin-top: 6px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

.action-chevron {
  flex: 0 0 auto;
  color: #7b9085;
  font-size: 24px;
  line-height: 1;
}

.action-row-disabled {
  cursor: default;
  background: var(--surface-muted);
}

.action-row-status {
  flex: 0 0 auto;
  padding: 5px 8px;
  border-radius: 999px;
  background: #e8efe5;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.menu-group {
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--surface);
}

.menu-group .action-row {
  border: 0;
  border-radius: 0;
}

.menu-group .action-row + .action-row {
  border-top: 1px solid var(--line);
}

.app-content .page-state {
  padding: 34px 22px;
  text-align: center;
  border: 1px dashed #c7d5ca;
  background: #ffffff9a;
  box-shadow: none;
}

.page-state h2 {
  margin: 14px 0 8px;
}

.page-state p {
  max-width: 360px;
  margin: 0 auto 14px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

.state-symbol {
  display: inline-grid;
  place-items: center;
  width: 50px;
  height: 50px;
  background: #e8efe5;
  border-radius: 16px;
  color: #52725a;
  font-size: 24px;
}

.page-state-error .state-symbol {
  background: #fbe7e1;
  color: var(--danger);
}

.text-action {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  color: var(--green);
  font-weight: 650;
  font-size: 14px;
}

.profile-intro {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 22px;
  background: #e8efe7;
  border-radius: var(--radius-card);
}

.profile-mark {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: #fff;
  font-size: 28px;
  color: var(--green);
}

.profile-intro p {
  margin: 8px 0 0;
  font-size: 13px;
  line-height: 1.8;
  color: var(--muted);
}

.privacy-caption {
  font-size: 12px;
  color: var(--muted);
  text-align: center;
  margin-top: 24px;
}

.capability-list {
  display: grid;
  gap: 12px;
}

.capability-list > div {
  padding: 18px 20px;
  border-left: 3px solid #b9cdb4;
}

.capability-list strong,
.capability-list span {
  display: block;
  font-size: 14px;
}

.capability-list span {
  margin-top: 7px;
  font-size: 12px;
  color: var(--muted);
}

.segmented-control {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4px;
  margin: 16px 0;
  padding: 4px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface-muted);
}

.app-content .segmented-control button {
  width: auto;
  min-height: 42px;
  margin: 0;
  padding: 8px 6px;
  border-radius: 10px;
  background: transparent;
  color: var(--muted);
  font-size: 12px;
}

.app-content .segmented-control button[aria-pressed="true"] {
  background: white;
  color: var(--ink);
  font-weight: 750;
  box-shadow: 0 2px 10px #16332b0a;
}

.app-content .primary-cta {
  min-height: 50px;
  margin-top: 12px;
  border-radius: 13px;
  font-weight: 750;
}

.issue-list,
.notification-list {
  list-style: none;
  display: grid;
  gap: 10px;
  margin: 16px 0 0;
  padding: 0;
}

.issue-list-item,
.notification-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 68px;
  padding: 15px 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  color: var(--ink);
  text-decoration: none;
}

.issue-list-item strong,
.notification-item strong {
  display: block;
  font-size: 14px;
}

.notification-item small {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.55;
}

.status-badge,
.notification-state {
  flex: 0 0 auto;
  padding: 5px 8px;
  border-radius: 999px;
  background: var(--surface-muted);
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.notification-state.is-unread {
  background: var(--green-soft);
  color: var(--green-strong);
}

.notification-filters {
  display: flex;
  gap: 8px;
  margin: 0 0 16px;
}

.notification-filters a {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  background: var(--surface);
  text-decoration: none;
  font-size: 13px;
  font-weight: 650;
}

.notification-filters a[aria-current="page"] {
  border-color: var(--green);
  color: var(--green-strong);
  background: var(--green-soft);
}

.empty-copy {
  margin: 18px 0;
  padding: 18px;
  border-radius: 14px;
  color: var(--muted);
  background: var(--surface-muted);
  font-size: 13px;
  line-height: 1.7;
}

.detail-card,
.notification-detail {
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--surface);
}

.utility-actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}

.app-content .utility-actions button {
  width: auto;
  flex: 1 1 0;
  margin: 0;
}

.secondary-link {
  display: inline-flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 14px;
  border-radius: 10px;
  background: #edf3ee;
  color: var(--ink);
  text-decoration: none;
  font-size: 14px;
  font-weight: 650;
}

.work-navigation {
  position: fixed;
  z-index: 30;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2px;
  padding: 7px 8px calc(7px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--line);
  background: #fffffff2;
  box-shadow: 0 -8px 28px #16332b0a;
  backdrop-filter: blur(16px);
}

.work-navigation a {
  display: flex;
  min-width: 0;
  min-height: 56px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 5px 2px;
  border-radius: 12px;
  color: #53685e;
  text-decoration: none;
}

.nav-icon {
  font-size: 19px;
  line-height: 1;
}

.nav-label {
  font-size: 11px;
  line-height: 1.1;
  white-space: nowrap;
}

.work-navigation a[aria-current="page"] {
  background: var(--green-soft);
  color: var(--green-strong);
  font-weight: 750;
}

.skip-link {
  position: fixed;
  top: -100px;
  left: 16px;
  z-index: 100;
  padding: 14px;
  background: white;
  color: var(--ink);
}

.skip-link:focus {
  top: 12px;
}

.app-content .dashboard-heading {
  background: transparent;
  border: 0;
  padding: 0;
  margin: 0 0 24px;
}

.dashboard-heading .eyebrow {
  margin-bottom: 8px;
  font-size: 12px;
}

.dashboard-heading h1 {
  margin-bottom: 8px;
  font-size: 30px;
}

.app-content .attendance-hero {
  background: #163f32;
  color: #fff;
  border: 0;
  padding: 26px;
  border-radius: 22px;
  box-shadow: 0 8px 24px #163f3214;
}

.hero-label {
  color: #bfe8d1;
  font-size: 12px;
  letter-spacing: 0.04em;
}

.attendance-hero h2 {
  font-size: 24px;
  margin: 12px 0;
}

.attendance-hero p {
  font-size: 14px;
  color: #dfede4;
  line-height: 1.7;
}

.hero-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 52px;
  margin: 22px 0 12px;
  padding: 12px 18px;
  border-radius: 12px;
  background: #d5f2bf;
  color: #163f32;
  font-weight: 700;
  text-decoration: none;
}

.attendance-hero small {
  color: #c6d9cd;
  font-size: 11px;
  line-height: 1.7;
}

.dashboard-section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28px 0 14px;
}

.dashboard-section-heading h2 {
  margin: 0;
}

.dashboard-section-heading > span {
  font-size: 12px;
  color: var(--muted);
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.quick-actions > * {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: white;
  color: var(--ink);
  text-decoration: none;
}

.quick-actions .action-symbol {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: #eaf3e9;
  font-size: 22px;
  color: #246247;
  margin-bottom: 6px;
}

.quick-actions strong {
  font-size: 15px;
}

.quick-actions span:last-child {
  color: var(--muted);
  font-size: 12px;
}

.quick-actions .unavailable-action {
  background: #eef1ed;
}

.app-content .dashboard-help {
  background: transparent;
  border-style: dashed;
  padding: 18px;
}

.dashboard-help h2 {
  margin-top: 0;
  font-size: 15px;
}

.dashboard-help p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.dashboard-help a {
  color: var(--green);
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-size: 13px;
}

a:focus-visible,
button:focus-visible,
summary:focus-visible {
  outline: 3px solid #458662;
  outline-offset: 3px;
}

@media (hover: hover) {
  .action-row:hover,
  .issue-list-item:hover,
  .notification-item:hover,
  .work-navigation a:hover {
    background: #f0f6f1;
  }

  .button-link-primary:hover {
    background: #e5f8d9;
  }

  .button-link-secondary:hover {
    background: #ffffff24;
  }
}

@media (max-width: 360px) {
  .app-shell-brand {
    padding-inline: 16px;
  }

  .app-shell .app-content {
    padding-inline: 16px;
  }

  .home-primary {
    padding: 20px;
  }

  .home-action-grid {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 900px) {
  .app-shell {
    position: relative;
    max-width: 1040px;
    min-height: calc(100dvh - 48px);
    margin: 24px auto;
    padding: 0 0 24px 204px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: #fafcf9;
    box-shadow: var(--shadow-soft);
    overflow: clip;
  }

  .app-shell-brand {
    position: sticky;
    max-width: none;
    margin: 0;
    padding: 18px 30px;
    background: #fafcf9e8;
  }

  .app-shell .app-content {
    max-width: none;
    padding: 30px;
  }

  .app-shell .work-navigation {
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 18px;
    right: auto;
    width: 168px;
    grid-template-columns: 1fr;
    align-content: start;
    gap: 5px;
    padding: 12px;
    border: 0;
    border-radius: 20px;
    background: #e9f0ea;
    box-shadow: none;
    backdrop-filter: none;
  }

  .work-navigation a {
    min-height: 48px;
    flex-direction: row;
    justify-content: flex-start;
    gap: 11px;
    padding: 0 14px;
  }

  .nav-icon {
    width: 22px;
    text-align: center;
  }

  .nav-label {
    font-size: 13px;
  }

  .work-navigation a[aria-current="page"] {
    background: white;
    box-shadow: 0 4px 16px #16332b0a;
  }

  .home-primary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 28px;
  }

  .home-primary-actions {
    width: 260px;
    margin-top: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation: none !important;
    transition: none !important;
  }
}

/* Scope management: predictable list → detail → action flow. */
.scope-management-nav {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin: -8px 0 24px;
  padding: 5px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--surface-muted);
}

.scope-management-nav a {
  display: flex;
  min-width: 0;
  min-height: 54px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 7px 8px;
  border-radius: 12px;
  color: var(--muted);
  text-decoration: none;
}

.scope-management-nav strong {
  font-size: 13px;
}

.scope-management-nav small {
  font-size: 10px;
}

.scope-management-nav a[aria-current="page"] {
  background: var(--surface);
  color: var(--green-strong);
  box-shadow: 0 3px 12px #16332b0a;
}

.crud-manager {
  display: grid;
  gap: 18px;
}

.repository-map-picker {
  display: grid;
  gap: 0.75rem;
}

.repository-map-search > * {
  width: 100%;
}

.repository-map-canvas-wrap {
  position: relative;
  overflow: hidden;
  min-height: 20rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
}

.repository-map-canvas {
  position: absolute;
  inset: 0;
}

.repository-map-pin {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  color: #dc2626;
  font-size: 2rem;
  line-height: 1;
  text-shadow: 0 1px 3px rgb(0 0 0 / 35%);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.repository-map-actions,
.repository-radius-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}

.repository-map-actions p {
  flex: 1 1 12rem;
  margin: 0;
}

.app-content .repository-radius-choices button {
  flex: 1;
  width: auto;
  padding: 10px 6px;
}

.crud-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 12px 14px;
  border-radius: 14px;
  background: #edf3ee;
}

.crud-toolbar p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.app-content .crud-refresh {
  width: auto;
  min-height: 40px;
  flex: 0 0 auto;
  margin: 0;
  padding: 8px 12px;
}

.app-content .crud-collection,
.app-content .crud-scope-picker,
.app-content .crud-detail,
.app-content .crud-guidance {
  margin: 0;
  border-radius: 18px;
}

.crud-section-head,
.crud-detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.crud-section-head h2,
.crud-detail-head h2 {
  margin: 0;
}

.crud-section-head p,
.crud-detail-head p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.app-content .crud-create,
.app-content .crud-back {
  width: auto;
  min-height: 44px;
  flex: 0 0 auto;
  margin: 0;
  padding: 10px 14px;
}

.crud-entity-list {
  list-style: none;
  display: grid;
  gap: 8px;
  margin: 16px 0 0;
  padding: 0;
}

.crud-entity-list li {
  margin: 0;
}

.app-content .crud-entity-item {
  display: flex;
  width: 100%;
  min-height: 64px;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin: 0;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  color: var(--ink);
  text-align: left;
}

.crud-entity-item strong,
.crud-entity-item small {
  display: block;
}

.crud-entity-item strong {
  font-size: 14px;
}

.crud-entity-item small {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11.5px;
  line-height: 1.5;
}

.crud-entity-item > span:last-child {
  color: #73877d;
  font-size: 24px;
}

.crud-kicker {
  display: block;
  margin-bottom: 5px;
  color: var(--green);
  font-size: 11px;
  font-weight: 700;
}

.crud-lifecycle-note {
  margin: 14px 0 20px;
  padding: 11px 13px;
  border-left: 3px solid #9bb8a5;
  background: #f2f6f2;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.crud-detail > h3 {
  margin: 26px 0 10px;
  padding-top: 20px;
  border-top: 1px solid var(--line);
  font-size: 15px;
}

.crud-detail > article,
.crud-detail > form {
  margin: 10px 0;
}

.crud-detail > article {
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: #fbfcfb;
}

.crud-detail > button {
  display: inline-flex;
  width: auto;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  margin: 0 8px 8px 0;
  padding: 10px 14px;
}

.crud-scope-picker {
  display: grid;
  gap: 14px;
}

.crud-scope-picker label {
  margin: 0;
}

.crud-create-row {
  display: flex;
  justify-content: flex-end;
}

.app-content .crud-create-row button {
  width: auto;
  margin: 0;
}

.crud-guidance p {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

@media (max-width: 430px) {
  .crud-section-head,
  .crud-detail-head {
    align-items: stretch;
    flex-direction: column;
  }

  .app-content .crud-create,
  .app-content .crud-back {
    width: 100%;
  }

  .crud-toolbar {
    align-items: stretch;
  }

  .crud-toolbar p {
    align-self: center;
  }
}

/* Profile, network and Repository discovery reuse one quiet management rhythm. */
.profile-panel,
.network-panel,
.discovery-panel {
  display: grid;
  gap: 16px;
}

.profile-form,
.network-follow-form {
  margin: 0;
}

.profile-form textarea {
  min-height: 120px;
}

.profile-note,
.discovery-boundary {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.profile-version {
  display: block;
  margin-top: 10px;
  color: var(--muted);
}

.inline-actions,
.discovery-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}

.app-content .inline-actions button,
.app-content .discovery-actions button,
.discovery-actions .secondary-link {
  width: auto;
  flex: 1 1 0;
  margin: 0;
}

.relationship-grid {
  display: grid;
  gap: 14px;
}

.relationship-grid > section {
  margin: 0;
}

.relationship-list {
  list-style: none;
  display: grid;
  gap: 8px;
  margin: 14px 0 0;
  padding: 0;
}

.relationship-list li {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-top: 1px solid var(--line);
}

.relationship-list strong,
.relationship-list small {
  display: block;
  overflow-wrap: anywhere;
}

.relationship-list small {
  margin-top: 4px;
  color: var(--muted);
}

.app-content .relationship-list button {
  width: auto;
  flex: 0 0 auto;
  margin: 0;
}

.discovery-list {
  display: grid;
  gap: 12px;
}

.discovery-item {
  display: grid;
  gap: 16px;
  margin: 0;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--surface);
}

.discovery-copy h2 {
  margin: 0;
  font-size: 17px;
}

.discovery-copy > p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 12px;
  overflow-wrap: anywhere;
}

.discovery-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
}

.discovery-meta span {
  padding: 5px 8px;
  border-radius: 999px;
  background: var(--surface-muted);
  color: var(--muted);
  font-size: 11px;
  font-weight: 650;
}

@media (min-width: 700px) {
  .relationship-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .discovery-item {
    grid-template-columns: minmax(0, 1fr) 260px;
    align-items: center;
  }
}

@media (max-width: 430px) {
  .inline-actions,
  .discovery-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .app-content .inline-actions button,
  .app-content .discovery-actions button,
  .discovery-actions .secondary-link {
    width: 100%;
  }
}

/* Authenticated mobile shell: GitHub-Mobile-inspired hierarchy using local product semantics. */
.app-shell {
  --ink: #f0f6fc;
  --muted: #8b949e;
  --green: #58a6ff;
  --green-strong: #79c0ff;
  --green-soft: #1f6feb2e;
  --line: #30363d;
  --surface: #161b22;
  --surface-muted: #21262d;
  --canvas: #0d1117;
  --danger: #f85149;
  color-scheme: dark;
  color: var(--ink);
  background: var(--canvas);
}

.app-shell .app-shell-brand {
  border-color: var(--line);
  background: #0d1117f2;
}

.app-shell .shell-wordmark {
  color: var(--ink);
}

.app-shell .shell-wordmark span {
  background: #21262d;
  color: var(--green-strong);
}

.app-shell .member-avatar {
  color: var(--green-strong);
  background: #21262d;
}

.app-shell .app-content {
  padding-top: 22px;
}

.app-shell .app-content section,
.app-shell .app-content form,
.app-shell .attendance-current,
.app-shell .quick-actions > *,
.app-shell .crud-toolbar,
.app-shell .scope-management-nav,
.app-shell .diary-entry {
  border-color: var(--line);
  background: var(--surface);
  color: var(--ink);
}

.app-shell .quick-actions .unavailable-action,
.app-shell .crud-toolbar,
.app-shell .scope-management-nav {
  background: var(--surface-muted);
}

.app-shell .attendance-hero {
  border-color: var(--line);
  background: var(--surface);
  color: var(--ink);
  box-shadow: none;
}

.app-shell .attendance-hero p,
.app-shell .attendance-hero small,
.app-shell .quick-actions span:last-child,
.app-shell .crud-toolbar p {
  color: var(--muted);
}

.app-shell .page-heading {
  min-height: 56px;
  align-items: center;
  margin-bottom: 22px;
}

.app-shell .page-heading h1 {
  margin: 0;
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -0.025em;
}

.app-shell .page-heading p,
.app-shell .section-heading p {
  color: var(--muted);
}

.app-shell .section-heading {
  margin: 26px 0 12px;
}

.app-shell .section-heading h2 {
  font-size: 20px;
  font-weight: 700;
}

.app-shell .menu-group {
  border: 0;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}

.app-shell .menu-group .action-row,
.app-shell .action-row {
  min-height: 72px;
  padding: 13px 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.app-shell .menu-group .action-row + .action-row {
  border-top: 0;
}

.app-shell .action-row {
  justify-content: flex-start;
  gap: 14px;
}

.app-shell .action-row-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.app-shell .action-row strong {
  color: var(--ink);
  font-size: 17px;
  font-weight: 550;
}

.app-shell .action-row small {
  margin-top: 4px;
  color: var(--muted);
  font-size: 12px;
}

.app-shell .action-row-icon {
  display: grid;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  place-items: center;
  border-radius: 7px;
  background: #30363d;
  color: #f0f6fc;
  font-size: 20px;
  font-weight: 700;
}

.app-shell .action-row-icon-green {
  background: #238636;
}

.app-shell .action-row-icon-blue {
  background: #1f6feb;
}

.app-shell .action-row-icon-purple {
  background: #8957e5;
}

.app-shell .action-row-icon-orange {
  background: #d29922;
}

.app-shell .action-row-icon-yellow {
  background: #9e6a03;
}

.app-shell .action-row-icon-pink {
  background: #bf4b8a;
}

.app-shell .action-chevron {
  color: #6e7681;
}

.app-shell .empty-copy,
.app-shell .discovery-boundary {
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--muted);
}

.app-shell .discovery-list {
  display: grid;
  gap: 12px;
}

.app-shell .discovery-item,
.app-shell .detail-card,
.app-shell .notification-detail,
.app-shell .page-state {
  border-color: var(--line);
  background: var(--surface);
  color: var(--ink);
  box-shadow: none;
}

.app-shell .discovery-copy p,
.app-shell .discovery-meta,
.app-shell .notification-item small {
  color: var(--muted);
}

.app-shell .secondary-link,
.app-shell .app-content button.secondary {
  border: 1px solid var(--line);
  background: #21262d;
  color: var(--ink);
}

.app-shell .app-content button {
  background: #238636;
  color: #fff;
}

.app-shell .notification-filters {
  gap: 10px;
  overflow-x: auto;
  scrollbar-width: none;
}

.app-shell .notification-filters a {
  min-height: 44px;
  border-color: var(--line);
  background: #21262d;
  color: var(--ink);
}

.app-shell .notification-filters a[aria-current="page"] {
  border-color: #6e7681;
  background: #30363d;
  color: #fff;
}

.app-shell .notification-item,
.app-shell .issue-list-item {
  border-color: var(--line);
  background: var(--surface);
  color: var(--ink);
}

.app-shell .notification-state {
  background: #21262d;
  color: var(--muted);
}

.app-shell .notification-state.is-unread {
  background: #1f6feb33;
  color: var(--green-strong);
}

.app-shell .membership-panel {
  border-color: var(--line);
  border-radius: 14px;
  background: var(--surface);
}

.app-shell .membership-emblem {
  border-color: var(--line);
  background: #21262d;
  color: var(--green-strong);
  box-shadow: none;
}

.app-shell .membership-hero > p:last-child,
.app-shell .membership-panel p {
  color: var(--muted);
}

.app-shell .app-content .membership-panel section,
.app-shell .app-content .membership-panel .membership-coins {
  border-color: var(--line);
  background: #0d1117;
  color: var(--ink);
  box-shadow: none;
}

.app-shell .app-content input,
.app-shell .app-content select,
.app-shell .app-content textarea {
  border-color: var(--line);
  background: #0d1117;
  color: var(--ink);
}

.app-shell .work-navigation {
  border-color: var(--line);
  background: #161b22f5;
  box-shadow: 0 -8px 26px #0008;
}

.app-shell .work-navigation a {
  color: #8b949e;
}

.app-shell .work-navigation a[aria-current="page"] {
  background: #1f6feb2e;
  color: #79c0ff;
}

.app-shell .nav-icon {
  display: grid;
  width: 52px;
  height: 32px;
  place-items: center;
  border-radius: 999px;
  font-size: 21px;
}

.app-shell .nav-label {
  font-size: 12px;
}

.app-shell .work-navigation a[aria-current="page"] {
  background: transparent;
}

.app-shell .work-navigation a[aria-current="page"] .nav-icon {
  background: #1f6feb3d;
}

.app-shell .home-resource-list .action-chevron {
  display: none;
}

.app-shell .crud-detail > article {
  border-color: var(--line);
  background: var(--surface);
  color: var(--ink);
}

.app-shell .crud-lifecycle-note {
  border-color: #6e7681;
  background: var(--surface-muted);
  color: var(--muted);
}

.app-shell .app-content .segmented-control button[aria-pressed="true"] {
  border: 1px solid #58a6ff;
  background: #30363d;
  color: #fff;
  box-shadow: none;
}

@media (hover: hover) {
  .app-shell .action-row:hover,
  .app-shell .issue-list-item:hover,
  .app-shell .notification-item:hover,
  .app-shell .work-navigation a:hover {
    background: #21262d;
  }
}

@media (max-width: 600px) {
  .app-shell .app-shell-brand {
    display: none;
  }

  .app-shell .app-content {
    padding-top: 30px;
    padding-bottom: 34px;
  }
}

/* App-shell target slices visible without inventing unavailable business capabilities. */
.app-shell .status-row {
  cursor: default;
}

.app-shell .row-status {
  flex: 0 0 auto;
  padding: 5px 8px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  background: var(--surface-muted);
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.app-shell .home-section-anchor {
  scroll-margin-top: 76px;
  border: 0;
  background: transparent;
}

.app-shell .notification-filter-disabled {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  padding: 0 14px;
  border: 1px dashed #484f58;
  border-radius: 999px;
  color: #6e7681;
  background: #161b22;
  font-size: 13px;
  white-space: nowrap;
}

