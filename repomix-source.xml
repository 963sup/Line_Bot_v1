<file path="packages/integration-supabase/src/schemas/101_account_logins.sql">
-- Global User/Organization login namespace owned by Namespace.

-- GitHub-like RepositoryOwner login namespace shared by User and Organization.
create table app_private.account_logins (
  account_id text primary key,
  account_kind text not null,
  login text not null unique,
  updated_at bigint not null,
  constraint account_logins_owner_kind_check check (account_kind in ('USER', 'ORGANIZATION')),
  constraint account_logins_login_check check (
    login = lower(login)
    and length(login) between 1 and 39
    and login ~ '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'
    and login not in ('admin','api','assistant','attendance','auth','complete','daily-check-in','diary','enterprises','expenses','explore','feedback','google-link','history','home','issues','login','membership','notifications','organizations','orgs','partners','planned','privacy','profile','projects','pulls','repositories','search','settings','sponsors','stars','team','terms','trending','unavailable')
  ),
  constraint account_logins_account_fkey foreign key (account_id, account_kind)
    references app_private.accounts(id, kind)
);
alter table app_private.account_logins enable row level security;
revoke all on app_private.account_logins from public, anon, authenticated, line_app;
grant insert, select, update on app_private.account_logins to line_app;
create policy backend on app_private.account_logins
  as permissive for all to line_app using (true) with check (true);

create function app_private.claim_account_login(
  p_account_id text,
  p_account_kind text,
  p_login text,
  p_at bigint
) returns text
language plpgsql
security invoker
set search_path to 'app_private', 'pg_catalog'
as $function$
declare
  normalized text := lower(trim(coalesce(p_login, '')));
  current_login app_private.account_logins%rowtype;
begin
  if p_account_kind not in ('USER', 'ORGANIZATION')
     or p_at is null or p_at < 0
     or normalized !~ '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'
     or length(normalized) not between 1 and 39
     or normalized in ('admin','api','assistant','attendance','auth','complete','daily-check-in','diary','enterprises','expenses','explore','feedback','google-link','history','home','issues','login','membership','notifications','organizations','orgs','partners','planned','privacy','profile','projects','pulls','repositories','search','settings','sponsors','stars','team','terms','trending','unavailable') then
    raise exception 'account_login_invalid' using errcode = '22023';
  end if;
  if not exists (
    select 1 from app_private.accounts
    where id=p_account_id and kind=p_account_kind
  ) then
    raise exception 'account_login_owner_not_found' using errcode = '23503';
  end if;
  perform app_private.claim_scoped_namespace_name(
    'account-login','GLOBAL','global',p_account_kind,p_account_id,normalized,p_at
  );
  insert into app_private.account_logins(account_id,account_kind,login,updated_at)
    values(p_account_id,p_account_kind,normalized,p_at)
    on conflict do nothing;
  select * into current_login
    from app_private.account_logins
    where account_id=p_account_id
    for update;
  if found then
    if current_login.account_kind <> p_account_kind
       or current_login.login <> normalized then
      raise exception 'account_login_already_claimed' using errcode = '23505';
    end if;
    return current_login.login;
  end if;
  raise exception 'account_login_already_claimed' using errcode = '23505';
end
$function$;
revoke all on function app_private.claim_account_login(text,text,text,bigint)
  from public, anon, authenticated;
grant execute on function app_private.claim_account_login(text,text,text,bigint) to line_app;

create function app_private.rename_account_login(
  p_account_id text,
  p_account_kind text,
  p_expected_login text,
  p_login text,
  p_at bigint
) returns text
language plpgsql
security invoker
set search_path to 'app_private', 'pg_catalog'
as $function$
declare
  expected text := lower(trim(coalesce(p_expected_login, '')));
  normalized text := lower(trim(coalesce(p_login, '')));
begin
  if p_account_kind not in ('USER', 'ORGANIZATION')
     or p_at is null or p_at < 0
     or expected !~ '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'
     or length(expected) not between 1 and 39
     or normalized !~ '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'
     or length(normalized) not between 1 and 39
     or normalized in ('admin','api','assistant','attendance','auth','complete','daily-check-in','diary','enterprises','expenses','explore','feedback','google-link','history','home','issues','login','membership','notifications','organizations','orgs','partners','planned','privacy','profile','projects','pulls','repositories','search','settings','sponsors','stars','team','terms','trending','unavailable') then
    raise exception 'account_login_invalid' using errcode = '22023';
  end if;
  perform app_private.rename_scoped_namespace_name(
    'account-login','GLOBAL','global',p_account_kind,p_account_id,expected,normalized,p_at
  );
  update app_private.account_logins
    set login=normalized,updated_at=p_at
    where account_id=p_account_id
      and account_kind=p_account_kind
      and login=expected;
  if not found then
    raise exception 'account_login_stale' using errcode = '40001';
  end if;
  return normalized;
end
$function$;
revoke all on function app_private.rename_account_login(text,text,text,text,bigint)
  from public, anon, authenticated;
grant execute on function app_private.rename_account_login(text,text,text,text,bigint) to line_app;
</file>

<file path="packages/integration-supabase/src/schemas/102_numbering.sql">
-- Scoped sequential Series and immutable Allocation facts owned by Numbering.

create table app_private.number_series (
  family text not null,
  scope_kind text not null,
  scope_id text not null,
  next_number bigint not null,
  legacy_high_water bigint not null,
  managed_from bigint not null,
  created_at bigint not null,
  updated_at bigint not null,
  primary key (family, scope_kind, scope_id),
  constraint number_series_scope_check check (
    (family in ('repository-work-item','repository-discussion','repository-milestone')
      and scope_kind='REPOSITORY')
    or (family='account-project' and scope_kind in ('USER','ORGANIZATION'))
    or (family='project-view' and scope_kind='PROJECT')
  ),
  constraint number_series_scope_id_check check (length(scope_id) > 0),
  constraint number_series_checkpoint_check check (
    legacy_high_water >= 0
    and managed_from = legacy_high_water + 1
    and next_number >= managed_from
    and (
      (family='project-view' and legacy_high_water <= 2147483647
        and next_number <= 2147483648)
      or (family<>'project-view' and legacy_high_water <= 9007199254740991
        and next_number <= 9007199254740992)
    )
  ),
  constraint number_series_time_check check (
    -- Explicit comparisons keep PostgreSQL CHECK deparse/reparse structurally stable.
    created_at >= 0 and created_at <= 9007199254740991
    and updated_at >= created_at and updated_at <= 9007199254740991
  )
);

create table app_private.number_allocations (
  family text not null,
  scope_kind text not null,
  scope_id text not null,
  number bigint not null,
  resource_kind text not null,
  resource_id text not null,
  provenance text not null,
  allocated_at bigint not null,
  primary key (family, scope_kind, scope_id, number),
  constraint number_allocations_resource_unique
    unique (family, scope_kind, scope_id, resource_kind, resource_id),
  constraint number_allocations_series_fkey
    foreign key (family, scope_kind, scope_id)
    references app_private.number_series(family, scope_kind, scope_id),
  constraint number_allocations_compatibility_check check (
    (family='repository-work-item' and scope_kind='REPOSITORY'
      and resource_kind in ('ISSUE','PULL_REQUEST'))
    or (family='repository-discussion' and scope_kind='REPOSITORY'
      and resource_kind='DISCUSSION')
    or (family='repository-milestone' and scope_kind='REPOSITORY'
      and resource_kind='MILESTONE')
    or (family='account-project' and scope_kind in ('USER','ORGANIZATION')
      and resource_kind='PROJECT')
    or (family='project-view' and scope_kind='PROJECT'
      and resource_kind='PROJECT_VIEW')
  ),
  constraint number_allocations_resource_id_check check (length(resource_id) > 0),
  constraint number_allocations_number_check check (
    (family='project-view' and number between 1 and 2147483647)
    or (family<>'project-view' and number between 1 and 9007199254740991)
  ),
  constraint number_allocations_provenance_check check (provenance in ('IMPORTED','MANAGED')),
  constraint number_allocations_allocated_at_check check (
    allocated_at between 0 and 9007199254740991
  )
);

alter table app_private.number_series enable row level security;
alter table app_private.number_allocations enable row level security;
revoke all on app_private.number_series from public, anon, authenticated, line_app;
revoke all on app_private.number_allocations from public, anon, authenticated, line_app;

create function app_private.protect_number_series()
returns trigger
language plpgsql
set search_path to 'app_private', 'pg_catalog'
as $function$
begin
  if tg_op = 'DELETE'
     or new.family is distinct from old.family
     or new.scope_kind is distinct from old.scope_kind
     or new.scope_id is distinct from old.scope_id
     or new.legacy_high_water is distinct from old.legacy_high_water
     or new.managed_from is distinct from old.managed_from
     or new.created_at is distinct from old.created_at
     or new.next_number <> old.next_number + 1
     or new.updated_at < old.updated_at
     or not exists (
       select 1 from app_private.number_allocations a
       where a.family=old.family
         and a.scope_kind=old.scope_kind
         and a.scope_id=old.scope_id
         and a.number=old.next_number
     ) then
    raise exception 'number_series_invalid_transition' using errcode = '23514';
  end if;
  return new;
end
$function$;
revoke all on function app_private.protect_number_series()
  from public, anon, authenticated, line_app;
create trigger number_series_transition
before update or delete on app_private.number_series
for each row execute function app_private.protect_number_series();

create function app_private.protect_number_allocation()
returns trigger
language plpgsql
set search_path to 'app_private', 'pg_catalog'
as $function$
begin
  raise exception 'number_allocation_immutable' using errcode = '23514';
end
$function$;
revoke all on function app_private.protect_number_allocation()
  from public, anon, authenticated, line_app;
create trigger number_allocation_immutable
before update or delete on app_private.number_allocations
