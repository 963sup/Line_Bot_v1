<file path="packages/project/src/adapters/outbound/persistence/postgres-project-collection-store.ts">
import { readAccountLogins } from "@line_bot_v1/namespace/postgres";
import { listOrganizationAdministrationScopeIds } from "@line_bot_v1/organization/postgres";
import type { Database, SqlRow } from "@line_bot_v1/platform/postgres";
import {
  booleanValue,
  literalValue,
  nullableNumericValue,
  numericValue,
  stringArray,
  stringValue,
} from "@line_bot_v1/platform/validation";
import { readActiveProjectTeamIds } from "@line_bot_v1/team/postgres/project-access";
import type { ProjectSummary } from "../../../contracts/dto/project-collection.js";
import type { ProjectCollectionStore } from "../../../contracts/repositories/project-collection-store.js";
import type { ProjectAccessRole, ProjectOwnerKind } from "../../../domain.js";

const roleRank: Readonly<Record<ProjectAccessRole, number>> = {
  READ: 1,
  WRITE: 2,
  ADMIN: 3,
};

type CollectionRow = {
  id: string;
  owner_account_id: string;
  owner_account_kind: ProjectOwnerKind;
  number: number | string | null;
  name: string;
  is_public: boolean;
  closed: boolean;
  version: number | string;
  user_role: ProjectAccessRole | null;
  team_roles: ProjectAccessRole[];
};

const projectAccessRoles: readonly ProjectAccessRole[] = ["READ", "WRITE", "ADMIN"];
const projectOwnerKinds: readonly ProjectOwnerKind[] = ["USER", "ORGANIZATION"];

function decodeCollectionRow(row: SqlRow): CollectionRow {
  return {
    id: stringValue(row.id),
    owner_account_id: stringValue(row.owner_account_id),
    owner_account_kind: literalValue(row.owner_account_kind, projectOwnerKinds),
    number: nullableNumericValue(row.number),
    name: stringValue(row.name),
    is_public: booleanValue(row.is_public),
    closed: booleanValue(row.closed),
    version: numericValue(row.version),
    user_role: row.user_role === null ? null : literalValue(row.user_role, projectAccessRoles),
    team_roles: stringArray(row.team_roles).map((role) => literalValue(role, projectAccessRoles)),
  };
}

function effectiveRole(values: readonly ProjectAccessRole[]): ProjectAccessRole {
  let best: ProjectAccessRole = "READ";
  for (const value of values) {
    if (roleRank[value] > roleRank[best]) best = value;
  }
  return best;
}

export class PostgresProjectCollectionStore implements ProjectCollectionStore {
  constructor(private readonly db: Database) {}

  accessible(userId: string): Promise<readonly ProjectSummary[]> {
    return this.db.transaction(async (sql) => {
      const [organizationAdministrationIds, teamIds] = await Promise.all([
        listOrganizationAdministrationScopeIds(sql, userId),
        readActiveProjectTeamIds(sql, userId),
      ]);
      const rows = (
        await sql.query(
          `SELECT
             p.id,
             p.owner_account_id,
             p.owner_account_kind,
             p.number,
             p.name,
             p.is_public,
             p.closed,
             p.version,
             ua.role AS user_role,
             COALESCE(
               (
                 SELECT array_agg(ta.role ORDER BY ta.role)
                 FROM project_team_access ta
                 WHERE ta.project_id=p.id
                   AND ta.team_id=ANY($3::text[])
               ),
               ARRAY[]::text[]
             ) AS team_roles
           FROM projects p
           LEFT JOIN project_user_access ua
             ON ua.project_id=p.id
            AND ua.user_id=$1
           WHERE p.deleted_at IS NULL
             AND (
               p.is_public
               OR (p.owner_account_kind='USER' AND p.owner_account_id=$1)
               OR (
                 p.owner_account_kind='ORGANIZATION'
                 AND p.owner_account_id=ANY($2::text[])
               )
               OR ua.user_id IS NOT NULL
               OR EXISTS (
                 SELECT 1
                 FROM project_team_access ta
                 WHERE ta.project_id=p.id
                   AND ta.team_id=ANY($3::text[])
               )
             )
           ORDER BY lower(p.name),p.id`,
          [userId, organizationAdministrationIds, teamIds],
          decodeCollectionRow,
        )
      ).rows;

      const owners = await readAccountLogins(
        sql,
        rows.map((row) => ({
          id: row.owner_account_id,
          kind: row.owner_account_kind,
        })),
      );
      const ownerLogins = new Map(
        owners.map((owner) => [`${owner.id}:\0:${owner.kind}`, owner.login] as const),
      );

      return rows.flatMap((row) => {
        const ownerLogin = ownerLogins.get(`${row.owner_account_id}:\0:${row.owner_account_kind}`);
        if (!ownerLogin) return [];

        const roles: ProjectAccessRole[] = [];
        if (row.is_public) roles.push("READ");
        if (
          (row.owner_account_kind === "USER" && row.owner_account_id === userId) ||
          (row.owner_account_kind === "ORGANIZATION" &&
            organizationAdministrationIds.includes(row.owner_account_id))
        ) {
          roles.push("ADMIN");
        }
        if (row.user_role) roles.push(row.user_role);
        roles.push(...row.team_roles);
        if (!roles.length) return [];

        return [
          {
            id: row.id,
            ownerLogin,
            ownerKind: row.owner_account_kind,
            number: row.number === null ? null : Number(row.number),
            name: row.name,
            public: row.is_public,
            closed: row.closed,
            role: effectiveRole(roles),
            version: Number(row.version),
          },
        ];
      });
    });
  }
}
</file>

<file path="packages/project/src/adapters/outbound/persistence/postgres-project-content-scope.ts">
import { readActiveUserQualification } from "@line_bot_v1/account/postgres";
import type { Sql } from "@line_bot_v1/platform/postgres";
import { booleanValue } from "@line_bot_v1/platform/validation";
import type {
  ProjectContentScope,
  ProjectContentScopeReader,
} from "../../../contracts/output/content-scope.js";
import { ProjectError } from "../../../domain.js";
import {
  decodeProjectRow,
  effectiveProjectRole,
  type ProjectRow,
} from "./postgres-project-management-helpers.js";

export class PostgresProjectContentScope implements ProjectContentScopeReader {
  constructor(private readonly sql: Sql) {}

  async read(userId: string, projectId: string): Promise<ProjectContentScope> {
    await this.sql.query("SELECT app_private.lock_governance('shared')");
    if (!(await readActiveUserQualification(this.sql, userId, "share"))) {
      throw new ProjectError(403, "目前 User 資格不可用。");
    }

    await this.sql.query("SELECT pg_advisory_xact_lock(hashtext($1))", [`project:${projectId}`]);
    const row = (
      await this.sql.query(
        "SELECT * FROM projects WHERE id=$1 FOR UPDATE",
        [projectId],
        decodeProjectRow,
      )
    ).rows[0];
    if (!row || row.deleted_at !== null) throw new ProjectError(404, "找不到 Project。");

    // Recompute only after the Project lock: a grant or lifecycle writer may have committed
    // while this transaction was waiting for the current scope.
    const role = await effectiveProjectRole(this.sql, row, userId);
    if (!role) throw new ProjectError(404, "找不到可存取的 Project。");

    const grants = (
      await this.sql.query(
        `SELECT
           EXISTS(SELECT 1 FROM project_user_access WHERE project_id=$1)
           OR EXISTS(SELECT 1 FROM project_team_access WHERE project_id=$1)
           AS has_collaborator_grants`,
        [row.id],
        (grantRow) => ({
          hasCollaboratorGrants: booleanValue(grantRow.has_collaborator_grants),
        }),
      )
    ).rows[0];
    if (!grants) throw new ProjectError(503, "無法確認 Project collaborator grants。");

    return contentScope(row, role, grants.hasCollaboratorGrants);
  }
}

function contentScope(
  row: ProjectRow,
  role: ProjectContentScope["role"],
  hasCollaboratorGrants: boolean,
): ProjectContentScope {
  return {
    project: {
      id: row.id,
      ownerAccountId: row.owner_account_id,
      ownerKind: row.owner_account_kind,
      title: row.name,
      number: row.number === null ? null : Number(row.number),
      public: row.is_public,
      hasCollaboratorGrants,
    },
    role,
    closed: row.closed,
  };
}
</file>

