      {error && (
        <p className="expense-error" role="alert">
          {error}
        </p>
      )}
      {notice && <p role="status">{notice}</p>}

      {token && !user && !busy && !error && (
        <section>
          <h2>加入 LINE 會員</h2>
          <p>LINE：{lineName}</p>
          <p>註冊後即可使用已授權的工作功能；Google 關聯為選填。</p>
