<file path="apps/web/src/modules/file/file-requests.ts">
import { type FileMutation, StaleRequest } from "./files-projection";

/** File workspace transport shares one session, scope and stale-response boundary. */
export function createFileRequests(context: {
  ownerLogin: string;
  repositoryName: string;
  epoch: { current: number };
  session(): Promise<string | null>;
  onDenied(message: string): void;
}) {
  async function send(
    target: "file" | "document" | "commercialIntake" | "commercialDocument" | "commercialTask",
    query: Record<string, string>,
    command?: object,
  ) {
    const ticket = context.epoch.current;
    const assertCurrent = () => {
      if (ticket !== context.epoch.current) throw new StaleRequest();
    };
    const session = await context.session();
    assertCurrent();
    if (!session) throw new Error("請完成 LINE 登入後重試。");
    const search = new URLSearchParams({
      ...query,
      owner: context.ownerLogin,
      name: context.repositoryName,
    });
    const endpoint = {
      file: "repository-files",
      document: "repository-document-intake",
      commercialIntake: "document-intakes",
      commercialDocument: "commercial-documents",
      commercialTask: "commercial-tasks",
    }[target];
    const response = await fetch(`/api/${endpoint}?${search}`, {
      method: command ? "POST" : "GET",
      headers: {
        "X-App-Session-Generation": session,
        ...(command ? { "Content-Type": "application/json" } : {}),
      },
      ...(command ? { body: JSON.stringify(command) } : {}),
      cache: "no-store",
    });
    assertCurrent();
    let value: unknown;
    try {
      value =
        target === "file" && query.view === "download" && response.ok
          ? await response.blob()
          : response.headers.get("content-type")?.includes("application/json")
            ? await response.json()
            : await response.text();
    } catch (error) {
      assertCurrent();
      if (response.ok) throw error;
      // A malformed gateway/authentication response cannot bypass denial handling.
    }
    assertCurrent();
    if (response.ok) return value;
    const fields = value && typeof value === "object" ? value : {};
    const code: unknown = Reflect.get(fields, "code");
    const serverMessage: unknown = Reflect.get(fields, "error");
    const message = typeof serverMessage === "string" ? serverMessage : String(value);
    if (response.status === 401 || response.status === 403) {
      context.onDenied(message);
      throw new StaleRequest();
    }
    const traceId: unknown = Reflect.get(fields, "traceId");
    const stage: unknown = Reflect.get(fields, "stage");
    const diagnostic =
      target !== "file"
        ? [
            typeof stage === "string" && /^[a-z.]{1,40}$/.test(stage) ? `階段：${stage}` : "",
            typeof code === "string" && /^[A-Z_]{1,64}$/.test(code) ? `錯誤碼：${code}` : "",
            typeof traceId === "string" && /^[a-f0-9-]{36}$/.test(traceId)
              ? `追蹤 ID：${traceId}`
              : "",
          ]
            .filter(Boolean)
            .join(" · ")
        : "";
    const failureMessage = message;
    throw Object.assign(new Error([failureMessage, diagnostic].filter(Boolean).join("\n")), {
      status: response.status,
      code,
      stage,
      traceId,
    });
  }
  return {
    file: (query: Record<string, string> = {}, mutation?: FileMutation) =>
      send("file", query, mutation),
    document: (query: Record<string, string>, command?: object) => send("document", query, command),
    commercialIntake: (query: Record<string, string>, command?: object) =>
      send("commercialIntake", query, command),
    commercialDocument: (query: Record<string, string>) => send("commercialDocument", query),
    commercialTask: (query: Record<string, string>, command?: object) =>
      send("commercialTask", query, command),
  };
}
</file>

<file path="apps/AGENTS.md">
# Application delivery boundary

`apps/` 擁有 application host、delivery 與 composition；business authority 仍由 `architecture/registry.json#domain` 的 semantic Owner 擁有，實作 consumer 再由 `#modules` 映射。頁面、API、route group、Bottom Navigation 或 provider session 都不建立新的 Domain owner。

## Governing files

完整 authority 與讀取條件繼承 [root context contract](../AGENTS.md#effective-context-contract)；本檔只增加 local constraints，不另存 governing 清單。

Local code、workflow、schema 或 guard 不得繞過、弱化或重定義這些 governing inputs；若發生 violation，先修真正 Owner / Truth / Boundary / Dependency。

## Boundary

- 正式 route / HTTP entry 只做 transport、layout、presentation 與最外層 dependency composition；不複製 owner use case。
- Web feature module 可以呈現 owner capability，但不得取得另一 owner 的 private model、table 或 authorization。
- `shared` 只保存真正跨 feature 且無 business authority 的 Web mechanism；多處引用本身不是 shared evidence。
- Browser state、URL、query、layout 與 navigation intent 不授權；protected operation 由 server 重新建立可信 Principal / qualification / scope。

Current URL、route partition、app-shell 與 runtime contract 以 [Web runtime](../docs/reference/runtime/routes.md) 加實際 `apps/web/src/app` source 為準；本檔不複製 route inventory。

## GitHub domain truth and external benchmarks

Vendored [GitHub FPT JSON](../architecture/fpt/) 是 GitHub GraphQL semantics 的本地 domain truth，不是 benchmark；[provenance](../architecture/fpt-source.json) 只證明來源與完整性。[Semantic model](../architecture/registry.json#domain) 只能補 Line_Bot_v1 owner/invariant/capability/implementation overlay。只有 GitHub Mobile / visual interaction 可作 UX / information hierarchy benchmark，不能從畫面推導 permission、route 或 runtime activation。

## Nested routing

| Scope | Responsibility |
| --- | --- |
| [Web](web/AGENTS.md) | Next.js/runtime 入口 |
| [app](web/src/app/AGENTS.md) | URL、route group、delivery、composition |
| [modules](web/src/modules/AGENTS.md) | Feature presentation / interaction / HTTP projection |
| [shared](web/src/shared/AGENTS.md) | 無 business authority 的共用機制 |

先讀父層，再沿目標路徑讀最近 AGENTS；子檔只補 local invariant。

## Change rules

1. 先核對現行 route、consumer、owner public contract、tests、trust boundary 與 current capability status。
2. URL / entry 變更同步 page/route、Link/back、login/LIFF continuation、Rich Menu entry、tests 與 canonical locator；已發布 URL 先查 consumer/compatibility。
3. Owner / capability 語意改變時先修 `architecture/registry.json#domain`；module dependency/path 改變才修 `registry.json#modules`。
4. 未啟用能力不得用 fake data、disabled shell 或空 route 冒充完成。
5. 文件變更檢查 local links；app/tooling 變更依 root validation contract。Git push 不等於部署或 LINE/device acceptance。

## Naming

- URL 是外部 contract，route folder/file name 先服務 stable URL 與 Next.js convention；不得為了內部命名一致性改變公開路徑。
- Web module 用其呈現的 business capability 命名；`shared` 只用中立 technical mechanism 命名。名稱不能把 package owner、authorization 或 use case authority 移入 host。
- 舊 route/module 名稱僅在同一變更已追完 Link、entry parser、continuation、tests 與外部入口後收斂；子 AGENTS 只記錄這些範圍的例外。
</file>

