<file path="packages/issue/src/adapters/outbound/persistence/metrics.ts">
import { businessDatabase, type Database } from "@line_bot_v1/platform/postgres";
import { numberValue } from "@line_bot_v1/platform/validation";
import { repositoryContentScope } from "@line_bot_v1/repository/postgres/content-scope";
import type { IssueMetricsQuery } from "../../../contracts/output/metrics.js";
import { IssueError } from "../../../domain.js";

export class PostgresIssueMetrics implements IssueMetricsQuery {
  constructor(private readonly db: Database = businessDatabase()) {}
  read(userId: string, repositoryId: string, from: number, to: number) {
    if (!Number.isSafeInteger(from) || !Number.isSafeInteger(to) || from < 0 || from >= to)
      throw new IssueError(400, "Invalid Issue metric interval.");
    return this.db.transaction(async (sql) => {
      await repositoryContentScope(sql, userId, { repositoryId });
      const current = (
        await sql.query(
          `SELECT
        count(*) FILTER(WHERE created_at >= $2 AND created_at < $3)::integer AS created,
        count(*) FILTER(WHERE COALESCE(workflow_status,status)='pending')::integer AS pending,
        count(*) FILTER(WHERE COALESCE(workflow_status,status)='active')::integer AS active,
        count(*) FILTER(WHERE COALESCE(workflow_status,status)='review')::integer AS review,
        count(*) FILTER(WHERE COALESCE(workflow_status,status)='completed')::integer AS completed,
        count(*) FILTER(WHERE state IS NULL)::integer AS legacy
        FROM issues WHERE repository_id=$1`,
          [repositoryId, from, to],
          (r) => ({
            created: numberValue(r.created),
            pending: numberValue(r.pending),
            active: numberValue(r.active),
            review: numberValue(r.review),
            completed: numberValue(r.completed),
            legacy: numberValue(r.legacy),
          }),
        )
      ).rows[0];
      const events = (
        await sql.query(
          `SELECT
        count(*) FILTER(WHERE e.action='close')::integer AS closed,
        count(*) FILTER(WHERE e.action='reopen')::integer AS reopened,
        count(*) FILTER(WHERE e.data='{}'::jsonb)::integer AS unstructured
        FROM issue_events e JOIN issues i ON i.id=e.issue_id
        WHERE i.repository_id=$1 AND e.at >= $2 AND e.at < $3`,
          [repositoryId, from, to],
          (r) => ({
            closed: numberValue(r.closed),
            reopened: numberValue(r.reopened),
            unstructured: numberValue(r.unstructured),
          }),
        )
      ).rows[0];
      if (!current || !events) throw new IssueError(503, "Issue metrics unavailable.");
      return {
        created: current.created,
        closed: events.closed,
        reopened: events.reopened,
        workflow: {
          pending: current.pending,
          active: current.active,
          review: current.review,
          completed: current.completed,
        },
        coverage: {
          stateChanges: "recorded-events-only" as const,
          legacyIssues: current.legacy,
          unstructuredEvents: events.unstructured,
        },
      };
    });
  }
}
</file>

<file path="packages/issue/src/adapters/postgres/activity.ts">
import { readAccountLogins } from "@line_bot_v1/namespace/postgres";
import { businessDatabase, type Database } from "@line_bot_v1/platform/postgres";
import { numberValue, numericValue, stringValue } from "@line_bot_v1/platform/validation";
import { readableRepositoriesByIds } from "@line_bot_v1/repository/postgres/access";
import type { IssueActivityItem, IssueActivityStore } from "../../contracts/activity.js";
import { IssueError } from "../../domain.js";

type ActivityRow = {
  issue_id: string;
  version: number;
  actor: string;
  action: string;
  at: number | string;
  number: number | string;
  title: string;
  repository_id: string;
};

function decodeActivityRow(row: Record<string, unknown>): ActivityRow {
  return {
    issue_id: stringValue(row.issue_id),
    version: numberValue(row.version),
    actor: stringValue(row.actor),
    action: stringValue(row.action),
    at: numericValue(row.at),
    number: numericValue(row.number),
    title: stringValue(row.title),
    repository_id: stringValue(row.repository_id),
  };
}

export class PostgresIssueActivityStore implements IssueActivityStore {
  constructor(private db: Database = businessDatabase()) {}

  activity(userId: string, limit: number): Promise<IssueActivityItem[]> {
    return this.db.transaction(async (sql) => {
      if (limit < 1) return [];

      const rows = (
        await sql.query(
          `SELECT e.issue_id,e.version,e.actor,e.action,e.at,
                  i.number,i.title,i.repository_id
           FROM issue_events e
           JOIN issues i ON i.id=e.issue_id
           WHERE EXISTS (
             SELECT 1
             FROM repository_visibility_access v
             WHERE v.repository_id=i.repository_id
               AND (v.user_id=$1 OR v.user_id IS NULL)
           )
           ORDER BY e.at DESC,e.issue_id,e.version DESC
           LIMIT $2`,
          [userId, limit],
          decodeActivityRow,
        )
      ).rows;
      if (!rows.length) return [];

      const repositories = await readableRepositoriesByIds(sql, userId, [
        ...new Set(rows.map((row) => row.repository_id)),
      ]);
      const repositoryById = new Map(repositories.map((repository) => [repository.id, repository]));
      const visibleRows = rows.filter((row) => repositoryById.has(row.repository_id));
      if (!visibleRows.length) return [];

      const actors = await readAccountLogins(
        sql,
        visibleRows.map((row) => ({ id: row.actor, kind: "USER" as const })),
      );
      const actorLoginById = new Map(actors.map((actor) => [actor.id, actor.login]));

      return visibleRows.map((row) => {
        const repository = repositoryById.get(row.repository_id);
        if (!repository) throw new IssueError(409, "Issue activity Repository scope 不可用。");
        const actorLogin = actorLoginById.get(row.actor);
        if (!actorLogin) throw new IssueError(409, "Issue activity actor locator 不可用。");
        return {
          id: `${row.issue_id}:${row.version}`,
          occurredAt: Number(row.at),
          actorLogin,
          action: row.action,
          repository: {
            id: repository.id,
            ownerLogin: repository.ownerLogin,
            name: repository.name,
          },
          issue: {
            number: Number(row.number),
            title: row.title,
          },
        };
      });
    });
  }
}
</file>

