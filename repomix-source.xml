<file path="packages/organization/src/adapters/outbound/persistence/organization-owner.ts">
import { readActiveUserQualification } from "@line_bot_v1/account/postgres";
import type { VerifiedLineActor } from "@line_bot_v1/identity-access/contracts/governance";
import { GovernanceAccessError } from "@line_bot_v1/identity-access/domain/role-assignment";
import { requireOrganizationOwner } from "@line_bot_v1/identity-access/postgres";
import type { Database } from "@line_bot_v1/platform/postgres";
import { literalValue, numberValue } from "@line_bot_v1/platform/validation";
import type {
  OrganizationMutationEvidence,
  OrganizationReceipt,
} from "../../../contracts/organization-governance.js";
import type {
  OrganizationOwnerTransaction,
  OrganizationOwnerTransactions,
} from "../../../contracts/output/organization-owner.js";
import {
  hasOrganizationOwnerAssignment,
  hasReplacementOrganizationOwner,
} from "../../../postgres/owner-roles.js";
import { organizationGovernanceTransaction } from "./organization-governance-transaction.js";

export class PostgresOrganizationOwner implements OrganizationOwnerTransactions {
  constructor(private readonly db: Database) {}
  transact(
    actor: VerifiedLineActor,
    scope: { organizationAccountId: string; targetUserId: string },
    mutation: OrganizationMutationEvidence,
    operation: (transaction: OrganizationOwnerTransaction) => Promise<OrganizationReceipt>,
  ) {
    return organizationGovernanceTransaction(
      this.db,
      actor,
      scope.organizationAccountId,
      mutation,
      async (sql, evidence, organization) => {
        const values = [scope.organizationAccountId, scope.targetUserId];
        return operation({
          organization,
          authorize: () =>
            requireOrganizationOwner(sql, scope.organizationAccountId, evidence.actorUserId),
          replay: evidence.replay,
          record: evidence.record,
          membership: async () =>
            (
              await sql.query(
                `SELECT status,version FROM organization_memberships
          WHERE organization_account_id=$1 AND user_id=$2`,
                values,
                (row) => ({
                  status: literalValue(row.status, ["active", "removed"]),
                  version: numberValue(row.version),
                }),
              )
            ).rows[0] ?? null,
          load: async () =>
            (
              await sql.query(
                `SELECT status,version,user_status_version,membership_version
          FROM organization_role_assignments
          WHERE organization_account_id=$1 AND user_id=$2 AND role='OrganizationOwner' FOR UPDATE`,
                values,
                (row) => ({
                  status: literalValue(row.status, ["active", "revoked"]),
                  version: numberValue(row.version),
                  userStatusVersion: numberValue(row.user_status_version),
                  membershipVersion: numberValue(row.membership_version),
                }),
              )
            ).rows[0] ?? null,
          activeTargetVersion: async () =>
            (await readActiveUserQualification(sql, scope.targetUserId, "share"))?.statusVersion ??
            null,
          targetEffective: () =>
            hasOrganizationOwnerAssignment(sql, scope.organizationAccountId, scope.targetUserId),
          anotherEffective: () =>
            hasReplacementOrganizationOwner(sql, scope.organizationAccountId, scope.targetUserId),
          save: async (next) => {
            if (next.version === 1) {
              await sql.query(
                `INSERT INTO organization_role_assignments(
              organization_account_id,user_id,role,status,version,user_status_version,membership_version,granted_at
            ) VALUES($1,$2,'OrganizationOwner','active',1,$3,$4,$5)`,
                [...values, next.userStatusVersion, next.membershipVersion, mutation.at],
              );
              return 1;
            }
            const query =
              next.status === "active"
                ? `UPDATE organization_role_assignments
               SET status='active',version=version+1,user_status_version=$3,membership_version=$4,granted_at=$5
               WHERE organization_account_id=$1 AND user_id=$2 AND role='OrganizationOwner' RETURNING version`
                : `UPDATE organization_role_assignments SET status='revoked',version=version+1
               WHERE organization_account_id=$1 AND user_id=$2 AND role='OrganizationOwner' RETURNING version`;
            const row = (
              await sql.query(
                query,
                next.status === "active"
                  ? [...values, next.userStatusVersion, next.membershipVersion, mutation.at]
                  : values,
                (row) => ({ version: numberValue(row.version) }),
              )
            ).rows[0];
            if (!row)
              throw new GovernanceAccessError(409, "conflict", "OrganizationOwner 指派已更新。");
            return row.version;
          },
        });
      },
    );
  }
}
</file>

<file path="packages/organization/src/adapters/outbound/persistence/organization-scope.ts">
import type { VerifiedLineActor } from "@line_bot_v1/identity-access/contracts/governance";
import { GovernanceAccessError } from "@line_bot_v1/identity-access/domain/role-assignment";
import { requireOrganizationOwner } from "@line_bot_v1/identity-access/postgres";
import type { Database } from "@line_bot_v1/platform/postgres";
import { numberValue } from "@line_bot_v1/platform/validation";
import type {
  OrganizationMutationEvidence,
  OrganizationReceipt,
} from "../../../contracts/organization-governance.js";
import type {
  OrganizationCreationTransaction,
  OrganizationMemberPolicyTransaction,
  OrganizationScopeTransactions,
} from "../../../contracts/output/organization-scope.js";
import {
  organizationCommandTransaction,
  organizationGovernanceTransaction,
} from "./organization-governance-transaction.js";

function versionRow(row: Record<string, unknown>) {
  return { version: numberValue(row.version) };
}

function provisionedScopeRow(row: Record<string, unknown>) {
  return { scope_version: numberValue(row.scope_version) };
}

function hasPostgresCode(error: unknown, code: string): boolean {
  return error instanceof Error && "code" in error && error.code === code;
}

export class PostgresOrganizationScope implements OrganizationScopeTransactions {
  constructor(private readonly db: Database) {}

  transactCreation(
    actor: VerifiedLineActor,
    mutation: OrganizationMutationEvidence,
    operation: (transaction: OrganizationCreationTransaction) => Promise<OrganizationReceipt>,
  ) {
    return organizationCommandTransaction(this.db, actor, null, mutation, async (sql, evidence) =>
      operation({
        replay: evidence.replay,
        nextOrganizationAccountId: () => crypto.randomUUID(),
        provision: async (organization, locator) => {
          let provisioned: { scope_version: number } | undefined;
          try {
            provisioned = (
              await sql.query(
                "SELECT scope_version FROM app_private.provision_organization_scope($1,$2,$3,$4,$5)",
                [organization.id, evidence.actorUserId, locator.login, locator.name, mutation.at],
                provisionedScopeRow,
              )
            ).rows[0];
          } catch (error) {
            if (hasPostgresCode(error, "23505")) {
              throw new GovernanceAccessError(409, "conflict", "Organization login 已被使用。");
            }
            throw error;
          }
          if (!provisioned) {
            throw new GovernanceAccessError(503, "unknown-result", "Organization 建立結果不完整。");
          }
          return provisioned.scope_version;
        },
        record: evidence.record,
      }),
    );
  }

  transactMemberPolicy(
    actor: VerifiedLineActor,
    scope: Readonly<{ organizationAccountId: string }>,
    mutation: OrganizationMutationEvidence,
    operation: (transaction: OrganizationMemberPolicyTransaction) => Promise<OrganizationReceipt>,
  ) {
    return organizationGovernanceTransaction(
      this.db,
      actor,
      scope.organizationAccountId,
      mutation,
      async (sql, evidence, organization) =>
        operation({
          organization,
          authorizeOwner: () =>
            requireOrganizationOwner(sql, scope.organizationAccountId, evidence.actorUserId),
          replay: evidence.replay,
          save: async (next, expectedVersion, policy) => {
            const changed = (
              await sql.query(
                `UPDATE organizations SET
                   member_can_create_public_repositories=$2,
                   member_can_create_private_repositories=$3,
                   member_can_create_internal_repositories=$4,
                   member_can_create_project_v2=$5,
                   member_can_create_teams=$6,
                   version=$7
                 WHERE account_id=$1 AND version=$8 AND status='active'
                 RETURNING version`,
                [
                  scope.organizationAccountId,
                  policy.memberCanCreatePublicRepositories,
                  policy.memberCanCreatePrivateRepositories,
                  policy.memberCanCreateInternalRepositories,
                  policy.memberCanCreateProjectV2,
                  policy.memberCanCreateTeams,
                  next.version,
                  expectedVersion,
                ],
                versionRow,
              )
            ).rows[0];
            if (!changed) {
              throw new GovernanceAccessError(
                409,
                "conflict",
                "Organization 狀態已更新，請重新讀取。",
              );
            }
            return changed.version;
          },
          record: evidence.record,
        }),
    );
  }
}
