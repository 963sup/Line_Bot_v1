<file path="apps/web/src/app/api/AGENTS.md">
# Web API transport boundary

`apps/web/src/app/api` owns HTTP transport only. Business truth, authorization,
persistence, transactions, replay, and recovery remain in the owning package.
Parent rules from [`app`](../AGENTS.md), [`apps`](../../../../AGENTS.md), and
the repository root apply.

`GET/POST /api/repository-document-intake` is the fixed ContractDocument purchase-order intake entry. It accepts only an exact FileRevision reference and stable request identity; provider/model selection is server-side composition. Contract remains the authority for candidate validation, review and confirmation; `operation=contract` forwards only the bounded review command to Contract. The route never accepts or returns private object bytes.

The commercial intake routes independently expose the Intelligence commercial intake lifecycle
and Contract commercial DRAFT reads. Server composition connects Contract normalization to an
authorized immutable Intelligence result; HTTP transport owns no normalization or business rules.

## Request boundary

- Route handlers decode and validate transport input, establish trusted request
  identity, resolve locators, call public owner contracts, and map results to
  HTTP responses.
- URL, query parameter, body role, selected UI scope, browser state, and session
  cache locate or express intent; none is authorization evidence.
- Protected requests must re-establish current identity, qualification, scope,
  and lifecycle at the owner boundary.
- Pass stable IDs, scope, request identity, expected version, and exact replay
  data required by the owner contract. Do not invent a second request identity.
- Never query another owner's private tables, import private source paths, or
  expose provider credentials, service-role keys, private object keys, or raw
  private object bytes.
- Keep route handlers thin. `_composition` may wire concrete adapters at the
  outer boundary; it must not become a generic service locator or business
  workflow registry.

## Failure and state semantics

- Preserve the owner's distinction between unauthorized, forbidden, invalid,
  conflict, unavailable, and unknown-result outcomes.
- Do not convert unavailable data into empty data or successful mutation into a
  generic HTTP success.
- Preserve expected-version conflicts, request replay, idempotency, transaction
  boundaries, and recovery semantics in HTTP projections.
- Browser-visible responses contain only the public projection required by the
  route contract; do not return internal authority, SQL rows, provider DTOs, or
  diagnostic secrets.

## Change and validation

Before adding or changing a route, trace:

```text
route → module/composition → public package export → owner contract → tests
```

Confirm direct open, refresh, authentication continuation, wrong scope,
unauthorized/forbidden, stale/replay conflict, unavailable source, and unknown
result behavior where the owner supports those states. Read the route source
and owner contract for the current endpoint map; do not maintain an inventory
in this file.

Run the narrow route/owner tests and applicable package scripts. For
public contract, schema, architecture, merge, or release changes, use the
canonical root validation required by the root contract.
</file>

<file path="apps/web/src/modules/document-intake/document-intake-http.server.ts">
import { randomUUID } from "node:crypto";
import { UserError } from "@line_bot_v1/account/domain/user";
import type { ContractDocumentIntake } from "@line_bot_v1/contract/contracts/input/document-intake";
import { ContractError } from "@line_bot_v1/contract/domain/error";
import {
  type IntakeCommand,
  IntakeError,
  type IntakeStage,
} from "@line_bot_v1/intelligence/contracts/output/document-intake";
import { IntelligenceError } from "@line_bot_v1/intelligence/domain/error";
import { normalizeAccountLogin } from "@line_bot_v1/namespace";
import { RepositoryError } from "@line_bot_v1/repository/contracts/errors/repository-error";
import { normalizeRepositoryName } from "@line_bot_v1/repository/domain/repository/value-objects/repository-name";
import { logServerError } from "../../shared/observability/runtime-error.server";
import { BodyTooLargeError, jsonResponse, readBodyText } from "../../shared/server/http";
import { RequestIdentityError } from "../../shared/server/request-identity-error";

type Scope = {
  actorUserId: string;
  repository: { id: string; ownerLogin: string; name: string };
  archived: boolean;
  canEdit: boolean;
  canManage: boolean;
};
type Intake = (
  actor: string,
  input: IntakeCommand,
  onStage?: (stage: IntakeStage) => void,
) => Promise<unknown>;

export type DocumentIntakeWebRuntime = {
  scope(subject: string, selector: { ownerLogin: string; repositoryName: string }): Promise<Scope>;
  intake: Intake | null;
  documents: ContractDocumentIntake | null;
};

function selector(query: URLSearchParams) {
  try {
    const ownerLogin = normalizeAccountLogin(query.get("owner") ?? "");
    const repositoryName = normalizeRepositoryName(query.get("name") ?? "");
    if (!repositoryName) throw new Error();
    return { ownerLogin, repositoryName };
  } catch {
    throw new ContractError(400, "Repository locator is invalid.", "INVALID_INPUT");
  }
}

async function jsonBody(request: Request): Promise<unknown> {
  const origin = process.env.APP_ORIGIN;
  if (!origin || !origin.startsWith("https://") || new URL(origin).origin !== origin)
    throw new ContractError(503, "Service origin is unavailable.", "UNAVAILABLE");
  if (request.headers.get("origin") !== origin)
    throw new ContractError(403, "Use the Line_Bot_v1 application.", "FORBIDDEN");
  if (request.headers.get("content-type")?.split(";")[0]?.trim() !== "application/json")
    throw new ContractError(415, "JSON is required.", "INVALID_INPUT");
  try {
    return JSON.parse(await readBodyText(request, 524_288));
  } catch (error) {
    if (error instanceof BodyTooLargeError)
      throw new ContractError(413, "Content is too large.", "INVALID_INPUT");
    throw new ContractError(400, "Invalid JSON body.", "INVALID_INPUT");
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function record(value: unknown): Record<string, unknown> {
  if (!isRecord(value))
    throw new ContractError(400, "Document intake command is required.", "INVALID_INPUT");
  return value;
}

function requiredString(value: unknown, field: string) {
  if (typeof value !== "string" || value.length === 0)
    throw new ContractError(400, `${field} is required.`, "INVALID_INPUT");
  return value;
}

function requiredInteger(value: unknown, field: string) {
  if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 0)
    throw new ContractError(400, `${field} must be a non-negative integer.`, "INVALID_INPUT");
  return value;
}

function diagnostic(error: unknown, seen = new Set<object>(), depth = 0): Record<string, string> | undefined {
  if (!error || typeof error !== "object") return undefined;
  if (seen.has(error) || depth > 3) return undefined;
  seen.add(error);
  const read = (key: string) => {
    const value = Reflect.get(error, key);
    return typeof value === "string" && value.length > 0 ? value : undefined;
  };
  const cause = Reflect.get(error, "cause");
  const nested = cause ? diagnostic(cause, seen, depth + 1) : undefined;
  const code = read("code");
  const schema = read("schema");
  const table = read("table");
  const column = read("column");
  const message = read("message");
  if (!code && !schema && !table && !column && !message) return nested;
  return {
    ...(nested ?? {}),
    ...(code ? { code } : {}),
    ...(schema ? { schema } : {}),
    ...(table ? { table } : {}),
    ...(column ? { column } : {}),
    ...(message ? { message } : {}),
  };
}

function parseIntakeCommand(value: unknown): IntakeCommand {
  const input = record(value);
  if (input.action !== "save")
    throw new ContractError(400, "Only document save intake is supported.", "INVALID_INPUT");
  const source = record(input.source);
  return {
    action: "save",
    repositoryId: requiredString(input.repositoryId, "repositoryId"),
    documentId: requiredString(input.documentId, "documentId"),
    requestId: requiredString(input.requestId, "requestId"),
    expectedVersion: requiredInteger(input.expectedVersion, "expectedVersion"),
    source: {
      fileId: requiredString(source.fileId, "source.fileId"),
      fileRevisionId: requiredString(source.fileRevisionId, "source.fileRevisionId"),
      fileSha256: requiredString(source.fileSha256, "source.fileSha256"),
    },
  };
}

function failure(
  error: unknown,
  stage: IntakeStage | "request" | "intake" | "contract.read" | "contract.review",
) {
  const traceId = randomUUID();
  const known =
    error instanceof ContractError ||
    error instanceof IntakeError ||
    error instanceof IntelligenceError ||
    error instanceof RepositoryError ||
    error instanceof UserError ||
    error instanceof RequestIdentityError;
  const connectionCode =
    error && typeof error === "object" ? Reflect.get(error, "code") : undefined;
  const connectionFailure =
    typeof connectionCode === "string" &&
    [
      "08000",
      "08001",
      "08003",
      "08004",
      "08006",
      "08007",
      "08P01",
      "57P01",
      "57P02",
      "57P03",
      "53300",
      "ECONNREFUSED",
      "ECONNRESET",
      "ETIMEDOUT",
      "ENOTFOUND",
    ].includes(connectionCode);
  const persistenceStage = [
    "attempt.reserve",
    "target.receipt",
    "target.submit",
    "attempt.complete",
    "contract.read",
    "contract.review",
  ].includes(stage);
  const status = known ? error.status : connectionFailure && persistenceStage ? 503 : 500;
  const code =
    error instanceof ContractError ||
    error instanceof IntakeError ||
    error instanceof IntelligenceError
      ? error.code
      : undefined;
  const message = error instanceof Error ? error.message : String(error);
  logServerError(error, {
    service: "repository-document-intake-api",
    operation: stage,
    status,
    ...(code ? { code } : {}),
    traceId,
  });
  return jsonResponse(
    {
      error: message,
      ...(code ? { code } : {}),
      stage,
      traceId,
      diagnostic: diagnostic(error),
    },
    status,
  );
}

export async function documentIntakeRequest(
  request: Request,
  runtime: DocumentIntakeWebRuntime,
  identity: (request: Request) => Promise<string>,
) {
  let stage: IntakeStage | "request" | "intake" | "contract.read" | "contract.review" = "request";
  try {
    const subject = await identity(request);
    const query = new URL(request.url).searchParams;
    const scope = await runtime.scope(subject, selector(query));
    const operation = query.get("operation") ?? (request.method === "POST" ? "intake" : "read");
    if (operation === "intake") {
      if (request.method !== "POST")
        throw new ContractError(405, "Document intake requires POST.", "INVALID_INPUT");
      if (!scope.canEdit || scope.archived)
        throw new ContractError(403, "目前沒有此 Repository 的文件寫入權限。", "FORBIDDEN");
      if (!runtime.intake)
        throw new ContractError(503, "採購單 AI 服務尚未設定，請聯絡系統管理員。", "UNAVAILABLE");
      const command = parseIntakeCommand(await jsonBody(request));
      if (command.repositoryId !== scope.repository.id)
        throw new ContractError(
          400,
          "Document intake scope does not match the URL.",
          "INVALID_INPUT",
        );
      stage = "intake";
      return jsonResponse(
        await runtime.intake(scope.actorUserId, command, (current) => {
          stage = current;
        }),
      );
    }
    if (!runtime.documents)
      throw new ContractError(503, "採購單 AI 服務尚未設定，請聯絡系統管理員。", "UNAVAILABLE");
    const documentId = query.get("documentId") ?? "";
    if (!documentId) throw new ContractError(400, "Document ID is required.", "INVALID_INPUT");
    stage = "contract.read";
    if (operation === "receipt") {
      const requestId = query.get("requestId") ?? "";
      return jsonResponse(
        await runtime.documents.receipt(scope.actorUserId, {
          repositoryId: scope.repository.id,
          documentId,
          requestId,
        }),
      );
    }
    if (operation === "contract") {
      stage = "contract.review";
      if (request.method !== "POST")
        throw new ContractError(405, "Contract document review requires POST.", "INVALID_INPUT");
      if (!scope.canEdit || scope.archived)
        throw new ContractError(403, "目前沒有此 Repository 的文件寫入權限。", "FORBIDDEN");
      const command = record(await jsonBody(request));
      if (command.repositoryId !== scope.repository.id || command.documentId !== documentId)
        throw new ContractError(
          400,
          "Contract document scope does not match the URL.",
          "INVALID_INPUT",
        );
      return jsonResponse(await runtime.documents.submit(scope.actorUserId, command));
    }
    if (operation === "read")
      return jsonResponse({
        revision: await runtime.documents.read(scope.actorUserId, {
          repositoryId: scope.repository.id,
          documentId,
          ...(query.has("revisionId") ? { revisionId: query.get("revisionId") ?? "" } : {}),
        }),
      });
    throw new ContractError(400, "Unknown document intake operation.", "INVALID_INPUT");
  } catch (error) {
    return failure(error, stage);
  }
}
</file>

