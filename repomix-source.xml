<file path="packages/account/src/application/use-cases/change-user-status.ts">
import type { UserManagementPersistence } from "../../contracts/output/user-management-transactions.js";
import type { UserStatusReceipt } from "../../contracts/user-management.js";
import {
  assertUserManagementTarget,
  decideUserStatusChange,
  requireUserManagementPermissions,
  UserError,
} from "../../domain/user.js";
import type { UserStatusCommand } from "../commands/user-status.js";

export function changeUserStatus(
  store: UserManagementPersistence,
  actor: string,
  input: UserStatusCommand,
  now: number,
) {
  const command = { ...input };
  return store.transact(
    actor,
    command.target,
    {
      requestId: command.requestId,
      payload: JSON.stringify(command),
      action: command.action,
      reason: command.reason,
    },
    async (transaction) => {
      requireUserManagementPermissions(await transaction.permissions(), true);
      assertUserManagementTarget(actor, command.target);
      const previous = await transaction.replay();
      if (previous) {
        if (!previous.matches) throw new UserError(409, "操作編號已用於不同內容。");
        return previous.result;
      }
      const target = await transaction.target();
      if (!target) throw new UserError(404, "使用者不存在。");
      const next = decideUserStatusChange(
        { action: command.action, expectedVersion: command.expectedVersion },
        target,
      );
      if (command.action === "suspend") await transaction.protectAdministrator();
      const version = await transaction.writeStatus(next.status);
      const result: UserStatusReceipt = {
        id: command.target,
        requestId: command.requestId,
        status: next.status,
        version,
        at: now,
      };
      requireUserManagementPermissions(await transaction.permissions(), true);
      await transaction.record(result, target.status, next.event);
      return result;
    },
  );
}
</file>

<file path="packages/account/src/application/use-cases/google-link.ts">
import type { GoogleLinkTransactions } from "../../contracts/output/google-link-transactions.js";
import type { VerifiedGoogleIdentity } from "../../contracts/output/identity-provider.js";
import {
  confirmGoogleLink,
  expiredGoogleLink,
  newGoogleLinkRequest,
  requireGoogleLinkOwner,
  stageGoogleLink,
  unlinkGoogleLink,
} from "../../domain/google-link.js";
import { bindGoogleUser } from "./user-lifecycle.js";

export function createGoogleLinkRequests(store: GoogleLinkTransactions) {
  return {
    start(provider: string, subject: string, now: number) {
      return store.transact(async (transaction) => {
        const owner = requireGoogleLinkOwner(await transaction.owner(provider, subject));
        const request = newGoogleLinkRequest(owner, now);
        await transaction.expire(owner.id, now);
        const token = transaction.token();
        await transaction.insert(request, token);
        return { token };
      });
    },
    async stage(token: string, google: VerifiedGoogleIdentity, now: number) {
      if (!/^[A-Za-z0-9_-]{43}$/.test(token)) throw expiredGoogleLink();
      await store.transact(async (transaction) => {
        const request = await transaction.stageRequest(token, now);
        const id = stageGoogleLink(request, google.id, google.sub);
        if (id !== null) await transaction.saveStage(id, google);
      });
    },
    pending(provider: string, subject: string, now: number) {
      return store.transact(async (transaction) => {
        const owner = requireGoogleLinkOwner(await transaction.owner(provider, subject));
        return transaction.pending(owner.id, owner.statusVersion, now);
      });
    },
    async confirm(provider: string, subject: string, id: string, now: number) {
      await store.transact(async (transaction) => {
        const owner = requireGoogleLinkOwner(await transaction.owner(provider, subject));
        const identity = confirmGoogleLink(
          await transaction.confirmation(id, owner.id, owner.statusVersion, now),
        );
        await bindGoogleUser(
          transaction.users,
          provider,
          subject,
          { id: identity.id, sub: identity.subject, email: identity.email },
          now,
        );
        await transaction.drop(id);
      });
    },
    async cancel(provider: string, subject: string, id: string) {
      await store.transact(async (transaction) => {
        const owner = requireGoogleLinkOwner(await transaction.owner(provider, subject));
        await transaction.cancel(id, owner.id);
      });
    },
    async unlink(provider: string, subject: string, now: number) {
      await store.transact(async (transaction) => {
        const owner = requireGoogleLinkOwner(await transaction.owner(provider, subject));
        const decision = unlinkGoogleLink(await transaction.linked(owner.id));
        await transaction.unlink(owner.id);
        await transaction.clear(owner.id);
        await transaction.audit(owner.id, decision.event, now);
      });
    },
  };
}
</file>

<file path="packages/account/src/application/use-cases/user-lifecycle.ts">
import type { VerifiedGoogleIdentity } from "../../contracts/output/identity-provider.js";
import type { UserTransactions } from "../../contracts/output/user-transactions.js";
import {
  assertExistingGoogleBinding,
  assertUserLoginChange,
  confirmUserRegistration,
  decideGoogleUserBinding,
  decideLineUser,
  pauseUser,
  registerUser,
  requireRegisteredLineUser,
  suspendUser,
  UserError,
} from "../../domain/user.js";

function lineIdentity(provider: string, subject: string) {
  if (!/^line:[\w-]{1,80}$/.test(provider) || !/^U[a-f0-9]{32}$/i.test(subject))
    throw new UserError(400, "LINE 身分不正確。");
}

export async function changeLineUser(
  store: UserTransactions,
  provider: string,
  subject: string,
  operation: "register" | "restore",
  login: string | null,
  now: number,
) {
  lineIdentity(provider, subject);
  return store.identity(provider, subject, async (transaction) => {
    const current = await transaction.lineUser(provider, subject);
    const decision = decideLineUser(operation, current?.user ?? null);
    if (decision.kind === "create") {
      const next = registerUser(transaction.newId(), now);
      await transaction.insert(next.user);
      if (!login) throw new UserError(400, "登入名稱格式不正確。");
      await transaction.claimLogin(next.user.id, login, now);
      await transaction.recordLineIdentity(next.user.id, provider, subject);
      await transaction.audit(next.user.id, next.event, now);
      return transaction.view(next.user.id);
    }
    if (decision.kind === "confirm") {
      if (!login) throw new UserError(400, "登入名稱格式不正確。");
      confirmUserRegistration(decision.user, login, await transaction.login(decision.user.id));
    } else if (decision.kind === "restore") {
      await transaction.saveStatus(decision.user);
      await transaction.audit(decision.user.id, decision.event, now);
    }
    return transaction.view(decision.user.id);
  });
}

export async function bindGoogleUser(
  store: UserTransactions,
  provider: string,
  subject: string,
  google: VerifiedGoogleIdentity,
  now: number,
) {
  lineIdentity(provider, subject);
  return store.binding(provider, subject, async (transaction) => {
    const current = await transaction.lineUser(provider, subject);
    const user = requireRegisteredLineUser(current?.user ?? null);
    assertExistingGoogleBinding(
      current?.authUserId ?? null,
      await transaction.googleSubject(user.id),
      google.id,
      google.sub,
    );
    const next = decideGoogleUserBinding(
      user,
      current?.authUserId ?? null,
      google.id,
      await transaction.googleOwner(google.sub),
    );
    await transaction.saveGoogleBinding(next.user, google);
    if (next.event) await transaction.audit(user.id, next.event, now);
    return { ...next.user, auth_user_id: google.id };
  });
}

export function changeUserLogin(
  store: UserTransactions,
  id: string,
  login: string,
  expectedLogin: string,
  now: number,
) {
  return store.rename(async (transaction) => {
    assertUserLoginChange(await transaction.user(id));
    await transaction.renameLogin(id, expectedLogin, login, now);
    return transaction.view(id);
  });
}

export function pauseCurrentUser(
  store: UserTransactions,
  id: string,
  now: () => number,
  authId?: string,
) {
  return store.lifecycle(async (transaction) => {
    await transaction.protectAdministrator(id);
    const next = pauseUser(await transaction.qualify(id, authId));
    await transaction.saveStatus(next.user);
    await transaction.audit(id, next.event, now());
    return transaction.view(id);
  });
}

export function suspendCurrentUser(store: UserTransactions, id: string, now: () => number) {
  return store.lifecycle(async (transaction) => {
    await transaction.protectAdministrator(id);
    const next = suspendUser(await transaction.user(id));
    await transaction.saveStatus(next.user);
    await transaction.audit(id, next.event, now());
  });
}
</file>

