<file path="apps/web/src/modules/account/profile-follow-control.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import { readNetwork, responseError } from "./wire-response";

type FollowState = "loading" | "following" | "not-following" | "error";

async function readFollowing(
  token: string,
  targetUserId: string,
  signal: AbortSignal,
): Promise<boolean> {
  const response = await fetch("/api/follows", {
    headers: { "X-App-Session-Generation": token },
    cache: "no-store",
    signal,
  });
  const value: unknown = await response.json();
  signal.throwIfAborted();
  if (!response.ok) throw new Error(responseError(value, "追蹤狀態讀取失敗。"));
  return readNetwork(value).following.some((item) => item.userId === targetUserId);
}

export default function ProfileFollowControl({
  token,
  targetUserId,
}: {
  token: string;
  targetUserId: string;
}) {
  const [state, setState] = useState<FollowState>("loading");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const generation = useRef(0);
  const activeRequest = useRef<AbortController | null>(null);

  useEffect(() => {
    const ticket = ++generation.current;
    const controller = new AbortController();
    activeRequest.current?.abort();
    activeRequest.current = controller;
    setState("loading");
    setBusy(false);
    setError("");

    void readFollowing(token, targetUserId, controller.signal).then(
      (following) => {
        if (ticket === generation.current) {
          setState(following ? "following" : "not-following");
        }
      },
      (cause: unknown) => {
        if (ticket === generation.current && !controller.signal.aborted) {
          setState("error");
          setError(cause instanceof Error ? cause.message : String(cause));
        }
      },
    );

    return () => {
      generation.current++;
      controller.abort();
      if (activeRequest.current === controller) activeRequest.current = null;
    };
  }, [targetUserId, token]);

  async function mutate() {
    if (state !== "following" && state !== "not-following") return;
    const ticket = ++generation.current;
    const controller = new AbortController();
    activeRequest.current?.abort();
    activeRequest.current = controller;
    const action = state === "following" ? "unfollow" : "follow";
    setBusy(true);
    setError("");
    try {
      const response = await fetch("/api/follows", {
        method: "POST",
        headers: {
          "X-App-Session-Generation": token,
          "content-type": "application/json",
        },
        body: JSON.stringify({ action, targetUserId }),
        signal: controller.signal,
      });
      const value: unknown = await response.json();
      controller.signal.throwIfAborted();
      if (!response.ok) throw new Error(responseError(value, "追蹤操作失敗。"));
      const following = await readFollowing(token, targetUserId, controller.signal);
      if (ticket === generation.current) {
        setState(following ? "following" : "not-following");
      }
    } catch (cause) {
      if (ticket === generation.current && !controller.signal.aborted) {
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) {
        setBusy(false);
        if (activeRequest.current === controller) activeRequest.current = null;
      }
    }
  }

  if (state === "loading") return <p role="status">正在讀取追蹤狀態…</p>;
  if (state === "error") return <p role="status">{error}</p>;

  const following = state === "following";
  return (
    <div>
      <button type="button" aria-pressed={following} disabled={busy} onClick={() => void mutate()}>
        {busy ? "正在更新…" : following ? "取消追蹤" : "追蹤"}
      </button>
      {error ? <p role="alert">{error}</p> : null}
    </div>
  );
}
</file>

<file path="apps/web/src/modules/account/profile-panel.tsx">
"use client";

import type {
  UserProfile,
  UserProfileVisibility,
} from "@line_bot_v1/account/contracts/repositories/profile";
import { isRecord } from "@line_bot_v1/platform/validation";
import { useEffect, useEffectEvent, useRef, useState } from "react";
import { liffClient } from "../../shared/browser/liff-client";
import MiniAppRuntime from "../../shared/browser/mini-app-runtime";
import { readProfile, responseError } from "./wire-response";

type Draft = {
  displayName: string;
  bio: string;
  visibility: UserProfileVisibility;
  expectedVersion: number;
};

const emptyDraft: Draft = {
  displayName: "",
  bio: "",
  visibility: "private",
  expectedVersion: 0,
};

function draftFrom(profile: UserProfile | null): Draft {
  return profile
    ? {
        displayName: profile.displayName ?? "",
        bio: profile.bio ?? "",
        visibility: profile.visibility,
        expectedVersion: profile.version,
      }
    : emptyDraft;
}

export default function ProfilePanel({ liffId }: { liffId: string }) {
  const [profile, setProfile] = useState<UserProfile | null>(null);
  const [draft, setDraft] = useState<Draft>(emptyDraft);
  const [loaded, setLoaded] = useState(false);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const generation = useRef(0);

  function clear() {
    generation.current++;
    setProfile(null);
    setDraft(emptyDraft);
    setLoaded(false);
    setBusy(false);
    setError("");
    setNotice("");
  }

  async function load() {
    const ticket = ++generation.current;
    setBusy(true);
    setError("");
    setNotice("");
    try {
      const token = await liffClient.ensureSession(liffId);
      if (!token) throw new Error("請完成 LINE 登入後重試。");
      const response = await fetch("/api/profile", {
        headers: { "X-App-Session-Generation": token },
        cache: "no-store",
      });
      const value: unknown = await response.json();
      if (!response.ok) throw new Error(responseError(value, "個人資料讀取失敗。"));
      if (ticket !== generation.current) return;
      if (!isRecord(value)) throw new Error("個人資料回應格式不正確。");
      const next = value.profile == null ? null : readProfile(value.profile);
      setProfile(next);
      setDraft(draftFrom(next));
      setLoaded(true);
    } catch (cause) {
      if (ticket === generation.current) {
        setLoaded(false);
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }

  async function save() {
    if (busy) return;
    const ticket = ++generation.current;
    setBusy(true);
    setError("");
    setNotice("");
    try {
      const token = await liffClient.ensureSession(liffId);
      if (!token) throw new Error("請完成 LINE 登入後重試。");
      const response = await fetch("/api/profile", {
        method: "POST",
        headers: {
          "X-App-Session-Generation": token,
          "content-type": "application/json",
        },
        body: JSON.stringify({
          displayName: draft.displayName.trim() || null,
          bio: draft.bio.trim() || null,
          visibility: draft.visibility,
          expectedVersion: draft.expectedVersion,
        }),
      });
      const value: unknown = await response.json();
      if (!response.ok) throw new Error(responseError(value, "個人資料保存失敗。"));
      if (!isRecord(value) || !("profile" in value)) throw new Error("個人資料回應格式不正確。");
      const saved = readProfile(value.profile);
      if (ticket !== generation.current) return;
      setProfile(saved);
      setDraft(draftFrom(saved));
      setLoaded(true);
      setNotice("個人資料已保存。");
    } catch (cause) {
      if (ticket === generation.current) {
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }

  const onVisibilityChange = useEffectEvent(() => {
    if (document.visibilityState === "hidden") clear();
    else void load();
  });

  useEffect(() => {
    const visibility = () => onVisibilityChange();
    document.addEventListener("visibilitychange", visibility);
    return () => {
      generation.current++;
      document.removeEventListener("visibilitychange", visibility);
    };
  }, []);

  return (
    <div className="profile-panel">
      <MiniAppRuntime liffId={liffId} onReady={load} onWait={clear} />
      {busy && <p role="status">正在確認個人資料…</p>}
      {error && <p role="alert">{error}</p>}
      {notice && <p role="status">{notice}</p>}
      {loaded && (
        <form
          className="profile-form"
          onSubmit={(event) => {
            event.preventDefault();
            void save();
          }}
        >
          <label>
            顯示名稱
            <input
              maxLength={120}
              value={draft.displayName}
              onChange={(event) => setDraft({ ...draft, displayName: event.target.value })}
              placeholder="你的產品顯示名稱"
            />
          </label>
          <label>
            自我介紹
            <textarea
              maxLength={2000}
              value={draft.bio}
              onChange={(event) => setDraft({ ...draft, bio: event.target.value })}
              placeholder="簡短說明你的工作或角色"
            />
          </label>
          <label>
            Profile 可見範圍
            <select
              value={draft.visibility}
              onChange={(event) => {
                const visibility = event.target.value;
                if (
                  visibility === "private" ||
                  visibility === "organization" ||
                  visibility === "public"
                )
                  setDraft({ ...draft, visibility });
              }}
            >
              <option value="private">僅自己</option>
              <option value="organization">Organization</option>
              <option value="public">公開</option>
            </select>
          </label>
          <p className="profile-note">
            Profile visibility 不授予任何 Enterprise、Organization、Team 或儲存庫權限。
          </p>
          <div className="inline-actions">
            <button type="submit" disabled={busy}>
              保存個人資料
            </button>
            <button type="button" className="secondary" disabled={busy} onClick={() => void load()}>
              重新載入
            </button>
          </div>
          {profile && <small className="profile-version">版本 {profile.version}</small>}
        </form>
      )}
    </div>
  );
}
</file>

<file path="apps/web/src/modules/account/service-session-control.tsx">
"use client";

import { useEffect, useState } from "react";
import { liffClient } from "../../shared/browser/liff-client";
import { SessionBlockedError } from "../../shared/browser/line-service-session";

type Status = "checking" | "signed-in" | "signed-out" | "sign-out-failed" | "unavailable";

export default function ServiceSessionControl({ liffId }: { liffId: string }) {
  const [status, setStatus] = useState<Status>("checking");
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState("");

  useEffect(() => {
    let active = true;
    const unsubscribe = liffClient.onSessionBlocked((reason) => {
      setStatus("signed-out");
      setMessage(
        reason === "signed-out" ? "你已登出此服務。" : "登入狀態已在其他分頁更新，請重新登入。",
      );
    });
    void liffClient
      .ensureSession(liffId)
      .then((session) => {
        if (!active) return;
        setStatus(session ? "signed-in" : "unavailable");
        if (!session) setMessage("目前無法取得 LINE 登入資訊，請從 LINE MINI App 開啟。");
      })
      .catch((error: unknown) => {
        if (!active) return;
        if (error instanceof SessionBlockedError) {
          setStatus("signed-out");
          setMessage(error.message);
          return;
        }
        setStatus("unavailable");
        setMessage(error instanceof Error ? error.message : String(error));
      });
    return () => {
      active = false;
      unsubscribe();
    };
  }, [liffId]);

  async function signOut() {
    setBusy(true);
    setMessage("");
    try {
      await liffClient.endSession();
      setStatus("signed-out");
      setMessage("你已登出此服務。LINE 帳號本身仍保持登入。");
    } catch (error) {
      setStatus("sign-out-failed");
      setMessage(error instanceof Error ? error.message : String(error));
    } finally {
      setBusy(false);
    }
  }

  async function signIn() {
    setBusy(true);
    setMessage("");
    try {
      const session = await liffClient.startSession(liffId);
      if (!session) {
        setStatus("unavailable");
        setMessage("目前無法取得 LINE 登入資訊，請從 LINE MINI App 開啟。");
        return;
      }
      setStatus("signed-in");
      setMessage("已重新登入此服務。");
    } catch (error) {
      setStatus(error instanceof SessionBlockedError ? "signed-out" : "unavailable");
      setMessage(error instanceof Error ? error.message : String(error));
    } finally {
      setBusy(false);
    }
  }

  return (
    <section aria-labelledby="service-session-title">
      <h2 id="service-session-title">登入狀態</h2>
      <p>這會登出本服務，不會登出你的 LINE 帳號。</p>
      <p role="status">
        {status === "checking"
          ? "正在確認服務登入狀態…"
          : status === "signed-in"
            ? "目前已登入此服務。"
            : status === "signed-out"
              ? "目前已登出此服務。"
              : status === "sign-out-failed"
                ? "此分頁已停止使用服務，但伺服器撤銷尚未確認。"
                : "目前無法確認服務登入狀態。"}
      </p>
      {message && <p role="alert">{message}</p>}
      {status === "signed-in" || status === "sign-out-failed" ? (
        <button type="button" className="secondary" disabled={busy} onClick={() => void signOut()}>
          {busy ? "正在登出…" : "登出此服務"}
        </button>
      ) : (
        <button
          type="button"
          disabled={busy || status === "checking"}
          onClick={() => void signIn()}
        >
          {busy ? "正在登入…" : "使用 LINE 重新登入"}
        </button>
      )}
    </section>
  );
}
</file>

<file path="apps/web/src/modules/account/status-panel.tsx">
"use client";

import type {
  UserProfileStatusChange,
  UserProfileStatusChangeResult,
} from "@line_bot_v1/account/contracts/dto/user-profile-status";
import type { UserProfileStatus } from "@line_bot_v1/account/contracts/repositories/user-profile-status";
import { isRecord, stringValue } from "@line_bot_v1/platform/validation";
import { useEffect, useEffectEvent, useRef, useState } from "react";
import styles from "./status-panel.module.css";
import { responseError } from "./wire-response";

type Draft = {
  message: string;
  emoji: string;
  limitedAvailability: boolean;
  expiresAt: string;
  expectedVersion: number;
};

const emptyDraft: Draft = {
  message: "",
  emoji: "",
  limitedAvailability: false,
  expiresAt: "",
  expectedVersion: 0,
};

function localDateTime(value: number | null) {
  if (value === null) return "";
  const date = new Date(value);
  const year = String(date.getFullYear()).padStart(4, "0");
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  const hours = String(date.getHours()).padStart(2, "0");
  const minutes = String(date.getMinutes()).padStart(2, "0");
  return `${year}-${month}-${day}T${hours}:${minutes}`;
}

function draftFrom(status: UserProfileStatus | null): Draft {
  return status
    ? {
        message: status.message ?? "",
        emoji: status.emoji ?? "",
        limitedAvailability: status.limitedAvailability,
        expiresAt: localDateTime(status.expiresAt),
        expectedVersion: status.version,
      }
    : emptyDraft;
}

function draftFromChange(change: UserProfileStatusChange): Draft {
  return {
    message: change.message ?? "",
    emoji: change.emoji ?? "",
    limitedAvailability: change.limitedAvailability,
    expiresAt: localDateTime(change.expiresAt),
    expectedVersion: change.expectedVersion,
  };
}

function nullableText(value: unknown) {
  if (value === null) return null;
  if (typeof value !== "string") throw new Error("狀態回應格式不正確。");
  return value;
}

function number(value: unknown) {
  if (typeof value !== "number" || !Number.isSafeInteger(value)) {
    throw new Error("狀態回應格式不正確。");
  }
  return value;
}

function readStatus(value: unknown): UserProfileStatus {
  if (!isRecord(value) || typeof value.limitedAvailability !== "boolean") {
    throw new Error("狀態回應格式不正確。");
  }
  return {
    userId: stringValue(value.userId),
    message: nullableText(value.message),
    emoji: nullableText(value.emoji),
    limitedAvailability: value.limitedAvailability,
    expiresAt: value.expiresAt === null ? null : number(value.expiresAt),
    version: number(value.version),
    createdAt: number(value.createdAt),
    updatedAt: number(value.updatedAt),
  };
}

function readChangedStatus(value: unknown): UserProfileStatusChangeResult {
  if (!isRecord(value) || typeof value.requestId !== "string") {
    throw new Error("狀態更新回應格式不正確。");
  }
  return { ...readStatus(value), requestId: value.requestId };
}

function commandFrom(draft: Draft, requestId: string): UserProfileStatusChange {
  const datetime = draft.expiresAt.replace(
    /^(\d{5,})-/,
    (_match: string, year: string) => `+${year.padStart(6, "0")}-`,
  );
  const expiresAt = datetime ? Date.parse(datetime) : null;
  if (expiresAt !== null && !Number.isSafeInteger(expiresAt)) {
    throw new Error("請選擇有效的到期時間。");
  }
  return {
    requestId,
    message: draft.message.trim() || null,
    emoji: draft.emoji.trim() || null,
    limitedAvailability: draft.limitedAvailability,
    expiresAt,
    expectedVersion: draft.expectedVersion,
  };
}

function commandPayload(command: UserProfileStatusChange) {
  return JSON.stringify({
    message: command.message,
    emoji: command.emoji,
    limitedAvailability: command.limitedAvailability,
    expiresAt: command.expiresAt,
    expectedVersion: command.expectedVersion,
  });
}

export default function StatusPanel({ token }: { token: string }) {
  const [status, setStatus] = useState<UserProfileStatus | null>(null);
  const [draft, setDraft] = useState<Draft>(emptyDraft);
  const [editing, setEditing] = useState(false);
  const [loaded, setLoaded] = useState(false);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [displayNow, setDisplayNow] = useState(() => Date.now());
  const generation = useRef(0);
  const pending = useRef<UserProfileStatusChange | null>(null);
  const pendingToken = useRef(token);

  function clearLocal() {
    generation.current++;
    setStatus(null);
    setDraft(emptyDraft);
    setEditing(false);
    setLoaded(false);
    setBusy(false);
    setError("");
    setNotice("");
  }

  async function readCurrentStatus() {
    const response = await fetch("/api/profile/status", {
      headers: { "X-App-Session-Generation": token },
      cache: "no-store",
    });
    const value: unknown = await response.json();
    if (!response.ok) throw new Error(responseError(value, "狀態讀取失敗。"));
    if (!isRecord(value)) throw new Error("狀態回應格式不正確。");
    return value.status === null ? null : readStatus(value.status);
  }

  async function load() {
    const ticket = ++generation.current;
    setBusy(true);
    setError("");
    try {
      const current = await readCurrentStatus();
      if (ticket !== generation.current) return;
      setStatus(current);
      setDraft(pending.current ? draftFromChange(pending.current) : draftFrom(current));
      setLoaded(true);
    } catch (cause) {
      if (ticket === generation.current) {
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }

  async function save(clear = false) {
    if (busy) return;
    const ticket = ++generation.current;
    setBusy(true);
    setError("");
    setNotice("");
    try {
      const nextDraft = clear ? { ...emptyDraft, expectedVersion: draft.expectedVersion } : draft;
      const fresh = commandFrom(nextDraft, crypto.randomUUID());
      const command =
        pending.current && commandPayload(pending.current) === commandPayload(fresh)
          ? pending.current
          : fresh;
      if (pending.current && pending.current !== command) {
        throw new Error("上一筆狀態更新結果尚待確認；請保留原內容重試或先重新載入。");
      }
      pending.current = command;
      const response = await fetch("/api/profile/status", {
        method: "POST",
        headers: {
          "X-App-Session-Generation": token,
          "content-type": "application/json",
        },
        body: JSON.stringify(command),
      });
      if (ticket !== generation.current) return;
      const value: unknown = await response.json();
      if (ticket !== generation.current) return;
      if (!response.ok) {
        const cause = new Error(responseError(value, "狀態更新失敗。"));
        if (response.status === 409) {
          const current = await readCurrentStatus();
          if (ticket !== generation.current) return;
          pending.current = null;
          setStatus(current);
          setDraft(draftFrom(current));
          setLoaded(true);
          setError(cause.message);
          return;
        }
        if (response.status < 500) pending.current = null;
        throw cause;
      }
      if (!isRecord(value)) throw new Error("狀態更新回應格式不正確。");
      const changed = readChangedStatus(value.status);
      if (changed.requestId !== command.requestId) {
        throw new Error("狀態更新結果無法確認；重試會沿用相同操作編號。");
      }
      const current = await readCurrentStatus();
      if (ticket !== generation.current) return;
      pending.current = null;
      setStatus(current);
      setDraft(draftFrom(current));
      setLoaded(true);
      setEditing(false);
      setNotice(clear ? "狀態已清除。" : "狀態已更新。");
    } catch (cause) {
      if (ticket === generation.current) {
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }

  const onVisibilityChange = useEffectEvent(() => {
    if (document.visibilityState === "hidden") clearLocal();
    else void load();
  });
  const loadCurrent = useEffectEvent(() => load());
  const clearCurrent = useEffectEvent(() => clearLocal());

  useEffect(() => {
    if (pendingToken.current !== token) {
      pending.current = null;
      pendingToken.current = token;
      clearCurrent();
    }
    void loadCurrent();
    const visibility = () => onVisibilityChange();
    document.addEventListener("visibilitychange", visibility);
    return () => {
      generation.current++;
      document.removeEventListener("visibilitychange", visibility);
    };
  }, [token]);

  useEffect(() => {
    setDisplayNow(Date.now());
    if (status?.expiresAt === null || status?.expiresAt === undefined) return;
    let timeout = 0;
    const updateAtExpiration = () => {
      const delay = status.expiresAt ? status.expiresAt - Date.now() : 0;
      if (delay <= 0) {
        setDisplayNow(Date.now());
        return;
      }
      timeout = window.setTimeout(updateAtExpiration, Math.min(delay + 50, 2_147_483_647));
    };
    updateAtExpiration();
    return () => window.clearTimeout(timeout);
  }, [status?.expiresAt]);

  if (!loaded) {
    return (
      <div className={styles.panel}>
        {busy && <p role="status">正在確認狀態…</p>}
        {error && <p role="alert">{error}</p>}
        {!busy && (
          <button type="button" className="secondary" onClick={() => void load()}>
            重新載入狀態
          </button>
        )}
      </div>
    );
  }

  const visible = Boolean(
    status &&
      (status.message || status.emoji || status.limitedAvailability) &&
      (status.expiresAt === null || status.expiresAt > displayNow),
  );
  const summary = visible
    ? [status?.emoji, status?.message || (status?.limitedAvailability ? "忙碌中" : "")]
        .filter(Boolean)
        .join(" ")
    : "Set your status";

  return (
    <div className={styles.panel}>
      <button
        type="button"
        className={styles.summary}
        aria-label="Set your status"
        aria-expanded={editing}
        onClick={() => {
          setDraft(pending.current ? draftFromChange(pending.current) : draftFrom(status));
          setEditing((value) => !value);
        }}
      >
        <span aria-hidden="true">{visible ? "💬" : "☺"}</span>
        <span>{summary}</span>
        <span className={styles.edit} aria-hidden="true">
          ✎
        </span>
      </button>
      {editing && (
        <form
          className={styles.editor}
          onSubmit={(event) => {
            event.preventDefault();
            void save();
          }}
        >
          <p>此狀態會公開顯示於你的 Profile。</p>
          <label>
            表情
            <input
              maxLength={64}
              value={draft.emoji}
              onChange={(event) => setDraft({ ...draft, emoji: event.target.value })}
              placeholder="例如 🎯"
            />
          </label>
          <label>
            狀態訊息
            <input
              maxLength={80}
              value={draft.message}
              onChange={(event) => setDraft({ ...draft, message: event.target.value })}
              placeholder="你正在做什麼？"
            />
          </label>
          <label className={styles.checkbox}>
            <input
              type="checkbox"
              checked={draft.limitedAvailability}
              onChange={(event) =>
                setDraft({ ...draft, limitedAvailability: event.target.checked })
              }
            />
            顯示忙碌中
          </label>
          <label>
            到期時間（選填）
            <input
              type="datetime-local"
              value={draft.expiresAt}
              onChange={(event) => setDraft({ ...draft, expiresAt: event.target.value })}
            />
          </label>
          {error && <p role="alert">{error}</p>}
          {notice && <p role="status">{notice}</p>}
          <div className={styles.actions}>
            <button type="submit" disabled={busy}>
              {busy ? "正在更新…" : "更新狀態"}
            </button>
            <button type="button" disabled={busy} onClick={() => void save(true)}>
              清除狀態
            </button>
            <button type="button" disabled={busy} onClick={() => void load()}>
              重新載入
            </button>
            <button
              type="button"
              disabled={busy}
              onClick={() => {
                setDraft(pending.current ? draftFromChange(pending.current) : draftFrom(status));
                setEditing(false);
              }}
            >
              取消
            </button>
          </div>
        </form>
      )}
      {!editing && error && <p role="alert">{error}</p>}
      {!editing && notice && <p role="status">{notice}</p>}
    </div>
  );
}
</file>

<file path="apps/web/src/modules/account/use-user.ts">
"use client";

import type { UserUseCases } from "@line_bot_v1/account/application/user";
import { isRecord } from "@line_bot_v1/platform/validation";
import { useEffect, useEffectEvent, useRef, useState } from "react";
import { liffClient } from "../../shared/browser/liff-client";
import type { AppSessionGeneration } from "../../shared/browser/line-service-session";
import { clearCurrentAccount, readCurrentAccount } from "./current-account";
import { responseError } from "./wire-response";

type AccountView = NonNullable<Awaited<ReturnType<UserUseCases["getUser"]>>>;
type MembershipWireResponse = { member: AccountView | null };

/** Current-viewer Account lifecycle for Settings/onboarding; DailyCheckIn has its own Web module. */
export function useUser(liffId: string) {
  const request = useRef<AbortController | null>(null);
  const mounted = useRef(true);
  const [pending, setPending] = useState<{
    id: string;
    email: string | null;
    expiresAt: number;
  } | null>(null);
  const [user, setUser] = useState<AccountView | null>(null);
  const [token, setToken] = useState<AppSessionGeneration | "">("");
  const [busy, setBusy] = useState(true);
  const [lineName, setLineName] = useState("");
  const [inClient, setInClient] = useState(false);
  const [error, setError] = useState("");
  const [pauseConfirmation, setPauseConfirmation] = useState(false);
  const [notice, setNotice] = useState("");

  useEffect(() => {
    mounted.current = true;
    return () => {
      mounted.current = false;
      request.current?.abort();
      clearCurrentAccount();
    };
  }, []);

  function begin() {
    request.current?.abort();
    const controller = new AbortController();
    request.current = controller;
    setBusy(true);
    setError("");
    return controller.signal;
  }

  async function load(access: AppSessionGeneration, signal: AbortSignal) {
    const headers = { "X-App-Session-Generation": access };
    signal.throwIfAborted();
    const current = await readCurrentAccount(access, signal);
    const account = current.member;
    setUser(account);
    if (account?.status === "active") {
      const response = await fetch("/api/membership/google-link", {
        headers,
        cache: "no-store",
        signal,
      });
      const link = await response.json();
      signal.throwIfAborted();
      if (!response.ok) throw new Error(typeof link.error === "string" ? link.error : JSON.stringify(link));
      setPending(link.pending);
    } else {
      setPending(null);
    }
  }

  async function initialize() {
    if (!mounted.current) return;
    const signal = begin();
    setUser(null);
    setToken("");
    setLineName("");
    setPauseConfirmation(false);
    setPending(null);
    try {
      if (!liffId) throw new Error("會員入口尚未設定。");
      const access = await liffClient.ensureSession(liffId);
      signal.throwIfAborted();
      if (!access) return;
      setInClient(liffClient.inClient());
      setToken(access);
      // Provider profile is presentation only; Account qualification never waits for it.
      void liffClient.profile().then(
        (profile) => {
          if (!signal.aborted) setLineName(profile.displayName);
        },
        () => {
          // Keep the fallback name when optional provider presentation is unavailable.
        },
      );
      await load(access, signal);
    } catch (cause) {
      if (signal.aborted) return;
      setError(cause instanceof Error ? cause.message : String(cause));
    } finally {
      if (!signal.aborted) setBusy(false);
    }
  }

  async function refresh() {
    if (!token) return initialize();
    clearCurrentAccount();
    const signal = begin();
    try {
      await load(token, signal);
    } catch (cause) {
      if (signal.aborted) return;
      setError(cause instanceof Error ? cause.message : String(cause));
    } finally {
      if (!signal.aborted) setBusy(false);
    }
  }

  const onResume = useEffectEvent(() => {
    if (document.visibilityState === "hidden") clearCurrentAccount();
    else void refresh();
  });

  useEffect(() => {
    if (!token || !inClient || busy) return;
    const resume = () => onResume();
    document.addEventListener("visibilitychange", resume);
    return () => document.removeEventListener("visibilitychange", resume);
  }, [token, inClient, busy]);

  async function googleLink(action: "start" | "confirm" | "cancel" | "unlink") {
    const signal = begin();
    try {
      const access = await liffClient.ensureSession(liffId);
      signal.throwIfAborted();
      if (!access) return;
      const response = await fetch("/api/membership/google-link", {
        method: "POST",
        signal,
        headers: { "X-App-Session-Generation": access, "Content-Type": "application/json" },
        body: JSON.stringify({ action, id: pending?.id }),
      });
      const data = await response.json();
      signal.throwIfAborted();
      if (!response.ok) throw new Error(typeof data.error === "string" ? data.error : JSON.stringify(data));
      if (action === "start") {
        const url = `${location.origin}/google-link#request=${encodeURIComponent(data.token)}`;
        if (liffClient.inClient()) liffClient.openExternal(url);
        else location.assign(url);
      }
      if (action === "confirm") setNotice("Google 綁定完成。");
      if (action === "unlink") setNotice("Google 綁定已解除；LINE 身分與既有資料保持不變。");
      clearCurrentAccount();
      await load(access, signal);
    } catch (cause) {
      if (!signal.aborted)
        setError(cause instanceof Error ? cause.message : String(cause));
    } finally {
      if (!signal.aborted) setBusy(false);
    }
  }

  async function action(action: "register" | "restore" | "deactivate", input?: { login?: string }) {
    const signal = begin();
    setNotice("");
    try {
      const access = token || (await liffClient.ensureSession(liffId));
      signal.throwIfAborted();
      if (!access) throw new Error("請完成 LINE 登入。");
      const headers = { "X-App-Session-Generation": access };
      signal.throwIfAborted();
      const endpoint =
        action === "register" || action === "restore"
          ? `/api/membership/${action}`
          : "/api/membership";
      const result = await fetch(endpoint, {
        method: "POST",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify(
          action === "register" ? { login: input?.login } : action === "restore" ? {} : { action },
        ),
        signal,
      });
      const data: unknown = await result.json();
      signal.throwIfAborted();
      if (!result.ok) throw new Error(responseError(data, "操作失敗，請重試。"));
      if (!isRecord(data) || !("member" in data)) throw new Error("會員回應格式不完整。");
      if (action === "register" || action === "restore")
        setNotice("會員已開通，可以使用工作功能。");
      clearCurrentAccount();
      await load(access, signal);
      setPauseConfirmation(false);
    } catch (cause) {
      if (signal.aborted) return;
        setError(cause instanceof Error ? cause.message : String(cause));
      try {
        const access = token || (await liffClient.ensureSession(liffId));
        if (access && !signal.aborted) {
          clearCurrentAccount();
          await load(access, signal);
        }
      } catch {
        // Keep the original operation error; explicit refresh remains available.
      }
    } finally {
      if (!signal.aborted) setBusy(false);
    }
  }

  return {
    user,
    token,
    busy,
    lineName,
    inClient,
    error,
    pauseConfirmation,
    notice,
    initialize,
    refresh,
    action,
    pending,
    googleLink,
    setBusy,
    setError,
    setPauseConfirmation,
  };
}
