.home-heading-action {
  display: inline-grid;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--green-strong);
  text-decoration: none;
  cursor: pointer;
}

.app-content button.home-heading-action {
  width: 44px;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--green-strong);
