export type ContentPlanRevisionDto = Readonly<{
  revisionId: string;
  repositoryId: string;
  version: number;
  parentRevisionId: string | null;
  actorUserId: string;
  at: number;
  action: "initialize" | "replace" | "import-file" | "import-contract-document";
