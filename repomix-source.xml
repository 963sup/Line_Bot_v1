<file path="packages/intelligence/src/adapters/outbound/persistence/document-attempts.ts">
import { randomUUID } from "node:crypto";
import type { FileRevisionQualifier } from "@line_bot_v1/file/contracts/output/references";
import {
  businessDatabase,
  type Database,
  type Sql,
  type SqlRow,
} from "@line_bot_v1/platform/postgres";
import { stringValue } from "@line_bot_v1/platform/validation";
import type {
  DocumentAttempt,
  DocumentAttemptInput,
  DocumentAttempts,
} from "../../../contracts/output/document-attempts.js";
import { DocumentAttemptError as AttemptError } from "../../../contracts/output/document-attempts.js";

const uuid = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i;
const sha256 = /^[0-9a-f]{64}$/;

type StoredAttempt = Readonly<{
  id: string;
  actor: string;
  requestId: string;
  repositoryId: string;
  fileId: string;
  fileRevisionId: string;
  fileSha256: string;
  intentFingerprint: string;
  state: "STARTED" | "UNKNOWN" | "COMPLETED";
  targetDocumentId: string | null;
  targetRevisionId: string | null;
}>;

function invalid(): never {
  throw new AttemptError(400, "INVALID_ATTEMPT");
}

function identifier(value: unknown): string {
  if (typeof value !== "string" || !uuid.test(value)) return invalid();
  return value.toLowerCase();
}

function targetReference(value: unknown): string {
  if (typeof value !== "string" || !value.trim() || value.length > 256 || value.includes("\u0000"))
    return invalid();
  return value;
}

function input(value: DocumentAttemptInput): DocumentAttemptInput {
  if (
    typeof value.repositoryId !== "string" ||
    !value.repositoryId.trim() ||
    value.repositoryId.length > 128 ||
    typeof value.intentFingerprint !== "string" ||
    !sha256.test(value.intentFingerprint) ||
    typeof value.source.fileSha256 !== "string" ||
    !sha256.test(value.source.fileSha256)
  )
    return invalid();
  return {
    requestId: identifier(value.requestId),
    repositoryId: value.repositoryId,
    source: {
      fileId: identifier(value.source.fileId),
      fileRevisionId: identifier(value.source.fileRevisionId),
      fileSha256: value.source.fileSha256,
    },
    intentFingerprint: value.intentFingerprint,
  };
}

function decode(row: SqlRow): StoredAttempt {
  const state = stringValue(row.state);
  if (state !== "STARTED" && state !== "UNKNOWN" && state !== "COMPLETED")
    throw new TypeError("Invalid document attempt state.");
  return {
    id: stringValue(row.id),
    actor: stringValue(row.actor_user_id),
    requestId: stringValue(row.request_id),
    repositoryId: stringValue(row.repository_id),
    fileId: stringValue(row.file_id),
    fileRevisionId: stringValue(row.file_revision_id),
    fileSha256: stringValue(row.file_sha256),
    intentFingerprint: stringValue(row.intent_fingerprint),
    state,
    targetDocumentId: row.target_document_id === null ? null : stringValue(row.target_document_id),
    targetRevisionId: row.target_revision_id === null ? null : stringValue(row.target_revision_id),
  };
}

function same(attempt: StoredAttempt, actor: string, value: DocumentAttemptInput): boolean {
  return (
    attempt.actor === actor &&
    attempt.requestId === value.requestId &&
    attempt.repositoryId === value.repositoryId &&
    attempt.fileId === value.source.fileId &&
    attempt.fileRevisionId === value.source.fileRevisionId &&
    attempt.fileSha256 === value.source.fileSha256 &&
    attempt.intentFingerprint === value.intentFingerprint
  );
}

async function lock(sql: Sql, actor: string, requestId: string) {
  await sql.query("SELECT pg_advisory_xact_lock(hashtext($1))", [
    `intelligence-document-attempt:${actor}:${requestId}`,
  ]);
}

async function load(sql: Sql, actor: string, requestId: string): Promise<StoredAttempt | null> {
  return (
    (
      await sql.query(
        `SELECT id,actor_user_id,request_id,repository_id,file_id,file_revision_id,file_sha256,
              intent_fingerprint,state,target_document_id,target_revision_id
       FROM intelligence_document_intakes WHERE actor_user_id=$1 AND request_id=$2 FOR UPDATE`,
        [actor, requestId],
        decode,
      )
    ).rows[0] ?? null
  );
}

class PostgresDocumentAttempts implements DocumentAttempts {
  constructor(
    private readonly qualifier: (sql: Sql) => FileRevisionQualifier,
    private readonly db: Database = businessDatabase(),
  ) {}

  async reserve(actor: string, raw: DocumentAttemptInput): Promise<DocumentAttempt> {
    const value = input(raw);
    return this.db.transaction(async (sql) => {
      await this.qualifier(sql).verify(actor, value.repositoryId, value.source);
      await lock(sql, actor, value.requestId);
      const prior = await load(sql, actor, value.requestId);
      if (prior) {
        if (!same(prior, actor, value)) throw new AttemptError(409, "REQUEST_ID_REUSED");
        return { id: prior.id, fresh: false };
      }
      const id = randomUUID();
      await sql.query(
        `INSERT INTO intelligence_document_intakes(
          id,actor_user_id,request_id,repository_id,file_id,file_revision_id,file_sha256,intent_fingerprint,state
        ) VALUES($1,$2,$3,$4,$5,$6,$7,$8,'STARTED')`,
        [
          id,
          actor,
          value.requestId,
          value.repositoryId,
          value.source.fileId,
          value.source.fileRevisionId,
          value.source.fileSha256,
          value.intentFingerprint,
        ],
      );
      return { id, fresh: true };
    });
  }

  async complete(
    actor: string,
    raw: DocumentAttemptInput & Readonly<{ id: string }>,
    target: Readonly<{ documentId: string; revisionId: string }>,
  ): Promise<void> {
    const value = input(raw);
    const id = identifier(raw.id);
    const documentId = targetReference(target.documentId);
    const revisionId = targetReference(target.revisionId);
    await this.db.transaction(async (sql) => {
      await this.qualifier(sql).verify(actor, value.repositoryId, value.source);
      await lock(sql, actor, value.requestId);
      const prior = await load(sql, actor, value.requestId);
      if (!prior || !same(prior, actor, value) || prior.id !== id)
        throw new AttemptError(409, "ATTEMPT_FENCED");
      if (prior.state === "COMPLETED") {
        if (prior.targetDocumentId !== documentId || prior.targetRevisionId !== revisionId)
          throw new AttemptError(409, "COMPLETION_CONFLICT");
        return;
      }
      await sql.query(
        `UPDATE intelligence_document_intakes
         SET state='COMPLETED',target_document_id=$3,target_revision_id=$4
         WHERE actor_user_id=$1 AND request_id=$2 AND id=$5 AND state IN ('STARTED','UNKNOWN')`,
        [actor, value.requestId, documentId, revisionId, id],
      );
    });
  }

  async unknown(
    actor: string,
    raw: DocumentAttemptInput & Readonly<{ id: string }>,
  ): Promise<void> {
    const value = input(raw);
    const id = identifier(raw.id);
    await this.db.transaction(async (sql) => {
      await this.qualifier(sql).verify(actor, value.repositoryId, value.source);
      await lock(sql, actor, value.requestId);
      const prior = await load(sql, actor, value.requestId);
      if (!prior || !same(prior, actor, value) || prior.id !== id)
        throw new AttemptError(409, "ATTEMPT_FENCED");
      if (prior.state === "COMPLETED") return;
      await sql.query(
        `UPDATE intelligence_document_intakes SET state='UNKNOWN'
         WHERE actor_user_id=$1 AND request_id=$2 AND id=$3 AND state IN ('STARTED','UNKNOWN')`,
        [actor, value.requestId, id],
      );
    });
  }
}

/** Composition hosts may inject a database; this adapter owns its technical receipt wiring. */
export function createPostgresDocumentAttempts(
  qualifier: (sql: Sql) => FileRevisionQualifier,
  db: Database = businessDatabase(),
): DocumentAttempts {
  return new PostgresDocumentAttempts(qualifier, db);
}
</file>

<file path="packages/intelligence/src/adapters/outbound/persistence/extraction-json-storage.ts">
import { createPrivateStorageClient } from "@line_bot_v1/integration-supabase/storage-client";
import type { CommercialExtractionResult } from "../../../contracts/output/commercial-intake.js";

const bucketName = "repository-files";

/** Durable, immutable recovery copy. The Contract revision remains the business write authority. */
export function createSupabaseExtractionJsonStore(config: {
  url: string;
  serviceRoleKey: string;
}) {
  const bucket = createPrivateStorageClient(config).storage.from(bucketName);
  return async (input: {
    actorUserId: string;
    repositoryId: string;
    extractionResultId: string;
    result: CommercialExtractionResult;
  }): Promise<void> => {
    const repositoryKey = createHash("sha256").update(input.repositoryId).digest("hex");
    const key = `commercial-extractions/${repositoryKey}/${input.extractionResultId}.json`;
    const body = new TextEncoder().encode(JSON.stringify({
      version: 1,
      actorUserId: input.actorUserId,
      repositoryId: input.repositoryId,
      extractionResultId: input.extractionResultId,
      result: input.result,
    }));
    const uploaded = await bucket.upload(key, body, {
      upsert: false,
      contentType: "application/json",
      cacheControl: "31536000",
    });
    const storageError = uploaded.error as { message?: string; statusCode?: string } | null;
    if (
      storageError &&
      storageError.statusCode !== "409" &&
      !/already exists|duplicate/i.test(storageError.message ?? "")
    )
      throw uploaded.error;
  };
}
import { createHash } from "node:crypto";
</file>

<file path="packages/intelligence/src/adapters/outbound/persistence/legacy-processing.ts">
import { businessDatabase, type Database } from "@line_bot_v1/platform/postgres";
import { repositoryContentScope } from "@line_bot_v1/repository/postgres/content-scope";
import type { LegacyProcessingHistory } from "../../../contracts/output/processing.js";

/** Reads retained pre-cutover processing evidence; current writes use Intelligence tables. */
export class PostgresLegacyProcessingHistory implements LegacyProcessingHistory {
  constructor(private readonly db: Database = businessDatabase()) {}

  read(actor: string, repositoryId: string, runId: string, revisionId?: string) {
    return this.db.transaction(async (sql) => {
      await repositoryContentScope(sql, actor, { repositoryId });
      const result = await sql.query(
        `SELECT revision.* FROM intelligence_legacy_processing_runs run JOIN intelligence_legacy_processing_revisions revision
          ON revision.repository_id=run.repository_id AND revision.run_id=run.id
         WHERE run.repository_id=$1 AND run.id=$2 AND (($3::uuid IS NULL AND revision.id=run.head_revision_id) OR revision.id=$3)`,
        [repositoryId, runId, revisionId ?? null],
      );
      return result.rows[0] ?? null;
    });
  }

  list(actor: string, repositoryId: string, fileId: string, after?: string) {
    return this.db.transaction(async (sql) => {
      await repositoryContentScope(sql, actor, { repositoryId });
      return (
        await sql.query(
          `SELECT revision.* FROM intelligence_legacy_processing_runs run JOIN intelligence_legacy_processing_revisions revision
            ON revision.repository_id=run.repository_id AND revision.run_id=run.id AND revision.id=run.head_revision_id
           WHERE run.repository_id=$1 AND run.file_id=$2 AND ($3::uuid IS NULL OR revision.run_id>$3)
           ORDER BY revision.run_id LIMIT 21`,
          [repositoryId, fileId, after ?? null],
        )
      ).rows;
    });
  }
}
</file>

<file path="packages/intelligence/src/adapters/outbound/commercial-extractor.ts">
import {
  createOpenAIStructuredOutput,
  OpenAIOutputError,
} from "@line_bot_v1/integration-openai/structured-output";
import {
  commercialExtractionPrompt,
  commercialObservationSchema,
} from "../../application/commercial-profile.js";
import { CommercialIntakeError } from "../../contracts/output/commercial-intake.js";
import type { ExtractionProfile } from "../../contracts/ports/commercial-intake.js";

type ExtractionInput = {
  bytes: Uint8Array;
  mediaType: string;
  profile: ExtractionProfile;
  timeoutMs?: number;
};
function providerInput(input: ExtractionInput) {
  return {
    ...input.profile,
    schema: commercialObservationSchema,
    system: commercialExtractionPrompt,
    text: "Extract the complete source document, preserving every logical item, field and term.",
    bytes: input.bytes,
    mediaType: input.mediaType,
    timeoutMs: input.timeoutMs ?? input.profile.timeoutMs,
  };
}
export function createCommercialExtractor() {
  return {
    async countInputTokens(input: ExtractionInput): Promise<number> {
      const provider = createOpenAIStructuredOutput({ model: input.profile.model });
      return provider.countInputTokens({
        ...providerInput(input),
        timeoutMs: input.profile.inputTokenCountTimeoutMs,
      });
    },
    async extract(input: {
      bytes: Uint8Array;
      mediaType: string;
      profile: ExtractionProfile;
      timeoutMs: number;
    }): Promise<unknown> {
      const provider = createOpenAIStructuredOutput({ model: input.profile.model });
      try {
        return await provider.generate(providerInput(input));
      } catch (error) {
        if (error instanceof OpenAIOutputError && error.code !== "UNAVAILABLE") {
          const code =
            error.code === "REFUSAL"
              ? "EXTRACTION_REFUSED"
              : error.code === "INCOMPLETE"
                ? "EXTRACTION_INCOMPLETE"
                : "EXTRACTION_OUTPUT_INVALID";
          throw new CommercialIntakeError(code, 422, "extraction.provider", { cause: error });
        }
        throw new CommercialIntakeError("EXTRACTION_OUTCOME_UNKNOWN", 503, "extraction.provider", {
          cause: error,
        });
      }
    },
  };
}
</file>

<file path="packages/intelligence/src/contracts/output/document-attempts.ts">
import type { FileSourceReference } from "@line_bot_v1/file/contracts/output/references";

export type DocumentAttemptInput = Readonly<{
  requestId: string;
  repositoryId: string;
  source: FileSourceReference;
  intentFingerprint: string;
}>;

export type DocumentAttempt = Readonly<{
  id: string;
  fresh: boolean;
}>;

export type DocumentAttemptErrorCode =
  | "INVALID_ATTEMPT"
  | "REQUEST_ID_REUSED"
  | "ATTEMPT_FENCED"
  | "COMPLETION_CONFLICT";

export class DocumentAttemptError extends Error {
  constructor(
    readonly status: 400 | 409,
    readonly code: DocumentAttemptErrorCode,
  ) {
    super(code);
    this.name = "DocumentAttemptError";
  }
}

/** Technical recovery record only; Contract remains the owner of candidate and formal facts. */
export interface DocumentAttempts {
  reserve(actor: string, input: DocumentAttemptInput): Promise<DocumentAttempt>;
  complete(
    actor: string,
    input: DocumentAttemptInput & Readonly<{ id: string }>,
    target: Readonly<{ documentId: string; revisionId: string }>,
  ): Promise<void>;
  unknown(actor: string, input: DocumentAttemptInput & Readonly<{ id: string }>): Promise<void>;
}
