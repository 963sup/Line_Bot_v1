<file path="apps/web/src/modules/repository/wbs-panel.tsx">
"use client";

import { parseWbsCommand } from "@line_bot_v1/wbs/application/commands/content";
import type { WbsCommand, WbsHistory, WbsView } from "@line_bot_v1/wbs/contracts/dto/content";
import type { WbsScopeTransfer } from "@line_bot_v1/wbs/contracts/dto/transfer";
import type { WbsEdit, WbsNode } from "@line_bot_v1/wbs/domain/document";
import Link from "next/link";
import { useCallback, useEffect, useEffectEvent, useRef, useState } from "react";
import { liffClient } from "../../shared/browser/liff-client";
import MiniAppRuntime from "../../shared/browser/mini-app-runtime";
import RepositoryPageHeader from "./repository-page-header";
import WbsGovernancePanel from "./wbs-governance-panel";
import styles from "./wbs-panel.module.css";
import { wbsHistory, wbsReceipt, wbsView } from "./wbs-response";
import WbsTransferPanel from "./wbs-transfer-panel";
import { parseWbsScopeTransfer } from "./wbs-transfer-state";

type Pending = { actor: string; command: WbsCommand };
export default function WbsPanel({
  liffId,
  ownerLogin,
  repositoryName,
}: {
  liffId: string;
  ownerLogin: string;
  repositoryName: string;
}) {
  const [view, setView] = useState<WbsView | null>(null);
  const [retired, setRetired] = useState(false);
  const [transfer, setTransfer] = useState<WbsScopeTransfer | null>(null);
  const [draft, setDraft] = useState<WbsNode | null>(null);
  const [creating, setCreating] = useState(false);
  const [history, setHistory] = useState<WbsHistory | null>(null);
  const [historical, setHistorical] = useState(false);
  const [moveParent, setMoveParent] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [pending, setPending] = useState<Pending | null>(null);
  const generation = useRef(0);
  const locked = useRef(false);
  const current = useRef<WbsView | null>(null);
  const lastActor = useRef<string | null>(null);
  const pendingRef = useRef<Pending | null>(null);
  const storageKey = `wbs:${ownerLogin.toLowerCase()}/${repositoryName.toLowerCase()}`;
  const query = new URLSearchParams({ owner: ownerLogin, name: repositoryName }).toString();
  const endpoint = `/api/repository-wbs?${query}`;

  function remember(value: Pending | null) {
    pendingRef.current = value;
    setPending(value);
    if (value) sessionStorage.setItem(storageKey, JSON.stringify(value));
    else sessionStorage.removeItem(storageKey);
  }
  async function request(url: string, command?: WbsCommand) {
    const token = await liffClient.ensureSession(liffId);
    if (!token) throw new Error("請完成 LINE 登入。");
    const response = await fetch(url, {
      method: command ? "POST" : "GET",
      cache: "no-store",
      headers: {
        "X-App-Session-Generation": token,
        ...(command ? { "Content-Type": "application/json" } : {}),
      },
      ...(command ? { body: JSON.stringify(command) } : {}),
    });
    const body: unknown = await response.json();
    if (!response.ok) {
      const message =
        body && typeof body === "object" && "error" in body && typeof body.error === "string"
          ? body.error
          : "WBS 服務暫時不可用。";
      throw Object.assign(new Error(message), { status: response.status });
    }
    return body;
  }
  const load = useCallback(async () => {
    const ticket = ++generation.current;
    setBusy(true);
    setError("");
    setTransfer(null);
    setRetired(false);
    try {
      const token = await liffClient.ensureSession(liffId);
      if (!token) throw new Error("請完成 LINE 登入。");
      const response = await fetch(endpoint, {
        cache: "no-store",
        headers: { "X-App-Session-Generation": token },
      });
      const body: unknown = await response.json();
      if (ticket !== generation.current) return;
      if (response.status === 410) {
        current.current = null;
        pendingRef.current = null;
        setView(null);
        setDraft(null);
        setHistory(null);
        setPending(null);
        setRetired(true);
        const destination = await fetch(
          `/api/repository-wbs/transfer?${new URLSearchParams({ owner: ownerLogin, name: repositoryName })}`,
          {
            cache: "no-store",
            headers: { "X-App-Session-Generation": token },
          },
        );
        const incoming: unknown = await destination.json();
        if (ticket !== generation.current) return;
        if (!destination.ok)
          throw Object.assign(
            new Error(
              incoming &&
                typeof incoming === "object" &&
                "error" in incoming &&
                typeof incoming.error === "string"
                ? incoming.error
                : "無法讀取目前的 WBS 移轉狀態，請確認來源存取權後重試。",
            ),
            {
              status: destination.status,
            },
          );
        if (incoming !== null) {
          const active = parseWbsScopeTransfer(incoming);
          if (active.state !== "ACTIVE") throw new Error("WBS 移轉狀態尚待確認，請重新載入。");
          setTransfer(active);
        }
        return;
      }
      if (!response.ok)
        throw Object.assign(
          new Error(
            body && typeof body === "object" && "error" in body && typeof body.error === "string"
              ? body.error
              : "WBS 讀取失敗。",
          ),
          { status: response.status },
        );
      const next = wbsView(body);
      if (ticket !== generation.current) return;
      if (lastActor.current && lastActor.current !== next.actorUserId) {
        setDraft(null);
        setHistory(null);
        pendingRef.current = null;
        setPending(null);
      }
      current.current = next;
      lastActor.current = next.actorUserId;
      setView(next);
      setHistorical(false);
      try {
        const raw = sessionStorage.getItem(storageKey);
        if (raw) {
          const saved: unknown = JSON.parse(raw);
          if (
            saved &&
            typeof saved === "object" &&
            "actor" in saved &&
            saved.actor === next.actorUserId &&
            "command" in saved
          ) {
            const command = parseWbsCommand(saved.command);
            if (command.repositoryId !== next.repository.id) throw new Error();
            pendingRef.current = { actor: next.actorUserId, command };
            setPending(pendingRef.current);
          } else if (raw) sessionStorage.removeItem(storageKey);
        }
      } catch {
        sessionStorage.removeItem(storageKey);
      }
    } catch (cause) {
      if (ticket === generation.current) {
        if (
          cause &&
          typeof cause === "object" &&
          "status" in cause &&
          [401, 403, 404].includes(Number(cause.status))
        ) {
          setHistory(null);
          setDraft(null);
          setPending(null);
          pendingRef.current = null;
          try {
            sessionStorage.removeItem(storageKey);
          } catch {
            /* State is already cleared in memory. */
          }
        }
        setError(cause instanceof Error ? cause.message : String(cause));
        setView(null);
        current.current = null;
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }, [endpoint, liffId, storageKey, ownerLogin, repositoryName]);

  async function execute(edit?: WbsEdit) {
    const source = current.current;
    if (!source || locked.current || historical) return;
    locked.current = true;
    const ticket = generation.current;
    setBusy(true);
    setError("");
    setNotice("");
    try {
      const saved = pendingRef.current;
      const operation =
        saved ??
        (edit
          ? {
              actor: source.actorUserId,
              command: {
                ...edit,
                repositoryId: source.repository.id,
                expectedVersion: source.version,
                requestId: crypto.randomUUID(),
              },
            }
          : null);
      if (!operation) return;
      // Bind exact retries to the currently verified User; a changed session must never replay another User's operation.
      const verified = wbsView(await request(endpoint));
      if (ticket !== generation.current) return;
      if (
        verified.actorUserId !== operation.actor ||
        verified.repository.id !== operation.command.repositoryId
      ) {
        clear();
        throw new Error("登入身分已改變，請重新載入。");
      }
      remember(operation);
      const receipt = wbsReceipt(await request("/api/repository-wbs", operation.command));
      if (ticket !== generation.current) return;
      if (
        receipt.requestId !== operation.command.requestId ||
        receipt.repositoryId !== source.repository.id
      )
        throw new Error("儲存結果無法確認，請重試原操作。");
      remember(null);
      setDraft(null);
      setHistory(null);
      setNotice("草稿已儲存；正式範圍須經提案審查後發布。");
      await load();
    } catch (cause) {
      if (ticket !== generation.current) return;
      const status =
        cause && typeof cause === "object" && "status" in cause ? cause.status : undefined;
      if (status === 401 || status === 403 || status === 404) {
        remember(null);
        clear();
        setError(cause instanceof Error ? cause.message : String(cause));
        return;
      }
      if (typeof status === "number" && status >= 400 && status < 500) remember(null);
      setError(cause instanceof Error ? cause.message : String(cause));
    } finally {
      locked.current = false;
      if (ticket === generation.current) setBusy(false);
    }
  }
  const clear = useCallback(() => {
    generation.current++;
    current.current = null;
    pendingRef.current = null;
    setView(null);
    setTransfer(null);
    setRetired(false);
    setDraft(null);
    setPending(null);
    setHistory(null);
    setError("");
    setNotice("");
    setBusy(false);
    setHistorical(false);
  }, []);
  const governanceAccessLost = useCallback(
    (message: string) => {
      clear();
      setError(message);
    },
    [clear],
  );
  const onVisibility = useEffectEvent(() => {
    clear();
    if (document.visibilityState === "visible") void load();
  });
  const onBlocked = useEffectEvent(() => clear());
  useEffect(() => {
    const visibility = () => onVisibility();
    const pagehide = () => onBlocked();
    const unsubscribe = liffClient.onSessionBlocked(() => onBlocked());
    document.addEventListener("visibilitychange", visibility);
    window.addEventListener("pagehide", pagehide);
    return () => {
      generation.current++;
      unsubscribe();
      document.removeEventListener("visibilitychange", visibility);
      window.removeEventListener("pagehide", pagehide);
    };
  }, []);
  async function showHistory(before?: number) {
    const ticket = generation.current;
    setBusy(true);
    setError("");
    try {
      const incoming = wbsHistory(
        await request(`/api/repository-wbs/history?${query}${before ? `&before=${before}` : ""}`),
      );
      if (ticket === generation.current)
        setHistory((h) =>
          before && h
            ? { revisions: [...h.revisions, ...incoming.revisions], next: incoming.next }
            : incoming,
        );
    } catch (cause) {
      if (ticket === generation.current) {
        if (
          cause &&
          typeof cause === "object" &&
          "status" in cause &&
          (cause.status === 401 || cause.status === 403 || cause.status === 404)
        ) {
          remember(null);
          clear();
        }
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }
  async function openRevision(id: string) {
    const ticket = ++generation.current;
    setBusy(true);
    setError("");
    try {
      const next = wbsView(await request(`${endpoint}&revisionId=${encodeURIComponent(id)}`));
      if (ticket === generation.current) {
        setView(next);
        setHistorical(true);
        setDraft(null);
      }
    } catch (cause) {
      if (ticket === generation.current) {
        if (
          cause &&
          typeof cause === "object" &&
          "status" in cause &&
          (cause.status === 401 || cause.status === 403 || cause.status === 404)
        ) {
          remember(null);
          clear();
        }
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }
  const nodes = view?.revision?.document.nodes ?? [];
  const editable = Boolean(view?.canEdit && !historical && !pending && !busy);
  function select(node: WbsNode) {
    setDraft({ ...node });
    setCreating(false);
    setMoveParent(node.parentId ?? "");
  }
  function tree(parentId: string | null, prefix = "") {
    return (
      <ol className={styles.tree}>
        {nodes
          .filter((n) => n.parentId === parentId)
          .sort((a, b) => a.position - b.position)
          .map((node, i) => (
            <li key={node.id}>
              <button
                type="button"
                disabled={busy || Boolean(pending)}
                onClick={() => select(node)}
              >
                {prefix}
                {i + 1} {node.title} {node.kind === "WORK_PACKAGE" ? "· 工作包" : ""}
              </button>
              {node.kind === "DELIVERABLE" && tree(node.id, `${prefix}${i + 1}.`)}
            </li>
          ))}
      </ol>
    );
  }
  return (
    <>
      <RepositoryPageHeader
        ownerLogin={view?.repository.ownerLogin ?? ownerLogin}
        repositoryName={view?.repository.name ?? repositoryName}
        active="wbs"
        title="舊 WBS 與移轉"
        canManage={view?.canManageRepository ?? false}
      />
      <MiniAppRuntime liffId={liffId} onReady={load} onWait={clear} />
      <section className={styles.notice} aria-label="WBS 入口">
        <h2>WBS 已由 Project 管理</h2>
        <p>
          新的工作分解結構請在 Project 建立。此頁保留舊 Repository WBS 的既有資料、操作重試與移轉。
        </p>
        <Link href="/projects">前往 Projects</Link>
      </section>
      {retired && (
        <section className={styles.notice} aria-label="WBS 移轉完成">
          <h2>Repository WBS 已停止使用</h2>
          {transfer ? (
            <Link href={`/projects/${encodeURIComponent(transfer.projectId)}/wbs`}>
              開啟 Project WBS
            </Link>
          ) : (
            <p>請從 Projects 開啟目前有權存取的 WBS。</p>
          )}
        </section>
      )}
      {error && (
        <p role="alert" className={styles.notice}>
          {error}
        </p>
      )}
      {notice && <p role="status">{notice}</p>}
      {busy && <p role="status">處理中…</p>}
      {pending && (
        <div className={styles.notice}>
          <p>有一筆結果尚未確認的操作；確認前不能送出新修改。</p>
          <button disabled={busy} onClick={() => void execute()}>
            重試原操作
          </button>
        </div>
      )}
      <div className={styles.actions}>
        <button disabled={busy} onClick={() => void load()}>
          重新載入目前版本
        </button>
        {view?.revision && (
          <button disabled={busy} onClick={() => void showHistory()}>
            查看歷史
          </button>
        )}
      </div>
      {view && !view.revision && (
        <div className={styles.panel}>
          <h2>尚未建立 WBS</h2>
          <p>Repository 不再提供新建 WBS；請前往 Project 建立。</p>
        </div>
      )}
      {view?.archived && <p>Repository 已封存，WBS 僅供讀取。</p>}
      {view?.revision && (
        <>
          <p>
            {historical ? "歷史版本（唯讀）" : "目前版本"}：{view.revision.version}
          </p>
          <div className={styles.layout}>
            <section className={styles.panel} aria-label="WBS 結構">
              {editable && (
                <button
                  onClick={() => {
                    setDraft({
                      id: crypto.randomUUID(),
                      parentId: null,
                      position: nodes.filter((n) => n.parentId === null).length,
                      kind: "WORK_PACKAGE",
                      title: "",
                      description: "",
                      deliverable: "",
                      acceptanceCriteria: "",
                    });
                    setCreating(true);
                  }}
                >
                  新增節點
                </button>
              )}
              {nodes.length ? tree(null) : <p>尚無節點。</p>}
            </section>
            <section className={styles.panel}>
              {draft ? (
                <>
                  <form
                    className={styles.form}
                    onSubmit={(e) => {
                      e.preventDefault();
                      void execute({
                        action: creating ? "create-node" : "update-node",
                        node: draft,
                      });
                    }}
                  >
                    <label>
                      標題
                      <input
                        required
                        maxLength={200}
                        value={draft.title}
                        disabled={!editable}
                        onChange={(e) => setDraft({ ...draft, title: e.target.value })}
                      />
                    </label>
                    <label>
                      類型
                      <select
                        value={draft.kind}
                        disabled={!editable}
                        onChange={(e) =>
                          setDraft({
                            ...draft,
                            kind: e.target.value === "DELIVERABLE" ? "DELIVERABLE" : "WORK_PACKAGE",
                          })
                        }
                      >
                        <option value="DELIVERABLE">交付分解節點</option>
                        <option value="WORK_PACKAGE">工作包</option>
                      </select>
                    </label>
                    {creating && (
                      <label>
                        父節點
                        <select
                          value={draft.parentId ?? ""}
                          disabled={!editable}
                          onChange={(e) =>
                            setDraft({
                              ...draft,
                              parentId: e.target.value || null,
                              position: nodes.filter((n) => n.parentId === (e.target.value || null))
                                .length,
                            })
                          }
                        >
                          <option value="">最上層</option>
                          {nodes
                            .filter((n) => n.kind === "DELIVERABLE")
                            .map((n) => (
                              <option key={n.id} value={n.id}>
                                {n.title}
                              </option>
                            ))}
                        </select>
                      </label>
                    )}
                    <label>
                      說明
                      <textarea
                        maxLength={10000}
                        value={draft.description}
                        disabled={!editable}
                        onChange={(e) => setDraft({ ...draft, description: e.target.value })}
                      />
                    </label>
                    <label>
                      交付成果
                      <textarea
                        maxLength={10000}
                        value={draft.deliverable}
                        disabled={!editable}
                        onChange={(e) => setDraft({ ...draft, deliverable: e.target.value })}
                      />
                    </label>
                    <label>
                      驗收要求
                      <textarea
                        maxLength={10000}
                        value={draft.acceptanceCriteria}
                        disabled={!editable}
                        onChange={(e) => setDraft({ ...draft, acceptanceCriteria: e.target.value })}
                      />
                    </label>
                    {draft.kind === "WORK_PACKAGE" &&
                      (!draft.deliverable.trim() || !draft.acceptanceCriteria.trim()) && (
                        <p>草稿尚缺交付成果或驗收要求。</p>
                      )}
                    {editable && <button type="submit">儲存內容</button>}
                  </form>
                  {!creating && editable && (
                    <div className={styles.actions}>
                      <button
                        onClick={() =>
                          void execute({
                            action: "move-node",
                            nodeId: draft.id,
                            parentId: draft.parentId,
                            position: Math.max(0, draft.position - 1),
                          })
                        }
                      >
                        上移
                      </button>
                      <button
                        onClick={() =>
                          void execute({
                            action: "move-node",
                            nodeId: draft.id,
                            parentId: draft.parentId,
                            position: draft.position + 1,
                          })
                        }
                      >
                        下移
                      </button>
                      <label>
                        移至父節點
                        <select value={moveParent} onChange={(e) => setMoveParent(e.target.value)}>
                          <option value="">最上層</option>
                          {nodes
                            .filter((n) => n.kind === "DELIVERABLE" && n.id !== draft.id)
                            .map((n) => (
                              <option key={n.id} value={n.id}>
                                {n.title}
                              </option>
                            ))}
                        </select>
                      </label>
                      <button
                        onClick={() =>
                          void execute({
                            action: "move-node",
                            nodeId: draft.id,
                            parentId: moveParent || null,
                            position: nodes.filter((n) => n.parentId === (moveParent || null))
                              .length,
                          })
                        }
                      >
                        移動
                      </button>
                      <button
                        onClick={() => {
                          const descendants = new Set([draft.id]);
                          for (let i = 0; i < nodes.length; i++)
                            for (const n of nodes)
                              if (n.parentId && descendants.has(n.parentId)) descendants.add(n.id);
                          if (
                            window.confirm(
                              `刪除「${draft.title}」及其子節點，共 ${descendants.size} 個節點？歷史版本會保留。`,
                            )
                          )
                            void execute({ action: "delete-subtree", nodeId: draft.id });
                        }}
                      >
                        刪除子樹
                      </button>
                    </div>
                  )}
                </>
              ) : (
                <p>選擇節點查看內容，或新增工作包。</p>
              )}
            </section>
          </div>
        </>
      )}
      {view?.revision && !historical && (
        <>
          <WbsGovernancePanel
            key={`${view.actorUserId}:${view.repository.id}:governance`}
            liffId={liffId}
            ownerLogin={ownerLogin}
            repositoryName={repositoryName}
            repositoryId={view.repository.id}
            actorUserId={view.actorUserId}
            draftRevisionId={view.revision.id}
            disabled={busy || Boolean(pending)}
            onAccessLost={governanceAccessLost}
          />
          <WbsTransferPanel
            key={`${view.actorUserId}:${view.repository.id}:transfer`}
            liffId={liffId}
            actorUserId={view.actorUserId}
            repositoryId={view.repository.id}
            repositoryName={view.repository.name}
            sourceVersion={view.version}
            sourceHeadRevisionId={view.revision.id}
            canManageRepository={view.canManageRepository}
            disabled={busy || Boolean(pending)}
          />
        </>
      )}
      {view && history && (
        <section className={styles.panel} aria-label="WBS 歷史">
          <h2>版本歷史</h2>
          <ul>
            {history.revisions.map((r) => (
              <li key={r.id}>
                <button disabled={busy || Boolean(pending)} onClick={() => void openRevision(r.id)}>
                  版本 {r.version} · {r.action} · {new Date(r.at).toLocaleString()}
                </button>
              </li>
            ))}
          </ul>
          {history.next !== null && (
            <button disabled={busy} onClick={() => void showHistory(history.next ?? undefined)}>
              載入更多歷史
            </button>
          )}
        </section>
      )}
    </>
  );
}
</file>

<file path="apps/web/src/modules/repository/wiki-panel.tsx">
"use client";
import { record } from "@line_bot_v1/platform/validation";
import { parseWikiCommand, type WikiCommand } from "@line_bot_v1/wiki/application/commands/pages";
import type { WikiPageSummary } from "@line_bot_v1/wiki/contracts/dto/wiki";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useCallback, useEffect, useEffectEvent, useRef, useState } from "react";
import { liffClient } from "../../shared/browser/liff-client";
import MiniAppRuntime from "../../shared/browser/mini-app-runtime";
import RepositoryPageHeader from "./repository-page-header";
import { repositoryPath } from "./resource-navigation";
import styles from "./wiki-panel.module.css";
import { wikiComparison, wikiHistory, wikiPages, wikiRevision, wikiScope } from "./wiki-response";

type Pending = { actor: string; command: WikiCommand };
export default function WikiPanel({
  liffId,
  ownerLogin,
  repositoryName,
  pageId,
}: {
  liffId: string;
  ownerLogin: string;
  repositoryName: string;
  pageId?: string;
}) {
  const router = useRouter();
  const [scope, setScope] = useState<ReturnType<typeof wikiScope> | null>(null);
  const [head, setHead] = useState<ReturnType<typeof wikiRevision> | null>(null);
  const [shown, setShown] = useState<ReturnType<typeof wikiRevision> | null>(null);
  const [pages, setPages] = useState<WikiPageSummary[]>([]);
  const [next, setNext] = useState<string | null>(null);
  const [history, setHistory] = useState<ReturnType<typeof wikiHistory> | null>(null);
  const [comparison, setComparison] = useState<ReturnType<typeof wikiComparison> | null>(null);
  const [editing, setEditing] = useState(false);
  const [draftVersion, setDraftVersion] = useState<number | null>(null);
  const [title, setTitle] = useState("");
  const [body, setBody] = useState("");
  const [busy, setBusy] = useState(true);
  const [error, setError] = useState("");
  const [pending, setPending] = useState<Pending | null>(null);
  const generation = useRef(0),
    locked = useRef(false),
    scopeRef = useRef(scope),
    pendingRef = useRef(pending);
  scopeRef.current = scope;
  pendingRef.current = pending;
  const base = `${repositoryPath(ownerLogin, repositoryName)}/wiki`;
  const key = `wiki:${ownerLogin.toLowerCase()}/${repositoryName.toLowerCase()}/${pageId ?? "new"}`;
  const request = useCallback(
    async (extra: Record<string, string> = {}, command?: WikiCommand) => {
      const token = await liffClient.ensureSession(liffId);
      if (!token) throw new Error("請完成 LINE 登入。");
      const query = new URLSearchParams({
        owner: ownerLogin,
        name: repositoryName,
        ...(pageId ? { pageId } : {}),
        ...extra,
      });
      const response = await fetch(`/api/repository-wiki?${query}`, {
        method: command ? "POST" : "GET",
        cache: "no-store",
        headers: {
          "X-App-Session-Generation": token,
          ...(command ? { "Content-Type": "application/json" } : {}),
        },
        ...(command ? { body: JSON.stringify(command) } : {}),
      });
      const value: unknown = await response.json();
      if (!response.ok) {
        const v = record(value);
        throw Object.assign(
          new Error(typeof v.error === "string" ? v.error : "Wiki 暫時不可用。"),
          { status: response.status },
        );
      }
      return value;
    },
    [liffId, ownerLogin, repositoryName, pageId],
  );
  function remember(value: Pending | null) {
    pendingRef.current = value;
    setPending(value);
    if (value) sessionStorage.setItem(key, JSON.stringify(value));
    else sessionStorage.removeItem(key);
  }
  const clear = useCallback(() => {
    generation.current++;
    scopeRef.current = null;
    pendingRef.current = null;
    setScope(null);
    setHead(null);
    setShown(null);
    setHistory(null);
    setComparison(null);
    setPages([]);
    setNext(null);
    setEditing(false);
    setDraftVersion(null);
    setTitle("");
    setBody("");
    setPending(null);
    setBusy(false);
  }, []);
  const load = useCallback(
    async (after?: string) => {
      const ticket = ++generation.current;
      setBusy(true);
      setError("");
      try {
        const value = await request(after ? { after } : {}),
          nextScope = wikiScope(value);
        if (ticket !== generation.current) return;
        if (scopeRef.current && scopeRef.current.actorUserId !== nextScope.actorUserId) {
          clear();
          return;
        }
        scopeRef.current = nextScope;
        setScope(nextScope);
        if (pageId) {
          const revision = wikiRevision(record(value).revision);
          setHead(revision);
          setShown(revision);
          setHistory(null);
          setComparison(null);
        } else {
          const list = wikiPages(value);
          setPages((current) => (after ? [...current, ...list.pages] : list.pages));
          setNext(list.next);
        }
        const raw = sessionStorage.getItem(key);
        if (raw) {
          try {
            const saved = record(JSON.parse(raw)),
              command = parseWikiCommand(saved.command);
            if (
              saved.actor !== nextScope.actorUserId ||
              command.repositoryId !== nextScope.repository.id ||
              (pageId ? command.pageId !== pageId : command.action !== "create")
            )
              throw new Error();
            const restored = { actor: nextScope.actorUserId, command };
            pendingRef.current = restored;
            setPending(restored);
            if (command.action === "create" || command.action === "edit") {
              setTitle(command.title);
              setBody(command.body);
              setEditing(true);
              setDraftVersion(command.expectedVersion);
            }
          } catch {
            sessionStorage.removeItem(key);
            pendingRef.current = null;
            setPending(null);
          }
        }
      } catch (cause) {
        if (ticket === generation.current) {
          clear();
          setError(cause instanceof Error ? cause.message : String(cause));
        }
      } finally {
        if (ticket === generation.current) setBusy(false);
      }
    },
    [request, pageId, key, clear],
  );
  const visibility = useEffectEvent(() => {
    clear();
    if (document.visibilityState === "visible") void load();
  });
  useEffect(() => {
    const onVisibility = () => visibility();
    const unsubscribe = liffClient.onSessionBlocked(clear);
    document.addEventListener("visibilitychange", onVisibility);
    window.addEventListener("pagehide", clear);
    return () => {
      generation.current++;
      unsubscribe();
      document.removeEventListener("visibilitychange", onVisibility);
      window.removeEventListener("pagehide", clear);
    };
  }, [clear]);
  async function save(action: WikiCommand["action"], revisionId?: string) {
    if (locked.current || !scopeRef.current) return;
    locked.current = true;
    const ticket = generation.current;
    setBusy(true);
    setError("");
    try {
      const fresh = wikiScope(await request());
      if (ticket !== generation.current) return;
      const current = scopeRef.current,
        saved = pendingRef.current;
      if (
        !current ||
        fresh.actorUserId !== (saved?.actor ?? current.actorUserId) ||
        fresh.repository.id !== current.repository.id
      ) {
        clear();
        throw new Error("登入身分或 Repository 已改變，請重新讀取。");
      }
      const command: WikiCommand =
        saved?.command ??
        parseWikiCommand({
          action,
          repositoryId: fresh.repository.id,
          pageId: pageId ?? crypto.randomUUID(),
          requestId: crypto.randomUUID(),
          expectedVersion:
            action === "create" || action === "edit" || action === "rename"
              ? (draftVersion ?? 0)
              : (head?.version ?? 0),
          ...(action === "create" || action === "edit"
            ? { title, body }
            : action === "rename"
              ? { title }
              : action === "restore"
                ? { revisionId }
                : {}),
        });
      remember({ actor: fresh.actorUserId, command });
      const result = record(await request({}, command));
      const revision = wikiRevision(result.revision);
      if (ticket !== generation.current) return;
      if (
        result.requestId !== command.requestId ||
        revision.pageId !== command.pageId ||
        revision.repositoryId !== command.repositoryId
      )
        throw new Error("Wiki 儲存結果無法確認，請重試原操作。");
      remember(null);
      setEditing(false);
      setDraftVersion(null);
      setHistory(null);
      setComparison(null);
      if (!pageId) router.push(`${base}/${encodeURIComponent(revision.pageId)}`);
      else await load();
    } catch (cause) {
      if (ticket === generation.current) {
        const status =
          cause && typeof cause === "object" && "status" in cause ? Number(cause.status) : 0;
        if ([401, 403, 404].includes(status)) clear();
        else if ([400, 409, 413, 415].includes(status)) remember(null);
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      locked.current = false;
      if (ticket === generation.current) setBusy(false);
    }
  }
  async function inspect(
    mode: "history" | "page" | "compare",
    revisionId?: string,
    before?: number,
  ) {
    const ticket = generation.current;
    setBusy(true);
    setError("");
    try {
      const value = await request({
        view: mode,
        ...(revisionId
          ? mode === "compare"
            ? { beforeId: revisionId, afterId: head?.id ?? "" }
            : { revisionId }
          : {}),
        ...(before ? { before: String(before) } : {}),
      });
      if (ticket !== generation.current) return;
      if (wikiScope(value).actorUserId !== scopeRef.current?.actorUserId) {
        clear();
        return;
      }
      if (mode === "history") {
        const data = wikiHistory(value);
        setHistory((current) =>
          before && current
            ? { revisions: [...current.revisions, ...data.revisions], next: data.next }
            : data,
        );
      } else if (mode === "page") {
        setShown(wikiRevision(record(value).revision));
        setEditing(false);
        setComparison(null);
      } else setComparison(wikiComparison(value));
    } catch (cause) {
      if (ticket === generation.current) {
        clear();
        setError(cause instanceof Error ? cause.message : String(cause));
      }
    } finally {
      if (ticket === generation.current) setBusy(false);
    }
  }
  const historical = shown && head && shown.id !== head.id;
  return (
    <>
      <RepositoryPageHeader
        ownerLogin={ownerLogin}
        repositoryName={repositoryName}
        active="wiki"
        canManage={scope?.canManageRepository ?? false}
      />
      <MiniAppRuntime liffId={liffId} onReady={load} onWait={clear} />
      <div className={styles.actions}>
        <button disabled={busy} onClick={() => void load()}>
          重新讀取 Wiki
        </button>
        {pageId && <Link href={base}>返回頁面清單</Link>}
      </div>
      {busy && <p role="status">正在處理 Wiki…</p>}
      {error && <p role="alert">{error}</p>}
      {!scope && !busy && !error && <p>請完成 LINE 登入以查看 Wiki。</p>}
      {scope?.archived && <p>Repository 已封存，Wiki 為唯讀。</p>}
      {pending && (
        <div role="status">
          <p>有待確認操作；重試將沿用原始內容與版本。</p>
          <button disabled={busy} onClick={() => void save(pending.command.action)}>
            重試原操作
          </button>
          <button
            disabled={busy}
            onClick={() => {
              remember(null);
              setEditing(false);
              void load();
            }}
          >
            停止重試並重新讀取
          </button>
        </div>
      )}
      {scope && !pageId && (
        <section className={styles.panel}>
          <h2>Wiki 頁面</h2>
          {pages.length ? (
            <ul>
              {pages.map((page) => (
                <li key={page.pageId}>
                  <Link href={`${base}/${encodeURIComponent(page.pageId)}`}>{page.title}</Link> ·
                  版本 {page.version}
                  {page.archived ? " · 已封存" : ""}
                </li>
              ))}
            </ul>
          ) : (
            <p>尚無 Wiki 頁面。</p>
          )}
          {next && (
            <button disabled={busy} onClick={() => void load(next)}>
              載入更多頁面
            </button>
          )}
          {scope.canEdit && !pending && (
            <button
              disabled={busy}
              onClick={() => {
                setTitle("");
                setBody("");
                setEditing(true);
                setDraftVersion(0);
              }}
            >
              建立頁面
            </button>
          )}
        </section>
      )}
      {shown && (
        <section className={styles.panel}>
          <h2>{shown.title}</h2>
          <p>
            {historical ? "歷史版本（唯讀）" : "目前版本"}：{shown.version}
            {shown.archived ? " · 已封存" : ""}
          </p>
          <pre className={styles.markdown}>{shown.body}</pre>
          <p>保存 Markdown 原文；不執行 HTML 或渲染外部內容。</p>
          <div className={styles.actions}>
            {scope?.canEdit && !pending && !historical && !shown.archived && (
              <>
                <button
                  disabled={busy}
                  onClick={() => {
                    setTitle(shown.title);
                    setBody(shown.body);
                    setEditing(true);
                    setDraftVersion(shown.version);
                  }}
                >
                  編輯頁面
                </button>
                <button
                  disabled={busy}
                  onClick={() => {
                    if (confirm("封存此頁面？歷史內容仍保留。")) void save("archive");
                  }}
                >
                  封存頁面
                </button>
              </>
            )}
            <button disabled={busy} onClick={() => void inspect("history")}>
              查看歷史
            </button>
            {historical && scope?.canEdit && !pending && (
              <button disabled={busy} onClick={() => void save("restore", shown.id)}>
                還原此版本為新版本
              </button>
            )}
          </div>
        </section>
      )}
      {editing && scope?.canEdit && (
        <section className={styles.panel}>
          <h2>{pageId ? "編輯 Wiki" : "建立 Wiki"}</h2>
          {pageId && (
            <p>
              草稿基於版本 {draftVersion}；目前讀取版本 {head?.version}
              。重新讀取不會改變草稿的基準版本。
            </p>
          )}
          <label htmlFor="wiki-title">標題</label>
          <input
            id="wiki-title"
            value={title}
            maxLength={200}
            disabled={busy || !!pending}
            onChange={(event) => setTitle(event.target.value)}
          />
          <label htmlFor="wiki-body">Markdown 原文</label>
          <textarea
            id="wiki-body"
            value={body}
            maxLength={262144}
            disabled={busy || !!pending}
            onChange={(event) => setBody(event.target.value)}
          />
          <div className={styles.actions}>
            <button
              disabled={busy || !!pending}
              onClick={() => void save(pageId ? "edit" : "create")}
            >
              儲存頁面
            </button>
            {pageId && (
              <button disabled={busy || !!pending} onClick={() => void save("rename")}>
                僅改名
              </button>
            )}
            <button disabled={busy || !!pending} onClick={() => setEditing(false)}>
              取消編輯
            </button>
          </div>
        </section>
      )}
      {history && (
        <section className={styles.panel}>
          <h2>版本歷史</h2>
          <ul>
            {history.revisions.map((revision) => (
              <li key={revision.id}>
                版本 {revision.version} · {revision.action}{" "}
                <button disabled={busy} onClick={() => void inspect("page", revision.id)}>
                  查看版本 {revision.version}
                </button>
                <button disabled={busy} onClick={() => void inspect("compare", revision.id)}>
                  比較版本 {revision.version} 與目前版本
                </button>
              </li>
            ))}
          </ul>
          {history.next && (
            <button
              disabled={busy}
              onClick={() => void inspect("history", undefined, history.next ?? undefined)}
            >
              載入更多歷史
            </button>
          )}
        </section>
      )}
      {comparison && (
        <section className={styles.panel}>
          <h2>版本差異</h2>
          {comparison.length ? (
            comparison.map((item) => (
              <div key={item.field}>
                <h3>{item.field}</h3>
                <p>之前</p>
                <pre className={styles.markdown}>{String(item.before)}</pre>
                <p>目前</p>
                <pre className={styles.markdown}>{String(item.after)}</pre>
              </div>
            ))
          ) : (
            <p>內容相同。</p>
          )}
        </section>
      )}
    </>
  );
}
