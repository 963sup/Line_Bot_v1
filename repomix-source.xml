<file path="apps/web/src/modules/expense/panel.tsx">
"use client";
import type { ExpenseApiView } from "@line_bot_v1/expense/contracts/dto/expense-api-view";
import type { ExpenseFields } from "@line_bot_v1/expense/domain/aggregates/expense";
import { isRecord } from "@line_bot_v1/platform/validation";
import Link from "next/link";
import { useEffect, useState } from "react";
import { liffClient } from "../../shared/browser/liff-client";
import MiniAppRuntime from "../../shared/browser/mini-app-runtime";

type View = ExpenseApiView;
type ReceiptReadingView = {
  merchant: string | null;
  amount: string | null;
  currency: string | null;
  date: string | null;
  invoiceNumber: string | null;
};

const labels = {
  merchant: "商家",
  amount: "金額",
  currency: "幣別",
  date: "日期",
  invoiceNumber: "憑證號碼（選填）",
};
const fieldKeys: readonly (keyof Omit<ExpenseFields, "payment">)[] = [
  "merchant",
  "amount",
  "currency",
  "date",
  "invoiceNumber",
];

function readExpense(value: unknown): ExpenseApiView {
  if (
    !isRecord(value) ||
    typeof value.id !== "string" ||
    typeof value.number !== "number" ||
    typeof value.merchant !== "string" ||
    typeof value.amount !== "string" ||
    typeof value.currency !== "string" ||
    typeof value.date !== "string" ||
    typeof value.invoiceNumber !== "string" ||
    (value.payment !== "" &&
      value.payment !== "advance" &&
      value.payment !== "company" &&
      value.payment !== "unpaid") ||
    (value.status !== "pending" &&
      value.status !== "draft" &&
      value.status !== "confirmed" &&
      value.status !== "cancelled") ||
    typeof value.revision !== "number" ||
    typeof value.createdAt !== "number"
  )
    throw new Error("支出回應格式不完整。");
  return {
    id: value.id,
    number: value.number,
    merchant: value.merchant,
    amount: value.amount,
    currency: value.currency,
    date: value.date,
    invoiceNumber: value.invoiceNumber,
    payment: value.payment,
    status: value.status,
    revision: value.revision,
    createdAt: value.createdAt,
  };
}

function readReceipt(value: unknown): ReceiptReadingView {
  if (!isRecord(value)) throw new Error("辨識回應格式不完整。");
  const nullable = (item: unknown) => item === null || typeof item === "string";
  if (
    !nullable(value.merchant) ||
    !nullable(value.amount) ||
    !nullable(value.currency) ||
    !nullable(value.date) ||
    !nullable(value.invoiceNumber)
  )
    throw new Error("辨識回應格式不完整。");
  return {
    merchant: value.merchant,
    amount: value.amount,
    currency: value.currency,
    date: value.date,
    invoiceNumber: value.invoiceNumber,
  };
}

export default function ExpensePanel({ liffId }: { liffId: string }) {
  const [expense, setExpense] = useState<View>();
  const [hasRecognition, setHasRecognition] = useState(false);
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(true);
  const [notice, setNotice] = useState("");
  const [token, setToken] = useState("");
  const [id, setId] = useState("");

  useEffect(() => {
    if (expense?.status !== "confirmed" || !liffClient.inClient()) return;
    const timer = setTimeout(() => liffClient.close(), 1500);
    return () => clearTimeout(timer);
  }, [expense?.status]);

  async function load(access: string, expenseId: string) {
    const result = await fetch(`/api/expenses/${encodeURIComponent(expenseId)}`, {
      headers: { "X-App-Session-Generation": access },
      cache: "no-store",
    });
    const data: unknown = await result.json();
    if (!result.ok)
      throw new Error(isRecord(data) && typeof data.error === "string" ? data.error : JSON.stringify(data));
    setHasRecognition(false);
    setExpense(readExpense(data));
  }

  async function initialize() {
    setExpense(undefined);
    setHasRecognition(false);
    setToken("");
    try {
      if (!liffId) throw new Error("操作頁尚未設定。");
      const access = await liffClient.ensureSession(liffId);
      if (!access) return;
      const expenseId = new URL(window.location.href).searchParams.get("expense");
      if (!expenseId) throw new Error("請從群組中的「處理」按鈕開啟支出。");
      setToken(access);
      setId(expenseId);
      await load(access, expenseId);
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setBusy(false);
    }
  }

  async function command(type: "recognize" | "save" | "confirm" | "cancel") {
    if (!expense || busy) return;
    setBusy(true);
    setError("");
    setNotice("");
    try {
      const fields = Object.fromEntries(
        ([...fieldKeys, "payment"] satisfies readonly (keyof ExpenseApiView)[]).map((key) => [
          key,
          expense[key],
        ]),
      );
      const result = await fetch(`/api/expenses/${id}`, {
        method: "POST",
        headers: { "X-App-Session-Generation": token, "Content-Type": "application/json" },
        body: JSON.stringify({
          type,
          revision: expense.revision,
          ...(["save", "confirm"].includes(type) ? { fields } : {}),
        }),
      });
      const data: unknown = await result.json();
      if (!result.ok)
        throw new Error(
          isRecord(data) && typeof data.error === "string" ? data.error : "操作失敗。",
        );

      if (type === "recognize") {
        if (!isRecord(data)) throw new Error("辨識回應格式不完整。");
        const reading = readReceipt(data.reading);
        setExpense({
          ...expense,
          merchant: reading.merchant ?? "",
          amount: reading.amount ?? "",
          currency: reading.currency ?? "",
          date: reading.date ?? "",
          invoiceNumber: reading.invoiceNumber ?? "",
        });
        setHasRecognition(true);
        return;
      }

      setHasRecognition(false);
      setExpense(readExpense(data));
      if (type === "save") setNotice("已儲存修改。");
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setBusy(false);
    }
  }

  const finished = expense && ["confirmed", "cancelled"].includes(expense.status);

  return (
    <>
      <MiniAppRuntime liffId={liffId} onReady={initialize} onWait={() => setBusy(false)} />
      <p className="eyebrow">Line_Bot_v1 · 支出</p>
      <h1>{expense ? `支出 #${expense.number}` : "處理支出"}</h1>
      {busy && <p role="status">{expense ? "處理中，請稍候…" : "正在驗證 LINE 身分…"}</p>}
      {error && (
        <div role="alert" className="expense-error">
          {error}
          <Link href="/settings">前往帳號設定</Link>
          <button
            disabled={busy}
            onClick={async () => {
              setBusy(true);
              setError("");
              try {
                if (token && id) await load(token, id);
                else await initialize();
              } catch (e) {
                setError(e instanceof Error ? e.message : String(e));
              } finally {
                setBusy(false);
              }
            }}
          >
            重新載入
          </button>
        </div>
      )}
      {notice && <p role="status">{notice}</p>}
      {finished ? (
        <section className="expense-success">
          <h2>{expense.status === "confirmed" ? "✓ 已確認" : "已取消"}</h2>
          <p>
            {expense.status === "confirmed" ? "資料已保存，尚未正式入帳。" : "這筆支出已取消。"}
          </p>
          <button
            onClick={() => {
              if (liffClient.inClient()) liffClient.close();
              else setNotice("可以關閉此視窗。");
            }}
          >
            完成，返回聊天
          </button>
        </section>
      ) : expense?.status === "pending" && !hasRecognition ? (
        <section>
          <p>辨識後，在這裡核對收據與補齊資料。</p>
          <p className="expense-hint">圖片將送至 Vercel AI Gateway 處理。請使用非敏感測試憑證。</p>
          <button disabled={busy} onClick={() => command("recognize")}>
            辨識收據
          </button>
          <button className="secondary" disabled={busy} onClick={() => command("cancel")}>
            取消支出
          </button>
        </section>
      ) : expense ? (
        <form
          onSubmit={(e) => {
            e.preventDefault();
            void command("confirm");
          }}
        >
          <p className="expense-hint">核對辨識結果；空白欄位需要補充。</p>
          <fieldset disabled={busy}>
            {fieldKeys.map((key) => (
              <label key={key}>
                {labels[key]}
                <input
                  aria-label={labels[key]}
                  required={key !== "invoiceNumber"}
                  maxLength={120}
                  inputMode={key === "amount" ? "decimal" : undefined}
                  type={key === "date" ? "date" : "text"}
                  value={expense[key]}
                  onChange={(e) => setExpense({ ...expense, [key]: e.target.value })}
                />
              </label>
            ))}
            <label>
              付款方式
              <select
                required
                aria-label="付款方式"
                value={expense.payment}
                onChange={(e) => {
                  const payment = e.target.value;
                  if (
                    payment === "" ||
                    payment === "advance" ||
                    payment === "company" ||
                    payment === "unpaid"
                  )
                    setExpense({ ...expense, payment });
                }}
              >
                <option value="">請選擇</option>
                <option value="advance">我先墊付</option>
                <option value="company">公司支付</option>
                <option value="unpaid">尚未付款</option>
              </select>
            </label>
            <button type="submit">確認支出</button>
            <button type="button" className="secondary" onClick={() => command("save")}>
              儲存修改
            </button>
            <button type="button" className="secondary" onClick={() => command("cancel")}>
              取消支出
            </button>
          </fieldset>
        </form>
      ) : null}
      <p className="expense-hint">測試版 · 資料保存在會員系統；一般修改與確認不發送群組訊息。</p>
    </>
  );
}
</file>

<file path="apps/web/src/modules/file/commercial-intake-panel.tsx">
"use client";
import { useCallback, useEffect, useRef, useState } from "react";
import { Button } from "../../shared/ui/button";
import CommercialDraftReview, { CommercialIntakeSource } from "./commercial-draft-review";
import {
  commercialRecoveryActions,
  commercialStatus,
  isMissingCommercialIntake,
  newCommercialIntake,
  observeCommercialDraft,
  type PendingCommercialIntake,
  restoreCommercialIntake,
} from "./commercial-intake-state";
import { errorMessage, type FileInfo, record, StaleRequest } from "./files-projection";

type Props = {
  actorUserId: string;
  repositoryId: string;
  selected: FileInfo | null;
  canEdit: boolean;
  blocked: boolean;
  request(query: Record<string, string>, command?: object): Promise<unknown>;
  read(query: Record<string, string>): Promise<unknown>;
};
export default function CommercialIntakePanel(props: Props) {
  const [pending, setPending] = useState<PendingCommercialIntake | null>(null),
    [state, setState] = useState(""),
    [revision, setRevision] = useState<unknown>(null),
    [busy, setBusy] = useState(false),
    [error, setError] = useState(""),
    [missingIntake, setMissingIntake] = useState(false),
    [confirmAbandon, setConfirmAbandon] = useState(false),
    [restored, setRestored] = useState(false),
    [sourceLoading, setSourceLoading] = useState(false),
    [savedDraft, setSavedDraft] = useState<{ file: FileInfo; revision: unknown } | null>(null);
  const current = useRef(0),
    lock = useRef(false);
  const storageKey = `commercial-intake:${props.actorUserId}:${props.repositoryId}`;
  const execute = useCallback(
    async function execute(
      operation: "start" | "status" | "resume",
      command: PendingCommercialIntake,
      ticket = current.current,
    ) {
      if (lock.current) return;
      lock.current = true;
      setBusy(true);
      setError("");
      setConfirmAbandon(false);
      if (operation === "start") {
        setMissingIntake(false);
        setState("OUTCOME_UNKNOWN");
      }
      try {
        const response = await props.request(
          operation === "status" ? { taskId: command.commandId } : {},
          operation === "status"
            ? undefined
            : operation === "start"
              ? {
                  operation,
                  taskId: command.commandId,
                  repositoryId: command.repositoryId,
                  source: command.source,
                }
              : { operation, taskId: command.commandId, repositoryId: command.repositoryId },
        );
        if (ticket !== current.current) return;
        const observed = commercialStatus(response, command);
        setState(observed);
        setMissingIntake(false);
        if (observed === "DRAFT_SAVED") {
          const response = record(await props.read({ documentId: command.target.documentId }));
          if (ticket !== current.current) return;
          if (!response.revision) throw new Error("草稿讀取尚未完成，請以原命令查詢狀態。");
          setRevision(response.revision);
        }
      } catch (cause) {
        if (ticket !== current.current || cause instanceof StaleRequest) return;
        if (operation !== "start" && isMissingCommercialIntake(cause)) setMissingIntake(true);
        setError(errorMessage(cause));
      } finally {
        if (ticket === current.current) {
          lock.current = false;
          setBusy(false);
        }
      }
    },
    [props.request, props.read],
  );
  useEffect(() => {
    const ticket = ++current.current;
    let saved: PendingCommercialIntake | null = null;
    try {
      saved = restoreCommercialIntake(localStorage.getItem(storageKey), props.repositoryId);
    } catch {
      /* Storage unavailable: commands still remain in memory. */
    }
    setPending(saved);
    setRestored(true);
    setState(saved ? "OUTCOME_UNKNOWN" : "");
    setRevision(null);
    setError("");
    setMissingIntake(false);
    setConfirmAbandon(false);
    if (saved) void execute("status", saved, ticket);
    return () => {
      current.current++;
      lock.current = false;
    };
    // Restoring a pending identity performs status readback only, never extraction.
  }, [storageKey, props.repositoryId, execute]);

  useEffect(() => {
    if (!restored) return;
    setSavedDraft(null);
    if (pending || !props.selected) {
      setSourceLoading(false);
      return;
    }
    const source = props.selected;
    setSourceLoading(true);
    setError("");
    return observeCommercialDraft({
      selected: source,
      pending: false,
      read: props.read,
      onResult: (revision) => {
        setSavedDraft(revision === null ? null : { file: source, revision });
        setSourceLoading(false);
      },
      onError: (cause) => {
        setSourceLoading(false);
        if (!(cause instanceof StaleRequest)) setError(errorMessage(cause));
      },
    });
  }, [restored, pending, props.selected, props.read]);

  function start() {
    if (!props.selected || !restored || sourceLoading || pending || lock.current || !props.canEdit)
      return;
    const command = newCommercialIntake(props.selected);
    setPending(command);
    setState("OUTCOME_UNKNOWN");
    try {
      localStorage.setItem(storageKey, JSON.stringify(command));
    } catch {
      setPending(null);
      setError("無法保存命令識別碼；請啟用瀏覽器儲存空間後重試。");
      return;
    }
    void execute("start", command);
  }
  function clearPending() {
    try {
      localStorage.removeItem(storageKey);
    } catch {
      setError("無法清除命令記錄；已保留原命令，請稍後重試。");
      return;
    }
    setPending(null);
    setState("");
    setRevision(null);
    setError("");
    setMissingIntake(false);
    setConfirmAbandon(false);
  }
  const recovery = commercialRecoveryActions(state, missingIntake);
  const labels: Record<string, string> = {
    WAITING: "等待處理",
    ANALYZING: "正在解析",
    RESULT_READY: "解析結果已保存，可繼續建立草稿",
    DRAFT_SAVED: "草稿已保存",
    FAILED: "處理失敗，請保留原命令供查核",
    OUTCOME_UNKNOWN: "結果待確認，請查詢原命令",
  };
  return (
    <section className="space-y-3 rounded-md border p-3" aria-label="商務文件解析">
      <h3 className="font-medium">商務文件解析</h3>
      <p className="text-sm text-muted-foreground">
        解析報價、估價、採購或合約原始檔，保存為待人工審閱的 DRAFT。
      </p>
      {!pending && (
        <Button
          disabled={
            !props.canEdit ||
            !restored ||
            sourceLoading ||
            props.blocked ||
            busy ||
            !props.selected ||
            !["application/pdf", "image/png", "image/jpeg", "image/webp"].includes(
              props.selected.mediaType,
            )
          }
          onClick={start}
        >
          {savedDraft ? "另建一份商務文件草稿" : "解析商務文件"}
        </Button>
      )}
      {pending && (
        <>
          <CommercialIntakeSource
            source={pending.source}
            repositoryId={pending.repositoryId}
            selected={props.selected}
          />
          <p role="status">{labels[state] ?? state}</p>
          <p className="break-all text-xs">原命令：{pending.commandId}</p>
          <Button
            variant="outline"
            disabled={busy || props.blocked}
            onClick={() => void execute("status", pending)}
          >
            查詢原命令狀態
          </Button>
          {missingIntake && (
            <>
              <p className="text-sm">
                原命令尚未建立處理記錄；可明確重送同一命令，沿用原來源與保存操作，不會另外建立一份文件。
              </p>
              <Button
                disabled={!props.canEdit || busy || props.blocked}
                onClick={() => void execute("start", pending)}
              >
                以原命令重新送出
              </Button>
            </>
          )}
          {recovery.resumeLabel && (
            <Button
              disabled={!props.canEdit || busy || props.blocked}
              onClick={() => void execute("resume", pending)}
            >
              {recovery.resumeLabel}
            </Button>
          )}
          {recovery.canAbandon && (
            <div className="space-y-2">
              <p className="text-sm">
                預設保留原命令。放棄瀏覽器記錄不會取消伺服器工作；原解析可能已扣費或稍後保存結果。之後另建解析可能再次扣費。
              </p>
              {!confirmAbandon ? (
                <Button
                  variant="outline"
                  disabled={busy || props.blocked}
                  onClick={() => setConfirmAbandon(true)}
                >
                  放棄此命令記錄…
                </Button>
              ) : (
                <>
                  <p>確認放棄後，可另行選擇「解析商務文件」；此動作不會自動開始解析。</p>
                  <Button variant="outline" disabled={busy || props.blocked} onClick={clearPending}>
                    確認放棄記錄
                  </Button>
                  <Button variant="ghost" disabled={busy} onClick={() => setConfirmAbandon(false)}>
                    繼續保留原命令
                  </Button>
                </>
              )}
            </div>
          )}
          {state === "DRAFT_SAVED" && (
            <Button variant="outline" disabled={busy} onClick={clearPending}>
              結束草稿檢視
            </Button>
          )}
        </>
      )}
      {!pending && savedDraft && (
        <section className="space-y-2" aria-label="已保存商務文件">
          <p>已保存草稿 · 唯讀檢視</p>
          <CommercialIntakeSource
            source={{
              fileId: savedDraft.file.fileId,
              fileRevisionId: savedDraft.file.revisionId,
              sha256: savedDraft.file.sha256,
            }}
            repositoryId={savedDraft.file.repositoryId}
            selected={props.selected}
          />
          <CommercialDraftReview revision={savedDraft.revision} />
        </section>
      )}
      {sourceLoading && <p role="status">正在讀取此來源已保存的草稿…</p>}
      {busy && <p role="status">處理中…</p>}
      {error && (
        <p role="alert" className="whitespace-pre-wrap text-destructive">
          {error}
        </p>
      )}
      {revision !== null && <CommercialDraftReview revision={revision} />}
    </section>
  );
}
</file>

<file path="apps/web/src/modules/project/project-wbs-response.ts">
import { isRecord, literalValue, numberValue, stringValue } from "@line_bot_v1/platform/validation";
import type {
  ProjectWbsHistory,
  ProjectWbsReceipt,
  ProjectWbsView,
} from "@line_bot_v1/wbs/contracts/dto/project-content";
import type { WbsRevision } from "@line_bot_v1/wbs/domain/content";
import { parseWbsDocument } from "@line_bot_v1/wbs/domain/document";

function contentImport(value: unknown): NonNullable<WbsRevision["contentImport"]> {
  if (
    !isRecord(value) ||
    value.mappingVersion !== "content-wbs-v1" ||
    !Array.isArray(value.nodeCoverage) ||
    !Array.isArray(value.sourceRows)
  )
    throw new Error("WBS Content 來源證據格式不正確。");
  return {
    repositoryId: stringValue(value.repositoryId),
    contentRevisionId: stringValue(value.contentRevisionId),
    contentVersion: numberValue(value.contentVersion),
    mappingVersion: "content-wbs-v1",
    nodeCoverage: value.nodeCoverage.map((item) => {
      if (!isRecord(item)) throw new Error("WBS Content 來源證據格式不正確。");
      return {
        contentNodeId: stringValue(item.contentNodeId),
        wbsNodeId: stringValue(item.wbsNodeId),
        sourceKind: literalValue(item.sourceKind, [
          "SUBJECT",
          "OBJECT",
          "SUBOBJECT",
          "WORK",
          "TASK",
        ]),
        targetKind: literalValue(item.targetKind, ["DELIVERABLE", "WORK_PACKAGE"]),
      };
    }),
    sourceRows: value.sourceRows.map((item) => {
      if (!isRecord(item) || !Array.isArray(item.wbsNodeIds))
        throw new Error("WBS Content 來源證據格式不正確。");
      return {
        documentId: stringValue(item.documentId),
        revisionId: stringValue(item.revisionId),
        sourceRowId: stringValue(item.sourceRowId),
        disposition: literalValue(item.disposition, ["CONTENT_WORK", "COMMERCIAL_ONLY"]),
        wbsNodeIds: item.wbsNodeIds.map(stringValue),
      };
    }),
  };
}

function metadata(value: unknown): Omit<WbsRevision, "document"> {
  if (!isRecord(value)) throw new Error("WBS 回應格式不正確。");
  const action = value.action;
  if (
    action !== "initialize" &&
    action !== "create-node" &&
    action !== "import-contract" &&
    action !== "import-content-document" &&
    action !== "update-node" &&
    action !== "move-node" &&
    action !== "delete-subtree"
  )
    throw new Error("WBS 歷史操作不正確。");
  return {
    id: stringValue(value.id),
    version: numberValue(value.version),
    parentRevisionId: value.parentRevisionId === null ? null : stringValue(value.parentRevisionId),
    actorUserId: stringValue(value.actorUserId),
    action,
    at: numberValue(value.at),
  };
}
export function wbsRevision(value: unknown): WbsRevision {
  if (!isRecord(value)) throw new Error("WBS Revision 不正確。");
  return {
    ...metadata(value),
    ...(value.contentImport ? { contentImport: contentImport(value.contentImport) } : {}),
    document: parseWbsDocument(value.document),
  };
}
export function projectWbsView(value: unknown): ProjectWbsView {
  if (
    !isRecord(value) ||
    !isRecord(value.project) ||
    typeof value.canEdit !== "boolean" ||
    typeof value.closed !== "boolean" ||
    typeof value.canManageProject !== "boolean"
  )
    throw new Error("WBS 回應格式不正確。");
  return {
    project: {
      id: stringValue(value.project.id),
      title: stringValue(value.project.title),
    },
    actorUserId: stringValue(value.actorUserId),
    canEdit: value.canEdit,
    canManageProject: value.canManageProject,
    closed: value.closed,
    version: numberValue(value.version),
    revision: value.revision === null ? null : wbsRevision(value.revision),
  };
}
export function projectWbsReceipt(value: unknown): ProjectWbsReceipt {
  if (!isRecord(value)) throw new Error("WBS 儲存結果無法確認，請重試原操作。");
  return {
    requestId: stringValue(value.requestId),
    projectId: stringValue(value.projectId),
    revision: wbsRevision(value.revision),
  };
}
export function projectWbsHistory(value: unknown): ProjectWbsHistory {
  if (!isRecord(value) || !Array.isArray(value.revisions)) throw new Error("WBS 歷史回應不正確。");
  return {
    revisions: value.revisions.map((item) => {
      const meta = metadata(item);
      if (isRecord(item) && item.contentImport)
        return { ...meta, contentImport: contentImport(item.contentImport) };
      return meta;
    }),
    next: value.next === null ? null : numberValue(value.next),
  };
}
