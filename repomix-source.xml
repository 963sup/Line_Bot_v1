<file path="packages/organization/src/application/use-cases/organization-lifecycle.ts">
import type { VerifiedLineActor } from "@line_bot_v1/identity-access/contracts/governance";
import { GovernanceAccessError } from "@line_bot_v1/identity-access/domain/role-assignment";
import type { OrganizationReceipt } from "../../contracts/organization-governance.js";
import type { OrganizationLifecycleTransactions } from "../../contracts/output/organization-lifecycle.js";
import {
  deactivateOrganization,
  type Organization,
  OrganizationError,
  reactivateOrganization,
} from "../../domain.js";
import type { OrganizationLifecycleCommand } from "../commands/organization-lifecycle.js";

export function executeOrganizationLifecycle(
  transactions: OrganizationLifecycleTransactions,
  actor: VerifiedLineActor,
  command: OrganizationLifecycleCommand,
  now: number,
) {
  return transactions.transact(
    actor,
    command.organizationAccountId,
    {
      requestId: command.requestId,
      payload: JSON.stringify(command),
      reason: command.reason,
      at: now,
    },
    async (transaction) => {
      const qualified =
        command.action === "deactivate"
          ? transaction.ownerQualification.activeOwner
          : transaction.ownerQualification.lifecycleOwner;
      if (!qualified) {
        throw new GovernanceAccessError(
          403,
          "forbidden",
          command.action === "deactivate"
            ? "你沒有此 Organization 的 owner 權限。"
            : "你沒有此 Organization 的生命週期權限。",
        );
      }
      const replay = await transaction.replay();
      if (replay) return replay;

      let next: Organization;
      const current = await transaction.organizations.load();
      try {
        next =
          command.action === "deactivate"
            ? deactivateOrganization(current, command.expectedVersion)
            : reactivateOrganization(current, command.expectedVersion);
      } catch (error) {
        if (!(error instanceof OrganizationError)) throw error;
        throw new GovernanceAccessError(
          error.code === "invalid-input" ? 400 : 409,
          error.code,
          error.code === "conflict"
            ? "Organization 版本已更新。"
            : "Organization 狀態不適用此操作。",
        );
      }
      await transaction.organizations.save(next, command.expectedVersion);
      const result: OrganizationReceipt = {
        requestId: command.requestId,
        action: command.action,
        scopeId: next.id,
        subjectKind: null,
        subjectId: null,
        status: next.status,
        version: next.version,
        at: now,
      };
      await transaction.record(result);
      return result;
    },
  );
}
</file>

<file path="packages/organization/src/application/use-cases/organization-membership.ts">
import type { VerifiedLineActor } from "@line_bot_v1/identity-access/contracts/governance";
import { GovernanceAccessError } from "@line_bot_v1/identity-access/domain/role-assignment";
import type { OrganizationReceipt } from "../../contracts/organization-governance.js";
import type { OrganizationMembershipTransactions } from "../../contracts/output/organization-membership.js";
import {
  activateOrganizationDirectMembership,
  inviteOrganizationUser,
  type OrganizationDirectMembership,
  OrganizationError,
  type OrganizationInvitation,
  removeOrganizationDirectMembership,
  requireActiveOrganizationMembershipScope,
  requireNoActiveOrganizationMembership,
  requireNoDerivedOrganizationMembership,
  resolveOrganizationInvitation,
} from "../../domain.js";
import type { OrganizationMembershipCommand } from "../commands/organization-membership.js";

export function executeOrganizationMembership(
  transactions: OrganizationMembershipTransactions,
  actor: VerifiedLineActor,
  input: OrganizationMembershipCommand,
  at: number,
) {
  const command = { ...input };
  const scope = {
    organizationAccountId: command.organizationAccountId,
    targetUserId: command.action === "leave-organization" ? null : command.targetUserId,
  };
  const evidence = {
    requestId: command.requestId,
    payload: JSON.stringify(command),
    action: command.action,
    reason: command.reason,
    at,
  };
  return transactions.transact(actor, scope, evidence, async (transaction) => {
    if (command.action === "accept-invitation" || command.action === "decline-invitation") {
      if (transaction.targetUserId !== transaction.actorUserId)
        throw new GovernanceAccessError(
          403,
          "forbidden",
          "只能接受自己的 Organization invitation。",
        );
    } else if (command.action !== "leave-organization") await transaction.authorizeOwner();
    const replay = await transaction.replay();
    if (replay) return replay;
    try {
      requireActiveOrganizationMembershipScope(transaction.organizationStatus);
      const membershipActive = await transaction.membershipActive();
      const direct = await transaction.directMembership();
      const invitation = await transaction.invitation();
      let status: string;
      let version: number;
      if (command.action === "invite-member") {
        requireNoActiveOrganizationMembership(membershipActive);
        await transaction.requireActiveTarget();
        const next = inviteOrganizationUser(
          invitation,
          command.organizationAccountId,
          transaction.targetUserId,
          command.expectedVersion,
        );
        version = await transaction.saveInvitation(next);
        status = next.status;
      } else if (
        command.action === "accept-invitation" ||
        command.action === "decline-invitation" ||
        command.action === "cancel-invitation"
      ) {
        if (!invitation)
          throw new GovernanceAccessError(409, "conflict", "找不到指定版本的 pending invitation。");
        let next: OrganizationInvitation;
        try {
          next = resolveOrganizationInvitation(
            invitation,
            command.action === "accept-invitation"
              ? "accepted"
              : command.action === "decline-invitation"
                ? "declined"
                : "cancelled",
            command.expectedVersion,
          );
        } catch (error) {
          if (!(error instanceof OrganizationError)) throw error;
          throw new GovernanceAccessError(409, "conflict", "找不到指定版本的 pending invitation。");
        }
        if (command.action === "accept-invitation") {
          await transaction.requireActiveTarget();
          requireNoActiveOrganizationMembership(membershipActive);
          await transaction.saveDirect(
            activateOrganizationDirectMembership(
              command.organizationAccountId,
              transaction.targetUserId,
              direct,
            ),
          );
          await transaction.refreshMembership();
        }
        version = await transaction.saveInvitation(next);
        status = next.status;
      } else {
        if (!direct)
          throw new GovernanceAccessError(
            409,
            "conflict",
            "找不到指定版本的有效 Organization direct membership。",
          );
        let next: OrganizationDirectMembership;
        try {
          next = removeOrganizationDirectMembership(direct, command.expectedVersion);
        } catch (error) {
          if (!(error instanceof OrganizationError)) throw error;
          throw new GovernanceAccessError(
            409,
            "conflict",
            "找不到指定版本的有效 Organization direct membership。",
          );
        }
        if (command.action === "leave-organization")
          requireNoDerivedOrganizationMembership(await transaction.hasOtherSource());
        await transaction.assertDirectSourceRemovable();
        version = await transaction.saveDirect(next);
        await transaction.refreshMembership();
        status = next.status;
      }
      const result: OrganizationReceipt = {
        requestId: command.requestId,
        action: command.action,
        scopeId: command.organizationAccountId,
        subjectKind: "user",
        subjectId: transaction.targetUserId,
        status,
        version,
        at,
      };
      await transaction.record(result);
      return result;
    } catch (error) {
      if (!(error instanceof OrganizationError)) throw error;
      throw new GovernanceAccessError(
        error.code === "invalid-input" ? 400 : 409,
        error.code,
        error.message,
      );
    }
  });
}
</file>

<file path="packages/organization/src/application/use-cases/organization-owner.ts">
import type { VerifiedLineActor } from "@line_bot_v1/identity-access/contracts/governance";
import { GovernanceAccessError } from "@line_bot_v1/identity-access/domain/role-assignment";
import type { OrganizationReceipt } from "../../contracts/organization-governance.js";
import type { OrganizationOwnerTransactions } from "../../contracts/output/organization-owner.js";
import {
  grantOrganizationOwner,
  OrganizationError,
  requireActiveOrganizationForOwner,
  requireOrganizationOwnerMembership,
  requireReplacementOrganizationOwner,
  revokeOrganizationOwner,
} from "../../domain.js";
import type { OrganizationOwnerCommand } from "../commands/organization-owner.js";

export function executeOrganizationOwner(
  transactions: OrganizationOwnerTransactions,
  actor: VerifiedLineActor,
  input: OrganizationOwnerCommand,
  at: number,
) {
  const command = { ...input };
  return transactions.transact(
    actor,
    { organizationAccountId: command.organizationAccountId, targetUserId: command.targetUserId },
    {
      requestId: command.requestId,
      payload: JSON.stringify(command),
      legacyPayload: JSON.stringify({
        action: command.action === "grant-organization-owner" ? "grant" : "revoke",
        requestId: command.requestId,
        scopeKind: "organization",
        scopeId: command.organizationAccountId,
        principal: { kind: "user", id: command.targetUserId },
        role: "OrganizationOwner",
        expectedVersion: command.expectedVersion,
        reason: command.reason,
      }),
      action: command.action,
      reason: command.reason,
      at,
    },
    async (transaction) => {
      await transaction.authorize();
      const replay = await transaction.replay();
      if (replay) return replay;
      try {
        requireActiveOrganizationForOwner(transaction.organization.status);
        const membership = await transaction.membership();
        requireOrganizationOwnerMembership(membership);
        const current = await transaction.load();
        const grant = command.action === "grant-organization-owner";
        const targetVersion =
          grant || current !== null ? await transaction.activeTargetVersion() : null;
        if (grant && targetVersion === null)
          throw new GovernanceAccessError(404, "not-found", "找不到有效對象使用者。");
        const next =
          grant && targetVersion !== null
            ? grantOrganizationOwner(
                current,
                command.expectedVersion,
                targetVersion,
                membership.version,
              )
            : revokeOrganizationOwner(
                current,
                command.expectedVersion,
                targetVersion,
                membership.version,
              );
        if (!grant) {
          const targetEffective = await transaction.targetEffective();
          requireReplacementOrganizationOwner(
            targetEffective,
            targetEffective && (await transaction.anotherEffective()),
          );
        }
        const version = await transaction.save(next);
        const result: OrganizationReceipt = {
          requestId: command.requestId,
          action: command.action,
          scopeId: command.organizationAccountId,
          subjectKind: "user",
          subjectId: command.targetUserId,
          status: next.status,
          version,
          at,
        };
        await transaction.record(result);
        return result;
      } catch (error) {
        if (!(error instanceof OrganizationError)) throw error;
        const status = error.code === "forbidden" ? 403 : error.code === "not-found" ? 404 : 409;
        throw new GovernanceAccessError(status, error.code, error.message);
      }
    },
  );
}
