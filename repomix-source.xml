  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface-muted);
  color: var(--muted);
}

.app-shell .assistant-tabs button[aria-selected="true"] {
  border-color: #58a6ff;
  background: #1f6feb33;
  color: var(--ink);
}

.app-shell .assistant-mode-copy h2,
.app-shell .assistant-result h2 {
  margin: 0;
  font-size: 20px;
}

.app-shell .assistant-mode-copy p,
.app-shell .assistant-boundary {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.app-shell .assistant-form {
  display: grid;
  gap: 10px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
}

.app-shell .assistant-form label {
  font-size: 13px;
  font-weight: 700;
}

.app-shell .assistant-form textarea {
  min-height: 150px;
  resize: vertical;
}

.app-shell .assistant-form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.app-shell .assistant-form-footer > span {
  color: var(--muted);
  font-size: 11px;
}

.app-shell .assistant-result {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
}

.app-shell .assistant-result p {
  margin: 10px 0 0;
  white-space: pre-wrap;
  line-height: 1.7;
}

.app-shell .assistant-error {
  margin: 0;
  color: #ff7b72;
}

@media (max-width: 600px) {
  .app-shell .app-shell-brand {
    display: flex;
    min-height: 60px;
    padding: 8px 16px;
    border-bottom-color: #21262d;
    background: #0d1117f7;
  }

  .app-shell .shell-wordmark {
    min-width: 0;
    font-size: 14px;
  }

  .app-shell .shell-wordmark-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-shell .app-content {
    padding: 14px 16px 34px;
  }

  .app-shell .page-heading {
    min-height: 48px;
    margin-bottom: 14px;
  }

  .app-shell .page-heading h1 {
    font-size: 28px;
  }

  .app-shell .section-heading {
    margin-top: 22px;
  }

  .app-shell .menu-group .action-row,
  .app-shell .action-row {
    min-height: 64px;
    padding: 10px 0;
  }

  .app-shell .work-navigation {
    padding-top: 5px;
  }
}

.app-shell .nav-icon svg {
  display: block;
}

.public-profile-identity {
