<file path="packages/file/src/adapters/outbound/persistence/reclamation.ts">
import { businessDatabase, type Database } from "@line_bot_v1/platform/postgres";
import { stringValue } from "@line_bot_v1/platform/validation";
import type { FileReclamation } from "../../../contracts/output/files.js";
import { FileError } from "../../../domain/error.js";
import { uploadIntent } from "./files.js";

/** Operator-only persistence: never available through the ordinary Web File owner. */
export class PostgresFileReclamation implements FileReclamation {
  constructor(private readonly db: Database = businessDatabase()) {}
  /** No public actor can call these: trusted operator scans only never-committed intents. */
  candidates(beforeAt: number, quietMillis: number) {
    return this.db.transaction(async (sql) => {
      const result = await sql.query(
        `SELECT intent.* FROM file_upload_intents intent
         WHERE (intent.abandoned_at IS NOT NULL
             OR (intent.reclaimed_at IS NULL
                 AND intent.last_attempt_at <= to_timestamp($1::double precision/1000)
                 AND intent.last_attempt_at <= clock_timestamp() - ($2::double precision * interval '1 millisecond')))
           AND NOT EXISTS (
             SELECT 1 FROM file_commands receipt
             WHERE receipt.actor_user_id=intent.actor_user_id
               AND receipt.request_id=intent.request_id
           )
           AND NOT EXISTS (
             SELECT 1 FROM file_revisions revision WHERE revision.id=intent.revision_id
           )
         ORDER BY COALESCE(intent.reclaimed_at,intent.last_attempt_at),
           intent.actor_user_id,intent.request_id LIMIT 20`,
        [beforeAt, quietMillis],
        uploadIntent,
      );
      return result.rows;
    });
  }
  async quarantine(actor: string, requestId: string, beforeAt: number, quietMillis: number) {
    return this.db.transaction(async (sql) => {
      const observed = (
        await sql.query(
          "SELECT repository_id,file_id FROM file_upload_intents WHERE actor_user_id=$1 AND request_id=$2",
          [actor, requestId],
        )
      ).rows[0];
      if (!observed) return null;
      const repositoryId = stringValue(observed.repository_id);
      const fileId = stringValue(observed.file_id);
      // Exactly the same request-then-aggregate advisory lock order as File Upload/Finalize.
      await sql.query("SELECT pg_advisory_xact_lock(hashtext($1))", [
        `file-request:${actor}:${requestId}`,
      ]);
      await sql.query("SELECT pg_advisory_xact_lock(hashtext($1))", [
        `file-aggregate:${repositoryId}:file:${fileId}`,
      ]);
      const rows = (
        await sql.query(
          `UPDATE file_upload_intents intent
           SET abandoned_at=COALESCE(intent.abandoned_at,clock_timestamp())
           WHERE intent.actor_user_id=$1 AND intent.request_id=$2
             AND intent.repository_id=$3 AND intent.file_id=$4
             AND (intent.abandoned_at IS NOT NULL
               OR (intent.reclaimed_at IS NULL
                   AND intent.last_attempt_at <= to_timestamp($5::double precision/1000)
                   AND intent.last_attempt_at <= clock_timestamp() - ($6::double precision * interval '1 millisecond')))
             AND NOT EXISTS (
               SELECT 1 FROM file_commands receipt
               WHERE receipt.actor_user_id=intent.actor_user_id
                 AND receipt.request_id=intent.request_id
             )
             AND NOT EXISTS (
               SELECT 1 FROM file_revisions revision WHERE revision.id=intent.revision_id
             )
           RETURNING intent.*`,
          [actor, requestId, repositoryId, fileId, beforeAt, quietMillis],
          uploadIntent,
        )
      ).rows;
      return rows[0]?.revision ?? null;
    });
  }
  async markReclaimed(actor: string, requestId: string, revisionId: string) {
    return this.db.transaction(async (sql) => {
      const observed = (
        await sql.query(
          "SELECT repository_id,file_id,revision_id FROM file_upload_intents WHERE actor_user_id=$1 AND request_id=$2",
          [actor, requestId],
        )
      ).rows[0];
      if (!observed || observed.revision_id !== revisionId)
        throw new FileError(409, "Reclamation identity mismatch.", "SOURCE_INVALID");
      await sql.query("SELECT pg_advisory_xact_lock(hashtext($1))", [
        `file-request:${actor}:${requestId}`,
      ]);
      await sql.query("SELECT pg_advisory_xact_lock(hashtext($1))", [
        `file-aggregate:${stringValue(observed.repository_id)}:file:${stringValue(observed.file_id)}`,
      ]);
      const result = await sql.query(
        `UPDATE file_upload_intents intent SET reclaimed_at=clock_timestamp()
         WHERE intent.actor_user_id=$1 AND intent.request_id=$2 AND intent.revision_id=$3
           AND intent.abandoned_at IS NOT NULL
           AND NOT EXISTS (
             SELECT 1 FROM file_commands receipt
             WHERE receipt.actor_user_id=intent.actor_user_id
               AND receipt.request_id=intent.request_id
           )
           AND NOT EXISTS (
             SELECT 1 FROM file_revisions revision WHERE revision.id=intent.revision_id
           )`,
        [actor, requestId, revisionId],
      );
      if (result.rowCount === 1) return;
      const check = (
        await sql.query(
          `SELECT reclaimed_at FROM file_upload_intents WHERE actor_user_id=$1
           AND request_id=$2 AND revision_id=$3 AND abandoned_at IS NOT NULL`,
          [actor, requestId, revisionId],
        )
      ).rows[0];
      if (!check || check.reclaimed_at === null)
        throw new FileError(409, "Reclamation could not be recorded.", "LIFECYCLE_CONFLICT");
    });
  }
}
</file>

<file path="packages/file/src/application/use-cases/queries.ts">
import type { FileReads } from "../../contracts/output/files.js";
import type { FileObjectStore } from "../../contracts/output/object-store.js";
import { fileErrorFromUnknown } from "../../domain/error.js";
import { identifier, scopeId } from "../../domain/values.js";
import { fileDto, pendingDto } from "../file-projections.js";
import { createFileSourceReader } from "./sources.js";

/** Read-only File capabilities never require upload/reclamation dependencies. */
export function createFileQueries(deps: {
  reads: FileReads;
  objects: () => Pick<FileObjectStore, "readVerified">;
}) {
  const sources = createFileSourceReader(deps);
  return {
    async source(actor: string, scope: string, id: string, revision: string, maxBytes?: number) {
      const result = await sources.read(
        actor,
        scope,
        { fileId: id, fileRevisionId: revision },
        maxBytes,
      );
      return { file: fileDto(result.revision), bytes: result.bytes };
    },
    async list(actor: string, scope: string, after?: string) {
      try {
        const page = await deps.reads.list(
          actor,
          scopeId(scope),
          after === undefined ? undefined : identifier(after),
        );
        return { files: page.files.map(fileDto), next: page.next };
      } catch (error) {
        throw fileErrorFromUnknown(error);
      }
    },
    async overview(actor: string, scope: string) {
      try {
        const page = await deps.reads.overview(actor, scopeId(scope));
        return {
          files: page.files.map(fileDto),
          next: page.next,
          uploads: page.intents.map(pendingDto),
          pendingNext: page.pendingNext,
        };
      } catch (error) {
        throw fileErrorFromUnknown(error);
      }
    },
    async pendingUploads(actor: string, scope: string, after?: string) {
      try {
        const page = await deps.reads.pendingUploads(
          actor,
          scopeId(scope),
          after === undefined ? undefined : identifier(after),
        );
        return { uploads: page.intents.map(pendingDto), next: page.next };
      } catch (error) {
        throw fileErrorFromUnknown(error);
      }
    },
    async file(actor: string, scope: string, id: string, revision?: string) {
      try {
        return fileDto(
          await deps.reads.file(
            actor,
            scopeId(scope),
            identifier(id),
            revision === undefined ? undefined : identifier(revision),
          ),
        );
      } catch (error) {
        throw fileErrorFromUnknown(error);
      }
    },
  };
}
</file>

<file path="packages/file/src/application/use-cases/uploads.ts">
import type {
  FilePayloadInspector,
  FileTransaction,
  FileTransactions,
} from "../../contracts/output/files.js";
import type { FileObjectStore } from "../../contracts/output/object-store.js";
import { FileError, fileErrorFromUnknown } from "../../domain/error.js";
import { type FileDescriptor, type FileUploadIntent, nextFileRevision } from "../../domain/file.js";
import { assertWritable, checkVersion } from "../../domain/values.js";
import { directUploadCommand, uploadCommand } from "../commands/files.js";
import { fileDto } from "../file-projections.js";

function newWrite(tx: FileTransaction): void {
  if (tx.scope.archived) throw new FileError(409, "Repository is archived.", "LIFECYCLE_CONFLICT");
}

/** One command owner for durable intent, object I/O and atomic File revision commit. */
export function createFileUploads(deps: {
  transactions: FileTransactions;
  payloads: FilePayloadInspector;
  objects: () => FileObjectStore;
  now(): number;
}) {
  type UploadDetails = ReturnType<typeof uploadCommand>;
  function uploadIdentity(c: UploadDetails) {
    return { repositoryId: c.repositoryId, kind: "file" as const, id: c.fileId };
  }
  function uploadEvidence(c: UploadDetails, descriptor: FileDescriptor) {
    // The same payload fingerprint is used by legacy CLI and signed Web upload.
    return {
      requestId: c.requestId,
      payload: JSON.stringify({
        ...c,
        descriptor: {
          name: descriptor.name,
          mediaType: descriptor.mediaType,
          byteLength: descriptor.byteLength,
          sha256: descriptor.sha256,
        },
      }),
    };
  }
  async function prepareUploadIntent(
    actor: string,
    c: UploadDetails,
    descriptor: FileDescriptor,
    mode: "prepare" | "resume",
  ) {
    return deps.transactions.transact(
      actor,
      uploadIdentity(c),
      uploadEvidence(c, descriptor),
      async (tx) => {
        assertWritable(tx.scope.permissions);
        const replay = await tx.replay();
        if (replay) return { committed: true as const, revision: replay.revision };
        newWrite(tx);
        const pending = await tx.uploads.load();
        if (!pending && mode === "resume")
          throw new FileError(409, "Upload intent was not prepared.", "LIFECYCLE_CONFLICT");
        const current = await tx.files.load(c.fileId);
        checkVersion(current, c.expectedVersion);
        if (pending) {
          await tx.uploads.touch();
          return { committed: false as const, intent: pending };
        }
        const revision = nextFileRevision(current, c.expectedVersion, c.fileId, descriptor, {
          id: tx.nextId(),
          repositoryId: tx.scope.repositoryId,
          actorUserId: actor,
          at: deps.now(),
        });
        const intent: FileUploadIntent = {
          requestId: c.requestId,
          expectedVersion: c.expectedVersion,
          revision,
        };
        await tx.uploads.prepare(intent);
        return { committed: false as const, intent };
      },
    );
  }
  async function finalize(actor: string, c: UploadDetails, descriptor: FileDescriptor) {
    return deps.transactions.transact(
      actor,
      uploadIdentity(c),
      uploadEvidence(c, descriptor),
      async (tx) => {
        assertWritable(tx.scope.permissions);
        const replay = await tx.replay();
        if (replay) return { requestId: c.requestId, file: fileDto(replay.revision) };
        newWrite(tx);
        const intent = await tx.uploads.load();
        if (!intent) throw new FileError(503, "Upload intent unavailable.", "UNAVAILABLE");
        const current = await tx.files.load(c.fileId);
        const next = nextFileRevision(
          current,
          intent.expectedVersion,
          c.fileId,
          intent.revision,
          intent.revision,
        );
        await tx.files.save(next, intent.expectedVersion);
        await tx.record({ kind: "file", requestId: c.requestId, revision: next });
        return { requestId: c.requestId, file: fileDto(next) };
      },
    );
  }

  return {
    /** Prepare an immutable request before allowing an untrusted browser to write bytes. */
    async prepareUpload(actor: string, input: unknown) {
      try {
        const { descriptor, ...c } = directUploadCommand(input);
        const prepared = await prepareUploadIntent(actor, c, descriptor, "prepare");
        if (prepared.committed) return { requestId: c.requestId, file: fileDto(prepared.revision) };
        const objects = deps.objects();
        const sign = objects.signUpload;
        if (!sign) throw new FileError(503, "Signed uploads are unavailable.", "UNAVAILABLE");
        const signedUrl = await sign.call(objects, prepared.intent.revision);
        // Signing is external I/O: do not disclose a capability after access was revoked.
        const current = await prepareUploadIntent(actor, c, descriptor, "resume");
        if (current.committed) return { requestId: c.requestId, file: fileDto(current.revision) };
        return { requestId: c.requestId, signedUrl, revisionId: prepared.intent.revision.id };
      } catch (error) {
        throw fileErrorFromUnknown(error);
      }
    },
    /** Finalize only after an independent Storage read proves digest and exact length. */
    async completeUpload(actor: string, input: unknown) {
      try {
        const { descriptor, ...c } = directUploadCommand(input);
        const prepared = await prepareUploadIntent(actor, c, descriptor, "resume");
        if (prepared.committed) return { requestId: c.requestId, file: fileDto(prepared.revision) };
        // No database lock is held while downloading and verifying untrusted bytes.
        await deps.objects().readVerified(prepared.intent.revision);
        return await finalize(actor, c, descriptor);
      } catch (error) {
        throw fileErrorFromUnknown(error);
      }
    },
    /** Existing CLI/multipart contract is retained; both transports share File invariants. */
    async upload(actor: string, input: unknown, bytes: Uint8Array) {
      try {
        const c = uploadCommand(input);
        const payload = deps.payloads.inspect(bytes, c.name, c.mediaType);
        const prepared = await prepareUploadIntent(actor, c, payload.descriptor, "prepare");
        if (prepared.committed) return { requestId: c.requestId, file: fileDto(prepared.revision) };
        await deps.objects().putVerified(prepared.intent.revision, payload.bytes);
        return await finalize(actor, c, payload.descriptor);
      } catch (error) {
        throw fileErrorFromUnknown(error);
      }
    },
  };
}
</file>

