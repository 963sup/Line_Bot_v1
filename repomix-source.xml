import type { RepositoryDiscoveryStore } from "@line_bot_v1/repository/contracts/discovery";

const TRENDING_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;
const TRENDING_LIMIT = 20;
const PUBLISHED_STAR_LIST_LIMIT = 20;

export function createRepositoryDiscovery(deps: {
  activeUser(subject: string): Promise<{ id: string }>;
  store(): RepositoryDiscoveryStore;
  now(): number;
}) {
  return {
    discover: async (subject: string) => {
      const userId = (await deps.activeUser(subject)).id;
      const now = deps.now();
      return deps.store().snapshot(userId, {
        recentSince: Math.max(0, now - TRENDING_WINDOW_MS),
        trendingLimit: TRENDING_LIMIT,
      });
    },
    publishedStarLists: async (subject: string) =>
      deps
        .store()
        .publishedStarLists((await deps.activeUser(subject)).id, PUBLISHED_STAR_LIST_LIMIT),
  };
}
</file>

