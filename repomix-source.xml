import { UserError } from "@line_bot_v1/account/domain/user";
import { readActiveUserQualification, readUserQualification } from "@line_bot_v1/account/postgres";
import { businessDatabase, type Database, type Sql } from "@line_bot_v1/platform/postgres";
import {
  booleanValue,
  numberValue,
  numericValue,
  record,
  stringValue,
} from "@line_bot_v1/platform/validation";
import type {
  PermissionChangeTransaction,
  PermissionPersistence,
} from "../../../contracts/output/permission-transactions.js";
import type { PermissionGrant, PermissionView } from "../../../contracts/permissions.js";
import {
  assertPermissionAdministratorDeactivation,
  type Permission,
  PermissionError,
  permissions,
} from "../../../domain/permission.js";

function versionRow(row: Record<string, unknown>) {
  return { version: numberValue(row.version) };
}

function userVersionRow(row: Record<string, unknown>) {
  return { user_version: numberValue(row.user_version) };
}

function administratorRow(row: Record<string, unknown>) {
  return { user_id: stringValue(row.user_id), user_version: numberValue(row.user_version) };
}

function grantRow(row: Record<string, unknown>) {
  return { permission: stringValue(row.permission), user_version: numberValue(row.user_version) };
}

function historyRow(row: Record<string, unknown>): PermissionView["history"][number] {
  return {
    requestId: stringValue(row.requestId),
    actor: stringValue(row.actor),
    permission: stringValue(row.permission),
    enabled: booleanValue(row.enabled),
    reason: stringValue(row.reason),
    at: Number(numericValue(row.at)),
  };
}

function permissionChangeResult(value: unknown) {
  const result = record(value);
  return { requestId: stringValue(result.requestId), version: numberValue(result.version) };
}

function previousCommandRow(row: Record<string, unknown>) {
  return { matches: booleanValue(row.matches), result: permissionChangeResult(row.result) };
}

async function permissionVersion(sql: Sql, userId: string, lock = false): Promise<number> {
  const row = (
    await sql.query(
      `SELECT version FROM permission_subject_versions WHERE user_id=$1${lock ? " FOR UPDATE" : ""}`,
      [userId],
      versionRow,
    )
  ).rows[0];
  return Number(row?.version ?? 0);
}

async function advancePermissionVersion(
  sql: Sql,
  userId: string,
  current: number,
): Promise<number> {
  const next = current + 1;
  await sql.query(
    `INSERT INTO permission_subject_versions(user_id,version) VALUES($1,$2)
     ON CONFLICT(user_id) DO UPDATE SET version=EXCLUDED.version`,
    [userId, next],
  );
  return next;
}

export async function hasPermission(sql: Sql, actor: string, permission: Permission) {
  const user = await readActiveUserQualification(sql, actor, "share");
  if (!user) return false;
  return Boolean(
    (
      await sql.query(
        `SELECT 1 FROM permission_grants
         WHERE user_id=$1 AND user_version=$2 AND permission=$3`,
        [actor, user.statusVersion, permission],
      )
    ).rows.length,
  );
}

async function manager(sql: Sql, actor: string) {
  const assignment = (
    await sql.query(
      "SELECT user_version FROM permission_administrators WHERE user_id=$1",
      [actor],
      userVersionRow,
    )
  ).rows[0];
  if (!assignment) return false;
  const user = await readActiveUserQualification(sql, actor, "share");
  return Boolean(user && user.statusVersion === Number(assignment.user_version));
}

export async function protectPermissionAdministrator(sql: Sql, userId: string) {
  const assignment = (
    await sql.query(
      "SELECT user_version FROM permission_administrators WHERE user_id=$1",
      [userId],
      userVersionRow,
    )
  ).rows[0];
  const current = assignment ? await readActiveUserQualification(sql, userId, "share") : null;
  const targetEffective = Boolean(assignment && current?.statusVersion === assignment.user_version);
  let anotherEffective = false;
  if (targetEffective) {
    const others = (
      await sql.query(
        "SELECT user_id,user_version FROM permission_administrators WHERE user_id<>$1 ORDER BY user_id",
        [userId],
        administratorRow,
      )
    ).rows;
    for (const other of others) {
      const qualification = await readActiveUserQualification(sql, other.user_id, "share");
      if (qualification?.statusVersion === Number(other.user_version)) {
        anotherEffective = true;
        break;
      }
    }
  }
  assertPermissionAdministratorDeactivation(targetEffective, anotherEffective);
}

async function grants(sql: Sql, id: string): Promise<PermissionGrant[]> {
  const qualification = await readUserQualification(sql, id);
  const rows = (
    await sql.query(
      `SELECT permission,user_version
       FROM permission_grants
       WHERE user_id=$1 AND permission::text=ANY($2::text[])
      ORDER BY permission`,
      [id, Object.keys(permissions)],
      grantRow,
    )
  ).rows;
  return rows.map((row) => ({
    permission: row.permission,
    effective:
      qualification?.status === "active" &&
      Number(row.user_version) === qualification.statusVersion,
  }));
}

export class PostgresPermissionPersistence implements PermissionPersistence {
  constructor(private db: Database = businessDatabase()) {}

  read(actor: string, target: string): Promise<PermissionView> {
    return this.db.transaction(async (sql) => {
      await sql.query("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ");
      if (!(await readActiveUserQualification(sql, actor, "share"))) {
        throw new UserError(403, "需要有效使用者。");
      }
      const canManage = await manager(sql, actor);
      if (target && !canManage) throw new PermissionError(403, "沒有權限管理資格。");
      const own = await grants(sql, actor);
      if (!target) {
        return {
          userId: actor,
          canManage,
          own,
          target: null,
          history: [],
          moreHistory: false,
        };
      }

      const user = await readUserQualification(sql, target);
      if (!user) throw new UserError(404, "使用者不存在。");
      const version = await permissionVersion(sql, target);
      const rows = (
        await sql.query(
          `SELECT request_id AS "requestId",actor,command->>'permission' AS permission,
                  (command->>'enabled')::boolean AS enabled,
                  command->>'reason' AS reason,at
           FROM permission_commands
           WHERE target=$1 AND command->>'permission'=ANY($2::text[])
           ORDER BY at DESC,request_id DESC
          LIMIT 21`,
          [target, Object.keys(permissions)],
          historyRow,
        )
      ).rows;
      return {
        userId: actor,
        canManage,
        own,
        target: {
          id: user.id,
          status: user.status,
          version,
          grants: await grants(sql, target),
        },
        history: rows.slice(0, 20),
        moreHistory: rows.length > 20,
      };
    });
  }

  transact<T>(
    actor: string,
    targetId: string,
    evidence: { requestId: string; payload: string },
    work: (transaction: PermissionChangeTransaction) => Promise<T>,
  ): Promise<T> {
    return this.db.transaction(async (sql) => {
      await sql.query("SELECT app_private.lock_governance('exclusive')");
      const qualifications = new Map<string, Awaited<ReturnType<typeof readUserQualification>>>();
      for (const userId of [...new Set([actor, targetId])].sort()) {
        qualifications.set(userId, await readUserQualification(sql, userId, "update"));
      }
      const canManage = await manager(sql, actor);
      const target = qualifications.get(targetId);
      return work({
        canManage,
        target: target ? { active: target.status === "active" } : null,
        replay: async () =>
          (
            await sql.query(
              "SELECT command=$3::jsonb AS matches,result FROM permission_commands WHERE actor=$1 AND request_id=$2",
              [actor, evidence.requestId, evidence.payload],
              previousCommandRow,
            )
          ).rows[0] ?? null,
        version: () => permissionVersion(sql, targetId, true),
        dependencies: async () => {
          const row = (
            await sql.query(
              `SELECT $3::boolean AND EXISTS(
               SELECT 1 FROM permission_grants WHERE user_id=$1 AND user_version=$2 AND permission='users.read'
             ) AS can_read_users,
             EXISTS(SELECT 1 FROM permission_grants WHERE user_id=$1 AND permission='users.suspend') AS has_suspend_grant`,
              [targetId, target?.statusVersion ?? 0, target?.status === "active"],
              (row) => ({
                canReadUsers: booleanValue(row.can_read_users),
                hasSuspendGrant: booleanValue(row.has_suspend_grant),
              }),
            )
          ).rows[0];
          if (!row) throw new Error("Permission dependency projection is missing");
          return row;
        },
        save: async (permission, enabled, currentVersion, now) => {
          if (!target) throw new Error("Permission target is missing");
          const before = (
            await sql.query(
              "SELECT * FROM permission_grants WHERE user_id=$1 ORDER BY permission,workplace_id NULLS FIRST",
              [targetId],
            )
          ).rows;
          await sql.query("DELETE FROM permission_grants WHERE user_id=$1 AND permission=$2", [
            targetId,
            permission,
          ]);
          if (enabled) {
            await sql.query(
              `INSERT INTO permission_grants(user_id,permission,user_version,granted_by,granted_at)
               VALUES($1,$2,$3,$4,$5)`,
              [targetId, permission, target.statusVersion, actor, now],
            );
          }
          const version = await advancePermissionVersion(sql, targetId, currentVersion);
          const result = { requestId: evidence.requestId, version };
          await sql.query(
            "INSERT INTO permission_commands(actor,request_id,target,command,before_grants,after_grants,result,at) VALUES($1,$2,$3,$4,$5,$6,$7,$8)",
            [
              actor,
              evidence.requestId,
              targetId,
              evidence.payload,
              JSON.stringify(before),
              JSON.stringify(
                (
                  await sql.query(
                    "SELECT * FROM permission_grants WHERE user_id=$1 ORDER BY permission,workplace_id NULLS FIRST",
                    [targetId],
                  )
                ).rows,
              ),
              JSON.stringify(result),
              now,
            ],
          );
          return result;
        },
      });
    });
  }
}
</file>

