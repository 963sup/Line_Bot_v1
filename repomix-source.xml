    return jsonResponse(
      await discussions.detailByNumber(
        await requestLineIdentity(request),
        repositoryPathSelector(ownerLogin, repositoryName),
        number,
        params.get("commentsAfter") ?? undefined,
      ),
    );
  } catch (error) {
    return repositoryFailure(error);
  }
}
