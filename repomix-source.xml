  miniAppUrl: string;
}) {
  const {
    user,
    token,
    busy,
    lineName,
    inClient,
    error,
    pauseConfirmation,
    notice,
    initialize,
    refresh,
    action,
    setBusy,
    setPauseConfirmation,
    pending,
    googleLink,
  } = useUser(liffId);
  return (
    <div className="membership-panel">
      <MiniAppRuntime liffId={liffId} onReady={initialize} onWait={() => setBusy(false)} />
      <header className="membership-hero">
