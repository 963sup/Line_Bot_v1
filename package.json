{
  "name": "line_bot_v1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "dev": "turbo run dev --filter=@line_bot_v1/web",
    "build": "node scripts/check.mjs build --",
    "typecheck": "node scripts/check.mjs typecheck --",
    "test": "node scripts/check.mjs test --",
    "lint": "node scripts/check.mjs lint --",
    "check:repository": "node scripts/check.mjs check:repository --",
    "format": "node scripts/check.mjs format --",
    "schema:check": "node scripts/check.mjs schema:check --",
    "provider:supabase": "tsx scripts/providers/supabase.ts",
    "provider:vercel": "tsx scripts/providers/vercel.ts",
    "line:rich-menu": "tsx scripts/providers/line-rich-menu.ts",
    "supabase:stop": "pnpm exec supabase stop --no-backup",
    "start": "pnpm --filter @line_bot_v1/web start"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@biomejs/biome": "catalog:",
