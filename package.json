{
  "name": "line_bot_v1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@line_bot_v1/web",
    "build": "turbo run build",
    "start": "npm run start --workspace=@line_bot_v1/web",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "2.10.12",
    "typescript": "^5.7.3",
    "pg": "^8.13.3",
    "@types/pg": "^8.11.11",
    "@types/node": "^22.13.0"
  }
}
