{
  "name": "line_bot_v1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@line_bot_v1/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:browser": "node scripts/browser/run-local.mjs",
    "line:rich-menu": "pnpm --filter @line_bot_v1/web exec tsx ../../scripts/line/rich-menu/sync.ts",
    "attendance:scheduler": "node scripts/attendance/scheduler.mjs",
    "vercel:deploy:production": "node scripts/vercel/deploy-production.mjs",
    "check": "node scripts/tooling/validate.mjs --fast",
    "validate": "node scripts/tooling/validate.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "architecture": "node scripts/architecture/check-all.mjs",
    "architecture:test": "node --test scripts/architecture/check-architecture.test.mjs scripts/architecture/check-convergence-guardrails.test.mjs scripts/architecture/check-semantic-benchmark.test.mjs scripts/architecture/check-semantic-architecture.test.mjs scripts/architecture/check-data-topology.test.mjs scripts/architecture/check-data-access.test.mjs",
    "deadcode": "knip",
    "docs:check": "node scripts/docs/check-docs.mjs && node scripts/docs/convergence.mjs check",
    "docs:test": "node --test scripts/docs/check-docs.test.mjs scripts/docs/convergence.test.mjs",
    "docs:convergence": "node scripts/docs/convergence.mjs",
    "schema:check": "turbo run schema:check",
    "schema:local": "node scripts/supabase/schema-local.mjs",
    "tooling:check": "node scripts/tooling/check-tooling.mjs",
    "tooling:rules": "node scripts/tooling/check-rules.mjs",
    "start": "pnpm --filter @line_bot_v1/web start",
    "boundaries": "node scripts/architecture/check-implementation-topology.mjs",
    "schema:remote": "node scripts/supabase/remote.mjs",
    "schema:remote:test": "node --test scripts/supabase/postgres.test.mjs scripts/supabase/remote.test.mjs",
    "probe:agent": "node scripts/probes/check-agent.mjs --live",
    "probe:expense-card": "node scripts/probes/check-expense-card.mjs --live",
    "probe:gemini": "node scripts/probes/check-gemini.mjs --live",
    "probe:line": "node scripts/probes/check-line.mjs --live",
    "probe:receipt": "node scripts/probes/check-receipt.mjs --live",
    "probe:redis": "node scripts/probes/check-redis.mjs --live",
    "semantic": "node scripts/architecture/semantic-cli.mjs",
    "patch:apply": "node scripts/changes/patch-apply.mjs",
    "github:current-main": "node scripts/github/current-main.mjs",
    "github:release-plan": "node scripts/github/release-plan.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "dependency-cruiser": "18.2.0",
    "knip": "6.34.0",
    "smol-toml": "1.8.0",
    "supabase": "2.116.0",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "yaml": "2.9.0",
    "pg": "catalog:"
  }
}
