{
  "name": "line_bot_v1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@line_bot_v1/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:browser": "node scripts/browser/run-local.mjs",
    "line:rich-menu": "pnpm --filter @line_bot_v1/web exec tsx ../../scripts/line/rich-menu/sync.ts",
    "attendance:scheduler": "node scripts/attendance/scheduler.mjs",
    "vercel:deploy:production": "node scripts/vercel/deploy-production.mjs",
    "check": "node scripts/tooling/validate.mjs --fast",
    "validate": "node scripts/tooling/validate.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "architecture": "node scripts/architecture/check-all.mjs",
    "architecture:test": "node --test scripts/architecture/*.test.mjs",
    "deadcode": "knip",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "docs:test": "node --test scripts/docs/check-docs.test.mjs",
    "schema:check": "turbo run schema:check",
    "schema:local": "node scripts/supabase/schema-local.mjs",
    "tooling:check": "node scripts/tooling/check-tooling.mjs",
    "tooling:rules": "node scripts/tooling/check-rules.mjs",
    "tooling:doctor": "node scripts/tooling/doctor.mjs",
    "skills:list": "node scripts/tooling/list-skills.mjs",
    "start": "pnpm --filter @line_bot_v1/web start",
    "boundaries": "node scripts/architecture/check-implementation-topology.mjs",
    "schema:remote": "node scripts/supabase/remote.mjs",
    "storage:remote": "node scripts/supabase/storage.mjs",
    "schema:remote:test": "node --test scripts/supabase/*.test.mjs",
    "probe:agent": "node scripts/probes/check-agent.mjs --live",
    "probe:expense-card": "node scripts/probes/check-expense-card.mjs --live",
    "probe:gemini": "node scripts/probes/check-gemini.mjs --live",
    "probe:line": "node scripts/probes/check-line.mjs --live",
    "probe:receipt": "node scripts/probes/check-receipt.mjs --live",
    "probe:redis": "node scripts/probes/check-redis.mjs --live",
    "semantic": "node scripts/architecture/semantic-cli.mjs",
    "code": "node scripts/code/cli.mjs",
    "patch:apply": "node scripts/changes/patch-apply.mjs",
    "change:status": "node scripts/changes/status.mjs",
    "change:preflight": "node scripts/changes/preflight.mjs",
    "change:finalize": "node scripts/changes/finalize.mjs",
    "github:current-main": "node scripts/github/current-main.mjs",
    "github:release-plan": "node scripts/github/release-plan.mjs",
    "github:rich-menu-ready": "node scripts/github/rich-menu-ready.mjs",
    "wiki:run": "node scripts/wiki/run.mjs",
    "insights:run": "node scripts/insights/run.mjs",
    "actions:run": "node scripts/actions/run.mjs",
    "actions:worker": "node scripts/actions/worker.mjs",
    "project-actions:run": "node scripts/actions/project-run.mjs",
    "project-actions:worker": "node scripts/actions/project-worker.mjs",
    "wbs:transfer": "node scripts/wbs/transfer.mjs",
    "project:imports": "node scripts/project/imports.mjs",
    "contract:run": "node scripts/contract/run.mjs",
    "execution:run": "node scripts/execution/run.mjs",
    "file:run": "node scripts/file/run.mjs",
    "file:reclaim": "node scripts/file/reclaim.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@biomejs/biome": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "smol-toml": "catalog:",
    "supabase": "catalog:",
    "ts-morph": "27.0.2",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "pg": "catalog:",
    "@line_bot_v1/wiki": "workspace:*",
    "@line_bot_v1/account": "workspace:*",
    "@line_bot_v1/line": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/insights": "workspace:*",
    "@line_bot_v1/intelligence": "workspace:*",
    "@line_bot_v1/issue": "workspace:*",
    "@line_bot_v1/wbs": "workspace:*",
    "@line_bot_v1/project": "workspace:*",
    "@line_bot_v1/repository": "workspace:*",
    "@line_bot_v1/actions": "workspace:*",
    "@line_bot_v1/notifications": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "next-devtools-mcp": "0.4.0",
    "@line_bot_v1/contract": "workspace:*",
    "@line_bot_v1/execution": "workspace:*",
    "libpg-query": "17.7.4",
    "@line_bot_v1/file": "workspace:*"
  }
}
