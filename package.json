{
  "name": "line_bot_v1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@line_bot_v1/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deadcode": "knip",
    "schema:check": "turbo run schema:check",
    "supabase:stop": "pnpm exec supabase stop --no-backup",
    "start": "pnpm --filter @line_bot_v1/web start"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@biomejs/biome": "catalog:",
    "@line_bot_v1/account": "workspace:*",
    "@line_bot_v1/actions": "workspace:*",
    "@line_bot_v1/contract": "workspace:*",
    "@line_bot_v1/execution": "workspace:*",
    "@line_bot_v1/file": "workspace:*",
    "@line_bot_v1/insights": "workspace:*",
    "@line_bot_v1/intelligence": "workspace:*",
    "@line_bot_v1/issue": "workspace:*",
    "@line_bot_v1/line": "workspace:*",
    "@line_bot_v1/notifications": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/project": "workspace:*",
    "@line_bot_v1/repository": "workspace:*",
    "@line_bot_v1/wbs": "workspace:*",
    "@line_bot_v1/wiki": "workspace:*",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "libpg-query": "17.7.4",
    "next-devtools-mcp": "0.4.0",
    "pg": "catalog:",
    "smol-toml": "catalog:",
    "supabase": "catalog:",
    "ts-morph": "27.0.2",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-language-server": "5.1.3",
    "yaml": "catalog:"
  }
}
