      "cache": false,
      "dependsOn": ["^build", "@line_bot_v1/actions#build", "@line_bot_v1/line#build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql",
        "$TURBO_ROOT$/scripts/operations/actions/*.mjs"
