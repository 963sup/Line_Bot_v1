      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "@line_bot_v1/attendance#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "@line_bot_v1/identity-access#test": {
      "cache": false,
      "dependsOn": ["^build"],
