{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "githubActionsRemoteBaseRefFallback": true
  },
  "globalPassThroughEnv": ["npm_config_store_dir"],
  "globalDependencies": [
    "tsconfig.base.json",
    "biome.json",
    "knip.jsonc",
    ".dependency-cruiser.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "schema:check": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@line_bot_v1/web#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "VERCEL", "VERCEL_ENV", "SENTRY_ORG", "SENTRY_PROJECT"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env.local", "$TURBO_ROOT$/.vercelignore"]
    },
    "@line_bot_v1/web#typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@line_bot_v1/namespace#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql",
        "$TURBO_ROOT$/apps/web/src/app/**"
      ]
    },
    "@line_bot_v1/wbs#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["WBS_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "@line_bot_v1/numbering#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "@line_bot_v1/web#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "@line_bot_v1/platform#schema:check": {
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/integration-supabase/src/config.toml",
        "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql",
        "$TURBO_ROOT$/scripts/providers/supabase/*.mjs"
      ]
    },
    "@line_bot_v1/wiki#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "@line_bot_v1/repository#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/integration-supabase/src/schemas/*.sql"]
    },
    "@line_bot_v1/platform#test": {
      "cache": false,
