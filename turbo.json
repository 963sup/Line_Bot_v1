{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "githubActionsRemoteBaseRefFallback": true
  },
  "globalPassThroughEnv": ["npm_config_store_dir"],
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "schema:check": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@line_bot_v1/web#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "VERCEL", "VERCEL_ENV", "SENTRY_ORG", "SENTRY_PROJECT"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env.local",
        "$TURBO_ROOT$/scripts/runtime/load-env.mjs",
        "$TURBO_ROOT$/scripts/runtime/next.mjs"
      ]
    },
    "@line_bot_v1/web#typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/runtime/load-env.mjs",
        "$TURBO_ROOT$/scripts/runtime/next.mjs"
      ]
    },
    "@line_bot_v1/namespace#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/schemas/*.sql",
        "$TURBO_ROOT$/apps/web/src/app/**"
      ]
    },
    "@line_bot_v1/wbs#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["WBS_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "@line_bot_v1/web#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/schemas/*.sql",
        "$TURBO_ROOT$/scripts/runtime/load-env.mjs",
        "$TURBO_ROOT$/scripts/runtime/load-env.test.mjs",
        "$TURBO_ROOT$/scripts/probes/*.mjs"
      ]
    },
    "@line_bot_v1/platform#schema:check": {
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/config.toml",
        "$TURBO_ROOT$/supabase/schemas/*.sql",
        "$TURBO_ROOT$/scripts/supabase/*.mjs"
      ]
    },
    "@line_bot_v1/wiki#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "@line_bot_v1/repository#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "@line_bot_v1/platform#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "@line_bot_v1/attendance#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "@line_bot_v1/identity-access#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "@line_bot_v1/account#test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/supabase/schemas/*.sql"]
    },
    "@line_bot_v1/actions#test": {
      "cache": false,
      "dependsOn": ["^build", "@line_bot_v1/actions#build", "@line_bot_v1/line#build"],
      "outputs": [],
      "env": ["CAPABILITY_TEST_DATABASE_URL", "CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/schemas/*.sql",
        "$TURBO_ROOT$/scripts/actions/*.mjs"
      ]
    }
  }
}
