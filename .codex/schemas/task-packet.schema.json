{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://line-bot-v1.local/codex/schemas/task-packet.schema.json",
  "title": "Atomic task packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "goal", "scope", "inputs", "invariants", "deliverable", "stopCondition", "validationOwner"],
  "properties": {
    "version": { "const": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "atomicId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "excluded"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "owners": { "type": "array", "items": { "type": "string" } },
        "providerBoundaries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deliverable": { "type": "string", "minLength": 1 },
    "stopCondition": { "type": "string", "minLength": 1 },
    "validationOwner": { "type": "string", "minLength": 1 }
  }
}
