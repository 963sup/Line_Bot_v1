{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://line-bot-v1.local/codex/schemas/capability-route.schema.json",
  "title": "Capability route",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "authority", "consumerRole", "trigger", "preflight", "proves", "doesNotProve", "prohibited", "fallback"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "authority": { "type": "string", "minLength": 1 },
    "consumerRole": { "type": "string", "minLength": 1 },
    "trigger": { "type": "string", "minLength": 1 },
    "preflight": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "proves": { "type": "string", "minLength": 1 },
    "doesNotProve": { "type": "string", "minLength": 1 },
    "prohibited": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fallback": { "type": "string", "minLength": 1 }
  }
}
