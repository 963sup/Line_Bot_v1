{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://line-bot-v1.local/codex/schemas/atomic-catalog.schema.json",
  "title": "Candidate atomic-operation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "atomics"],
  "properties": {
    "version": { "const": 2 },
    "atomics": {
      "type": "array",
      "minItems": 181,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "status", "goal", "input", "must", "mustNot", "deliverable", "stopCondition", "evidenceBoundary", "requiredCapabilityRouteIds", "activationCriteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "family": { "enum": ["locate-research", "analyse-decide", "design-plan", "implement-document", "review", "runtime-diagnose", "validate-accept"] },
          "status": { "enum": ["candidate", "enabled", "retired"] },
          "executorRoleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "candidateRoleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "goal": { "type": "string", "minLength": 1 },
          "input": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "must": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "mustNot": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "deliverable": { "type": "string", "minLength": 1 },
          "stopCondition": { "type": "string", "minLength": 1 },
          "evidenceBoundary": { "type": "string", "minLength": 1 },
          "requiredCapabilityRouteIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "activationCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "enabled" } } },
            "then": { "required": ["executorRoleId"], "not": { "required": ["candidateRoleIds"] } },
            "else": { "required": ["candidateRoleIds"], "not": { "required": ["executorRoleId"] } }
          }
        ]
      }
    }
  }
}
