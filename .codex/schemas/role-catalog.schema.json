{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://line-bot-v1.local/codex/schemas/role-catalog.schema.json",
  "title": "Candidate role catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roles"],
  "properties": {
    "version": { "const": 2 },
    "roles": {
      "type": "array",
      "minItems": 58,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "status", "mission", "input", "deliverable", "stopCondition", "evidenceBoundary", "activationCriteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "family": { "enum": ["locate-research", "analyse-decide", "design-plan", "implement-document", "review", "runtime-diagnose", "validate-accept"] },
          "status": { "enum": ["candidate", "enabled", "retired"] },
          "mission": { "type": "string", "minLength": 1 },
          "input": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "deliverable": { "type": "string", "minLength": 1 },
          "stopCondition": { "type": "string", "minLength": 1 },
          "evidenceBoundary": { "type": "string", "minLength": 1 },
          "activationCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "profilePath": { "type": "string", "pattern": "^\\.codex/agents/l3-[a-z0-9-]+-gpt-5\\.6-(luna|terra)\\.toml$" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "enabled" } } },
            "then": { "required": ["profilePath"] },
            "else": { "not": { "required": ["profilePath"] } }
          }
        ]
      }
    }
  }
}
