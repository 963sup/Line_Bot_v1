playwright_commands = ["playwright", "playwright.exe"]

prefix_rule(
    pattern = [playwright_commands, ["--version", "test"]],
    decision = "allow",
    justification = "Playwright version checks and repository-pinned browser tests are local validation operations.",
    match = [
        "playwright --version",
        "playwright test",
    ],
    not_match = ["playwright install"],
)

prefix_rule(
    pattern = [playwright_commands, ["install", "codegen"]],
    decision = "prompt",
    justification = "Playwright install or interactive browser generation can download executables or open external browser flows.",
    match = [
        "playwright install",
        "playwright codegen https://example.com",
    ],
    not_match = ["playwright test"],
)
