knip_commands = ["knip", "knip.exe"]

prefix_rule(
    pattern = [knip_commands, "--version"],
    decision = "allow",
    justification = "Knip version is a local tool availability check.",
    match = ["knip --version"],
    not_match = ["knip --fix"],
)

prefix_rule(
    pattern = [knip_commands, ["--reporter", "--fix"]],
    decision = "prompt",
    justification = "Knip analysis may write reports or apply fixes depending on flags and requires review of the exact operation.",
    match = [
        "knip --reporter compact",
        "knip --fix",
    ],
    not_match = ["knip --version"],
)
