gitleaks_commands = ["gitleaks", "gitleaks.exe"]

# ============================================================
# gitleaks: local secret scanning
# ============================================================

prefix_rule(
    pattern = [gitleaks_commands, "version"],
    decision = "allow",
    justification = "gitleaks version is a local tool availability check.",
    match = ["gitleaks version"],
    not_match = ["gitleaks dir ."],
)

prefix_rule(
    pattern = [gitleaks_commands, ["dir", "detect", "protect"], "--redact"],
    decision = "allow",
    justification = "Redacted gitleaks scans are bounded local validation and do not expose detected secret values in output.",
    match = [
        "gitleaks dir --redact .",
        "gitleaks detect --redact",
        "gitleaks protect --redact",
    ],
    not_match = [
        "gitleaks dir .",
        "gitleaks detect",
    ],
)

prefix_rule(
    pattern = [gitleaks_commands, "dir", "."],
    decision = "prompt",
    justification = "Unredacted secret scans may expose sensitive findings in command output and require review before execution.",
    match = [
        "gitleaks dir .",
    ],
    not_match = [
        "gitleaks dir --redact .",
    ],
)
