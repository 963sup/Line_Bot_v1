










# ============================================================
# GCP
# ============================================================

prefix_rule(
    pattern = [["gcloud", "gcloud.cmd"], "iam", "service-accounts", "keys", "create"],
    decision = "prompt",
    justification = "Do not create long-lived service-account keys. If GCP is explicitly needed, use restricted ADC per AGENTS.md.",
    match = [
        "gcloud iam service-accounts keys create example.json --iam-account=example",
        "gcloud.cmd iam service-accounts keys create example.json",
    ],
    not_match = [
        "gcloud iam service-accounts list",
    ],
)

prefix_rule(
    pattern = [["gcloud", "gcloud.cmd"], "run", "deploy"],
    decision = "prompt",
    justification = "Confirm the exact project, service, image digest and existing deployment authorization.",
    match = [
        "gcloud run deploy line-bot-v1-web --project=example",
        "gcloud.cmd run deploy line-bot-v1-web",
    ],
    not_match = [
        "gcloud run services describe line-bot-v1-web",
    ],
)

prefix_rule(
    pattern = [["gcloud", "gcloud.cmd"], "sql", "instances", "delete"],
    decision = "prompt",
    justification = "Database deletion requires an exact target and explicit destructive-action authorization.",
    match = [
        "gcloud sql instances delete line-bot-v1-db",
        "gcloud.cmd sql instances delete line-bot-v1-db",
    ],
    not_match = [
        "gcloud sql instances describe line-bot-v1-db",
    ],
)

prefix_rule(
    pattern = [["gcloud", "gcloud.cmd"], "secrets", "versions", "destroy"],
    decision = "prompt",
    justification = "Confirm the secret, version and authorization before destroying a secret version.",
    match = [
        "gcloud secrets versions destroy 1 --secret=example",
        "gcloud.cmd secrets versions destroy 1 --secret=example",
    ],
    not_match = [
        "gcloud secrets versions list example",
    ],
)
