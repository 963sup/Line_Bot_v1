npm_commands = ["npm", "npm.exe", "npm.cmd"]

prefix_rule(
    pattern = [npm_commands, "--version"],
    decision = "allow",
    justification = "npm version is a local environment check; this repository uses pnpm for dependency management.",
    match = ["npm --version"],
    not_match = ["npm install", "npm publish"],
)

prefix_rule(
    pattern = [npm_commands, ["install", "i", "update", "uninstall", "publish"]],
    decision = "prompt",
    justification = "This repository uses pnpm; npm dependency or publication commands can change project state or publish externally.",
    match = [
        "npm install",
        "npm update",
        "npm uninstall package-name",
        "npm publish",
    ],
    not_match = ["npm --version"],
)
