turbo_commands = ["turbo", "turbo.exe"]

prefix_rule(
    pattern = [turbo_commands, "--version"],
    decision = "allow",
    justification = "Turbo version is a local environment check.",
    match = ["turbo --version"],
    not_match = ["turbo run build"],
)

prefix_rule(
    pattern = [turbo_commands, "run"],
    decision = "allow",
    justification = "Turbo run executes repository-defined local development and validation tasks.",
    match = [
        "turbo run build",
        "turbo run test",
        "turbo run typecheck",
    ],
    not_match = ["turbo prune"],
)
