node_commands = ["node", "node.exe"]

# ============================================================
# Node.js: local version and test execution
# ============================================================

prefix_rule(
    pattern = [node_commands, ["--version", "--test"]],
    decision = "allow",
    justification = "Node.js version checks and local test execution are ordinary development operations.",
    match = [
        "node --version",
        "node --test scripts/tooling/doctor.test.mjs",
    ],
    not_match = [
        "node -e \"fetch('https://example.invalid')\"",
    ],
)
