actionlint_commands = ["actionlint", "actionlint.exe"]

# ============================================================
# actionlint: local workflow validation
# ============================================================

prefix_rule(
    pattern = [actionlint_commands],
    decision = "allow",
    justification = "actionlint performs bounded local validation of GitHub Actions workflow files without remote mutation.",
    match = [
        "actionlint",
        "actionlint .github/workflows/ci.yml",
        "actionlint --version",
    ],
    not_match = [
        "gh workflow run deploy.yml",
        "vercel deploy --prod",
    ],
)
