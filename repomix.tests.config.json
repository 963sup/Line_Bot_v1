{
  "$schema": "https://repomix.com/config-schema.json",
  "input": { "include": ["apps/**", "packages/**"] },
  "output": { "filePath": "repomix-tests.xml", "style": "xml" },
  "ignore": { "customPatterns": ["repomix-*.xml", "node_modules/**", ".cache/**", ".tools/**", ".agents/**", ".codex/**", "architecture/fpt/**", "!**/test/**", "!**/*.test.*", "!**/*.spec.*", "**/*.lock", "**/*.{png,jpg,jpeg,gif,webp,svg,ico,pdf}"] }
}
