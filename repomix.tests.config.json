{
  "$schema": "https://repomix.com/config-schema.json",
  "include": ["apps/**/test/**", "apps/**/*.test.*", "apps/**/*.spec.*", "packages/**/test/**", "packages/**/*.test.*", "packages/**/*.spec.*"],
  "output": { "filePath": "repomix-tests.xml", "style": "xml" },
  "ignore": { "customPatterns": ["repomix-*.xml", "node_modules/**", ".cache/**", ".tools/**", ".agents/**", ".codex/**", "architecture/fpt/**", "**/*.lock", "**/*.{png,jpg,jpeg,gif,webp,svg,ico,pdf}"] }
