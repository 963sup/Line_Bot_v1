        "@line-work/account",
        "@line-work/asset",
        "@line-work/ledger",
        "@line-work/platform"
      ]
    },
    "@line-work/enterprise": {
      "path": "packages/enterprise",
      "moduleKind": "domain-module",
      "semanticOwner": "enterprise",
      "allowedWorkspaceDependencies": [
        "@line-work/account",
        "@line-work/identity-access",
        "@line-work/organization",
        "@line-work/platform"
