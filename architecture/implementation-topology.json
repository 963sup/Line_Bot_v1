      "path": "packages/wallet",
      "moduleKind": "domain-module",
      "semanticOwner": "wallet",
      "allowedWorkspaceDependencies": [
        "@line-work/account",
        "@line-work/asset",
        "@line-work/ledger",
        "@line-work/platform"
      ]
    },
    "@line-work/project": {
      "path": "packages/project",
      "moduleKind": "domain-module",
      "semanticOwner": "project",
      "allowedWorkspaceDependencies": []
    },
    "@line-work/workforce": {
      "path": "packages/workforce",
      "moduleKind": "domain-module",
      "semanticOwner": "workforce",
      "allowedWorkspaceDependencies": []
    }
