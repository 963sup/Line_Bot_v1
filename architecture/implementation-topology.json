  "applications": {
    "@line-work/web": {
      "path": "apps/web",
      "moduleKind": "application-host",
      "semanticOwner": null,
      "allowedWorkspaceDependencies": [
        "@line-work/account",
        "@line-work/notifications",
        "@line-work/asset",
        "@line-work/assistant",
        "@line-work/attendance",
        "@line-work/daily-check-in",
        "@line-work/enterprise",
        "@line-work/expense",
        "@line-work/identity-access",
        "@line-work/line-channel",
        "@line-work/organization",
        "@line-work/partners",
        "@line-work/platform",
        "@line-work/repository",
        "@line-work/team",
        "@line-work/wallet"
      ]
