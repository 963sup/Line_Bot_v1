{
  "version": 2,
  "role": "implementation-topology",
  "architecture": "context-first-modular-monolith",
  "semanticModel": "architecture/semantic-model.json",
  "invariants": {
    "boundedContextIsNotModuleBoundary": true,
    "moduleBoundaryIsNotDataBoundary": true,
    "dependenciesUsePublicContracts": true
