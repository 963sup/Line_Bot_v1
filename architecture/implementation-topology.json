    "@line-work/platform": {
      "path": "packages/platform",
      "moduleKind": "support-module",
      "semanticOwner": "platform",
      "allowedWorkspaceDependencies": []
    },
    "@line-work/repository": {
      "path": "packages/repository",
      "moduleKind": "domain-module",
      "semanticOwner": "repository",
      "allowedWorkspaceDependencies": [
        "@line-work/account",
        "@line-work/organization",
        "@line-work/platform"
      ]
