  "relationships": [
    {
      "id": "organization-team-scope",
      "provider": "organization",
      "consumer": "team",
      "meaning": "Team commands recheck Organization-owned active participation, membership version, viewerCanCreateTeams capability, and current Owner administration in the caller transaction.",
      "integrationMode": "stable-identity+query",
      "authority": "organization",
      "consistency": "transaction-recheck"
    },
    {
      "id": "organization-project-owner-scope",
      "provider": "organization",
      "consumer": "project",
      "meaning": "ProjectV2 collection and owner-level management consume current Organization-owned viewerCanAdminister for Organization-owned Projects; creation separately consumes viewerCanCreateProjectV2, while personal Projects remain User-owned.",
      "integrationMode": "query",
      "authority": "organization",
      "consistency": "current-state"
    },
    {
      "id": "organization-project-creation-capability",
      "provider": "organization",
      "consumer": "project",
      "meaning": "ProjectV2 creation rechecks the product-local Organization-owned viewerCanCreateProjectV2 capability for the current active member. A creator without OrganizationOwner authority receives a Project-owned ADMIN grant atomically; OrganizationOwner remains implicit owner authority. The deprecated FPT Projects (classic) field is not its authorization contract.",
      "integrationMode": "query",
      "authority": "organization",
      "consistency": "transaction-recheck"
    },
    {
      "id": "organization-issue-type-scope",
      "provider": "organization",
      "consumer": "issue",
      "meaning": "IssueType definitions consume Organization-owned stable identity, active lifecycle and current OrganizationOwner qualification; Issue retains IssueType definition and assignment authority.",
      "integrationMode": "stable-identity+query",
      "authority": "organization",
      "consistency": "transaction-recheck"
    },
    {
      "id": "organization-enterprise-qualification",
      "provider": "organization",
      "consumer": "enterprise",
      "meaning": "Enterprise attachment and Enterprise Team assignment consume Organization-owned stable identity, active lifecycle, and current OrganizationOwner consent or qualification; no Organization authority transfers to Enterprise.",
      "integrationMode": "stable-identity+query",
      "authority": "organization",
      "consistency": "transaction-recheck"
    },
    {
      "id": "organization-enterprise-membership-coordination",
      "provider": "organization",
      "consumer": "enterprise",
      "meaning": "Enterprise Team membership and assignment transitions call Organization-owned source-removal protection, effective membership refresh, and pending invitation cancellation in the same transaction; Enterprise retains its Team source and assignment facts.",
      "integrationMode": "command",
      "authority": "organization",
      "consistency": "same-transaction"
    },
    {
      "id": "organization-identity-access-owner-facts",
      "provider": "organization",
      "consumer": "identity-access",
      "meaning": "IdentityAccess consumes current Organization-owned OrganizationOwner relationship facts and membership qualification when evaluating scoped authorization; it does not own or mutate the role lifecycle.",
      "integrationMode": "query",
      "authority": "organization",
      "consistency": "current-state"
    },
    {
      "id": "organization-repository-owner-scope",
      "provider": "organization",
      "consumer": "repository",
      "meaning": "Organization-owned Repositories consume current Organization scope and viewerCanCreateRepositories/viewerCanAdminister capabilities. OrganizationMembership qualifies Team-derived access and classifies direct User grants as member/outside, but it does not own or qualify the Repository-owned direct grant.",
      "integrationMode": "stable-identity+query",
      "authority": "organization",
      "consistency": "current-state"
    },
    {
      "id": "organization-repository-creation-capability",
      "provider": "organization",
      "consumer": "repository",
      "meaning": "Repository creation under an Organization consumes the Organization-owned visibility-specific member creation policy; current OrganizationOwner also projects implicit admin on Organization-owned Repositories without copying grants.",
      "integrationMode": "query",
      "authority": "organization",
      "consistency": "transaction-recheck"
    }
  ],
