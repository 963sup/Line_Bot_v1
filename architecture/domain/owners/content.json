          "./application/use-cases/plans",
          "./contracts/output/plans",
          "./contracts/output/plan-references",
          "./contracts/output/wbs-expansion",
          "./composition/bootstrap/plans",
          "./composition/bootstrap/plan-references",
          "./composition/bootstrap/wbs-expansion",
          "./domain/plan-reference"
        ],
        "testPaths": [
          "packages/content/test/plan-domain.test.ts",
          "packages/content/test/plans.test.ts",
          "packages/content/test/plans-postgres.test.ts"
        ],
        "entrypoints": [
          "apps/web/src/app/api/repository-content/route.ts",
          "apps/web/src/app/api/_composition/content-plans.server.ts",
          "apps/web/src/app/api/_composition/contract-content-expansion.server.ts"
        ],
        "note": "The application host composes Contract's public confirmed-document reader with Content's injected port; Content owns only the deterministic whole-document purchase-order-content-v1 expansion and its immutable plan/provenance. It also provides the public immutable Content expansion reader used by WBS. Source implementation, local verification and production publication are separate evidence."
      }
    }
