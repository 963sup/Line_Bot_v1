      "implementation": {
        "status": "implemented",
        "scope": "Manage Repository work definitions and one fixed purchase-order-content-v1 expansion of an exact confirmed ContractDocument into a complete immutable Content revision, including source-row coverage and provenance.",
        "sourcePaths": [
          "packages/content/src/domain/plan.ts",
          "packages/content/src/application/use-cases/plans.ts",
          "packages/content/src/adapters/outbound/persistence/plans.ts",
