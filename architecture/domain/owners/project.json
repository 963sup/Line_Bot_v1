    {
      "id": "read-projects",
      "owner": "project",
      "kind": "leaf",
      "intent": "Read authorized Project summaries without asserting Project planning writes or underlying Repository work authority.",
      "preserves": ["K1", "K2", "K5"],
      "validationProfiles": [
        "semantic-architecture",
        "architecture-tests",
        "schema",
        "tests",
        "fast-repository"
      ],
      "runtimeExpectation": "required",
      "implementation": {
        "status": "implemented",
        "scope": "Project aggregate-root authorized collection read",
        "sourcePaths": [
          "packages/project/src/application/queries/project-collection.ts",
          "packages/project/src/contracts/dto/project-collection.ts",
          "packages/project/src/contracts/repositories/project-collection-store.ts"
        ],
        "publicExports": [
          "./application/queries/project-collection",
          "./contracts/dto/project-collection"
        ],
        "entrypoints": [
          "apps/web/src/app/api/projects/route.ts",
          "apps/web/src/app/(mobile)/(tabs)/projects/page.tsx"
        ],
        "testPaths": ["packages/project/test/collection.test.ts"],
        "note": "Project collection reads combine current Organization viewerCanAdminister capability, Project-owned direct User grants, current Team membership grants and public READ. Source Issue visibility is rechecked separately in Project detail projections."
      }
    },
    {
      "id": "manage-project-planning",
      "owner": "project",
      "kind": "leaf",
      "intent": "Manage ProjectV2 root lifecycle, owner-scoped number, collaborators, Item/DraftIssue lifecycle, typed fields and values, views, status updates, and Repository/Issue references without taking source-owner authority.",
      "preserves": ["K1", "K2", "K3", "K4", "K5"],
      "validationProfiles": [
        "semantic-architecture",
        "architecture-tests",
        "schema",
        "tests",
        "fast-repository"
      ],
      "runtimeExpectation": "required",
      "implementation": {
        "status": "implemented",
        "scope": "ProjectV2 root, owner-scoped creation through product-local viewerCanCreateProjectV2 with an atomic creator ADMIN grant for non-Owner members, distinct implicit OrganizationOwner authority, access grants, Item/DraftIssue, typed field/value, View and StatusUpdate management with current source access, expectedVersion, exact replay and immutable Project events. Optional repository Issue import at creation or later configuration; bounded, qualification-version-bound background admission preserves source access, manual removal exclusions, Project versions and immutable events.",
        "sourcePaths": [
          "packages/project/src/application/management.ts",
          "packages/project/src/contracts/management.ts",
          "packages/project/src/adapters/outbound/persistence/postgres-project-management-store.ts",
          "packages/project/src/adapters/outbound/persistence/postgres-project-items.ts",
          "packages/project/src/adapters/outbound/persistence/postgres-project-fields.ts",
          "packages/project/src/adapters/outbound/persistence/postgres-project-view-status.ts",
          "packages/project/src/adapters/outbound/persistence/postgres-project-repository-imports.ts"
        ],
        "publicExports": [
          "./application/management",
          "./contracts/management",
          "./composition/bootstrap/postgres-project-management-store",
          "./composition/bootstrap/repository-imports"
        ],
        "entrypoints": ["apps/web/src/app/api/project-management/route.ts"],
        "testPaths": [
          "packages/project/test/collection.test.ts",
          "packages/project/test/management.test.ts",
          "packages/project/test/repository-imports.test.ts"
        ],
        "note": "Project owns planning metadata only. Issue content/state remains Issue-owned and every viewer-facing Issue item is filtered by current source access; Draft conversion calls the Issue owner contract in the same transaction. WBS and Project-local Milestone writes remain explicitly data-only."
      }
    },
    {
      "id": "provide-project-content-scope",
      "owner": "project",
      "kind": "leaf",
      "intent": "Provide the current active-User, Project access and lifecycle decision used by Project-scoped WBS and Actions without transferring Project authority.",
      "preserves": ["K1", "K2", "K3", "K5"],
      "validationProfiles": [
        "semantic-architecture",
        "architecture-tests",
        "tests",
        "fast-repository"
      ],
      "runtimeExpectation": "required",
      "implementation": {
        "status": "implemented",
        "scope": "Current active-User qualification, locked Project access recomputation and open/closed/deleted lifecycle projection for WBS and Actions.",
        "sourcePaths": [
          "packages/project/src/contracts/output/content-scope.ts",
          "packages/project/src/adapters/outbound/persistence/postgres-project-content-scope.ts",
          "packages/project/src/composition/bootstrap/project-content-scope.ts"
        ],
        "publicExports": [
          "./contracts/output/content-scope",
          "./composition/bootstrap/project-content-scope"
        ],
        "entrypoints": [],
        "testPaths": ["packages/project/test/content-scope.test.ts"],
        "note": "READ allows reads only; WRITE allows WBS edit/propose/review; ADMIN additionally allows publish, policy and fixed Actions. Closed is read/exact-replay only and deleted resolves as not found."
      }
    }
