  "policies": [
    {
      "id": "SEM-001",
      "kind": "single-concept-owner",
      "severity": "error",
      "rationale": "Authoritative business truth needs one decision owner.",
      "remediation": "Choose one semantic owner; make other representations references, snapshots or projections."
    },
    {
      "id": "SEM-002",
      "kind": "relationship-endpoints-exist",
      "severity": "error",
      "rationale": "Cross-owner contracts cannot target invented responsibilities.",
      "remediation": "Declare the real owner or remove the relationship."
    },
    {
      "id": "SEM-003",
      "kind": "benchmark-mapping-must-exist",
      "severity": "error",
      "rationale": "External benchmark evidence cannot silently become product semantics.",
      "remediation": "Map to a pinned benchmark node explicitly or remove the benchmark claim."
    },
    {
      "id": "SEM-004",
      "kind": "derived-concept-cannot-be-authoritative",
      "severity": "error",
      "rationale": "Derived state is rebuildable and cannot replace its source authority.",
      "remediation": "Point the projection to authoritative sources and keep writes with the source owner."
    },
    {
      "id": "SEM-005",
      "kind": "implementation-mapping-must-resolve",
      "severity": "error",
      "rationale": "Semantic responsibility must map explicitly to implementation when implementation exists.",
      "remediation": "Fix the mapping or explicitly keep the owner data-only/target-only."
    },
    {
      "id": "SEM-006",
      "kind": "module-owner-must-resolve",
      "severity": "error",
      "rationale": "A module cannot exist without a semantic responsibility owner.",
      "remediation": "Assign the real semantic owner or remove the module."
    },
    {
      "id": "SEM-007",
      "kind": "selected-target-module-not-required",
      "severity": "error",
      "rationale": "Target semantics must not imply runtime implementation.",
      "remediation": "Keep target-only owners unmapped until an implementation boundary actually exists."
    },
    {
      "id": "SEM-008",
      "kind": "workspace-dependency-must-resolve",
      "severity": "error",
      "rationale": "Declared dependencies must be directional and point to real public modules.",
      "remediation": "Fix or remove the stale dependency."
    },
    {
      "id": "SEM-009",
      "kind": "consumer-contract",
      "severity": "error",
      "rationale": "Consumer need does not transfer provider authority.",
      "remediation": "Represent cross-owner use as an explicit contract relationship owned by the provider truth and consumer need."
    },
    {
      "id": "SEM-010",
      "kind": "evidence-scope-integrity",
      "severity": "error",
      "rationale": "Validation evidence cannot prove a stronger scope than it executed.",
      "remediation": "Use the validation profile whose evidence class matches the claim."
    },
    {
      "id": "SEM-011",
      "kind": "runtime-feedback-derived-proposal",
      "severity": "error",
      "rationale": "Observed reality is evidence and must not silently rewrite design authority.",
      "remediation": "Produce a derived revision proposal, review the affected owner and evidence, then change canonical semantics explicitly if justified."
    },
    {
      "id": "SEM-012",
      "kind": "data-topology-integrity",
      "severity": "error",
      "rationale": "Persistence authority belongs to database objects/relationships, not schema filenames; file grouping must never hide mixed semantic ownership.",
      "remediation": "Assign every persisted relation exactly one semantic owner, group only same-owner authoritative relations in object-shaped schema files, and keep cross-owner projections/enforcement/coordinators non-authoritative."
    }
  ],
  "language": {
    "canonicalNamePolicy": "One business concept has one canonical name inside its semantic boundary.",
    "ambiguityPolicy": "The same display name may exist in different semantic boundaries only when the concept ids and owners remain explicit.",
    "aliasPolicy": "Aliases are lookup metadata only; aliases never create a second concept or owner.",
    "globalVocabularyProjection": "Derived from concepts; human glossaries are projections or owner-local detail."
  },
