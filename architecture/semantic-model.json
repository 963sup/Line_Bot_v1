        "acceptance-evidence"
      ],
      "tags": [
        "evidence",
        "validation"
      ]
    },
    {
      "id": "SA1",
      "scope": "semantic-architecture",
      "statement": "Bounded Context, Module Boundary, Data Boundary, Consistency Boundary, Trust Boundary, and Runtime Boundary are distinct dimensions.",
      "severity": "error",
      "enforcement": [
        "semantic-policy",
        "manifest"
      ],
      "tags": [
        "architecture",
        "boundary"
      ]
    },
    {
      "id": "SA2",
      "scope": "semantic-architecture",
      "statement": "External benchmark evidence never becomes product authority without an explicit product concept mapping.",
      "severity": "error",
      "enforcement": [
