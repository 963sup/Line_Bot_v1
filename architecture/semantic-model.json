    {
      "id": "SA5",
      "scope": "semantic-architecture",
      "statement": "Runtime, provider, deployment, device, and human observations are evidence only; they may produce a revision proposal but never auto-modify canonical semantic authority.",
      "severity": "error",
      "enforcement": [
        "semantic-policy",
        "runtime-feedback"
