    {
      "id": "SA6",
      "scope": "semantic-architecture",
      "statement": "Every persisted app_private relation has exactly one relation-level data authority; relation ownership must agree with semantic concept ownership, and every concept that requires relation persistence must resolve to at least one authoritative relation.",
      "severity": "error",
      "enforcement": [
