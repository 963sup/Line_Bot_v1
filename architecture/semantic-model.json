    {
      "id": "K3",
      "scope": "system",
      "statement": "Mutable conditional state does not silently use last-write-wins; replay-sensitive effects use stable request identity.",
      "severity": "error",
      "enforcement": [
        "application",
        "database",
        "tests"
      ],
      "tags": [
        "concurrency",
        "replay"
      ]
