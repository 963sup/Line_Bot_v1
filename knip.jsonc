{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreWorkspaces": ["packages/workforce"],
  "workspaces": {
    ".": {
      // Analyze every repository-owned script. Exact opaque entries below are limited to
      // scripts whose external/manual execution cannot be inferred reliably by Knip.
      "project": ["scripts/**/*.{mjs,ts}", "vercel/integrations/**/*.{mjs,ts}"],
      "entry": [
        "scripts/attendance/worker.mjs",
        "scripts/browser/check-auto-clock.mjs",
        "scripts/browser/check-member-management.mjs",
        "scripts/browser/check-membership.mjs",
        "scripts/browser/check-navigation.mjs",
        "scripts/browser/check-wbs.mjs",
        "scripts/browser/check-project-wbs.mjs",
        "scripts/browser/check-work-content.mjs",
        "scripts/browser/check-project-imports.mjs",
        "scripts/browser/check-partner-management.mjs",
        "scripts/browser/check-permissions.mjs",
        "scripts/browser/check-profile.mjs",
        "scripts/browser/check-repository-resources.mjs",
        "scripts/browser/check-repository-address.mjs",
        "scripts/browser/measure-loading.mjs",
        "scripts/line/rich-menu/sync.ts",
        "vercel/integrations/ai-gateway.mjs",
        "vercel/integrations/gateway.ts"
      ],
      // Root operator scripts intentionally resolve these from their owning workspace:
      // Next/tsx from Web and the repository-owned Supabase CLI.
      // Serena launches this executable from .serena/project.yml. Knip cannot
      // infer a dependency consumed by a YAML runtime path.
      "ignoreDependencies": ["next", "supabase", "tsx", "typescript-language-server"]
    },
    "apps/web": {
      "entry": [
        "test/**/*.test.ts",
        "src/modules/assistant/rich-menu/operator.server.ts",
        "src/app/api/_composition/attendance-worker.server.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts"]
    },
    // Private workspace exports are checked against repository consumers.
    // Production entries come from package exports; tsx scripts discover test entries.
    "packages/*": {
      "includeEntryExports": true,
      "project": ["{src,test}/**/*.{ts,tsx}"]
    }
  }
}
