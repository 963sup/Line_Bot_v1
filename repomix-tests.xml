  const resources = createResources({ ...createPostgresResourceDependencies(db), now: () => 10 });
  const resourceId = randomUUID();
  const resource = await resources.execute("owner", {
    action: "create",
    repositoryId: "repo",
    resourceId,
    requestId: randomUUID(),
    expectedVersion: 0,
    kind: "EQUIPMENT",
