            title: "Network",
            body: "",
            plannedQuantity: null,
          },
          {
            id: subobject,
            parentId: object,
            position: 0,
            kind: "SUBOBJECT" as const,
            title: "Backbone",
            body: "",
            plannedQuantity: null,
          },
          {
            id: work,
