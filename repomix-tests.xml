test("profile use case owns presentation metadata only", async () => {
  const calls: unknown[][] = [];
  const profiles = createUserProfiles({
    activeUser: async () => ({ id: "user-a" }),
    store: () => {
      const store: UserProfileStore = {
        read: async () => null,
        save: async (...args: unknown[]) => {
          calls.push(args);
          return {
            userId: "user-a",
            displayName: "Alice",
            bio: null,
            avatarRef: "profile-avatar-a",
            visibility: "private",
            version: 1,
            createdAt: 10,
            updatedAt: 10,
          };
        },
      };
      return store;
    },
    now: () => 10,
  });

  await profiles.update("line-subject", {
    displayName: "  Alice  ",
    bio: "",
    visibility: "private",
    expectedVersion: 0,
  });
  assert.deepEqual(calls, [
    [
      "user-a",
      {
        displayName: "Alice",
        bio: null,
        visibility: "private",
