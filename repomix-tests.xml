  const second = await store.execute(
    "owner",
    {
      action: "create-milestone",
      requestId: "22222222-2222-4222-8222-222222222222",
      repositoryId: "repo",
      expectedVersion: 0,
      title: "M2",
      description: "",
      dueAt: 100,
    },
    21,
  );
  if (first.action !== "create-milestone" || second.action !== "create-milestone") {
    throw new Error("unexpected receipt");
  }
