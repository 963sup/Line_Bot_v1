  await assert.rejects(publish(bId, 1, 2), conflict);
  await assert.rejects(
    executeWbsGovernanceCommand(governance, "owner", { ...publishCommand, expectedVersion: 0 }, 21),
    conflict,
  );
  await assert.rejects(
    executeWbsCommand(
      content,
      "owner",
      {
        action: "update-node",
