test("Repository address application validates the full address value before persistence", async () => {
  const calls: Parameters<RepositoryAddressStore["execute"]>[] = [];
  const store: RepositoryAddressStore = {
    view: async () => {
      throw new Error("not used");
    },
    execute: async (...args) => {
      calls.push(args);
      return {
        requestId: "11111111-1111-4111-8111-111111111111",
        repositoryId: "repo",
        address: null,
        version: 2,
        at: 10,
      };
    },
  };
  const service = createRepositoryAddress({
    activeUser: async () => ({ id: "actor" }),
    store: () => store,
    now: () => 10,
  });

  await service.execute("subject", {
    action: "set",
    requestId: "11111111-1111-4111-8111-111111111111",
    repositoryId: "repo",
    expectedVersion: 1,
    address: {
      address: "台北市信義區市府路 1 號",
      latitude: 25.0375,
      longitude: 121.5637,
      radius: 100,
    },
  });
  assert.equal(calls[0]?.[0], "actor");
  assert.equal(calls[0]?.[2], 10);

  await service.execute("subject", {
    action: "set",
    requestId: "22222222-2222-4222-8222-222222222222",
    repositoryId: "repo",
    expectedVersion: 1,
    address: {
      address: null,
      latitude: 25.0375,
      longitude: 121.5637,
      radius: 100,
    },
  });
  const command = calls[1]?.[1];
  assert.ok(command?.action === "set");
  assert.deepEqual(command.address, {
    address: null,
    latitude: 25.0375,
    longitude: 121.5637,
    radius: 100,
  });

  await assert.rejects(
    service.execute("subject", {
      action: "set",
      requestId: "33333333-3333-4333-8333-333333333333",
      repositoryId: "repo",
      expectedVersion: 1,
      address: {
        address: "台北",
        latitude: 91,
        longitude: 121,
        radius: 100,
      },
    }),
    (error) => error instanceof RepositoryError && error.status === 400,
  );
  await assert.rejects(
    service.execute("subject", {
      action: "set",
      requestId: "88888888-8888-4888-8888-888888888888",
      repositoryId: "repo",
      expectedVersion: 1,
      address: { address: null, latitude: 25, longitude: 121, radius: 0 },
    }),
    (error) => error instanceof RepositoryError && error.status === 400,
  );
  await assert.rejects(
    service.execute("subject", {
      action: "remove",
      requestId: "44444444-4444-4444-8444-444444444444",
      repositoryId: "repo",
      expectedVersion: 1,
      address: null,
    }),
    (error) => error instanceof RepositoryError && error.status === 400,
  );
});

