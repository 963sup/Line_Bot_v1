test("Discussion application validates scope and cursor before persistence", async () => {
  const calls: unknown[][] = [];
  let stores = 0;
  const store: DiscussionReadStore = {
    list: async (...args: Parameters<DiscussionReadStore["list"]>) => {
      calls.push(args);
      return {
        repository: { id: "repo-a", ownerLogin: "owner-a", name: "Alpha", permissions: ["read"] },
        discussions: [],
        next: null,
      };
    },
    detail: unusedReadStore().detail,
    detailByNumber: unusedReadStore().detailByNumber,
  };
  const discussions = createDiscussions({
    activeUser: async (subject) => ({ id: `${subject}-user` }),
    store: () => {
      stores += 1;
      return store;
    },
  });

