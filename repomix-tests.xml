  );
  const official = await governance.view("owner", { repositoryId: "repo" }, { proposalId: aId });
  assert.equal(official.baseline?.revision.id, frozen.id);
  assert.equal(official.baseline?.baseline.approvalReviewIds.length, 2);
  assert.equal(
