  for (let i = 0; i < 101; i++)
    await issues.execute(
      { userId: "owner" },
      {
        action: "create",
        requestId: randomUUID(),
        repositoryId: "repo",
        title: `Source ${i}`,
        body: "",
        criteria: "",
        assigneeIds: [],
      },
      5,
    );
  const projects = new PostgresProjectManagementStore(db);
  const worker = new PostgresProjectRepositoryImports(db);
