import type { Database } from "@line_bot_v1/platform/postgres";
import { postgresFixture } from "@line_bot_v1/platform/testing/postgres";
import { isRecord } from "@line_bot_v1/platform/validation";
import { createRepositoryCreation } from "../src/application/use-cases/repository-creation.js";
import { PostgresRepositoryCreationStore } from "../src/composition/bootstrap/repository-creation.js";
import { RepositoryError } from "../src/contracts/errors/repository-error.js";
import type { RepositoryCreationStore } from "../src/contracts/input/repository-creation.js";

test("Repository create application canonicalizes input before the store", async () => {
  const calls: Parameters<RepositoryCreationStore["create"]>[] = [];
  const store: RepositoryCreationStore = {
    owners: async () => [],
    create: async (...args) => {
      calls.push(args);
      return {
        id: "repo",
        ownerAccountId: "user",
        ownerKind: "USER",
        ownerLogin: "alice",
        name: "Repo",
        visibility: "private",
        version: 1,
      } as const;
    },
  };
  const service = createRepositoryCreation({
    activeUser: async () => ({ id: "user" }),
    store: () => store,
    now: () => 10,
  });

  await service.create("subject", {
    requestId: "11111111-1111-4111-8111-111111111111",
    ownerAccountId: "user",
    ownerKind: "USER",
    name: "  Repo  ",
  });
  assert.deepEqual(calls[0]?.[1], {
    requestId: "11111111-1111-4111-8111-111111111111",
    ownerAccountId: "user",
    ownerKind: "USER",
    name: "Repo",
    visibility: "private",
  });
  assert.equal(calls[0]?.[2], 10);

  await service.create("subject", {
    requestId: "22222222-2222-4222-8222-222222222222",
    ownerAccountId: "user",
    ownerKind: "USER",
    name: "Public",
    visibility: "public",
  });
  assert.equal(calls[1]?.[1].visibility, "public");

  await assert.rejects(
    service.create("subject", {
      requestId: "33333333-3333-4333-8333-333333333333",
      ownerAccountId: "user",
      ownerKind: "USER",
      name: "Repo",
      visibility: "hidden",
    }),
    (error) => error instanceof RepositoryError && error.status === 400,
  );
});

