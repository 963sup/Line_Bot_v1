<file path="apps/web/test/file-requests.test.ts">
import assert from "node:assert/strict";
import test from "node:test";
import { createFileRequests } from "../src/modules/file/file-requests";
import { StaleRequest } from "../src/modules/file/files-projection";

function client(onDenied: (message: string) => void = () => {}) {
  const epoch = { current: 0 };
  return {
    epoch,
    requests: createFileRequests({
      ownerLogin: "owner",
      repositoryName: "files",
      epoch,
      session: async () => "offline-session",
      onDenied,
    }),
  };
}

test("File and intake requests bind one session and Repository scope, including binary downloads", async (t) => {
  const { requests } = client();
  const calls: { url: URL; init: RequestInit }[] = [];
  t.mock.method(globalThis, "fetch", async (input: string, init: RequestInit) => {
    const url = new URL(input, "https://app.example");
    calls.push({ url, init });
    assert.equal(url.searchParams.get("owner"), "owner");
    assert.equal(url.searchParams.get("name"), "files");
    assert.equal(new Headers(init.headers).get("X-App-Session-Generation"), "offline-session");
    return url.searchParams.get("view") === "download"
      ? new Response("original")
      : Response.json({ ok: true });
  });
  await requests.file({ owner: "other", name: "other" });
  const download = await requests.file({ view: "download" });
  assert.ok(download instanceof Blob);
  assert.equal(await download.text(), "original");
  await requests.document({ operation: "intake" }, { requestId: "request" });
  assert.equal(calls[0]?.url.pathname, "/api/repository-files");
  assert.equal(calls[2]?.url.pathname, "/api/repository-document-intake");
  assert.equal(calls[2]?.init.method, "POST");
  assert.deepEqual(JSON.parse(String(calls[2]?.init.body)), { requestId: "request" });
});

test("a stale denial after response parsing cannot clear a newer session", async (t) => {
  let denied = 0;
  const { requests, epoch } = client(() => denied++);
  const started = Promise.withResolvers<void>();
  const body = Promise.withResolvers<unknown>();
  const response = Response.json({}, { status: 403 });
  t.mock.method(response, "json", () => {
    started.resolve();
    return body.promise;
  });
  t.mock.method(globalThis, "fetch", async () => response);
  const request = requests.document({ operation: "read" });
  await started.promise;
  epoch.current++;
  body.resolve({ error: "revoked" });
  await assert.rejects(request, StaleRequest);
  assert.equal(denied, 0);
});

test("malformed authorization responses still clear protected state for both endpoints", async (t) => {
  let denied = 0;
  const { requests } = client(() => denied++);
  t.mock.method(
    globalThis,
    "fetch",
    async () =>
      new Response("not JSON", {
        status: 401,
        headers: { "Content-Type": "application/json" },
      }),
  );
  await assert.rejects(requests.file(), StaleRequest);
  await assert.rejects(requests.document({ operation: "read" }), StaleRequest);
  assert.equal(denied, 2);
});

test("unknown-result and non-JSON timeout responses preserve raw errors", async (t) => {
  const { requests } = client();
  t.mock.method(globalThis, "fetch", async () =>
    Response.json({ code: "UNKNOWN_RESULT" }, { status: 503 }),
  );
  await assert.rejects(
    requests.document({ operation: "intake" }),
    (error: unknown) =>
      error instanceof Error &&
      Reflect.get(error, "code") === "UNKNOWN_RESULT" &&
      error.message.includes("[object Object]"),
  );
  t.mock.method(globalThis, "fetch", async () => new Response("gateway timeout", { status: 504 }));
  await assert.rejects(
    requests.document({ operation: "intake" }),
    /gateway timeout/,
  );
});

test("a session resolved after invalidation never dispatches a request", async (t) => {
  const epoch = { current: 0 };
  const session = Promise.withResolvers<string>();
  const requests = createFileRequests({
    ownerLogin: "owner",
    repositoryName: "files",
    epoch,
    session: () => session.promise,
    onDenied() {
      assert.fail("Stale identity must not clear current data");
    },
  });
  t.mock.method(globalThis, "fetch", () => assert.fail("Stale identity must not dispatch"));
  const request = requests.file();
  epoch.current++;
  session.resolve("old-session");
  await assert.rejects(request, StaleRequest);
});

test("document failures display bounded stage, code and correlation without losing recovery guidance", async (t) => {
  const { requests } = client();
  t.mock.method(globalThis, "fetch", async () =>
    Response.json(
      {
        error: "null value in column expected_line_count",
        code: "23502",
        stage: "target.submit",
        traceId: "11111111-1111-4111-8111-111111111111",
      },
      { status: 500 },
    ),
  );
  await assert.rejects(requests.document({ operation: "intake" }), (error: unknown) => {
    assert.ok(error instanceof Error);
    assert.match(error.message, /null value in column expected_line_count/);
    assert.match(error.message, /null value in column expected_line_count/);
    assert.match(error.message, /target.submit/);
    assert.match(error.message, /11111111-1111-4111-8111-111111111111/);
    return true;
  });
});
</file>

<file path="apps/web/test/repository-content-owner-http.test.ts">
import assert from "node:assert/strict";
import { test } from "node:test";
import { ContentError } from "@line_bot_v1/content/domain/error";
import { type ContentWebRuntime, contentRequest } from "../src/modules/content/content-http.server";
import { RequestIdentityError } from "../src/shared/server/request-identity-error";

const scope = {
  actorUserId: "user-1",
  repository: { id: "repository-1", ownerLogin: "owner", name: "repo" },
  archived: false,
  canEdit: true,
  canManage: false,
};
const url = "https://app.example/api?owner=owner&name=repo";

function runtime(error?: ContentError): ContentWebRuntime {
  return {
    scope: async (_subject, selector) => {
      assert.deepEqual(selector, { ownerLogin: "owner", repositoryName: "repo" });
      return scope;
    },
    owner: () => ({
      read: async (actor, query) => {
        if (error) throw error;
        assert.equal(actor, "user-1");
        assert.deepEqual(query, { repositoryId: "repository-1" });
        return {
          revisionId: "revision-1",
          repositoryId: "repository-1",
          version: 1,
          parentRevisionId: null,
          actorUserId: "user-1",
          at: 1,
          action: "initialize",
          document: { schemaVersion: 1, measures: [], nodes: [], resourcePins: [] },
        };
      },
      history: async () => {
        if (error) throw error;
        return { revisions: [], next: null };
      },
      execute: async () => {
        if (error) throw error;
        throw new Error("must not execute");
      },
    }),
  };
}

test("owner HTTP requires identity and resolves current Repository scope", async () => {
  const denied = await contentRequest(new Request(url), runtime(), async () => {
    throw new RequestIdentityError(401, "sign in");
  });
  assert.equal(denied.status, 401);
  const read = await contentRequest(new Request(url), runtime(), async () => "subject");
  assert.equal(read.status, 200);
  assert.equal((await read.json()).revision.revisionId, "revision-1");
});

test("owner HTTP enforces origin and command Repository scope", async () => {
  const previous = process.env.APP_ORIGIN;
  process.env.APP_ORIGIN = "https://app.example";
  try {
    let scopeCalls = 0;
    const forbiddenRuntime = runtime();
    forbiddenRuntime.scope = async () => {
      scopeCalls++;
      return scope;
    };
    const forbidden = await contentRequest(
      new Request(url, {
        method: "POST",
        headers: { origin: "https://evil.example", "content-type": "application/json" },
        body: JSON.stringify({ repositoryId: "repository-1" }),
      }),
      forbiddenRuntime,
      async () => "subject",
    );
    assert.equal(forbidden.status, 403);
    assert.equal(scopeCalls, 0);
    const mismatch = await contentRequest(
      new Request(url, {
        method: "POST",
        headers: { origin: "https://app.example", "content-type": "application/json" },
        body: JSON.stringify({ repositoryId: "other" }),
      }),
      runtime(),
      async () => "subject",
    );
    assert.equal(mismatch.status, 400);
  } finally {
    if (previous === undefined) delete process.env.APP_ORIGIN;
    else process.env.APP_ORIGIN = previous;
  }
});

test("Content maps only an uninitialized current head to null", async () => {
  const missing = new ContentError(404, "missing", "NOT_FOUND");
  const current = await contentRequest(new Request(url), runtime(missing), async () => "subject");
  assert.equal(current.status, 200);
  assert.equal((await current.json()).revision, null);
  const historical = await contentRequest(
    new Request(`${url}&revisionId=00000000-0000-4000-8000-000000000001`),
    runtime(missing),
    async () => "subject",
  );
  assert.equal(historical.status, 404);
  const unavailable = await contentRequest(
    new Request(url),
    {
      ...runtime(),
      owner: () => ({
        ...runtime().owner(),
        read: async () => {
          throw new Error("provider detail");
        },
      }),
    },
    async () => "subject",
  );
  assert.equal(unavailable.status, 500);
  assert.notEqual((await unavailable.json()).revision, null);
});

test("owner HTTP preserves owner status and code", async () => {
  const response = await contentRequest(
    new Request(url),
    runtime(new ContentError(409, "conflict", "VERSION_CONFLICT")),
    async () => "subject",
  );
  assert.equal(response.status, 409);
  assert.deepEqual(await response.json(), { error: "conflict", code: "VERSION_CONFLICT" });
});

test("Content HTTP pins an explicitly requested plan revision instead of substituting current head", async () => {
  const pinnedId = "55555555-5555-4555-8555-555555555555";
  const fixture = runtime();
  const baseOwner = fixture.owner();
  const reference = await baseOwner.read("user-1", { repositoryId: "repository-1" });
  let checked = false;
  const target: ContentWebRuntime = {
    ...fixture,
    owner: () => ({
      ...baseOwner,
      read: async (actor, query) => {
        assert.equal(actor, "user-1");
        assert.deepEqual(query, { repositoryId: "repository-1", revisionId: pinnedId });
        checked = true;
        return reference;
      },
    }),
  };
  const response = await contentRequest(
    new Request(url + "&revisionId=" + pinnedId),
    target,
    async () => "subject",
  );
  assert.equal(response.status, 200);
  assert.equal(checked, true);
});
</file>

