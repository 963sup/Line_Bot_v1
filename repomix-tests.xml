      const alias = "line_bot_v1-attendance-in";
      const aliases = new Map<string, string>(existing ? [[alias, oldId]] : []);
      const deleted: string[] = [];
      let reads = 0;
      let writes = 0;
      const write = async (id: string) => {
        writes++;
