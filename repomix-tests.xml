<file path="packages/project/test/management-concurrency.test.ts">
import assert from "node:assert/strict";
import test from "node:test";
import { createSql, type Database } from "@line_bot_v1/platform/postgres";
import { PostgresProjectLifecycle } from "../src/adapters/outbound/persistence/postgres-project-lifecycle.js";
import { readProjectReceipt } from "../src/adapters/outbound/persistence/postgres-project-management-helpers.js";
import { PostgresProjectManagementStore } from "../src/adapters/outbound/persistence/postgres-project-management-store.js";
import { executeProjectLifecycle } from "../src/application/use-cases/project-lifecycle.js";
import { ProjectError } from "../src/domain.js";

type QueryRecord = { text: string; values?: unknown[] };
const governanceLockQuery = "SELECT app_private.lock_governance('shared')";

function databaseWith(
  responder: (
    text: string,
    values: unknown[] | undefined,
  ) => Promise<{
    rows: Record<string, unknown>[];
  }>,
  queries: QueryRecord[],
): Database {
  const sql = createSql(async (text, values) => {
    queries.push({ text, ...(values === undefined ? {} : { values }) });
    return responder(text, values);
  });
  return {
    transaction: (work) => work(sql),
  };
}

function queryIndex(queries: QueryRecord[], fragment: string) {
  return queries.findIndex((query) => query.text.includes(fragment));
}

test("Project management takes a shared governance lock before replay and capability checks", async () => {
  const queries: QueryRecord[] = [];
  const db = databaseWith(async (text) => {
    if (text === governanceLockQuery || text.includes("pg_advisory_xact_lock"))
      return { rows: [{}] };
    if (text.includes("FROM project_commands")) return { rows: [] };
    if (text.includes("FROM users")) return { rows: [] };
    throw new Error(`unexpected query: ${text}`);
  }, queries);
  const store = new PostgresProjectManagementStore(db);

  await assert.rejects(
    () =>
      store.execute(
        { userId: "user-1" },
        {
          action: "create-project",
          requestId: "request-project-governance-lock",
          ownerAccountId: "organization-1",
          ownerKind: "ORGANIZATION",
          expectedVersion: 0,
          title: "Organization plan",
          public: false,
          repositoryId: null,
          teamId: null,
        },
        100,
      ),
    (error: unknown) => error instanceof ProjectError && error.status === 403,
  );

  const governanceLock = queryIndex(queries, "lock_governance('shared')");
  assert.equal(queryIndex(queries, "lock_governance('exclusive')"), -1);
  const requestLock = queries.findIndex(
    (query, index) =>
      index > governanceLock && query.text.includes("pg_advisory_xact_lock(hashtext($1))"),
  );
  const replayLookup = queryIndex(queries, "FROM project_commands");
  const capabilityQualification = queryIndex(queries, "FROM users");

  const order = [governanceLock, requestLock, replayLookup, capabilityQualification];
  assert.ok(order.every((index) => index >= 0));
  assert.deepEqual(
    order,
    [...order].sort((left, right) => left - right),
  );
});

test("Project lifecycle keeps governance, request, replay and Project row locking order", async () => {
  const queries: QueryRecord[] = [];
  const db = databaseWith(async (text) => {
    if (text === governanceLockQuery || text.includes("pg_advisory_xact_lock"))
      return { rows: [{}] };
    if (text.includes("FROM project_commands") || text.includes("FROM projects"))
      return { rows: [] };
    throw new Error(`unexpected query: ${text}`);
  }, queries);
  await assert.rejects(
    executeProjectLifecycle(
      new PostgresProjectLifecycle(db),
      { userId: "actor" },
      {
        action: "close-project",
        requestId: "request",
        projectId: "project",
        expectedVersion: 1,
      },
      10,
    ),
    (error: unknown) => error instanceof ProjectError && error.status === 404,
  );
  assert.deepEqual(
    queries.map((query) => query.text),
    [
      governanceLockQuery,
      "SELECT pg_advisory_xact_lock(hashtext($1))",
      "SELECT fingerprint,result FROM project_commands WHERE actor=$1 AND request_id=$2",
      "SELECT pg_advisory_xact_lock(hashtext($1))",
      "SELECT * FROM projects WHERE id=$1 FOR UPDATE",
    ],
  );
  assert.deepEqual(queries[1]?.values, ["project-request:actor:request"]);
  assert.deepEqual(queries[3]?.values, ["project:project"]);
});

