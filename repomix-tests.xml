      0,
    );
    assert.equal(
      (await pg.query("SELECT * FROM app_private.governance_command_receipts")).rows.length,
      1,
    );
    assert.equal(
      (await pg.query("SELECT * FROM app_private.governance_audit_events")).rows.length,
