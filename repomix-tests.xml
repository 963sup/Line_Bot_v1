<file path="packages/team/test/team-write-concurrency-postgres.test.ts">
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import test from "node:test";
import { postgresSessions } from "@line_bot_v1/platform/testing/postgres-sessions";
import { createTeamCollaboration } from "../src/application/collaboration.js";
import { PostgresTeamRepository } from "../src/composition/bootstrap/team.js";

const databaseUrl = process.env.CAPABILITY_TEST_DATABASE_URL;
test("PostgreSQL Team writes serialize competing versions and concurrent exact replay", {
  skip: !databaseUrl && !process.env.CI,
  timeout: 60_000,
}, async (t) => {
  assert.ok(databaseUrl, "CI must supply its disposable PostgreSQL service");
  const { pool, db, close, waitForBlocked } = await postgresSessions(databaseUrl);
  t.after(close);
  await pool.query(`INSERT INTO app_private.users(id,status,"createdAt") VALUES ('owner','active',1);
    SELECT app_private.claim_account_login('owner','USER','owner',1);
    INSERT INTO app_private.user_identities(provider,subject,user_id) VALUES('line:test','owner','owner');
    SELECT * FROM app_private.provision_organization_scope('org','owner','org','Org',2);`);
  const repository = new PostgresTeamRepository(db);
  const collaboration = createTeamCollaboration(
    () => repository,
    () => 100,
  );
  const actor = { provider: "line:test", subject: "owner" };
  const created = await collaboration.execute(actor, {
    action: "create-team",
    requestId: randomUUID(),
    organizationAccountId: "org",
    name: "Core",
    privacy: "SECRET",
    notificationSetting: "NOTIFICATIONS_DISABLED",
  });
  const first = {
    action: "rename-team",
    requestId: randomUUID(),
    organizationAccountId: "org",
    teamId: created.teamId,
    expectedVersion: 1,
    name: "One",
  };
  const second = { ...first, requestId: randomUUID(), name: "Two" };
  async function compete(commands: readonly unknown[]) {
    const blocker = await pool.connect();
    let outcomes:
      | Promise<PromiseSettledResult<Awaited<ReturnType<typeof collaboration.execute>>>[]>
      | undefined;
    try {
      await blocker.query("BEGIN; SELECT app_private.lock_governance('exclusive')");
      const pid = (await blocker.query<{ pid: number }>("SELECT pg_backend_pid() AS pid")).rows[0]
        ?.pid;
      assert.ok(pid);
      outcomes = Promise.allSettled(
        commands.map((command) => collaboration.execute(actor, command)),
      );
      const waiters = await waitForBlocked(pid, commands.length);
      assert.equal(new Set(waiters.map((row) => row.pid)).size, commands.length);
      assert.ok(waiters.every((row) => row.wait_event === "advisory"));
      await blocker.query("COMMIT");
      return await outcomes;
    } finally {
      try {
        await blocker.query("ROLLBACK");
      } finally {
        blocker.release();
      }
      await outcomes;
    }
  }
  const commands = [first, second];
  const results = await compete(commands);
  const accepted = results.filter((result) => result.status === "fulfilled");
  const rejected = results.filter((result) => result.status === "rejected");
  assert.equal(accepted.length, 1);
  assert.equal(rejected.length, 1);
  const error = rejected[0]?.reason;
  assert.ok(error instanceof Error && "status" in error && error.status === 409);
  const receipt = accepted[0]?.value;
  assert.ok(receipt);
  const winner = commands[results.findIndex((result) => result.status === "fulfilled")];
  assert.ok(winner);
  assert.deepEqual(await compete([winner, winner]), [
    { status: "fulfilled", value: receipt },
    { status: "fulfilled", value: receipt },
  ]);
  assert.deepEqual(
    (await pool.query("SELECT name,version FROM app_private.teams WHERE id=$1", [created.teamId]))
      .rows,
    [{ name: winner.name, version: 2 }],
  );
  assert.equal(
    (await pool.query("SELECT count(*)::int AS count FROM app_private.team_commands")).rows[0]
      ?.count,
    2,
  );
});
</file>

<file path="packages/team/test/team-write-postgres.test.ts">
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import test from "node:test";
import { resolveScopedName } from "@line_bot_v1/namespace/postgres";
import { postgresFixture } from "@line_bot_v1/platform/testing/postgres";
import { createTeamCollaboration } from "../src/application/collaboration.js";
import { PostgresTeamRepository } from "../src/composition/bootstrap/team.js";

function hasStatus(status: number) {
  return (error: unknown) => error instanceof Error && "status" in error && error.status === status;
}

async function fixture() {
  const f = await postgresFixture();
  await f.pg.exec(`BEGIN;
    INSERT INTO app_private.users(id,status,"createdAt") VALUES ('owner','active',1),('backup','active',1),('member','active',1),('outsider','active',1);
    SELECT app_private.claim_account_login(id,'USER',id,1) FROM app_private.users;
    INSERT INTO app_private.user_identities(provider,subject,user_id) SELECT 'line:test',id,id FROM app_private.users;
    SELECT * FROM app_private.provision_organization_scope('org','owner','org','Org',2);
    INSERT INTO app_private.organization_memberships(organization_account_id,user_id,status,version,created_at) VALUES ('org','backup','active',1,3),('org','member','active',1,3);
    COMMIT;`);
  const repository = new PostgresTeamRepository(f.db);
  let at = 100;
  const collaboration = createTeamCollaboration(
    () => repository,
    () => ++at,
  );
  const request = (fields: Record<string, unknown>) => ({
    requestId: randomUUID(),
    organizationAccountId: "org",
    ...fields,
  });
  const execute = (userId: string, input: unknown) =>
    collaboration.execute({ provider: "line:test", subject: userId }, input);
  const create = (userId = "owner") =>
    execute(
      userId,
      request({
        action: "create-team",
        name: "Core",
        privacy: "SECRET",
        notificationSetting: "NOTIFICATIONS_DISABLED",
      }),
    );
  const teamVersion = async (teamId: string) =>
    (
      await f.pg.query<{ version: number }>("SELECT version FROM app_private.teams WHERE id=$1", [
        teamId,
      ])
    ).rows[0]?.version;
  const count = async () =>
    Number(
      (
        await f.pg.query<{ count: number }>(
          "SELECT count(*) AS count FROM app_private.team_commands",
        )
      ).rows[0]?.count,
    );
  const membership = async (teamId: string, userId: string) =>
    (
      await f.pg.query(
        "SELECT status,version FROM app_private.team_memberships WHERE team_id=$1 AND user_id=$2",
        [teamId, userId],
      )
    ).rows[0];
  return { ...f, request, execute, create, teamVersion, count, membership };
}

test("Team join, approval and maintainer grant preserve independent epochs, no-op membership and exact replay", async (t) => {
  const f = await fixture();
  t.after(() => f.pg.close());
  const { teamId } = await f.create();
  assert.equal(await f.teamVersion(teamId), 1);
  const join = f.request({ action: "join", teamId, expectedVersion: 0, name: "Member" });
  const joined = await f.execute("member", join);
  assert.deepEqual(await f.membership(teamId, "member"), { status: "pending", version: 1 });
  await assert.rejects(
    f.execute(
      "owner",
      f.request({
        action: "maintainer",
        teamId,
        expectedVersion: 2,
        targetUserId: "member",
        enabled: false,
      }),
    ),
    (error: unknown) =>
      hasStatus(409)(error) &&
      error instanceof Error &&
      error.message === "TeamMaintainer 對象必須是有效 Team member。",
  );
  assert.deepEqual(await f.execute("member", join), joined);
  await assert.rejects(f.execute("member", { ...join, name: "Other" }), hasStatus(409));
  assert.equal(await f.teamVersion(teamId), 2);
  await f.execute(
    "owner",
    f.request({
      action: "membership",
      teamId,
      expectedVersion: 2,
      targetUserId: "member",
      status: "active",
    }),
  );
  assert.deepEqual(await f.membership(teamId, "member"), { status: "active", version: 2 });
  await f.execute(
    "owner",
    f.request({
      action: "membership",
      teamId,
      expectedVersion: 3,
      targetUserId: "member",
      status: "active",
    }),
  );
  assert.deepEqual(await f.membership(teamId, "member"), { status: "active", version: 2 });
  assert.equal(await f.teamVersion(teamId), 4);
  const grant = f.request({
    action: "maintainer",
    teamId,
    expectedVersion: 4,
    targetUserId: "member",
    enabled: true,
  });
  const granted = await f.execute("owner", grant);
  assert.deepEqual(
    (
      await f.pg.query(
        "SELECT status,version,user_status_version,membership_version FROM app_private.team_role_assignments WHERE team_id=$1 AND user_id='member'",
        [teamId],
      )
    ).rows,
    [{ status: "active", version: 1, user_status_version: 1, membership_version: 2 }],
  );
  assert.deepEqual(await f.execute("owner", grant), granted);
  await assert.rejects(f.execute("owner", { ...grant, enabled: false }), hasStatus(409));
  await assert.rejects(
    f.execute(
      "owner",
      f.request({
        action: "maintainer",
        teamId,
        expectedVersion: 5,
        targetUserId: "member",
        enabled: true,
      }),
    ),
    hasStatus(409),
  );
  await assert.rejects(
    f.execute("member", f.request({ action: "join", teamId, expectedVersion: 0, name: "Again" })),
    hasStatus(403),
  );
  assert.equal(await f.teamVersion(teamId), 5);
  assert.equal(await f.count(), 5);
});

test("Team removal protects the last maintainer, revokes epoch-bound authority and permits exact self-removal replay", async (t) => {
  const f = await fixture();
  t.after(() => f.pg.close());
  const { teamId } = await f.create("member");
  await assert.rejects(
    f.execute(
      "member",
      f.request({
        action: "membership",
        teamId,
        expectedVersion: 1,
        targetUserId: "member",
        status: "removed",
      }),
    ),
    hasStatus(409),
  );
  assert.equal(await f.teamVersion(teamId), 1);
  assert.equal(await f.count(), 1);
  await f.execute(
    "backup",
    f.request({ action: "join", teamId, expectedVersion: 0, name: "Backup" }),
  );
  await f.execute(
    "member",
    f.request({
      action: "membership",
      teamId,
      expectedVersion: 2,
      targetUserId: "backup",
      status: "active",
    }),
  );
  await f.execute(
    "member",
    f.request({
      action: "maintainer",
      teamId,
      expectedVersion: 3,
      targetUserId: "backup",
      enabled: true,
    }),
  );
  const remove = f.request({
    action: "membership",
