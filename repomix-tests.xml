<file path="scripts/tooling/codex-config.test.mjs">
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { isAbsolute, relative, resolve } from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";
import { parse } from "smol-toml";

const directory = fileURLToPath(new URL("../../.codex/", import.meta.url));
const config = parse(readFileSync(resolve(directory, "config.toml"), "utf8"));

test("MCP and app approval modes use the host-supported enum", () => {
  const modes = ["auto", "prompt", "writes", "approve"];
  for (const item of [...Object.values(config.mcp_servers), ...Object.values(config.apps ?? {})]) {
    if (item.default_tools_approval_mode !== undefined)
      assert.ok(
        modes.includes(item.default_tools_approval_mode),
        `Invalid tool approval mode: ${item.default_tools_approval_mode}`,
      );
  }
});

test("project guidance budget fits every tracked AGENTS instruction chain", () => {
  const root = resolve(directory, "..");
  const defaultBudget = 32768;
  assert.ok(
    config.project_doc_max_bytes <= defaultBudget,
    "Do not hide guidance growth by raising the host budget",
  );
  assert.ok(
    readFileSync(resolve(root, "AGENTS.md")).length <= 15360,
    "Root guidance must leave room for nested instructions",
  );
  const paths = execFileSync("git", ["ls-files", "--", "AGENTS.md", "**/AGENTS.md"], {
    cwd: root,
    encoding: "utf8",
  })
    .trim()
    .split("\n")
    .filter((path) => !path.startsWith(".agents/skills/"));
  for (const path of paths) {
    const parts = path.split("/");
    let bytes = 0;
    for (let depth = 0; depth < parts.length; depth++) {
      const ancestor = [...parts.slice(0, depth), "AGENTS.md"].join("/");
      if (paths.includes(ancestor)) bytes += readFileSync(resolve(root, ancestor)).length + 2;
    }
    assert.ok(
      bytes <= Math.min(defaultBudget, config.project_doc_max_bytes),
      `${path}: ${bytes} bytes exceeds budget`,
    );
  }
});

test("global Codex settings stay at root rather than leaking into MCP server tables", () => {
  for (const key of ["tool_output_token_limit", "project_doc_max_bytes"]) {
    assert.ok(
      Number.isInteger(config[key]) && config[key] > 0,
      `${key} must be a positive root budget`,
    );
  }
  assert.ok(["disabled", "cached", "indexed", "live"].includes(config.web_search));
  for (const [name, server] of Object.entries(config.mcp_servers)) {
    for (const key of [
      "tool_output_token_limit",
      "project_doc_max_bytes",
      "web_search",
      "features",
      "agents",
      "max_depth",
      "max_concurrent_threads_per_session",
    ]) {
      assert.equal(Object.hasOwn(server, key), false, `${name}: misplaced ${key}`);
    }
  }
});

test("registered agent configurations resolve locally with matching roles and instructions", () => {
  let count = 0;
  for (const [name, role] of Object.entries(config.agents)) {
    if (typeof role !== "object" || !role.config_file) continue;
    const path = resolve(directory, role.config_file);
    const location = relative(resolve(directory, "agents"), path);
    assert.ok(
      location && !isAbsolute(location) && location !== ".." && !location.startsWith("../"),
    );
    const agent = parse(readFileSync(path, "utf8"));
    assert.equal(agent.name, name);
    assert.ok(agent.developer_instructions.trim().length > 0);
    count++;
  }
  assert.ok(count > 0);
});

test("project hooks have one source and all command handlers exist", () => {
  assert.equal(config.hooks, undefined, "Do not duplicate hooks.json in inline configuration");
  const hooks = JSON.parse(readFileSync(resolve(directory, "hooks.json"), "utf8"));
  assert.equal(config.features.hooks, true);
  assert.ok(
    hooks.hooks.UserPromptSubmit.some((group) =>
      group.hooks.some((handler) => handler.command.includes("/requirement-preflight.mjs")),
    ),
  );
  for (const groups of Object.values(hooks.hooks)) {
    for (const group of groups) {
      if (group.matcher) assert.doesNotThrow(() => new RegExp(group.matcher));
      for (const handler of group.hooks) {
        const match = handler.command.match(/\/\.codex\/hooks\/([^"/]+\.mjs)"$/);
        assert.ok(match, "Use a git-root-based handler path");
        assert.ok(readFileSync(resolve(directory, "hooks", match[1]), "utf8").length > 0);
        assert.ok(handler.timeout > 0 && handler.timeout <= 60);
      }
    }
  }
});
</file>

<file path="scripts/tooling/hooks.test.mjs">
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { resolve } from "node:path";
import test from "node:test";
import { fileURLToPath } from "node:url";
import { context, patchPaths } from "../../.codex/hooks/runtime.mjs";

const hooks = fileURLToPath(new URL("../../.codex/hooks/", import.meta.url));
function fixture() {
  const root = mkdtempSync(resolve(tmpdir(), "codex-hooks-test-"));
  execFileSync("git", ["init", "--quiet"], { cwd: root });
  mkdirSync(resolve(root, "scripts"));
  writeFileSync(
    resolve(root, "scripts/check.mjs"),
    `import {appendFileSync,existsSync} from 'node:fs'; appendFileSync('.calls', JSON.stringify(process.argv.slice(2))+'\\n'); process.exitCode=existsSync('.fail')?1:0;`,
  );
  writeFileSync(resolve(root, "sample.js"), "export const value = 1;\n");
  writeFileSync(resolve(root, ".gitignore"), ".artifacts/\n");
  execFileSync("git", ["add", "."], { cwd: root });
  execFileSync(
    "git",
    [
      "-c",
      "user.name=Hook Test",
      "-c",
      "user.email=test@example.invalid",
      "commit",
      "--quiet",
      "-m",
      "fixture",
    ],
    { cwd: root },
  );
  const event = {
    cwd: root,
    session_id: "session",
    turn_id: "turn",
    tool_name: "apply_patch",
    tool_use_id: "edit-1",
    tool_input: { command: "*** Update File: sample.js\n" },
  };
  return { root, event };
}
function invoke(script, event) {
  const result = spawnSync(process.execPath, [resolve(hooks, `${script}.mjs`)], {
    input: JSON.stringify(event),
    encoding: "utf8",
    timeout: 10000,
  });
  assert.equal(result.status, 0, result.stderr);
  return JSON.parse(result.stdout);
}
function calls(root) {
  return readFileSync(resolve(root, ".calls"), "utf8")
    .trim()
    .split("\n")
    .map((line) => JSON.parse(line));
}

test("patch scope includes rename/deletion and rejects outside or artifact paths", () => {
  assert.deepEqual(
    patchPaths(
      "*** Update File: a.js\n*** Move to: b.js\n*** Delete File: c.js\n*** Add File: ../escape.js\n*** Add File: .artifacts/no.js\n",
      "/repo",
      "/repo",
    ),
    ["a.js", "b.js", "c.js"],
  );
});
test("read-only turns do not execute checks", () => {
  const { root, event } = fixture();
  assert.deepEqual(invoke("verify-turn", event), {});
  assert.throws(() => calls(root), { code: "ENOENT" });
});
test("scoped checks deduplicate evidence and invalidate it when file content changes", () => {
  const { root, event } = fixture();
  invoke("track-changes", event);
  assert.match(invoke("verify-turn", event).systemMessage, /2\/2 passed/);
  assert.deepEqual(calls(root), [
    ["patch", "--", "HEAD", "--", "sample.js"],
    ["lint", "--", "./sample.js"],
  ]);
  assert.deepEqual(invoke("verify-turn", event), {});
  assert.equal(calls(root).length, 2);
  writeFileSync(resolve(root, "sample.js"), "export const value = 2;\n");
  invoke("verify-turn", event);
  assert.equal(calls(root).length, 4);
  execFileSync(
    "git",
    [
      "-c",
      "user.name=Hook Test",
      "-c",
      "user.email=test@example.invalid",
      "commit",
      "--quiet",
      "--allow-empty",
      "-m",
      "new revision",
    ],
    { cwd: root },
  );
  invoke("verify-turn", event);
  assert.equal(calls(root).length, 6);
});
test("failed checks request at most one continuation and keep raw output out of feedback", () => {
  const { root, event } = fixture();
  writeFileSync(resolve(root, ".fail"), "");
  invoke("track-changes", event);
  assert.equal(invoke("verify-turn", event).decision, "block");
  assert.deepEqual(invoke("verify-turn", { ...event, stop_hook_active: true }), {});
  writeFileSync(resolve(root, "sample.js"), "changed again\n");
  assert.match(
    invoke("verify-turn", { ...event, stop_hook_active: true }).systemMessage,
    /no automatic retry/,
  );
  assert.equal(calls(root).length, 2);
});
test("turns are isolated and deleted files do not reach Biome", () => {
  const { root, event } = fixture();
  invoke("track-changes", { ...event, tool_input: { command: "*** Delete File: deleted.js\n" } });
  assert.deepEqual(invoke("verify-turn", { ...event, turn_id: "other" }), {});
  invoke("verify-turn", event);
  assert.deepEqual(calls(root), [["patch", "--", "HEAD", "--", "deleted.js"]]);
});
test("session context reports tracked changes without filenames or file contents", () => {
  const { root, event } = fixture();
  writeFileSync(resolve(root, "sample.js"), "private-content\n");
  const result = invoke("session-context", event);
  const summary = JSON.parse(result.hookSpecificOutput.additionalContext);
  assert.equal(summary.trackedChanges, 1);
  assert.equal(JSON.stringify(result).includes("private-content"), false);
});

test("prompt preflight delivers bounded guidance and records delivery without private prompt", () => {
  const { root, event } = fixture();
  const result = invoke("requirement-preflight", {
    ...event,
    hook_event_name: "UserPromptSubmit",
    prompt: "private requirement content",
  });
  assert.equal(result.hookSpecificOutput.hookEventName, "UserPromptSubmit");
  assert.match(result.hookSpecificOutput.additionalContext, /requirement-architect/);
  assert.ok(result.hookSpecificOutput.additionalContext.length < 1000);
  assert.equal(JSON.stringify(result).includes("private requirement content"), false);
  const { base, turn } = context(event);
  const record = readFileSync(resolve(turn ?? base, "requirement-preflight.json"), "utf8");
  assert.equal(JSON.parse(record).event, "UserPromptSubmit");
  assert.equal(record.includes("private requirement content"), false);
  assert.equal(
    spawnSync("git", ["status", "--porcelain"], { cwd: root, encoding: "utf8" }).stdout,
    "",
  );
});

test("prompt preflight reports failed delivery when session identity is missing", () => {
  const { event } = fixture();
  const result = invoke("requirement-preflight", { ...event, session_id: undefined });
  assert.equal(result.hookSpecificOutput, undefined);
  assert.match(result.systemMessage, /could not run/);
});
</file>

