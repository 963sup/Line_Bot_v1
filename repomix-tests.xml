  );
  assert.throws(
    () =>
      parseContentPlanCommand({
        action: "import-file",
        repositoryId: "repo",
        requestId: ids[6],
        expectedVersion: 1,
        confirmedDisclosure: true,
      }),
    (error) => error instanceof ContentError && error.code === "INVALID_INPUT",
