    },
    async replay() {
      order.push("replay");
      return null;
    },
    async record() {
      order.push("receipt");
    },
    async partnerVersion() {
      throw Error("unexpected");
    },
    async existingContacts() {
      throw Error("unexpected");
    },
    async duplicateContact() {
      order.push("unique");
      return false;
    },
    async lockDirectory() {
      order.push("directory-lock");
    },
    async savePartner() {
      throw Error("unexpected");
    },
