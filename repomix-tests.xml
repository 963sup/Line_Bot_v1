<file path="packages/contract/test/commercial-document-evidence.test.ts">
import assert from "node:assert/strict";
import test from "node:test";
import { validateCommercialDocumentEvidence } from "../src/application/commercial-document-evidence.js";
import { commercialDocumentContentSchema } from "../src/contracts/input/commercial-document.js";

const resultId = "11111111-1111-4111-8111-111111111111";
const observationId = "22222222-2222-4222-8222-222222222222";
const evidenceId = "33333333-3333-4333-8333-333333333333";
const source = { fileId: resultId, fileRevisionId: observationId, sha256: "a".repeat(64) };
const context = {
  source,
  extractionResultId: resultId,
  pageCount: 2,
  observations: [{ observationId, pageNumber: 2 }],
  humanEvidence: [{ evidenceId, source, pageNumber: 1 }],
};
const missing = {
  value: null,
  missingReason: "NOT_PRESENT",
  evidenceRefs: [],
  origin: "EXTRACTION",
  correctionReason: null,
};
function content(refs: unknown[]) {
  return commercialDocumentContentSchema.parse({
    documentKind: "ESTIMATE",
    header: {
      documentNumber: missing,
      documentRevisionLabel: missing,
      title: { ...missing, value: "Synthetic", missingReason: null, evidenceRefs: refs },
      issueDate: missing,
      validUntilDate: missing,
      defaultCurrencyCode: missing,
    },
    parties: [],
    sections: [],
    rows: [],
    selectionGroups: [],
    totals: [],
    terms: [],
    extensionFields: [],
  });
}
const extraction = { kind: "EXTRACTION", extractionResultId: resultId, observationId };
test("evidence accepts qualified observations and retained human evidence", () => {
  assert.deepEqual(
    validateCommercialDocumentEvidence(
      content([extraction, { kind: "HUMAN", evidenceId }]),
      context,
    ),
    [],
  );
});
test("evidence rejects cross-result and absent observation references with a field location", () => {
  for (const ref of [
    { ...extraction, extractionResultId: evidenceId },
    { ...extraction, observationId: evidenceId },
  ]) {
    const report = validateCommercialDocumentEvidence(content([ref]), context);
    assert.equal(report[0]?.code, "INVALID_EXTRACTION_REFERENCE");
    assert.equal(report[0]?.fieldPath, "header.title.evidenceRefs.0");
  }
});
test("human evidence cannot point at another source or outside inspected page bounds", () => {
  for (const human of [
    { evidenceId, pageNumber: 1, source: { ...source, sha256: "b".repeat(64) } },
    { evidenceId, source, pageNumber: 3 },
  ]) {
    assert.ok(
      validateCommercialDocumentEvidence(content([{ kind: "HUMAN", evidenceId }]), {
        ...context,
        humanEvidence: [human],
      }).some((d) => d.code === "INVALID_EVIDENCE_CONTEXT"),
    );
  }
  assert.equal(
    validateCommercialDocumentEvidence(
      content([{ kind: "HUMAN", evidenceId: resultId }]),
      context,
    )[0]?.code,
    "INVALID_HUMAN_REFERENCE",
  );
});
test("technical evidence rejects duplicate identities and untrusted page metadata", () => {
  for (const invalid of [
    { ...context, pageCount: 0 },
    { ...context, observations: [{ observationId, pageNumber: 3 }] },
    { ...context, observations: [...context.observations, ...context.observations] },
  ]) {
    assert.ok(
      validateCommercialDocumentEvidence(content([extraction]), invalid).some(
        (d) => d.code === "INVALID_EVIDENCE_CONTEXT",
      ),
    );
  }
});

test("source validation visits row facts and typed vendor extension evidence", () => {
  const document = content([extraction]);
  const field = {
    value: "Synthetic note",
    missingReason: null,
    evidenceRefs: [{ kind: "HUMAN", evidenceId: resultId }],
    origin: "EXTRACTION",
    correctionReason: null,
  };
  const withRows = commercialDocumentContentSchema.parse({
    ...document,
    rows: [
      {
        rowType: "NOTE",
        rowId: evidenceId,
        sectionId: null,
        position: 0,
        evidenceRefs: [extraction],
        extensionFields: [
          {
            fieldId: observationId,
            label: "Vendor",
            valueType: "TEXT",
            value: "X",
            missingReason: null,
            unitLabel: null,
            evidenceRefs: [{ ...extraction, extractionResultId: evidenceId }],
          },
        ],
        text: field,
      },
    ],
  });
  assert.deepEqual(validateCommercialDocumentEvidence(withRows, context), [
    { code: "INVALID_EXTRACTION_REFERENCE", fieldPath: "rows.0.extensionFields.0.evidenceRefs.0" },
    { code: "INVALID_HUMAN_REFERENCE", fieldPath: "rows.0.text.evidenceRefs.0" },
  ]);
});

test("evidence boundary rejects malformed projections and leaves immutable evidence untouched", () => {
  const document = content([extraction]);
  const original = JSON.stringify({ document, context });
  Object.freeze(document.header.title.evidenceRefs);
  Object.freeze(context.observations);
  Object.freeze(context.source);
  Object.freeze(context);
  assert.deepEqual(validateCommercialDocumentEvidence(document, context), []);
  assert.equal(JSON.stringify({ document, context }), original);
  assert.deepEqual(
    validateCommercialDocumentEvidence(document, {
      ...context,
      source: { ...source, sha256: "invalid" },
    }),
    [{ code: "INVALID_EVIDENCE_CONTEXT", fieldPath: "evidenceContext" }],
  );
});
</file>

<file path="packages/contract/test/commercial-document-money.test.ts">
import assert from "node:assert/strict";
import test from "node:test";
import { reconcileDocumentAmounts } from "../src/application/commercial-document-money.js";
import { commercialDocumentContentSchema } from "../src/contracts/input/commercial-document.js";

const id = "11111111-1111-4111-8111-111111111111";
const refs = [{ kind: "HUMAN", evidenceId: id }];
const missing = {
  value: null,
  missingReason: "NOT_PRESENT",
  evidenceRefs: [],
  origin: "EXTRACTION",
  correctionReason: null,
};
function fact(value: string | null) {
  return value === null ? missing : { ...missing, value, missingReason: null, evidenceRefs: refs };
}
function document(
  amountBasis = "TAX_EXCLUSIVE",
  values: (string | null)[] = ["100", "-10", "4.5", "94.5"],
  currencyCode: string | null = "TWD",
) {
  return commercialDocumentContentSchema.parse({
    documentKind: "QUOTATION",
    header: {
      documentNumber: missing,
      documentRevisionLabel: missing,
      title: fact("Synthetic"),
      issueDate: missing,
      validUntilDate: missing,
      defaultCurrencyCode: missing,
    },
    parties: [],
    sections: [],
    rows: [],
    selectionGroups: [],
    totals: [
      {
        summaryId: id,
        scope: { scopeType: "DOCUMENT", sectionId: null, rowId: null },
        currencyCode,
        amountBasis,
        itemsAmount: fact(values[0] ?? null),
        nonTaxAdjustmentsAmount: fact(values[1] ?? null),
        taxAmount: fact(values[2] ?? null),
        payableAmount: fact(values[3] ?? null),
        evidenceRefs: refs,
      },
    ],
    terms: [],
    extensionFields: [],
  });
}
test("exclusive tax uses exact signed adjustments without double-negating discounts", () => {
  const input = document();
  const original = JSON.stringify(input);
  const report = reconcileDocumentAmounts(input, 1);
  assert.equal(report.status, "PASS");
  assert.equal(report.checks[0]?.computedAmount, "94.5");
  assert.equal(report.rulesetVersion, 1);
  assert.match(report.contentFingerprint, /^[a-f0-9]{64}$/);
  assert.equal(JSON.stringify(input), original);
});
test("inclusive tax does not add included tax twice and need not invent missing tax", () => {
  const report = reconcileDocumentAmounts(document("TAX_INCLUSIVE", ["100", "-10", null, "90"]), 1);
  assert.equal(report.status, "PASS");
  assert.equal(report.checks[0]?.computedAmount, "90");
});
test("source discrepancies are reported without rewriting reported amounts", () => {
  const input = document("TAX_EXCLUSIVE", ["100", "-10", "4.5", "90"]);
  const report = reconcileDocumentAmounts(input, 1);
  assert.equal(report.status, "MISMATCH");
  assert.equal(report.checks[0]?.reportedAmount, "90");
  assert.equal(input.totals[0]?.payableAmount.value, "90");
});
test("missing inputs, unknown currencies and unspecified tax bases are not a passing calculation", () => {
  for (const input of [
    document("MIXED"),
    document("UNSPECIFIED"),
    document("TAX_EXCLUSIVE", ["100", null, "5", "105"]),
    document("TAX_EXCLUSIVE", undefined, null),
    { ...document(), totals: [] },
  ]) {
    assert.equal(reconcileDocumentAmounts(input, 1).status, "NOT_COMPUTABLE");
  }
});
test("large decimals retain precision and equivalent source representations have the same fingerprint", () => {
  const first = document("TAX_EXCLUSIVE", [
    "12345678901234567890123456.123456789012",
    "0",
    "0",
    "12345678901234567890123456.123456789012",
  ]);
  assert.equal(reconcileDocumentAmounts(first, 1).status, "PASS");
  const a = document("TAX_INCLUSIVE", ["100.00", "-10.0", null, "90.000"]);
  const b = document("TAX_INCLUSIVE", ["100", "-10", null, "90"]);
  assert.equal(
    reconcileDocumentAmounts(a, 1).contentFingerprint,
    reconcileDocumentAmounts(b, 1).contentFingerprint,
  );
  assert.throws(() => reconcileDocumentAmounts(b, 2), /ruleset/i);
});

test("each summary keeps its own currency and scope instead of combining reported totals", () => {
  const input = document();
  const other = document("TAX_INCLUSIVE", ["200", "-20", null, "180"], "USD");
  const report = reconcileDocumentAmounts(
    {
      ...input,
      totals: [
        ...input.totals,
        ...other.totals.map((summary) => ({
          ...summary,
          summaryId: "22222222-2222-4222-8222-222222222222",
        })),
      ],
    },
    1,
  );
  assert.equal(report.status, "PASS");
  assert.deepEqual(
    report.checks.map((check) => check.computedAmount),
    ["94.5", "180"],
  );
});
</file>

<file path="packages/contract/test/commercial-document-normalizer.test.ts">
import assert from "node:assert/strict";
import test from "node:test";
import { validateCommercialDocumentEvidence } from "../src/application/commercial-document-evidence.js";
import {
  type CommercialDocumentTechnicalResult,
  normalizeCommercialDocument,
} from "../src/application/normalization/commercial-document.js";
import { visitDocumentEvidenceReferences } from "../src/domain/commercial-document-evidence.js";

const id = (n: number) => `11111111-1111-4111-8111-${n.toString().padStart(12, "0")}`;
function result(
  cells: readonly [string | null, string | null, string | null, string | null, number?][],
): CommercialDocumentTechnicalResult {
  return {
    extractionResultId: id(1),
    repositoryId: id(2),
    source: { fileId: id(3), fileRevisionId: id(4), sha256: "a".repeat(64) },
    pageCount: 2,
    observations: cells.map(([rawLabel, rawValue, , , pageNumber], index) => ({
      observationId: id(100 + index),
      pageNumber: pageNumber ?? 1,
      rawLabel,
      rawValue,
    })),
    semanticHints: cells.flatMap(([, , target, rowKey], observationIndex) =>
      target ? [{ observationIndex, target, rowKey }] : [],
    ),
  };
}

test("normalizes synthetic vendor purchase orders, quotations and estimates without inventing values", () => {
  for (const [kind, numberLabel, itemLabel] of [
    ["PURCHASE_ORDER", "PO Number", "Article"],
    ["QUOTATION", "報價編號", "品名規格"],
    ["ESTIMATE", "Estimate reference", "Work description"],
  ]) {
    const input = result([
      ["Form", kind ?? null, "documentKind", null],
      [numberLabel ?? null, "ACME-001", "header.documentNumber", null],
      ["Currency", "TWD", "header.defaultCurrencyCode", null],
      ["Issued", "2026-10-28", "header.issueDate", null],
      [itemLabel ?? null, "Synthetic part", "item.description", "line-1"],
      ["Unit price", "12345678901234567890.123456789012", "item.unitPrice", "line-1"],
      [itemLabel ?? null, "Synthetic part", "item.description", "line-2", 2],
      ["Vendor-specific field", "retain me", "vendor.unknown", null],
    ]);
    const { content, evidenceContext } = normalizeCommercialDocument(input);
    assert.equal(content.documentKind, kind);
    assert.equal(content.header.documentNumber.value, "ACME-001");
    assert.equal(content.header.issueDate.value, "2026-10-28");
    assert.equal(content.rows.length, 2);
    const row = content.rows[0];
    assert.equal(row?.rowType, "ITEM");
    if (row?.rowType !== "ITEM") throw new Error("Expected ITEM");
    assert.equal(row.quantity.value, null);
    assert.equal(row.quantity.missingReason, "NOT_PRESENT");
    assert.deepEqual(row.unitPrice.value, {
      amount: "12345678901234567890.123456789012",
      currencyCode: "TWD",
    });
    assert.notEqual(content.rows[0]?.rowId, content.rows[1]?.rowId);
    assert.ok(
      content.extensionFields.some(
        (e) => e.label === "Vendor-specific field" && e.value === "retain me",
      ),
    );
    const covered = new Set<string>();
    visitDocumentEvidenceReferences(content, (ref) => {
      if (ref.kind === "EXTRACTION") covered.add(ref.observationId);
    });
    assert.equal(covered.size, input.observations.length);
    assert.deepEqual(validateCommercialDocumentEvidence(content, evidenceContext), []);
    assert.equal("reviewState" in content, false);
  }
});

test("malformed dates, formatted or overprecise decimals and duplicate scalar hints remain ambiguous with raw evidence", () => {
  const input = result([
    ["Date", "28/10/2026", "header.issueDate", null],
    ["Title A", "A", "header.title", null],
    ["Title B", "B", "header.title", null],
    ["Quantity", "1,234", "item.quantity", "r"],
    ["Price", "0.1234567890123", "item.unitPrice", "r"],
    ["Description", "part", "item.description", "r"],
    ["Description continued", "part continued", "item.description", "r", 2],
  ]);
  const { content } = normalizeCommercialDocument(input);
  assert.equal(content.header.issueDate.value, null);
  assert.equal(content.header.issueDate.missingReason, "AMBIGUOUS");
  assert.equal(content.header.title.missingReason, "AMBIGUOUS");
  const row = content.rows[0];
  if (row?.rowType !== "ITEM") throw new Error("Expected ITEM");
  for (const field of [row.quantity, row.unitPrice, row.description]) {
    assert.equal(field.value, null);
    assert.equal(field.missingReason, "AMBIGUOUS");
  }
  const retained = [...content.extensionFields, ...row.extensionFields].map((e) => e.value);
  for (const observation of input.observations) assert.ok(retained.includes(observation.rawValue));
});

test("explicit absence, null labels, unknown hints, invalid kinds and missing row keys are retained", () => {
  const { content } = normalizeCommercialDocument(
    result([
      [null, null, null, null],
      ["Currency", "$", "header.defaultCurrencyCode", null],
      ["Type", "vendor-form", "documentKind", null],
      ["Description", "unanchored", "item.description", null],
      ["Q", null, "item.quantity", "r"],
      ["Total", "12.00", "item.lineAmount", "r"],
    ]),
  );
  assert.equal(content.documentKind, "UNCLASSIFIED");
  assert.equal(content.header.defaultCurrencyCode.missingReason, "AMBIGUOUS");
  const row = content.rows[0];
  if (row?.rowType !== "ITEM") throw new Error("Expected ITEM");
  assert.equal(row.quantity.missingReason, "UNREADABLE");
  assert.deepEqual(row.lineAmount.value, { amount: "12", currencyCode: null });
  assert.ok(content.extensionFields.some((e) => e.value === "unanchored"));
});

test("rejects invalid source identities, pages, duplicate observations and hint indexes", () => {
  const input = result([["D", "part", "item.description", "r"]]);
  const observation = input.observations[0];
  if (!observation) throw new Error("Expected observation");
  const bad: CommercialDocumentTechnicalResult[] = [
    { ...input, pageCount: 25 },
    { ...input, repositoryId: "" },
    { ...input, source: { ...input.source, sha256: "bad" } },
    { ...input, observations: [{ ...observation, pageNumber: 3 }] },
    { ...input, observations: [observation, observation] },
    { ...input, semanticHints: [{ observationIndex: 1, target: "item.description", rowKey: "r" }] },
    {
      ...input,
      semanticHints: [{ observationIndex: -1, target: "item.description", rowKey: "r" }],
    },
  ];
  for (const value of bad) assert.throws(() => normalizeCommercialDocument(value));
});

test("rejects over-budget retained fields instead of silently dropping source observations", () => {
  assert.throws(() =>
    normalizeCommercialDocument(
      result(Array.from({ length: 65 }, () => ["Unknown", "value", null, null])),
    ),
  );
  assert.throws(() =>
    normalizeCommercialDocument(result([["Unknown", "x".repeat(2049), null, null]])),
  );
});

test("replay is deterministic and never mutates or aliases technical input", () => {
  const input = result([
    ["D", "part", "item.description", "r"],
    ["Vendor", "custom", null, null],
  ]);
  const snapshot = structuredClone(input);
  const first = normalizeCommercialDocument(input);
  assert.deepEqual(normalizeCommercialDocument(input), first);
  assert.deepEqual(input, snapshot);
  first.evidenceContext.source.sha256 = "b".repeat(64);
  assert.deepEqual(input, snapshot);
});

test("rejects oversized Unicode technical payloads by UTF-8 bytes", () => {
  const input = result(
    Array.from({ length: 50 }, (_, index) => [
      "字".repeat(3000),
      "part",
      "item.description",
      `r-${index}`,
    ]),
  );
  assert.ok(JSON.stringify(input).length < 393_216);
  assert.ok(new TextEncoder().encode(JSON.stringify(input)).byteLength > 393_216);
  assert.throws(() => normalizeCommercialDocument(input));
});

test("classifies explicit source document titles across vendor formats while preserving the raw title", () => {
  for (const [title, kind] of [
    ["Purchase Order", "PURCHASE_ORDER"],
    ["採購單", "PURCHASE_ORDER"],
    ["Quotation", "QUOTATION"],
    ["報價單", "QUOTATION"],
    ["Estimate", "ESTIMATE"],
    ["估價單", "ESTIMATE"],
    ["Contract", "CONTRACT"],
    ["合約", "CONTRACT"],
  ]) {
    const { content } = normalizeCommercialDocument(
      result([["Document", title ?? null, "documentKind", null]]),
    );
    assert.equal(content.documentKind, kind);
    assert.equal(content.extensionFields[0]?.value, title);
  }
});

test("accepts Contract text repository identifiers without relaxing extraction or file UUIDs", () => {
  const input = { ...result([["Title", "Synthetic", "header.title", null]]), repositoryId: "repo" };
  assert.equal(normalizeCommercialDocument(input).content.header.title.value, "Synthetic");
  for (const repositoryId of ["", "r".repeat(129)])
    assert.throws(() => normalizeCommercialDocument({ ...input, repositoryId }));
  assert.throws(() => normalizeCommercialDocument({ ...input, extractionResultId: "result" }));
  assert.throws(() =>
    normalizeCommercialDocument({ ...input, source: { ...input.source, fileId: "file" } }),
  );
  assert.throws(() =>
    normalizeCommercialDocument({
      ...input,
      source: { ...input.source, fileRevisionId: "revision" },
    }),
  );
});
