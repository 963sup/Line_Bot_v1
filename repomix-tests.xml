<file path="packages/project/test/content-scope.test.ts">
import assert from "node:assert/strict";
import test from "node:test";
import { createSql, type SqlRow } from "@line_bot_v1/platform/postgres";
import { createPostgresProjectContentScope } from "../src/composition/bootstrap/project-content-scope.js";
import { ProjectError } from "../src/domain.js";

type AccessState = {
  active: boolean;
  public: boolean;
  closed: boolean;
  deleted: boolean;
  directRole: "READ" | "WRITE" | "ADMIN" | null;
  teamIds: string[];
  teamRole: "READ" | "WRITE" | "ADMIN" | null;
};

function projectRow(state: AccessState): SqlRow {
  return {
    id: "project-1",
    owner_account_id: "owner-1",
    owner_account_kind: "USER",
    number: 7,
    creator: "owner-1",
    name: "Delivery plan",
    short_description: "",
    readme: "",
    is_public: state.public,
    closed: state.closed,
    closed_at: state.closed ? 200 : null,
    deleted_at: state.deleted ? 300 : null,
    version: 1,
    created_at: 100,
    updated_at: 100,
  };
}

function scopeFor(state: AccessState, queries: string[] = []) {
  const sql = createSql(async (text) => {
    queries.push(text);
    if (text === "SELECT app_private.lock_governance('shared')") return { rows: [{}] };
    if (text.includes("FROM users WHERE id=$1")) {
      return {
        rows: state.active
          ? [
              {
                id: "user-1",
                status: "active",
                status_version: 1,
                auth_user_id: null,
                createdAt: 100,
              },
            ]
          : [],
      };
    }
    if (text.includes("pg_advisory_xact_lock")) return { rows: [{}] };
    if (text.includes("FROM projects") && text.includes("FOR UPDATE")) {
      return { rows: [projectRow(state)] };
    }
    if (text.includes("AS has_collaborator_grants")) {
      return {
        rows: [{ has_collaborator_grants: state.directRole !== null || state.teamRole !== null }],
      };
    }
    if (text.includes("FROM project_user_access")) {
      return { rows: state.directRole ? [{ role: state.directRole }] : [] };
    }
    if (text.includes("FROM team_effective_memberships")) {
      return { rows: state.teamIds.map((team_id) => ({ team_id })) };
    }
    if (text.includes("FROM project_team_access")) {
      return { rows: state.teamRole ? [{ role: state.teamRole }] : [] };
    }
    throw new Error(`unexpected query: ${text}`);
  });
  return createPostgresProjectContentScope(sql);
}

function privateState(): AccessState {
  return {
    active: true,
    public: false,
    closed: false,
    deleted: false,
    directRole: null,
    teamIds: [],
    teamRole: null,
  };
}

test("Project content scope exposes a public Project as READ", async () => {
  const state = { ...privateState(), public: true };

  assert.deepEqual(await scopeFor(state).read("user-1", "project-1"), {
    project: {
      id: "project-1",
      ownerAccountId: "owner-1",
      ownerKind: "USER",
      title: "Delivery plan",
      number: 7,
      public: true,
      hasCollaboratorGrants: false,
    },
    role: "READ",
    closed: false,
  });
});

test("Project content scope reads current direct and Team grants on every call", async () => {
  const direct: AccessState = { ...privateState(), directRole: "WRITE" };
  const directScope = scopeFor(direct);
  assert.deepEqual(
    await directScope.read("user-1", "project-1").then((scope) => ({
      role: scope.role,
      hasCollaboratorGrants: scope.project.hasCollaboratorGrants,
    })),
    { role: "WRITE", hasCollaboratorGrants: true },
  );
  direct.directRole = null;
  await assert.rejects(
    () => directScope.read("user-1", "project-1"),
    (error: unknown) => error instanceof ProjectError && error.status === 404,
  );

  const team: AccessState = {
    ...privateState(),
    teamIds: ["team-1"],
    teamRole: "ADMIN",
  };
  const teamScope = scopeFor(team);
  assert.deepEqual(
    await teamScope.read("user-1", "project-1").then((scope) => ({
      role: scope.role,
      hasCollaboratorGrants: scope.project.hasCollaboratorGrants,
    })),
    { role: "ADMIN", hasCollaboratorGrants: true },
  );
  team.teamIds = [];
  team.teamRole = null;
  await assert.rejects(
    () => teamScope.read("user-1", "project-1"),
    (error: unknown) => error instanceof ProjectError && error.status === 404,
  );
});

test("Project content scope reports closed state and hides deleted Projects", async () => {
  const closed = { ...privateState(), public: true, closed: true };
  assert.equal((await scopeFor(closed).read("user-1", "project-1")).closed, true);

  const deleted = { ...privateState(), public: true, deleted: true };
  await assert.rejects(
    () => scopeFor(deleted).read("user-1", "project-1"),
    (error: unknown) => error instanceof ProjectError && error.status === 404,
  );
});

test("Project content scope rejects inactive qualification before taking Project locks", async () => {
  const queries: string[] = [];
  const state = { ...privateState(), active: false, public: true };

  await assert.rejects(
    () => scopeFor(state, queries).read("user-1", "project-1"),
    (error: unknown) => error instanceof ProjectError && error.status === 403,
  );
  assert.equal(
    queries.some((query) => query.includes("pg_advisory_xact_lock")),
    false,
  );
  assert.equal(
    queries.some((query) => query.includes("FROM projects")),
    false,
  );
});

test("Project content scope recomputes access only after a contended Project row lock", async () => {
  const queries: string[] = [];
  let markStarted = () => {};
  const started = new Promise<void>((resolve) => {
    markStarted = resolve;
  });
  let releaseRowLock = () => {};
  const released = new Promise<void>((resolve) => {
    releaseRowLock = resolve;
  });
  const state = privateState();
  const sql = createSql(async (text) => {
    queries.push(text);
    if (text === "SELECT app_private.lock_governance('shared')") return { rows: [{}] };
    if (text.includes("FROM users WHERE id=$1")) {
      return {
        rows: [
          {
            id: "user-1",
            status: "active",
            status_version: 1,
            auth_user_id: null,
            createdAt: 100,
          },
        ],
      };
    }
    if (text.includes("pg_advisory_xact_lock")) return { rows: [{}] };
    if (text.includes("FROM projects") && text.includes("FOR UPDATE")) {
      markStarted();
      await released;
      return { rows: [projectRow(state)] };
    }
    if (text.includes("FROM project_user_access")) return { rows: [] };
    if (text.includes("FROM team_effective_memberships")) return { rows: [] };
    throw new Error(`unexpected query: ${text}`);
  });

  const read = createPostgresProjectContentScope(sql).read("user-1", "project-1");
  await started;
  assert.equal(
    queries.some((query) => query.includes("FROM project_user_access")),
    false,
  );
  releaseRowLock();
  await assert.rejects(
    read,
    (error: unknown) => error instanceof ProjectError && error.status === 404,
  );

  const governance = queries.findIndex((query) => query.includes("lock_governance('shared')"));
  const qualification = queries.findIndex((query) => query.includes("FROM users WHERE id=$1"));
  const advisory = queries.findIndex((query) => query.includes("pg_advisory_xact_lock"));
  const rowLock = queries.findIndex(
    (query) => query.includes("FROM projects") && query.includes("FOR UPDATE"),
  );
  const directGrant = queries.findIndex((query) => query.includes("FROM project_user_access"));
  const order = [governance, qualification, advisory, rowLock, directGrant];
  assert.ok(order.every((index) => index >= 0));
  assert.deepEqual(
    order,
    [...order].sort((left, right) => left - right),
  );
});
</file>

<file path="packages/project/test/lifecycle-postgres.test.ts">
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import { test } from "node:test";
import { postgresFixture } from "@line_bot_v1/platform/testing/postgres";
import { PostgresProjectLifecycle } from "../src/adapters/outbound/persistence/postgres-project-lifecycle.js";
import { PostgresProjectManagementStore } from "../src/adapters/outbound/persistence/postgres-project-management-store.js";
import { createProjectManagement } from "../src/application/management.js";
import { ProjectError } from "../src/domain.js";

const fails = (status: number, message: string) => (error: unknown) =>
  error instanceof ProjectError && error.status === status && error.message === message;

test("Project lifecycle preserves transitions, replay authority, error precedence and rollback", async (t) => {
  const { pg, db } = await postgresFixture();
  t.after(() => pg.close());
  for (const id of ["owner", "admin", "reader"]) {
    await db.transaction(async (sql) => {
      await sql.query(
        "INSERT INTO users(id,status,status_version,\"createdAt\") VALUES($1,'active',1,1)",
        [id],
      );
      await sql.query("SELECT app_private.claim_account_login($1,'USER',$2,1)", [
        id,
        `lifecycle-${id}`,
      ]);
    });
  }
  let now = 10;
  const store = new PostgresProjectManagementStore(db);
  const management = createProjectManagement({
    activeUser: async (subject) => ({ id: subject }),
    store: () => store,
    lifecycle: () => new PostgresProjectLifecycle(db),
    now: () => now,
  });
  const created = await management.command("owner", {
    action: "create-project",
    requestId: randomUUID(),
    ownerAccountId: "owner",
    ownerKind: "USER",
    expectedVersion: 0,
    title: "Lifecycle",
    public: false,
    repositoryId: null,
    teamId: null,
  });
  const projectId = created.projectId;
  await pg.query(
    "INSERT INTO project_user_access(project_id,user_id,role,version,created_at,updated_at) VALUES($1,'admin','ADMIN',1,10,10),($1,'reader','READ',1,10,10)",
    [projectId],
  );
  const close = { action: "close-project", requestId: randomUUID(), projectId, expectedVersion: 1 };
  now = 20;
  const closed = await management.command("admin", close);
  assert.deepEqual(closed, {
    requestId: close.requestId,
    action: close.action,
    projectId,
    resourceId: null,
    version: 2,
    at: 20,
    data: { closed: true },
  });
  const readState = async () => (await store.view({ userId: "owner" }, projectId)).project;
  assert.equal((await readState()).closedAt, 20);
  now = 30;
  assert.deepEqual(await management.command("admin", close), closed);
  await assert.rejects(
    management.command("admin", { ...close, expectedVersion: 2 }),
    fails(409, "此請求編號已用於不同 Project 操作。"),
  );
  await assert.rejects(
    management.command("owner", { ...close, requestId: randomUUID(), expectedVersion: 2 }),
    fails(409, "Project 已關閉，目前 planning facts 為唯讀。"),
  );
  await assert.rejects(
    management.command("reader", { ...close, requestId: randomUUID(), expectedVersion: 1 }),
    fails(409, "Project 已更新，請重新讀取後再操作。"),
  );
  await assert.rejects(
    management.command("reader", { ...close, requestId: randomUUID(), expectedVersion: 2 }),
    fails(403, "目前 Project access 不允許此操作。"),
  );

  await pg.query(
    "UPDATE project_user_access SET role='READ',version=version+1 WHERE project_id=$1 AND user_id='admin'",
    [projectId],
  );
  assert.deepEqual(await management.command("admin", close), closed);
  await pg.query("DELETE FROM project_user_access WHERE project_id=$1 AND user_id='admin'", [
    projectId,
  ]);
  await assert.rejects(management.command("admin", close), fails(404, "找不到可存取的 Project。"));
  const reopen = {
    action: "reopen-project",
    requestId: randomUUID(),
    projectId,
    expectedVersion: 2,
  };
  const reopened = await management.command("owner", reopen);
  assert.deepEqual(reopened.data, { closed: false });
  assert.equal(reopened.version, 3);
  assert.equal((await readState()).closedAt, null);
  assert.deepEqual(await management.command("owner", reopen), reopened);
  await assert.rejects(
    management.command("owner", { ...reopen, requestId: randomUUID(), expectedVersion: 3 }),
    fails(409, "Project 已開啟。"),
  );
  assert.equal(
    (await pg.query("SELECT * FROM project_events WHERE project_id=$1", [projectId])).rows.length,
    3,
  );
  assert.equal((await pg.query("SELECT * FROM project_commands")).rows.length, 3);

  const rollback = await management.command("owner", {
    action: "create-project",
    requestId: randomUUID(),
    ownerAccountId: "owner",
    ownerKind: "USER",
    expectedVersion: 0,
    title: "Rollback",
    public: false,
    repositoryId: null,
    teamId: null,
  });
  await pg.query(
    "INSERT INTO project_events(project_id,version,actor,action,data,at) VALUES($1,2,'owner','collision','{}',30)",
    [rollback.projectId],
  );
  const failedRequest = randomUUID();
  await assert.rejects(
    management.command("owner", {
      action: "close-project",
      requestId: failedRequest,
      projectId: rollback.projectId,
      expectedVersion: 1,
    }),
  );
  const afterFailure = (await store.view({ userId: "owner" }, rollback.projectId)).project;
  assert.equal(afterFailure.closed, false);
  assert.equal(afterFailure.closedAt, null);
  assert.equal(afterFailure.version, 1);
  assert.deepEqual(
    (await pg.query("SELECT * FROM project_commands WHERE request_id=$1", [failedRequest])).rows,
    [],
  );
});
