  const command: Parameters<typeof writePendingRepositoryCreate>[1] = {
    requestId: "11111111-1111-4111-8111-111111111111",
    ownerAccountId: "user-1",
    ownerKind: "USER",
    name: "Repo",
    visibility: "private",
