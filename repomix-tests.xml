test("actual upload dimensions and malformed image rejection", () => {
  const directory = new URL("../../../assets/line/rich-menu/", import.meta.url);
  const files = [
    "line_bot_v1-attendance-in.jpg",
    "line_bot_v1-attendance-out.jpg",
