  "99999999-9999-4999-8999-999999999999",
] as const;

function document(): ContentPlanDocument {
  return {
    schemaVersion: 1,
    measures: [{ id: ids[5], name: "Length", subject: "Installed length", unit: "m" }],
    nodes: [
      {
        id: ids[0],
        parentId: null,
        position: 0,
        kind: "SUBJECT",
        title: "25P1",
        body: "",
        plannedQuantity: null,
      },
      {
        id: ids[1],
        parentId: ids[0],
        position: 0,
        kind: "OBJECT",
        title: "Network",
        body: "",
        plannedQuantity: null,
      },
      {
        id: ids[2],
        parentId: ids[1],
        position: 0,
        kind: "SUBOBJECT",
        title: "Backbone",
        body: "",
        plannedQuantity: null,
      },
      {
        id: ids[3],
        parentId: ids[2],
        position: 2,
        kind: "WORK",
        title: " Main fiber construction ",
        body: "plan",
        plannedQuantity: { measureId: ids[5], value: "10.000" },
