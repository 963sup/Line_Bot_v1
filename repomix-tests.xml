});

test("commercial POST rejects unknown fields before any owner operation", async () => {
  const command = {
    repositoryId: "repo-1",
    commandId: "analysis-1",
    source: { fileId: "file-1", fileRevisionId: "revision-1", sha256: "a".repeat(64) },
