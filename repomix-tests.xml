    },
  ]);
  const outsideView = await store.view("owner", { repositoryId: "repo" });
  assert.deepEqual(
    outsideView.directUserGrants.find((grant) => grant.userId === "outside"),
    { userId: "outside", capability: "triage", version: 1, isOutsideCollaborator: true },
