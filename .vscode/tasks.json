{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "repo: dev",
      "type": "process",
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "repo: format",
      "type": "process",
      "command": "pnpm",
      "args": [
        "format"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "repo: check",
      "type": "process",
      "command": "pnpm",
      "args": [
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "repo: validate",
      "type": "process",
      "command": "pnpm",
      "args": [
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "repo: browser test",
      "type": "process",
      "command": "pnpm",
      "args": [
        "test:browser"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "repo: docs check",
      "type": "process",
      "command": "pnpm",
      "args": [
        "docs:check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "repo: schema check",
      "type": "process",
      "command": "pnpm",
      "args": [
        "schema:check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "semantic: context",
      "type": "process",
      "command": "pnpm",
      "args": [
        "semantic",
        "context",
        "${input:changeIntent}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "semantic: plan",
      "type": "process",
      "command": "pnpm",
      "args": [
        "semantic",
        "plan",
        "${input:changeIntent}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "changeIntent",
      "type": "promptString",
      "description": "Describe the repository change intent"
    }
  ]
}
