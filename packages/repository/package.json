{
  "name": "@line-work/repository",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "default": "./dist/adapters/postgres.js"
    },
    "./application/issues": {
      "types": "./dist/application/issues.d.ts",
      "default": "./dist/application/issues.js"
    },
    "./application/ports/issues": {
      "types": "./dist/application/ports/issues.d.ts",
      "default": "./dist/application/ports/issues.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./application/stars": {
      "types": "./dist/application/stars.d.ts",
      "default": "./dist/application/stars.js"
    },
    "./application/ports/stars": {
      "types": "./dist/application/ports/stars.d.ts",
      "default": "./dist/application/ports/stars.js"
    },
    "./application/public": {
      "types": "./dist/application/public.d.ts",
      "default": "./dist/application/public.js"
    },
    "./application/ports/public": {
      "types": "./dist/application/ports/public.d.ts",
      "default": "./dist/application/ports/public.js"
    },
    "./adapters/postgres/public": {
      "types": "./dist/adapters/postgres/public.d.ts",
      "default": "./dist/adapters/postgres/public.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@line-work/platform": "workspace:*",
    "@line-work/account": "workspace:*",
    "@line-work/organization": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:"
  }
}
