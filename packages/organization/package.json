  },
  "dependencies": {
    "@line_bot_v1/account": "workspace:*",
    "@line_bot_v1/identity-access": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/namespace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
