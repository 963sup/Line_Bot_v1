{
  "name": "@line_bot_v1/organization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/commands/organization-lifecycle": {
      "types": "./dist/application/commands/organization-lifecycle.d.ts",
      "default": "./dist/application/commands/organization-lifecycle.js"
    },
    "./composition/bootstrap/organization-governance": {
      "types": "./dist/composition/bootstrap/organization-governance.d.ts",
      "default": "./dist/composition/bootstrap/organization-governance.js"
    },
    "./application/organization-governance": {
      "types": "./dist/application/organization-governance.d.ts",
      "default": "./dist/application/organization-governance.js"
    },
    "./contracts/organization-governance": {
      "types": "./dist/contracts/organization-governance.d.ts",
      "default": "./dist/contracts/organization-governance.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./application/public": {
      "types": "./dist/application/public.d.ts",
      "default": "./dist/application/public.js"
    },
    "./postgres/public": {
      "types": "./dist/postgres/public.d.ts",
      "default": "./dist/postgres/public.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./contracts/input/organization-governance": {
      "types": "./dist/contracts/input/organization-governance.d.ts",
