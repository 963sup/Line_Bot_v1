{
  "name": "@line_bot_v1/organization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "default": "./dist/adapters/postgres.js"
    },
    "./application/organization-governance": {
      "types": "./dist/application/organization-governance.d.ts",
      "default": "./dist/application/organization-governance.js"
    },
    "./application/ports/organization-governance": {
      "types": "./dist/application/ports/organization-governance.d.ts",
      "default": "./dist/application/ports/organization-governance.js"
    },
    "./contracts/organization-governance": {
      "types": "./dist/contracts/organization-governance.d.ts",
      "default": "./dist/contracts/organization-governance.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./application/public": {
      "types": "./dist/application/public.d.ts",
      "default": "./dist/application/public.js"
    },
    "./application/ports/public": {
      "types": "./dist/application/ports/public.d.ts",
      "default": "./dist/application/ports/public.js"
