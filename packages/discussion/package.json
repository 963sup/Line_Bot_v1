{
  "name": "@line_bot_v1/discussion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/discussions": {
      "types": "./dist/application/discussions.d.ts",
      "default": "./dist/application/discussions.js"
    },
    "./contracts/discussions": {
      "types": "./dist/contracts/output/discussion-read.d.ts",
      "default": "./dist/contracts/output/discussion-read.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@line_bot_v1/namespace": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/repository": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
