{
  "name": "@line_bot_v1/project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/queries/project-collection": {
      "types": "./dist/application/queries/project-collection.d.ts",
      "default": "./dist/application/queries/project-collection.js"
    },
    "./contracts/dto/project-collection": {
      "types": "./dist/contracts/dto/project-collection.d.ts",
      "default": "./dist/contracts/dto/project-collection.js"
    },
    "./composition/bootstrap/postgres-project-collection-store": {
      "types": "./dist/composition/bootstrap/postgres-project-collection-store.d.ts",
      "default": "./dist/composition/bootstrap/postgres-project-collection-store.js"
    },
    "./contracts/management": {
      "types": "./dist/contracts/management.d.ts",
      "default": "./dist/contracts/management.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@line_bot_v1/namespace": "workspace:*",
    "@line_bot_v1/organization": "workspace:*",
    "@line_bot_v1/platform": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
