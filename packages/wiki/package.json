{
  "name": "@line_bot_v1/wiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./domain/wiki-error": {
      "types": "./dist/domain/wiki-error.d.ts",
      "default": "./dist/domain/wiki-error.js"
    },
    "./domain/policies/wiki-access": {
      "types": "./dist/domain/policies/wiki-access.d.ts",
      "default": "./dist/domain/policies/wiki-access.js"
    },
    "./application/commands/pages": {
      "types": "./dist/application/commands/pages.d.ts",
      "default": "./dist/application/commands/pages.js"
    },
    "./application/use-cases/pages": {
      "types": "./dist/application/use-cases/pages.d.ts",
      "default": "./dist/application/use-cases/pages.js"
    },
    "./application/use-cases/history": {
      "types": "./dist/application/use-cases/history.d.ts",
      "default": "./dist/application/use-cases/history.js"
    },
    "./contracts/dto/wiki": {
      "types": "./dist/contracts/dto/wiki.d.ts",
      "default": "./dist/contracts/dto/wiki.js"
    },
    "./composition/bootstrap/wiki-pages": {
      "types": "./dist/composition/bootstrap/wiki-pages.d.ts",
      "default": "./dist/composition/bootstrap/wiki-pages.js"
    },
    "./contracts/repositories/wiki-pages": {
      "types": "./dist/contracts/repositories/wiki-pages.d.ts",
      "default": "./dist/contracts/repositories/wiki-pages.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 test/*.test.ts"
  },
  "dependencies": {
    "@line_bot_v1/content": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/repository": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:"
  }
}
