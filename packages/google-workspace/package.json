{
  "name": "@line_bot_v1/google-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "default": "./dist/docs.js"
    },
    "./drive": {
      "types": "./dist/drive.d.ts",
      "default": "./dist/drive.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./gmail": {
      "types": "./dist/gmail.d.ts",
      "default": "./dist/gmail.js"
    },
    "./keep": {
      "types": "./dist/keep.d.ts",
      "default": "./dist/keep.js"
    },
    "./maps": {
      "types": "./dist/maps.d.ts",
      "default": "./dist/maps.js"
    },
    "./sheets": {
      "types": "./dist/sheets.d.ts",
      "default": "./dist/sheets.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
