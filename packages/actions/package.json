{
  "name": "@line_bot_v1/actions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/use-cases/automation": {
      "types": "./dist/application/use-cases/automation.d.ts",
      "default": "./dist/application/use-cases/automation.js"
