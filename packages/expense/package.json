    "./application/get-expense": {
      "types": "./dist/application/get-expense.d.ts",
      "default": "./dist/application/get-expense.js"
    },
    "./application/ports/expense-repository": {
      "types": "./dist/application/ports/expense-repository.d.ts",
      "default": "./dist/application/ports/expense-repository.js"
    },
    "./application/ports/receipt-intake": {
      "types": "./dist/application/ports/receipt-intake.d.ts",
