  },
  "dependencies": {
    "@line_bot_v1/integration-openai": "workspace:*",
    "@line_bot_v1/file": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/repository": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
