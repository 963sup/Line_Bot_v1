{
  "name": "@line_bot_v1/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    },
    "./testing/postgres": {
      "types": "./dist/testing/postgres.d.ts",
      "default": "./dist/testing/postgres.js"
    },
    "./testing/postgres-sessions": {
      "types": "./dist/testing/postgres-sessions.d.ts",
      "default": "./dist/testing/postgres-sessions.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "schema:check": "node --test ../../scripts/supabase/schema-source.test.mjs && node --no-wasm-code-gc --import tsx --test test/schema-contract.schema.ts"
  },
  "dependencies": {
    "pg": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
