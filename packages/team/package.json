{
  "name": "@line_bot_v1/team",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./postgres": {
      "types": "./dist/composition/bootstrap/team.d.ts",
      "default": "./dist/composition/bootstrap/team.js"
    },
    "./application/collaboration": {
      "types": "./dist/application/collaboration.d.ts",
      "default": "./dist/application/collaboration.js"
    },
    "./contracts/input/team-command": {
      "types": "./dist/contracts/input/team-command.d.ts",
      "default": "./dist/contracts/input/team-command.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./application/commands/team-command": {
      "types": "./dist/application/commands/team-command.d.ts",
      "default": "./dist/application/commands/team-command.js"
    },
    "./contracts/errors/team-error": {
      "types": "./dist/contracts/errors/team-error.d.ts",
      "default": "./dist/contracts/errors/team-error.js"
    },
    "./application/commands/team-slug": {
      "types": "./dist/application/commands/team-slug.d.ts",
      "default": "./dist/application/commands/team-slug.js"
    },
    "./postgres/project-access": {
      "types": "./dist/postgres/project-access.d.ts",
      "default": "./dist/postgres/project-access.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .cache/typecheck.tsbuildinfo && tsc -p tsconfig.test.json",
    "test": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 test/*.test.ts"
  },
  "dependencies": {
    "@line_bot_v1/account": "workspace:*",
    "@line_bot_v1/identity-access": "workspace:*",
    "@line_bot_v1/organization": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/namespace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
