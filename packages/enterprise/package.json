{
  "name": "@line_bot_v1/enterprise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/commands/enterprise-lifecycle": {
      "types": "./dist/application/commands/enterprise-lifecycle.d.ts",
      "default": "./dist/application/commands/enterprise-lifecycle.js"
    },
    "./composition/bootstrap/enterprise-governance": {
      "types": "./dist/composition/bootstrap/enterprise-governance.d.ts",
      "default": "./dist/composition/bootstrap/enterprise-governance.js"
    },
    "./application/enterprise-governance": {
      "types": "./dist/application/enterprise-governance.d.ts",
      "default": "./dist/application/enterprise-governance.js"
    },
    "./contracts/enterprise-governance": {
      "types": "./dist/contracts/enterprise-governance.d.ts",
      "default": "./dist/contracts/enterprise-governance.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./contracts/input/enterprise-governance": {
      "types": "./dist/contracts/input/enterprise-governance.d.ts",
      "default": "./dist/contracts/input/enterprise-governance.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 test/*.test.ts"
  },
  "dependencies": {
    "@line_bot_v1/account": "workspace:*",
    "@line_bot_v1/identity-access": "workspace:*",
    "@line_bot_v1/namespace": "workspace:*",
    "@line_bot_v1/organization": "workspace:*",
    "@line_bot_v1/platform": "workspace:*",
    "@line_bot_v1/repository": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
