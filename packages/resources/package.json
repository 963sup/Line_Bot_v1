{
  "name": "@line_bot_v1/resources",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/commands": {
      "types": "./dist/application/commands.d.ts",
      "default": "./dist/application/commands.js"
    },
    "./application/queries": {
      "types": "./dist/application/queries.d.ts",
      "default": "./dist/application/queries.js"
    },
    "./application/use-cases/objects": {
      "types": "./dist/application/use-cases/objects.d.ts",
      "default": "./dist/application/use-cases/objects.js"
    },
    "./contracts/dto/objects": {
      "types": "./dist/contracts/dto/objects.d.ts",
      "default": "./dist/contracts/dto/objects.js"
    },
    "./contracts/output/references": {
      "types": "./dist/contracts/output/references.d.ts",
      "default": "./dist/contracts/output/references.js"
    },
    "./contracts/output/engineering-references": {
      "types": "./dist/contracts/output/engineering-references.d.ts",
      "default": "./dist/contracts/output/engineering-references.js"
    },
    "./composition/bootstrap/objects": {
      "types": "./dist/composition/bootstrap/objects.d.ts",
      "default": "./dist/composition/bootstrap/objects.js"
    },
    "./composition/bootstrap/references": {
      "types": "./dist/composition/bootstrap/references.d.ts",
      "default": "./dist/composition/bootstrap/references.js"
    },
    "./composition/bootstrap/engineering-references": {
      "types": "./dist/composition/bootstrap/engineering-references.d.ts",
      "default": "./dist/composition/bootstrap/engineering-references.js"
    },
    "./domain/quantity": {
      "types": "./dist/domain/quantity.d.ts",
