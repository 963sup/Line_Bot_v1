{
  "name": "@line_bot_v1/assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./agents/intake": {
      "types": "./dist/composition/bootstrap/intake-agent.d.ts",
      "default": "./dist/composition/bootstrap/intake-agent.js"
    },
    "./application/answer-question": {
      "types": "./dist/application/answer-question.d.ts",
      "default": "./dist/application/answer-question.js"
    },
    "./application/parse-command": {
      "types": "./dist/application/parse-command.d.ts",
      "default": "./dist/application/parse-command.js"
    },
    "./application/runtime": {
      "types": "./dist/application/runtime.d.ts",
      "default": "./dist/application/runtime.js"
    },
    "./application/surface": {
      "types": "./dist/application/surface.d.ts",
      "default": "./dist/application/surface.js"
    },
    "./application/reply": {
      "types": "./dist/application/reply.d.ts",
      "default": "./dist/application/reply.js"
    },
    "./application/webhook-router": {
      "types": "./dist/application/webhook-router.d.ts",
      "default": "./dist/application/webhook-router.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
