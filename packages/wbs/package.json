    },
    "./domain/governance": {
      "types": "./dist/domain/governance.d.ts",
      "default": "./dist/domain/governance.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "default": "./dist/application.js"
    },
    "./contracts": {
