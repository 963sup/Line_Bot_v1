{
  "name": "@line_bot_v1/payroll",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./application/readiness": {
      "types": "./dist/application/readiness.d.ts",
      "default": "./dist/application/readiness.js"
    },
    "./domain/error": {
      "types": "./dist/domain/error.d.ts",
      "default": "./dist/domain/error.js"
    },
    "./domain/value-objects/payroll-rule": {
      "types": "./dist/domain/value-objects/payroll-rule.d.ts",
      "default": "./dist/domain/value-objects/payroll-rule.js"
    },
    "./domain/policies/payroll-readiness": {
      "types": "./dist/domain/policies/payroll-readiness.d.ts",
      "default": "./dist/domain/policies/payroll-readiness.js"
    },
    "./contracts/input/payroll-readiness-query": {
      "types": "./dist/contracts/input/payroll-readiness-query.d.ts",
      "default": "./dist/contracts/input/payroll-readiness-query.js"
    },
    "./contracts/output/payroll-readiness-sources": {
      "types": "./dist/contracts/output/payroll-readiness-sources.d.ts",
      "default": "./dist/contracts/output/payroll-readiness-sources.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
