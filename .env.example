# Project-managed configuration only.
# Copy this root-level file to .env.local beside it; configure only capabilities you use.
# Platform/CI-owned variables such as NODE_ENV, VERCEL_*, GITHUB_* and tool-only NAVIGATION_* are not duplicated here.
# Shell/deployment variables take precedence; tests do not load this file.
# Never put secrets in NEXT_PUBLIC_* variables.

# LINE Messaging API (server-only).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE MINI App public identity is source-owned, not an environment secret.
# URL format example: https://miniapp.line.me/1234567890-AbCdEfGh
# Developing / Review / Published mappings live in apps/web/src/shared/server/line-mini-app.ts.
# LIFF ID and Login Channel ID are derived from that canonical URL; do not duplicate them here.
# Local development only. Installs @line/liff-mock after the LIFF SDK loads.
NEXT_PUBLIC_USE_LIFF_MOCK=false

# Fixed public HTTPS origin, no trailing slash.
APP_ORIGIN=

# Supabase browser/Auth configuration. These values are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL runtime connection.
# Vercel Production receives POSTGRES_URL from the connected Supabase Marketplace resource.
# Local development may provide the same Supavisor transaction-mode URL (port 6543).
POSTGRES_URL=
# Operator-only non-pooling PostgreSQL connection for remote schema reconciliation.
POSTGRES_URL_NON_POOLING=
# Exact Supabase project URL used to fail closed on a wrong remote target.
SUPABASE_URL=

# Vercel Marketplace Redis REST credentials (server-only).
# Marketplace may also provide KV_URL / KV_REST_API_READ_ONLY_TOKEN; this project does not consume them.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Current AI runtime.
GEMINI_API_KEY=
GEMINI_MODEL=

# Server-only >=32 characters for POST /api/internal/attendance-maintenance.
# Configure a scheduler every minute separately; never put this secret in a URL.
ATTENDANCE_WORKER_SECRET=
